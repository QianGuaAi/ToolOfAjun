<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <!-- 本字典仅作配色与几何，禁止放置功能逻辑 -->

    <Color x:Key="BrushSidebarColor">#172030</Color>
    <Color x:Key="BrushSidebarTopColor">#1E2A3D</Color>
    <Color x:Key="BrushSidebarDividerColor">#253347</Color>
    <Color x:Key="BrushSidebarHoverColor">#1F3347</Color>
    <Color x:Key="BrushSidebarPressedColor">#253F58</Color>
    <Color x:Key="BrushSidebarActiveColor">#1A3048</Color>
    <Color x:Key="BrushSidebarTextColor">#8FA8C0</Color>
    <Color x:Key="BrushSidebarTextHoverColor">#C8DCF0</Color>
    <Color x:Key="BrushSidebarTextActiveColor">#FFFFFF</Color>

    <Color x:Key="BrushAccentBlueColor">#3B82F6</Color>
    <Color x:Key="BrushAccentTealColor">#14B8A6</Color>
    <Color x:Key="BrushAccentPurpleColor">#8B5CF6</Color>
    <Color x:Key="BrushAccentAmberColor">#F59E0B</Color>
    <Color x:Key="BrushAccentRoseColor">#F43F5E</Color>
    <Color x:Key="BrushAccentLimeColor">#84CC16</Color>

    <Color x:Key="BrushSuccessColor">#22C55E</Color>
    <Color x:Key="BrushWarningColor">#F59E0B</Color>
    <Color x:Key="BrushErrorColor">#EF4444</Color>
    <Color x:Key="BrushInfoColor">#0EA5E9</Color>

    <Color x:Key="BrushHeaderGradientStartColor">#F8FAFC</Color>
    <Color x:Key="BrushHeaderGradientEndColor">#EEF2F7</Color>

    <SolidColorBrush x:Key="BrushSidebar" Color="{StaticResource BrushSidebarColor}" />
    <SolidColorBrush x:Key="BrushSidebarTop" Color="{StaticResource BrushSidebarTopColor}" />
    <SolidColorBrush x:Key="BrushSidebarDivider" Color="{StaticResource BrushSidebarDividerColor}" />
    <SolidColorBrush x:Key="BrushSidebarHover" Color="{StaticResource BrushSidebarHoverColor}" />
    <SolidColorBrush x:Key="BrushSidebarPressed" Color="{StaticResource BrushSidebarPressedColor}" />
    <SolidColorBrush x:Key="BrushSidebarActive" Color="{StaticResource BrushSidebarActiveColor}" />
    <SolidColorBrush x:Key="BrushSidebarText" Color="{StaticResource BrushSidebarTextColor}" />
    <SolidColorBrush x:Key="BrushSidebarTextHover" Color="{StaticResource BrushSidebarTextHoverColor}" />
    <SolidColorBrush x:Key="BrushSidebarTextActive" Color="{StaticResource BrushSidebarTextActiveColor}" />

    <SolidColorBrush x:Key="BrushAccentBlue" Color="{StaticResource BrushAccentBlueColor}" />
    <SolidColorBrush x:Key="BrushAccentTeal" Color="{StaticResource BrushAccentTealColor}" />
    <SolidColorBrush x:Key="BrushAccentPurple" Color="{StaticResource BrushAccentPurpleColor}" />
    <SolidColorBrush x:Key="BrushAccentAmber" Color="{StaticResource BrushAccentAmberColor}" />
    <SolidColorBrush x:Key="BrushAccentRose" Color="{StaticResource BrushAccentRoseColor}" />
    <SolidColorBrush x:Key="BrushAccentLime" Color="{StaticResource BrushAccentLimeColor}" />

    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource BrushSuccessColor}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource BrushWarningColor}" />
    <SolidColorBrush x:Key="BrushError" Color="{StaticResource BrushErrorColor}" />
    <SolidColorBrush x:Key="BrushInfo" Color="{StaticResource BrushInfoColor}" />

    <SolidColorBrush x:Key="BrushHeaderGradientStart" Color="{StaticResource BrushHeaderGradientStartColor}" />
    <SolidColorBrush x:Key="BrushHeaderGradientEnd" Color="{StaticResource BrushHeaderGradientEndColor}" />

    <CornerRadius x:Key="CornerRadiusCard">12</CornerRadius>
    <CornerRadius x:Key="CornerRadiusButton">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusBadge">999</CornerRadius>

    <Style x:Key="BadgeBase" TargetType="Border">
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusBadge}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="TextElement.Foreground" Value="White" />
        <Setter Property="TextElement.FontSize" Value="11" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="BadgeSuccess" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
        <Setter Property="Background" Value="{DynamicResource BrushSuccess}" />
    </Style>

    <Style x:Key="BadgeWarning" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
        <Setter Property="Background" Value="{DynamicResource BrushWarning}" />
    </Style>

    <Style x:Key="BadgeError" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
        <Setter Property="Background" Value="{DynamicResource BrushError}" />
    </Style>

    <Style x:Key="BadgeInfo" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
        <Setter Property="Background" Value="{DynamicResource BrushInfo}" />
    </Style>

    <Style TargetType="materialDesign:Card">
        <Setter Property="UniformCornerRadius" Value="12" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="materialDesign:ShadowAssist.ShadowDepth" Value="Depth2" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="materialDesign:ShadowAssist.ShadowDepth" Value="Depth4" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
