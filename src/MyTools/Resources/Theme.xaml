<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <!-- 本字典仅作配色与几何，禁止放置功能逻辑 -->

    <Color x:Key="BrushSidebarColor">#172030</Color>
    <Color x:Key="BrushSidebarTopColor">#1E2A3D</Color>
    <Color x:Key="BrushSidebarDividerColor">#253347</Color>
    <Color x:Key="BrushSidebarHoverColor">#1F3347</Color>
    <Color x:Key="BrushSidebarPressedColor">#253F58</Color>
    <Color x:Key="BrushSidebarActiveColor">#1A3048</Color>
    <Color x:Key="BrushSidebarTextColor">#8FA8C0</Color>
    <Color x:Key="BrushSidebarTextHoverColor">#C8DCF0</Color>
    <Color x:Key="BrushSidebarTextActiveColor">#FFFFFF</Color>

    <Color x:Key="BrushAccentBlueColor">#3B82F6</Color>
    <Color x:Key="BrushAccentTealColor">#14B8A6</Color>
    <Color x:Key="BrushAccentPurpleColor">#8B5CF6</Color>
    <Color x:Key="BrushAccentAmberColor">#F59E0B</Color>
    <Color x:Key="BrushAccentRoseColor">#F43F5E</Color>
    <Color x:Key="BrushAccentLimeColor">#84CC16</Color>

    <Color x:Key="BrushSuccessColor">#22C55E</Color>
    <Color x:Key="BrushWarningColor">#F59E0B</Color>
    <Color x:Key="BrushErrorColor">#EF4444</Color>
    <Color x:Key="BrushInfoColor">#0EA5E9</Color>
    <Color x:Key="BrushInfoSoftColor">#EAF6FF</Color>

    <Color x:Key="BrushHeaderGradientStartColor">#F8FAFC</Color>
    <Color x:Key="BrushHeaderGradientEndColor">#EEF2F7</Color>

    <SolidColorBrush x:Key="BrushSidebar" Color="{StaticResource BrushSidebarColor}" />
    <SolidColorBrush x:Key="BrushSidebarTop" Color="{StaticResource BrushSidebarTopColor}" />
    <SolidColorBrush x:Key="BrushSidebarDivider" Color="{StaticResource BrushSidebarDividerColor}" />
    <SolidColorBrush x:Key="BrushSidebarHover" Color="{StaticResource BrushSidebarHoverColor}" />
    <SolidColorBrush x:Key="BrushSidebarPressed" Color="{StaticResource BrushSidebarPressedColor}" />
    <SolidColorBrush x:Key="BrushSidebarActive" Color="{StaticResource BrushSidebarActiveColor}" />
    <SolidColorBrush x:Key="BrushSidebarText" Color="{StaticResource BrushSidebarTextColor}" />
    <SolidColorBrush x:Key="BrushSidebarTextHover" Color="{StaticResource BrushSidebarTextHoverColor}" />
    <SolidColorBrush x:Key="BrushSidebarTextActive" Color="{StaticResource BrushSidebarTextActiveColor}" />

    <SolidColorBrush x:Key="BrushAccentBlue" Color="{StaticResource BrushAccentBlueColor}" />
    <SolidColorBrush x:Key="BrushAccentTeal" Color="{StaticResource BrushAccentTealColor}" />
    <SolidColorBrush x:Key="BrushAccentPurple" Color="{StaticResource BrushAccentPurpleColor}" />
    <SolidColorBrush x:Key="BrushAccentAmber" Color="{StaticResource BrushAccentAmberColor}" />
    <SolidColorBrush x:Key="BrushAccentRose" Color="{StaticResource BrushAccentRoseColor}" />
    <SolidColorBrush x:Key="BrushAccentLime" Color="{StaticResource BrushAccentLimeColor}" />

    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource BrushSuccessColor}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource BrushWarningColor}" />
    <SolidColorBrush x:Key="BrushError" Color="{StaticResource BrushErrorColor}" />
    <SolidColorBrush x:Key="BrushInfo" Color="{StaticResource BrushInfoColor}" />
    <SolidColorBrush x:Key="BrushInfoSoft" Color="{StaticResource BrushInfoSoftColor}" />

    <SolidColorBrush x:Key="BrushHeaderGradientStart" Color="{StaticResource BrushHeaderGradientStartColor}" />
    <SolidColorBrush x:Key="BrushHeaderGradientEnd" Color="{StaticResource BrushHeaderGradientEndColor}" />

    <CornerRadius x:Key="CornerRadiusCard">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusButton">6</CornerRadius>
    <CornerRadius x:Key="CornerRadiusBadge">999</CornerRadius>

    <!-- ============================================================ -->
    <!-- 设计令牌：间距 (Spacing) -->
    <!-- ============================================================ -->
    <Thickness x:Key="ThicknessCardPadding">12,10</Thickness>
    <Thickness x:Key="ThicknessCardPaddingDense">10,8</Thickness>
    <Thickness x:Key="ThicknessCardMargin">0,0,0,8</Thickness>
    <Thickness x:Key="ThicknessCardMarginDense">0,0,0,6</Thickness>
    <Thickness x:Key="ThicknessFieldRow">0,0,0,8</Thickness>
    <Thickness x:Key="ThicknessFieldGap">0,0,8,0</Thickness>

    <!-- ============================================================ -->
    <!-- 设计令牌：字号 (Typography) -->
    <!-- ============================================================ -->
    <system:Double x:Key="FontSizeCaption">11</system:Double>
    <system:Double x:Key="FontSizeBody">12</system:Double>
    <system:Double x:Key="FontSizeBodyLarge">13</system:Double>
    <system:Double x:Key="FontSizeSubtitle">13</system:Double>
    <system:Double x:Key="FontSizeTitle">15</system:Double>
    <system:Double x:Key="FontSizeHeadline">18</system:Double>

    <!-- ============================================================ -->
    <!-- 强调渐变（用于 Hero / Header / 重点按钮） -->
    <!-- ============================================================ -->
    <LinearGradientBrush x:Key="BrushAccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6366F1" Offset="0" />
        <GradientStop Color="#8B5CF6" Offset="0.5" />
        <GradientStop Color="#EC4899" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushBlueGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3B82F6" Offset="0" />
        <GradientStop Color="#0EA5E9" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushTealGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#14B8A6" Offset="0" />
        <GradientStop Color="#22C55E" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushHeroGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F8FAFC" Offset="0" />
        <GradientStop Color="#E0E7FF" Offset="0.6" />
        <GradientStop Color="#FCE7F3" Offset="1" />
    </LinearGradientBrush>

    <!-- ============================================================ -->
    <!-- 文本样式 -->
    <!-- ============================================================ -->
    <Style x:Key="TextHeadline" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeadline}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#0F172A" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="TextSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#0F172A" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <Style x:Key="TextSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#1F2937" />
    </Style>

    <Style x:Key="TextBodyStandard" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="#1F2937" />
    </Style>

    <Style x:Key="TextFieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="#475569" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="TextCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="#64748B" />
        <Setter Property="Opacity" Value="0.92" />
    </Style>

    <Style x:Key="TextHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="#94A3B8" />
    </Style>

    <Style x:Key="TextMonoCode" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas, 'Cascadia Mono', 'Fira Code', monospace" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="#1F2937" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ============================================================ -->
    <!-- 卡片样式 -->
    <!-- ============================================================ -->
    <Style x:Key="SectionCard" TargetType="materialDesign:Card">
        <Setter Property="UniformCornerRadius" Value="8" />
        <Setter Property="Padding" Value="{StaticResource ThicknessCardPadding}" />
        <Setter Property="Margin" Value="{StaticResource ThicknessCardMargin}" />
        <Setter Property="materialDesign:ShadowAssist.ShadowDepth" Value="Depth2" />
        <Setter Property="Background" Value="White" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="materialDesign:ShadowAssist.ShadowDepth" Value="Depth2" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SectionCardDense" TargetType="materialDesign:Card" BasedOn="{StaticResource SectionCard}">
        <Setter Property="Padding" Value="{StaticResource ThicknessCardPaddingDense}" />
        <Setter Property="Margin" Value="{StaticResource ThicknessCardMarginDense}" />
    </Style>

    <Style x:Key="SectionCardOutlined" TargetType="materialDesign:Card" BasedOn="{StaticResource SectionCard}">
        <Setter Property="materialDesign:ShadowAssist.ShadowDepth" Value="Depth0" />
        <Setter Property="BorderBrush" Value="#E2E8F0" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ============================================================ -->
    <!-- Section 头：图标 + 标题 + 副标题 -->
    <!-- ============================================================ -->
    <Style x:Key="SectionHeaderRow" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- ============================================================ -->
    <!-- 按钮样式（基于 MaterialDesign） -->
    <!-- ============================================================ -->
    <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="84" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6" />
    </Style>

    <Style x:Key="GhostActionButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6" />
    </Style>

    <Style x:Key="DangerActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
        <Setter Property="Background" Value="{DynamicResource BrushError}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushError}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="SuccessActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
        <Setter Property="Background" Value="{DynamicResource BrushSuccess}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushSuccess}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- ============================================================ -->
    <!-- 输入框样式 -->
    <!-- ============================================================ -->
    <Style x:Key="StandardTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
        <Setter Property="Height" Value="30" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="materialDesign:HintAssist.FloatingScale" Value="0.85" />
    </Style>

    <Style x:Key="StandardComboBox" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
        <Setter Property="Height" Value="30" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    </Style>

    <!-- ============================================================ -->
    <!-- Badge 样式 -->
    <!-- ============================================================ -->
    <Style x:Key="BadgeBase" TargetType="Border">
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusBadge}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="TextElement.Foreground" Value="White" />
        <Setter Property="TextElement.FontSize" Value="11" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="BadgeSuccess" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
        <Setter Property="Background" Value="{DynamicResource BrushSuccess}" />
    </Style>

    <Style x:Key="BadgeWarning" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
        <Setter Property="Background" Value="{DynamicResource BrushWarning}" />
    </Style>

    <Style x:Key="BadgeError" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
        <Setter Property="Background" Value="{DynamicResource BrushError}" />
    </Style>

    <Style x:Key="BadgeInfo" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
        <Setter Property="Background" Value="{DynamicResource BrushInfo}" />
    </Style>

    <!-- ============================================================ -->
    <!-- 默认 Card 样式（保留向后兼容） -->
    <!-- ============================================================ -->
    <Style TargetType="materialDesign:Card">
        <Setter Property="UniformCornerRadius" Value="8" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="materialDesign:ShadowAssist.ShadowDepth" Value="Depth2" />
        <Setter Property="Background" Value="White" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="materialDesign:ShadowAssist.ShadowDepth" Value="Depth2" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================ -->
    <!-- 分隔线 -->
    <!-- ============================================================ -->
    <Style x:Key="DividerLine" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="#E5E7EB" />
        <Setter Property="Margin" Value="0,8" />
    </Style>

    <!-- ============================================================ -->
    <!-- 状态药丸 (StatusPill) -->
    <!-- ============================================================ -->
    <Style x:Key="StatusPill" TargetType="Border">
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="#F1F5F9" />
        <Setter Property="TextElement.FontSize" Value="11" />
        <Setter Property="TextElement.Foreground" Value="#475569" />
        <Setter Property="TextElement.FontWeight" Value="Medium" />
    </Style>
</ResourceDictionary>
