<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <SolidColorBrush x:Key="ShellPaperBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ShellFlatBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="ShellDividerBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="ShellBodyBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="ShellCaptionBrush" Color="#64748B" />

    <system:Double x:Key="ShellFontSizeCaption">11</system:Double>
    <system:Double x:Key="ShellFontSizeBody">12</system:Double>
    <system:Double x:Key="TopMenuBarHeight">24</system:Double>
    <system:Double x:Key="BottomStatusBarHeight">22</system:Double>

    <Style x:Key="TopMenuBarBorder" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource TopMenuBarHeight}" />
        <Setter Property="Background" Value="{StaticResource ShellPaperBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ShellDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="TopMenuBar" TargetType="Menu">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="{StaticResource ShellFontSizeBody}" />
    </Style>

    <Style x:Key="TopMenuItem" TargetType="MenuItem">
        <Setter Property="Height" Value="{StaticResource TopMenuBarHeight}" />
        <Setter Property="FontSize" Value="{StaticResource ShellFontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource ShellBodyBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="BottomStatusBar" TargetType="StatusBar">
        <Setter Property="Height" Value="{StaticResource BottomStatusBarHeight}" />
        <Setter Property="Background" Value="{StaticResource ShellPaperBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ShellDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="6,0" />
    </Style>

    <Style x:Key="StatusBarText" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource ShellFontSizeCaption}" />
        <Setter Property="Foreground" Value="{StaticResource ShellCaptionBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
</ResourceDictionary>
