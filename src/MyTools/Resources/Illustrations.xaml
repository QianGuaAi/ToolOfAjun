    <DrawingImage x:Key="HomeHero">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,260,180" RadiusX="18" RadiusY="18" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{DynamicResource BrushAccentBlue}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="22,24,102,128" RadiusX="12" RadiusY="12" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{DynamicResource BrushAccentPurple}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="136,24,102,72" RadiusX="12" RadiusY="12" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{DynamicResource BrushAccentTeal}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="136,104,102,48" RadiusX="12" RadiusY="12" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="White">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="73,88" RadiusX="20" RadiusY="20" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="White">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="162,50,48,8" RadiusX="4" RadiusY="4" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="White">
