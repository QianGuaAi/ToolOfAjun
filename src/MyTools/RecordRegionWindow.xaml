<Window x:Class="MyTools.RecordRegionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="录像区域"
        Width="960"
        Height="540"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid x:Name="OverlayRoot">
        <Border BorderBrush="#FFE53935"
                BorderThickness="4"
                Background="Transparent"
                CornerRadius="2"
                Margin="6" />

        <Grid Margin="6" IsHitTestVisible="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Width="8" Height="8" Background="#FFE53935" />
            <Border Grid.Row="0" Grid.Column="1" Width="8" Height="8" Background="#FFE53935" HorizontalAlignment="Center" />
            <Border Grid.Row="0" Grid.Column="2" Width="8" Height="8" Background="#FFE53935" />
            <Border Grid.Row="1" Grid.Column="0" Width="8" Height="8" Background="#FFE53935" VerticalAlignment="Center" />
            <Border Grid.Row="1" Grid.Column="2" Width="8" Height="8" Background="#FFE53935" VerticalAlignment="Center" />
            <Border Grid.Row="2" Grid.Column="0" Width="8" Height="8" Background="#FFE53935" />
            <Border Grid.Row="2" Grid.Column="1" Width="8" Height="8" Background="#FFE53935" HorizontalAlignment="Center" />
            <Border Grid.Row="2" Grid.Column="2" Width="8" Height="8" Background="#FFE53935" />
        </Grid>

        <Border HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,12,12,0"
                Width="48"
                Height="48"
                Background="#FFE53935"
                CornerRadius="24">
            <Button x:Name="ToggleRecordButton"
                    BorderThickness="0"
                    Background="Transparent"
                    Foreground="White"
                    ToolTip="开始录像"
                    Click="ToggleRecordButton_Click">
                <materialDesign:PackIcon x:Name="RecordIcon"
                                         Kind="RecordRec"
                                         Width="24"
                                         Height="24" />
            </Button>
        </Border>
    </Grid>
</Window>
