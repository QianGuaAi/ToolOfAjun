                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="Home">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <Grid Margin="16">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="Network">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,10"
                        CornerRadius="{StaticResource CornerRadiusCard}"
                        Padding="14,10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding RefreshCommand}" ToolTip="刷新">
                            <materialDesign:PackIcon Kind="Refresh" Width="22" Height="22" />
                        </Button>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BrushBlueGradient}" Margin="0,0,12,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="LanConnect" Width="18" Height="18" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="当前网络" Style="{StaticResource TextHeadline}" />
                                <TextBlock Text="实时查看网卡、IP、网关与 DNS 信息。" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="NetworkListControl" ItemsSource="{Binding NetworkList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <materialDesign:Card Margin="0,0,0,10" Padding="12,10" materialDesign:ElevationAssist.Elevation="Dp1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <materialDesign:PackIcon Kind="Lan"
                                                                     Width="24" Height="24"
                                                                     VerticalAlignment="Top"
                                                                     HorizontalAlignment="Center"
                                                                     Margin="0,2,0,0"
                                                                     Foreground="{Binding Status, Converter={StaticResource StatusToColorConverter}}" />

                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource TextSubtitle}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource TextCaption}" Margin="0,1,0,6" TextTrimming="CharacterEllipsis" />

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Text="IP 地址：" Grid.Row="0" Style="{StaticResource TextHint}" Margin="0,0,10,3" />
                                                    <TextBlock Text="{Binding IpAddress}" Grid.Row="0" Grid.Column="1" Style="{StaticResource TextBodyStandard}" TextWrapping="Wrap" Margin="0,0,0,3" />

                                                    <TextBlock Text="网关：" Grid.Row="1" Style="{StaticResource TextHint}" Margin="0,0,10,3" />
                                                    <TextBlock Text="{Binding Gateway}" Grid.Row="1" Grid.Column="1" Style="{StaticResource TextBodyStandard}" TextWrapping="Wrap" Margin="0,0,0,3" />

                                                    <TextBlock Text="DNS：" Grid.Row="2" Style="{StaticResource TextHint}" Margin="0,0,10,3" />
                                                    <TextBlock Text="{Binding Dns}" Grid.Row="2" Grid.Column="1" Style="{StaticResource TextBodyStandard}" TextWrapping="Wrap" Margin="0,0,0,3" />

                                                    <TextBlock Text="MAC：" Grid.Row="3" Style="{StaticResource TextHint}" Margin="0,0,10,3" />
                                                    <TextBlock Text="{Binding MacAddress}" Grid.Row="3" Grid.Column="1" Style="{StaticResource TextBodyStandard}" Margin="0,0,0,3" />

                                                    <TextBlock Text="速率：" Grid.Row="4" Style="{StaticResource TextHint}" Margin="0,0,10,3" />
                                                    <TextBlock Text="{Binding LinkSpeed}" Grid.Row="4" Grid.Column="1" Style="{StaticResource TextBodyStandard}" Margin="0,0,0,3" />

                                                    <TextBlock Text="类型：" Grid.Row="5" Style="{StaticResource TextHint}" Margin="0,0,10,0" />
                                                    <TextBlock Text="{Binding AdapterType}" Grid.Row="5" Grid.Column="1" Style="{StaticResource TextBodyStandard}" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </materialDesign:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=NetworkListControl}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Image Source="{StaticResource NetworkEmpty}" Width="160" Height="120" HorizontalAlignment="Center" />
                        <TextBlock Text="No network entries available right now."
                                   Style="{StaticResource TextSubtitle}"
                                   HorizontalAlignment="Center"
                                   Opacity="0.4"
                                   Margin="0,12,0,0" />
                        <Button Content="刷新" HorizontalAlignment="Center"
                                Style="{StaticResource GhostActionButton}"
                                Command="{Binding RefreshCommand}"
                                Margin="0,12,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Margin="16">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="Uninstall">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,10"
                        CornerRadius="{StaticResource CornerRadiusCard}"
                        Padding="14,10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Style="{StaticResource BadgeInfo}"
                                    Margin="0,0,12,0"
                                    Background="{DynamicResource BrushAccentLime}">
                                <TextBlock Text="{Binding InstalledProgramsCountText}" />
                            </Border>
                            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                         IsIndeterminate="True"
                                         Width="22"
                                         Height="22"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding IsInstalledProgramsBusy, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                    Command="{Binding RefreshInstalledProgramsCommand}"
                                    ToolTip="刷新程序列表">
                                <materialDesign:PackIcon Kind="Refresh" Width="22" Height="22" />
                            </Button>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    Margin="0,0,12,0">
                            <TextBox Width="190"
                                     Margin="0,0,8,0"
                                     Text="{Binding InstalledProgramSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource StandardTextBox}"
                                     materialDesign:HintAssist.Hint="搜索程序/发布者/路径" />
                            <ComboBox Width="126"
                                      Height="32"
                                      Margin="0,0,8,0"
                                      ItemsSource="{Binding InstalledProgramSortOptions}"
                                      SelectedItem="{Binding InstalledProgramSortMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="排序" />
                            <ComboBox Width="112"
                                      Height="32"
                                      Margin="0,0,8,0"
                                      ItemsSource="{Binding InstalledProgramSizeFilterOptions}"
                                      SelectedItem="{Binding InstalledProgramSizeFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="按大小筛选" />
                            <ComboBox Width="112"
                                      Height="32"
                                      ItemsSource="{Binding InstalledProgramDateFilterOptions}"
                                      SelectedItem="{Binding InstalledProgramDateFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="按安装日期筛选" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BrushTealGradient}" Margin="0,0,12,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="PackageVariantRemove" Width="18" Height="18" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="程序卸载" Style="{StaticResource TextHeadline}" />
                                <TextBlock Text="{Binding InstalledProgramsStatusMessage}" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <DockPanel Grid.Row="1" Margin="0,0,0,8">
                    <Border DockPanel.Dock="Right" Style="{StaticResource BadgeInfo}" Margin="8,0,0,0">
                        <TextBlock Text="{Binding SelectedInstalledProgramsCountText}" />
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource GhostActionButton}"
                                Command="{Binding SelectFilteredInstalledProgramsCommand}"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="14" Height="14" Margin="0,0,6,0" />
                                <TextBlock Text="全选筛选" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostActionButton}"
                                Command="{Binding ClearInstalledProgramSelectionCommand}"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Broom" Width="14" Height="14" Margin="0,0,6,0" />
                                <TextBlock Text="清除选择" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostActionButton}"
                                Command="{Binding ExportInstalledProgramListCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileExportOutline" Width="14" Height="14" Margin="0,0,6,0" />
                                <TextBlock Text="导出清单" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="2">
                    <DataGrid ItemsSource="{Binding FilteredInstalledProgramsView}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              RowHeight="42"
                              Style="{StaticResource MaterialDesignDataGrid}"
                              materialDesign:DataGridAssist.CellPadding="10 4 10 4"
                              materialDesign:DataGridAssist.ColumnHeaderPadding="10 8 10 8">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="42" IsReadOnly="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="程序" Width="2.1*" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding DisplayName}" />
                                            <TextBlock Text="{Binding PublisherDisplay}"
                                                       FontSize="11"
                                                       Opacity="0.55"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="版本" Width="120" Binding="{Binding VersionDisplay}" IsReadOnly="True" />
                            <DataGridTextColumn Header="安装日期" Width="110" Binding="{Binding InstallDateDisplay}" IsReadOnly="True" />
                            <DataGridTextColumn Header="大小" Width="90" Binding="{Binding EstimatedSizeDisplay}" IsReadOnly="True" />
                            <DataGridTextColumn Header="来源" Width="120" Binding="{Binding Source}" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="静默" Width="102" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SilentUninstallDisplay}"
                                                   ToolTip="{Binding SilentUninstallDetail}"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBodyStandard}">
                                                    <Setter Property="Foreground" Value="#64748B" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSilentUninstallCandidate}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource BrushAccentTeal}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="安装位置" Width="1.3*" Binding="{Binding InstallLocationDisplay}" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="卸载" Width="86" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding DataContext.UninstallProgramCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding RequiresAdminDisplay}">
                                            <materialDesign:PackIcon Kind="TrashCanOutline"
                                                                     Width="20"
                                                                     Height="20"
                                                                     Foreground="{DynamicResource BrushError}" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding HasNoInstalledPrograms, Converter={StaticResource BoolToVis}}">
                        <materialDesign:PackIcon Kind="PackageVariant"
                                                 Width="76"
                                                 Height="76"
                                                 Opacity="0.28"
                                                 HorizontalAlignment="Center" />
                        <TextBlock Text="未发现匹配的程序"
                                   Style="{StaticResource TextSubtitle}"
                                   HorizontalAlignment="Center"
                                   Opacity="0.5"
                                   Margin="0,12,0,0" />
                        <Button Content="刷新列表"
                                Style="{StaticResource GhostActionButton}"
                                Command="{Binding RefreshInstalledProgramsCommand}"
                                Margin="0,12,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Margin="20">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="Startup">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,8"
                        CornerRadius="{StaticResource CornerRadiusCard}"
                        Padding="12,8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBox Width="220"
                                     Margin="0,0,10,0"
                                     Text="{Binding StartupSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource StandardTextBox}"
                                     materialDesign:HintAssist.Hint="搜索名称/发布者/命令/位置/来源" />
                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                    Command="{Binding RefreshCommand}"
                                    ToolTip="刷新启动项">
                                <materialDesign:PackIcon Kind="Refresh" Width="22" Height="22" />
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#F59E0B" Offset="0" />
                                        <GradientStop Color="#EF4444" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <materialDesign:PackIcon Kind="RocketLaunchOutline" Width="18" Height="18" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="启动项管理" Style="{StaticResource TextHeadline}" />
                                <TextBlock Text="管理 Windows 开机启动项" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredStartupView}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <materialDesign:Card Margin="0,0,0,10" Padding="0"
                                                        materialDesign:ElevationAssist.Elevation="Dp1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="5" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" CornerRadius="4,0,0,4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#2E7D32" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                <Setter Property="Background" Value="#9E9E9E" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="12,12,8,12">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource TextSubtitle}" FontWeight="Bold" />
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <materialDesign:PackIcon Kind="CertificateOutline" Width="12" Height="12" VerticalAlignment="Center" Opacity="0.5" />
                                                    <TextBlock Text="{Binding PublisherDisplay}"
                                                               Style="{StaticResource TextCaption}"
                                                               Margin="4,0,14,0"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding PublisherDisplay}" />
                                                    <materialDesign:PackIcon Kind="FileOutline" Width="12" Height="12" VerticalAlignment="Center" Opacity="0.5" />
                                                    <TextBlock Text="{Binding ExecutablePathDisplay}"
                                                               Style="{StaticResource TextCaption}"
                                                               Margin="4,0,0,0"
                                                               Opacity="0.65"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding ExecutablePathDisplay}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Command}" Style="{StaticResource TextCaption}" Opacity="0.6" Margin="0,4,0,4"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="AccountCircle" Width="12" Height="12" VerticalAlignment="Center" Opacity="0.5" />
                                                    <TextBlock Text="{Binding SourceLocationDisplay}" Style="{StaticResource TextCaption}" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="4,0,0,0" />
                                                    <materialDesign:PackIcon Kind="AlertCircleOutline" Width="12" Height="12" VerticalAlignment="Center" Opacity="0.5" Margin="14,0,0,0" />
                                                    <TextBlock Text="{Binding ExecutableStatusDisplay}" Margin="4,0,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                                                                <Setter Property="Foreground" Value="#2E7D32" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ExecutableExists}" Value="False">
                                                                        <Setter Property="Foreground" Value="#E65100" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding HasExecutablePath}" Value="False">
                                                                        <Setter Property="Foreground" Value="#757575" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="12" Height="12" VerticalAlignment="Center" Opacity="0.5" Margin="14,0,0,0" />
                                                    <TextBlock Text="{Binding SignatureStatusDisplay}" Margin="4,0,0,0"
                                                               ToolTip="{Binding SignatureDetailDisplay}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                                                                <Setter Property="Foreground" Value="#E65100" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDigitallySigned}" Value="True">
                                                                        <Setter Property="Foreground" Value="#2E7D32" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ExecutableExists}" Value="False">
                                                                        <Setter Property="Foreground" Value="#757575" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <materialDesign:PackIcon Kind="ShieldLockOutline" Width="12" Height="12" VerticalAlignment="Center" Opacity="0.5" Margin="14,0,0,0" />
                                                    <TextBlock Text="{Binding SignatureTrustStatus}" Margin="4,0,0,0"
                                                               ToolTip="{Binding SignatureDetailDisplay}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                                                                <Setter Property="Foreground" Value="#757575" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSignatureChainTrusted}" Value="True">
                                                                        <Setter Property="Foreground" Value="#2E7D32" />
                                                                    </DataTrigger>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsDigitallySigned}" Value="True" />
                                                                            <Condition Binding="{Binding IsSignatureChainTrusted}" Value="False" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Foreground" Value="#C62828" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Margin="0,0,8,0">
                                                <Button Command="{Binding DataContext.ToggleStartupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Width="80"
                                                        Margin="0,0,8,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource GhostActionButton}">
                                                            <Setter Property="Content" Value="禁用" />
                                                            <Setter Property="Foreground" Value="#C62828" />
                                                            <Setter Property="BorderBrush" Value="#C62828" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                    <Setter Property="Content" Value="启用" />
                                                                    <Setter Property="Foreground" Value="#2E7D32" />
                                                                    <Setter Property="BorderBrush" Value="#2E7D32" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        Command="{Binding DataContext.DeleteStartupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="永久删除（需确认）">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Foreground="#9E9E9E" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </materialDesign:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasNoStartupItems, Converter={StaticResource BoolToVis}}">
                        <Image Source="{StaticResource StartupEmpty}" Width="160" Height="120" HorizontalAlignment="Center" />
                        <TextBlock Text="未发现匹配的启动项" Style="{StaticResource TextSubtitle}"
                                   HorizontalAlignment="Center" Opacity="0.4" Margin="0,12,0,0" />
                        <TextBlock Text="可清空搜索或点击刷新重新扫描" Style="{StaticResource TextCaption}"
                                   HorizontalAlignment="Center" Opacity="0.3" Margin="0,4,0,0" />
                        <Button Content="刷新"
                                Style="{StaticResource GhostActionButton}"
                                Command="{Binding RefreshCommand}"
                                Margin="0,12,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Margin="20">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="WireGuard">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="0,0,0,20" CornerRadius="{StaticResource CornerRadiusCard}" Padding="20,16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BrushTealGradient}" Margin="0,0,12,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ShieldLock" Width="18" Height="18" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="VPN 连接" Style="{StaticResource TextHeadline}" />
                        <TextBlock Text="快速连接与切换 WireGuard 隧道" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                    </StackPanel>
                    <Border Padding="10,3" Margin="20,0,0,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource BadgeInfo}">
                                <Setter Property="Background" Value="{DynamicResource BrushInfo}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWgConnected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrushSuccess}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsWgBusy}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrushWarning}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding WgStatusText}" Foreground="White" FontWeight="Bold" />
                    </Border>
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                 IsIndeterminate="True"
                                 Width="20" Height="20"
                                 Margin="12,0,0,0"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsWgBusy, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding ToggleWgSettingsCommand}" Margin="6,0,0,0" ToolTip="设置">
                        <materialDesign:PackIcon Kind="Settings" />
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding ImportWireGuardConfigCommand}" Margin="2,0,0,0" ToolTip="导入 .conf 配置">
                        <materialDesign:PackIcon Kind="FileImportOutline" />
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding ToggleWgLogCommand}" Margin="2,0,0,0" ToolTip="连接日志">
                        <materialDesign:PackIcon Kind="TextBoxSearchOutline" />
                    </Button>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <materialDesign:Card Grid.Row="0" Padding="12,10" Margin="0,0,0,10"
                                         Background="#FFF3E0"
                                         Visibility="{Binding WgExeNotFound, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="#E65100" Width="20" Height="20" VerticalAlignment="Center" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#BF360C">
                                <Run FontWeight="Bold" Text="WireGuard 未安装" />
                                <Run Text="— 请先安装 WireGuard for Windows，下载地址：https://www.wireguard.com/install/" />
                            </TextBlock>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Row="1" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBox materialDesign:HintAssist.Hint="接口名称 (例如 wg0)"
                                     Text="{Binding WgInterfaceName}"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Margin="0,0,0,10" />
                            <TextBlock Text="配置内容 (.conf):" Style="{StaticResource TextCaption}" Margin="0,10,0,5" />
                            <TextBox Text="{Binding WgConfig, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="200"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="[Interface]&#x0a;PrivateKey = ...&#x0a;Address = ...&#x0a;&#x0a;[Peer]&#x0a;PublicKey = ...&#x0a;Endpoint = ..." />
                            <UniformGrid Rows="1" Columns="2" Margin="0,10,0,0">
                                <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,8,0" Background="#FAFBFC">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="TimerOutline" Width="15" Height="15" Margin="0,0,6,0" Foreground="{DynamicResource BrushAccentTeal}" />
                                        <TextBlock Text="{Binding WgConnectionElapsedText}" Style="{StaticResource TextCaption}" />
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0" Background="#FAFBFC">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ClockCheckOutline" Width="15" Height="15" Margin="0,0,6,0" Foreground="{DynamicResource BrushAccentBlue}" />
                                        <TextBlock Text="{Binding WgLastConnectedText}" Style="{StaticResource TextCaption}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,8"
                                    Margin="0,10,0,0"
                                    Visibility="{Binding HasWireGuardTunnels, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right"
                                                Content="刷新"
                                                Height="28"
                                                Command="{Binding RefreshWireGuardTunnelsCommand}"
                                                Style="{StaticResource GhostActionButton}" />
                                        <TextBlock Text="已保存隧道" Style="{StaticResource TextSubtitle}" FontSize="13" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding WireGuardTunnels}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E2E8F0"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="8,6"
                                                        Background="#FAFBFC"
                                                        Margin="0,0,0,5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding InterfaceName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding DirectoryPath}" Style="{StaticResource TextHint}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding TimeText}" Style="{StaticResource TextHint}" FontSize="10" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding SizeText}"
                                                                   Style="{StaticResource TextHint}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="8,0,10,0" />
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="加载"
                                                                    Height="28"
                                                                    Padding="8,0"
                                                                    Margin="0,0,5,0"
                                                                    Command="{Binding DataContext.LoadWireGuardTunnelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource GhostActionButton}" />
                                                            <Button Content="差异"
                                                                    Height="28"
                                                                    Padding="8,0"
                                                                    Margin="0,0,5,0"
                                                                    Command="{Binding DataContext.PreviewWireGuardTunnelDiffCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource GhostActionButton}" />
                                                            <Button Content="导出"
                                                                    Height="28"
                                                                    Padding="8,0"
                                                                    Margin="0,0,5,0"
                                                                    Command="{Binding DataContext.ExportWireGuardTunnelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource GhostActionButton}" />
                                                            <Button Content="重命名"
                                                                    Height="28"
                                                                    Padding="8,0"
                                                                    Margin="0,0,5,0"
                                                                    Command="{Binding DataContext.RenameWireGuardTunnelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource GhostActionButton}" />
                                                            <Button Height="28"
                                                                    Width="28"
                                                                    Padding="0"
                                                                    Command="{Binding DataContext.DeleteWireGuardTunnelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource MaterialDesignIconButton}"
                                                                    ToolTip="删除配置">
                                                                <materialDesign:PackIcon Kind="DeleteOutline" Width="15" Height="15" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Row="2"
                                         Padding="12,10"
                                         Margin="0,0,0,10"
                                         Visibility="{Binding IsWgLogOpen, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right"
                                        Content="清空"
                                        Height="28"
                                        Command="{Binding ClearWgLogCommand}"
                                        Style="{StaticResource GhostActionButton}" />
                                <TextBlock Text="连接日志" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <ListBox ItemsSource="{Binding WgConnectionLogs}"
                                     MaxHeight="140"
                                     BorderThickness="0"
                                     FontFamily="Consolas"
                                     FontSize="12" />
                        </StackPanel>
                    </materialDesign:Card>

                    <DockPanel Grid.Row="3">
                        <Button DockPanel.Dock="Right"
                                Command="{Binding ImportWireGuardConfigCommand}"
                                Style="{StaticResource GhostActionButton}"
                                Height="44"
                                Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileImportOutline" Width="14" Height="14" Margin="0,0,6,0" />
                                <TextBlock Text="导入配置" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ToggleWireGuardCommand}" Height="44">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
                                    <Setter Property="Content" Value="启动连接" />
                                    <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWgConnected}" Value="True">
                                            <Setter Property="Content" Value="断开连接" />
                                            <Setter Property="Background" Value="#E53935" />
                                            <Setter Property="BorderBrush" Value="#E53935" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DockPanel>

                    <materialDesign:Card Grid.Row="0"
                                         Grid.RowSpan="4"
                                         Background="{DynamicResource MaterialDesignPaper}"
                                         Visibility="{Binding IsWgSettingsOpen, Converter={StaticResource BoolToVis}}"
                                         materialDesign:ElevationAssist.Elevation="Dp8">
                        <Grid Margin="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding ToggleWgSettingsCommand}">
                                    <materialDesign:PackIcon Kind="ArrowLeft" />
                                </Button>
                                <TextBlock Text="VPN 高级设置" Style="{StaticResource TextHeadline}" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="1">
                                <TextBox materialDesign:HintAssist.Hint="服务器 Endpoint (IP:Port)"
                                         Text="{Binding WgEndpoint}"
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                         Margin="{StaticResource ThicknessFieldRow}" />
                                <TextBox materialDesign:HintAssist.Hint="本地 Address (例如 10.0.0.2/32)"
                                         Text="{Binding WgAddress}"
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                         Margin="{StaticResource ThicknessFieldRow}" />
                                <TextBox materialDesign:HintAssist.Hint="服务器 Public Key"
                                         Text="{Binding WgServerPublicKey}"
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                         Margin="{StaticResource ThicknessFieldRow}" />

                                <TextBlock Text="点击生成后会自动回填主配置框，PrivateKey 仍需手动补充。"
                                           Style="{StaticResource TextCaption}"
                                           Foreground="#F59E0B"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Button Grid.Row="2"
                                    Content="生成并应用配置"
                                    Command="{Binding GenerateConfigCommand}"
                                    Style="{StaticResource PrimaryActionButton}"
                                    Height="38" />
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </Grid>

            <Grid Margin="16">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="System">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,8"
                        CornerRadius="{StaticResource CornerRadiusCard}"
                        Padding="12,8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#F43F5E" Offset="0" />
                                    <GradientStop Color="#F59E0B" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <materialDesign:PackIcon Kind="Tools" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="系统优化" Style="{StaticResource TextHeadline}" />
                            <TextBlock Text="执行白名单维护与优化任务" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <materialDesign:Card Padding="14,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="锁定 Windows 10 版本 (22H2)" Style="{StaticResource TextSubtitle}" FontWeight="Bold" />
                                    <TextBlock Text="防止系统自动升级到 Windows 11 或更高版本，适用于希望继续停留在 Win10 22H2 的用户。"
                                               Style="{StaticResource TextCaption}"
                                               FontSize="12"
                                               Opacity="0.6"
                                               TextWrapping="Wrap"
                                               Margin="0,3,18,0" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Width="86"
                                        Height="32"
                                        Content="执行锁定"
                                        Command="{Binding LockWin10Command}"
                                        Style="{StaticResource PrimaryActionButton}" />
                            </Grid>
                        </materialDesign:Card>

                        <materialDesign:Card Padding="14,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Windows Defender 实时防护"
                                                   Style="{StaticResource TextSubtitle}"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center" />
                                        <Border Margin="8,0,0,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource BadgeSuccess}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDefenderEnabled}" Value="False">
                                                            <Setter Property="Background" Value="{DynamicResource BrushError}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Foreground="White" FontWeight="Bold" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="防护中" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDefenderEnabled}" Value="False">
                                                                <Setter Property="Text" Value="已关闭" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="关闭或恢复 Windows 安全中心的实时防护。Win11 需先在安全中心手动关闭「篡改保护」，否则命令将被拒绝。"
                                               Style="{StaticResource TextCaption}"
                                               FontSize="12"
                                               Opacity="0.6"
                                               TextWrapping="Wrap"
                                               Margin="0,0,18,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Width="86" Height="32" Margin="0,0,6,0" Command="{Binding ToggleDefenderCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource GhostActionButton}">
                                                <Setter Property="Content" Value="关闭防护" />
                                                <Setter Property="Foreground" Value="#C62828" />
                                                <Setter Property="BorderBrush" Value="#C62828" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDefenderEnabled}" Value="False">
                                                        <Setter Property="Content" Value="恢复防护" />
                                                        <Setter Property="Foreground" Value="#2E7D32" />
                                                        <Setter Property="BorderBrush" Value="#2E7D32" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Width="32"
                                            Height="32"
                                            Command="{Binding RefreshSystemStatusCommand}"
                                            ToolTip="刷新状态">
                                        <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>

                        <materialDesign:Card Padding="14,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Windows 自动更新"
                                                   Style="{StaticResource TextSubtitle}"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center" />
                                        <Border Margin="8,0,0,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource BadgeInfo}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAutoUpdateEnabled}" Value="False">
                                                            <Setter Property="Background" Value="{DynamicResource BrushWarning}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Foreground="White" FontWeight="Bold" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="自动更新中" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAutoUpdateEnabled}" Value="False">
                                                                <Setter Property="Text" Value="已停止" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="停止 Windows 后台自动更新，或手动触发立即检查并安装所有可用更新（以前台最高优先级下载安装，速度最快）。"
                                               Style="{StaticResource TextCaption}"
                                               FontSize="12"
                                               Opacity="0.6"
                                               TextWrapping="Wrap"
                                               Margin="0,0,18,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,0">
                                    <Button Width="86" Height="32" Margin="0,0,0,6" Command="{Binding ToggleAutoUpdateCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource GhostActionButton}">
                                                <Setter Property="Content" Value="停止更新" />
                                                <Setter Property="Foreground" Value="#C62828" />
                                                <Setter Property="BorderBrush" Value="#C62828" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAutoUpdateEnabled}" Value="False">
                                                        <Setter Property="Content" Value="恢复更新" />
                                                        <Setter Property="Foreground" Value="#1565C0" />
                                                        <Setter Property="BorderBrush" Value="#1565C0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Width="86"
                                            Height="32"
                                            Content="立即更新"
                                            Command="{Binding TriggerUpdateNowCommand}"
                                            Style="{StaticResource PrimaryActionButton}" />
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>

                        <TextBlock Text="{Binding SystemStatusMessage}"
                                   Style="{StaticResource TextCaption}"
                                   Opacity="0.7"
                                   TextWrapping="Wrap"
                                   Margin="4,0,0,8" />

                        <materialDesign:Card Padding="14,10" Margin="0,0,0,8" Background="{DynamicResource PrimaryHueLightBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="温馨提示" Style="{StaticResource TextSubtitle}" Foreground="White" FontWeight="Bold" Margin="0,0,14,0" />
                                <TextBlock Text="部分优化操作需要管理员权限，执行过程中请留意系统弹出的 UAC 授权窗口。"
                                           Grid.Column="1"
                                           Style="{StaticResource TextCaption}"
                                           FontSize="12"
                                           Foreground="White"
                                           Opacity="0.9"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </materialDesign:Card>

                        <materialDesign:Card Padding="14,10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="自动优化与报告"
                                           Style="{StaticResource TextSubtitle}"
                                           FontWeight="Bold" />
                                <TextBlock Text="按白名单步骤自动执行系统优化，完成后自动生成可追溯报告。"
                                           Style="{StaticResource TextCaption}"
                                           FontSize="12"
                                           Opacity="0.65"
                                           Margin="0,3,0,8"
                                           TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="开始自动优化"
                                            Height="32"
                                            Style="{StaticResource PrimaryActionButton}"
                                            Command="{Binding StartAutoOptimizeCommand}" />
                                    <ProgressBar Width="22" Height="22"
                                                 Margin="10,0,0,0"
                                                 IsIndeterminate="True"
                                                 Visibility="{Binding IsAutoOptimizeBusy, Converter={StaticResource BoolToVis}}"
                                                 Style="{StaticResource MaterialDesignCircularProgressBar}" />
                                </StackPanel>
                                <TextBlock Text="{Binding AutoOptimizeStatusMessage}"
                                           Style="{StaticResource TextCaption}"
                                           Margin="0,6,0,6"
                                           TextWrapping="Wrap" />

                                <DataGrid ItemsSource="{Binding OptimizationReports}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          SelectionMode="Single"
                                          MinHeight="120"
                                          MaxHeight="220"
                                          VerticalScrollBarVisibility="Auto"
                                          GridLinesVisibility="Horizontal"
                                          HeadersVisibility="Column"
                                          Margin="0,0,0,6">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="选择" Width="58">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="时间"
                                                            Width="165"
                                                            Binding="{Binding StartedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" />
                                        <DataGridTextColumn Header="类型" Width="92" Binding="{Binding ReportTypeDisplay}" />
                                        <DataGridTextColumn Header="释放空间" Width="120" Binding="{Binding TotalBytesFreedDisplay}" />
                                        <DataGridTextColumn Header="摘要" Width="*" Binding="{Binding Summary}" />
                                        <DataGridTemplateColumn Header="详情" Width="78">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="查看"
                                                            Padding="8,2"
                                                            Command="{Binding DataContext.ShowReportDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Button Content="删除选中"
                                        Width="96"
                                        Height="32"
                                        HorizontalAlignment="Right"
                                        Command="{Binding DeleteSelectedReportsCommand}" />
                            </StackPanel>
                        </materialDesign:Card>

                        <materialDesign:Card Padding="14,10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="垃圾清理"
                                           Style="{StaticResource TextSubtitle}"
                                           FontWeight="Bold" />
                                <TextBlock Text="扫描并清理白名单目录中的临时垃圾文件，执行前会进行二次确认。"
                                           Style="{StaticResource TextCaption}"
                                           FontSize="12"
                                           Opacity="0.65"
                                           Margin="0,3,0,8"
                                           TextWrapping="Wrap" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="开始扫描"
                                            Height="32"
                                            Style="{StaticResource PrimaryActionButton}"
                                            Command="{Binding StartJunkScanCommand}" />
                                    <Button Content="立即清理"
                                            Height="32"
                                            Margin="8,0,0,0"
                                            Command="{Binding RunJunkCleanupCommand}" />
                                    <Button Content="导出报告"
                                            Height="32"
                                            Margin="8,0,0,0"
                                            Command="{Binding ExportJunkCleanupPlanCommand}" />
                                    <ProgressBar Width="22" Height="22"
                                                 Margin="10,0,0,0"
                                                 IsIndeterminate="True"
                                                 Visibility="{Binding IsJunkBusy, Converter={StaticResource BoolToVis}}"
                                                 Style="{StaticResource MaterialDesignCircularProgressBar}" />
                                </StackPanel>

                                <TextBlock Text="{Binding JunkStatusMessage}"
                                           Style="{StaticResource TextCaption}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,6" />

                                <DataGrid ItemsSource="{Binding JunkCandidates}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          MinHeight="110"
                                          MaxHeight="210"
                                          VerticalScrollBarVisibility="Auto"
                                          GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="选择" Width="58">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="类别" Width="100" Binding="{Binding CategoryDisplay}" />
                                        <DataGridTextColumn Header="大小" Width="90" Binding="{Binding BytesDisplay}" />
                                        <DataGridTextColumn Header="风险" Width="70" Binding="{Binding RiskDisplay}" />
                                        <DataGridTextColumn Header="建议" Width="160" Binding="{Binding AdviceDisplay}" />
                                        <DataGridTextColumn Header="路径" Width="*" Binding="{Binding Path}" />
                                        <DataGridTextColumn Header="说明" Width="190" Binding="{Binding Reason}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </materialDesign:Card>

                        <materialDesign:Card Padding="14,10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="微信清理"
                                           Style="{StaticResource TextSubtitle}"
                                           FontWeight="Bold" />
                                <TextBlock Text="微信运行中清理可能导致部分图片/视频缩略图丢失，建议先关闭微信后再清理。"
                                           Foreground="#C62828"
                                           Style="{StaticResource TextCaption}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,8" />

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <DatePicker Grid.Column="0" SelectedDate="{Binding WeChatCleanupStartDate}" />
                                    <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Text="~" />
                                    <DatePicker Grid.Column="2" SelectedDate="{Binding WeChatCleanupEndDate}" />
                                    <ComboBox Grid.Column="3" Margin="12,0,0,0"
                                              ItemsSource="{Binding WeChatRoots}"
                                              SelectedItem="{Binding SelectedWeChatRoot}"
                                              DisplayMemberPath="WxIdOrUserName" />
                                </Grid>

                                <WrapPanel Margin="0,0,0,6">
                                    <CheckBox Content="文字" IsChecked="{Binding WeChatCleanupIncludeText}" Margin="0,0,10,4" />
                                    <CheckBox Content="图像" IsChecked="{Binding WeChatCleanupIncludeImage}" Margin="0,0,10,4" />
                                    <CheckBox Content="视频" IsChecked="{Binding WeChatCleanupIncludeVideo}" Margin="0,0,10,4" />
                                    <CheckBox Content="语音" IsChecked="{Binding WeChatCleanupIncludeVoice}" Margin="0,0,10,4" />
                                    <CheckBox Content="其它文件" IsChecked="{Binding WeChatCleanupIncludeFile}" Margin="0,0,10,4" />
                                    <CheckBox Content="缓存" IsChecked="{Binding WeChatCleanupIncludeCache}" Margin="0,0,10,4" />
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="扫描" Height="32" Command="{Binding ScanWeChatCleanupCommand}" Style="{StaticResource PrimaryActionButton}" />
                                    <Button Content="开始清理" Height="32" Margin="8,0,0,0" Command="{Binding StartWeChatCleanupCommand}" />
                                    <ProgressBar Width="22" Height="22"
                                                 Margin="10,0,0,0"
                                                 IsIndeterminate="True"
                                                 Visibility="{Binding IsWeChatCleanupBusy, Converter={StaticResource BoolToVis}}"
                                                 Style="{StaticResource MaterialDesignCircularProgressBar}" />
                                </StackPanel>

                                <TextBlock Text="{Binding WeChatCleanupStatusMessage}"
                                           Style="{StaticResource TextCaption}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,6" />

                                <DataGrid ItemsSource="{Binding WeChatCleanupCandidates}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          MinHeight="120"
                                          MaxHeight="220"
                                          VerticalScrollBarVisibility="Auto"
                                          GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="选择" Width="58">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="类别" Width="82" Binding="{Binding CategoryDisplay}" />
                                        <DataGridTextColumn Header="时间" Width="160" Binding="{Binding LastWriteTime, StringFormat=yyyy-MM-dd HH:mm:ss}" />
                                        <DataGridTextColumn Header="大小" Width="90" Binding="{Binding BytesDisplay}" />
                                        <DataGridTextColumn Header="风险" Width="70" Binding="{Binding RiskDisplay}" />
                                        <DataGridTextColumn Header="建议" Width="150" Binding="{Binding AdviceDisplay}" />
                                        <DataGridTextColumn Header="路径" Width="*" Binding="{Binding Path}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </materialDesign:Card>

                        <materialDesign:Card Padding="14,10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="微信备份"
                                           Style="{StaticResource TextSubtitle}"
                                           FontWeight="Bold" />
                                <TextBlock Text="按日期和类别备份为单个 ZIP，包含 manifest.json 与 SHA256 校验信息。"
                                           Style="{StaticResource TextCaption}"
                                           FontSize="12"
                                           Opacity="0.65"
                                           Margin="0,3,0,8"
                                           TextWrapping="Wrap" />

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <DatePicker Grid.Column="0" SelectedDate="{Binding WeChatBackupStartDate}" />
                                    <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Text="~" />
                                    <DatePicker Grid.Column="2" SelectedDate="{Binding WeChatBackupEndDate}" />
                                    <ComboBox Grid.Column="3" Margin="12,0,0,0"
                                              ItemsSource="{Binding WeChatRoots}"
                                              SelectedItem="{Binding SelectedWeChatRoot}"
                                              DisplayMemberPath="WxIdOrUserName" />
                                </Grid>

                                <WrapPanel Margin="0,0,0,6">
                                    <CheckBox Content="文字" IsChecked="{Binding WeChatBackupIncludeText}" Margin="0,0,10,4" />
                                    <CheckBox Content="图像" IsChecked="{Binding WeChatBackupIncludeImage}" Margin="0,0,10,4" />
                                    <CheckBox Content="视频" IsChecked="{Binding WeChatBackupIncludeVideo}" Margin="0,0,10,4" />
                                    <CheckBox Content="语音" IsChecked="{Binding WeChatBackupIncludeVoice}" Margin="0,0,10,4" />
                                    <CheckBox Content="其它文件" IsChecked="{Binding WeChatBackupIncludeFile}" Margin="0,0,10,4" />
                                    <CheckBox Content="缓存" IsChecked="{Binding WeChatBackupIncludeCache}" Margin="0,0,10,4" />
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="选择保存目录"
                                            Height="32"
                                            Command="{Binding SelectWeChatBackupOutputFolderCommand}"
                                            Style="{StaticResource GhostActionButton}" />
                                    <Button Content="开始备份"
                                            Height="32"
                                            Margin="8,0,0,0"
                                            Command="{Binding StartWeChatBackupCommand}"
                                            Style="{StaticResource PrimaryActionButton}" />
                                    <ProgressBar Width="22" Height="22"
                                                 Margin="10,0,0,0"
                                                 IsIndeterminate="True"
                                                 Visibility="{Binding IsWeChatBackupBusy, Converter={StaticResource BoolToVis}}"
                                                 Style="{StaticResource MaterialDesignCircularProgressBar}" />
                                </StackPanel>

                                <TextBlock Text="{Binding WeChatBackupOutputFolder}"
                                           Style="{StaticResource TextCaption}"
                                           Opacity="0.75"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding WeChatBackupStatusMessage}"
                                           Style="{StaticResource TextCaption}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </materialDesign:Card>

                        <materialDesign:Card Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="微信恢复"
                                           Style="{StaticResource TextSubtitle}"
                                           FontWeight="Bold" />
                                <TextBlock Text="从备份 ZIP 读取 manifest 后恢复到原路径或自定义目录；同名文件自动改名防覆盖。"
                                           Style="{StaticResource TextCaption}"
                                           FontSize="12"
                                           Opacity="0.65"
                                           Margin="0,3,0,8"
                                           TextWrapping="Wrap" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="选择备份文件"
                                            Height="32"
                                            Command="{Binding SelectWeChatRestoreZipCommand}"
                                            Style="{StaticResource GhostActionButton}" />
                                    <Button Content="选择恢复目录"
                                            Height="32"
                                            Margin="8,0,0,0"
                                            Command="{Binding SelectWeChatRestoreTargetRootCommand}"
                                            IsEnabled="{Binding RestoreToCustom}"
                                            Style="{StaticResource GhostActionButton}" />
                                    <Button Content="开始恢复"
                                            Height="32"
                                            Margin="8,0,0,0"
                                            Command="{Binding StartWeChatRestoreCommand}"
                                            Style="{StaticResource PrimaryActionButton}" />
                                    <ProgressBar Width="22" Height="22"
                                                 Margin="10,0,0,0"
                                                 IsIndeterminate="True"
                                                 Visibility="{Binding IsWeChatRestoreBusy, Converter={StaticResource BoolToVis}}"
                                                 Style="{StaticResource MaterialDesignCircularProgressBar}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <RadioButton Content="恢复到原微信目录"
                                                  IsChecked="{Binding RestoreToOriginal, Mode=TwoWay}"
                                                  GroupName="RestoreMode"
                                                  Margin="0,0,16,0" />
                                    <RadioButton Content="恢复到自定义目录"
                                                 IsChecked="{Binding RestoreToCustom, Mode=TwoWay}"
                                                 GroupName="RestoreMode" />
                                </StackPanel>

                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="恢复类别" Style="{StaticResource TextHint}" Margin="0,0,0,4" />
                                    <WrapPanel>
                                        <CheckBox Content="文字" IsChecked="{Binding WeChatRestoreIncludeText}" Margin="0,0,10,4" />
                                        <CheckBox Content="图像" IsChecked="{Binding WeChatRestoreIncludeImage}" Margin="0,0,10,4" />
                                        <CheckBox Content="视频" IsChecked="{Binding WeChatRestoreIncludeVideo}" Margin="0,0,10,4" />
                                        <CheckBox Content="语音" IsChecked="{Binding WeChatRestoreIncludeVoice}" Margin="0,0,10,4" />
                                        <CheckBox Content="其它文件" IsChecked="{Binding WeChatRestoreIncludeFile}" Margin="0,0,10,4" />
                                        <CheckBox Content="缓存" IsChecked="{Binding WeChatRestoreIncludeCache}" Margin="0,0,10,4" />
                                    </WrapPanel>
                                </StackPanel>

                                <TextBlock Text="{Binding WeChatRestoreZipPath}"
                                           Style="{StaticResource TextCaption}"
                                           Opacity="0.75"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding WeChatRestoreTargetRoot}"
                                           Style="{StaticResource TextCaption}"
                                           Opacity="0.75"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding WeChatRestoreManifestSummary}"
                                           Style="{StaticResource TextCaption}"
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding WeChatRestoreStatusMessage}"
                                           Style="{StaticResource TextCaption}"
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap" />

                                <Border BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,8"
                                        Margin="0,8,0,0"
                                        Visibility="{Binding HasRecentWeChatBackups, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="最近备份" Style="{StaticResource TextSubtitle}" FontSize="13" Margin="0,0,0,6" />
                                        <ItemsControl ItemsSource="{Binding RecentWeChatBackups}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.OpenRecentWeChatBackupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource HomeShortcutButtonStyle}"
                                                            Margin="0,0,0,5">
                                                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6" Background="#FAFBFC">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding DirectoryPath}" Style="{StaticResource TextHint}" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Margin="8,0,0,0" HorizontalAlignment="Right">
                                                                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource TextHint}" HorizontalAlignment="Right" />
                                                                    <TextBlock Text="{Binding TimeText}" Style="{StaticResource TextHint}" FontSize="10" HorizontalAlignment="Right" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid Margin="20">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="SqlExport">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,10"
                        CornerRadius="{StaticResource CornerRadiusCard}"
                        Padding="12,8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <Border DockPanel.Dock="Right"
                                Margin="16,0,0,0"
                                Padding="8,3"
                                CornerRadius="12"
                                Background="#1F1976D2"
                                VerticalAlignment="Center">
                            <TextBlock Text="SQL Server / PostgreSQL / MySQL" Foreground="#1976D2" FontWeight="SemiBold" />
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource BrushBlueGradient}" Margin="0,0,10,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="DatabaseArrowDown" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SQL 导出工具" Style="{StaticResource TextHeadline}" />
                                <TextBlock Text="批量导出数据库表到 .xlsx" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <materialDesign:Card Padding="12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.7*" />
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="1.25*" />
                                <ColumnDefinition Width="1.25*" />
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Row="0"
                                      Grid.Column="0"
                                      Margin="0,0,8,6"
                                      ItemsSource="{Binding SqlProviderOptions}"
                                      SelectedValuePath="Kind"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValue="{Binding SelectedSqlProvider, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                      materialDesign:HintAssist.Hint="数据库类型" />

                            <ComboBox Grid.Row="0"
                                      Grid.Column="1"
                                      Margin="0,0,8,6"
                                      IsEditable="True"
                                      IsReadOnly="False"
                                      IsTextSearchEnabled="False"
                                      StaysOpenOnEdit="True"
                                      ItemsSource="{Binding SqlServerAddressHistory}"
                                      Text="{Binding SqlServerAddress, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                      materialDesign:HintAssist.Hint="服务器地址或 IP" />

                            <TextBox Grid.Row="0"
                                     Grid.Column="2"
                                     Margin="0,0,8,6"
                                     Text="{Binding SqlPort, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     materialDesign:HintAssist.Hint="{Binding SqlPortHint}" />

                            <ComboBox Grid.Row="0"
                                      Grid.Column="3"
                                      Margin="0,0,8,6"
                                      IsEditable="True"
                                      IsTextSearchEnabled="False"
                                      ItemsSource="{Binding SqlUsernameHistory}"
                                      Text="{Binding SqlUsername, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                      materialDesign:HintAssist.Hint="用户名" />

                            <Grid Grid.Row="0"
                                  Grid.Column="4"
                                  Margin="0,0,0,6">
                                <PasswordBox x:Name="SqlPasswordBox"
                                             Padding="0,0,38,0"
                                             Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                                             materialDesign:HintAssist.Hint="密码"
                                             PasswordChanged="SqlPasswordBox_OnPasswordChanged" />
                                <Button x:Name="SqlPasswordHistoryButton"
                                        Width="32"
                                        Height="32"
                                        Margin="0,18,0,0"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Click="SqlPasswordHistoryButton_OnClick"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="选择历史密码">
                                    <materialDesign:PackIcon Width="20" Height="20" Kind="ChevronDown" />
                                    <Button.ContextMenu>
                                        <ContextMenu ItemsSource="{Binding PlacementTarget.DataContext.SqlPasswordHistory, RelativeSource={RelativeSource Self}}"
                                                     materialDesign:MenuAssist.TopLevelMenuItemHeight="36">
                                            <ContextMenu.ItemContainerStyle>
                                                <Style TargetType="MenuItem">
                                                    <Setter Property="Header" Value="••••••••" />
                                                    <Setter Property="ToolTip" Value="使用此历史密码" />
                                                    <EventSetter Event="Click" Handler="SqlPasswordHistoryMenuItem_OnClick" />
                                                </Style>
                                            </ContextMenu.ItemContainerStyle>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </Grid>

                            <ComboBox Grid.Row="1"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="2"
                                      Margin="0,0,8,6"
                                      ItemsSource="{Binding SqlDatabaseList}"
                                      SelectedItem="{Binding SelectedSqlDatabase}"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource MaterialDesignFilledComboBox}"
                                      materialDesign:HintAssist.Hint="数据库" />

                            <ComboBox Grid.Row="1"
                                      Grid.Column="2"
                                      Grid.ColumnSpan="2"
                                      Margin="0,0,8,6"
                                      IsEditable="True"
                                      IsTextSearchEnabled="False"
                                      StaysOpenOnEdit="True"
                                      ItemsSource="{Binding FilteredSqlTableView}"
                                      SelectedItem="{Binding SelectedSqlTable, UpdateSourceTrigger=PropertyChanged}"
                                      Text="{Binding SqlTableSearchText, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="DisplayName"
                                      Style="{StaticResource MaterialDesignFilledComboBox}"
                                      materialDesign:HintAssist.Hint="数据表" />

                            <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal">
                                <Button Width="88"
                                        Height="34"
                                        Margin="0,0,8,0"
                                        Command="{Binding TestSqlConnectionCommand}"
                                        Style="{StaticResource PrimaryActionButton}"
                                        Content="测试连接" />

                                <Button Width="104"
                                        Height="34"
                                        Margin="0,0,8,0"
                                        Command="{Binding ExportSqlTableCommand}"
                                        Style="{StaticResource SuccessActionButton}"
                                        Content="导出为 Excel" />

                                <Button Width="72"
                                        Height="34"
                                        Command="{Binding CancelSqlExportCommand}"
                                        Style="{StaticResource GhostActionButton}"
                                        Content="取消" />
                            </StackPanel>

                            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource BadgeInfo}" Padding="8,2">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="InformationOutline" Width="12" Height="12" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding SqlStatusMessage}" TextWrapping="Wrap" FontSize="12" />
                                    </StackPanel>
                                </Border>

                                <ProgressBar Grid.Column="1"
                                             Width="140"
                                             Height="5"
                                             Margin="12,0,0,0"
                                             VerticalAlignment="Center"
                                             IsIndeterminate="True"
                                             Visibility="{Binding IsSqlBusy, Converter={StaticResource BoolToVis}}" />
                            </Grid>

                            <Border Grid.Row="3"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="5"
                                    Margin="0,8,0,0"
                                    Visibility="{Binding HasSqlRecentConnections, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <materialDesign:PackIcon Kind="History" Width="14" Height="14"
                                                                 Foreground="{DynamicResource BrushAccentBlue}"
                                                                 Margin="0,0,6,0"
                                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="最近连接" Style="{StaticResource TextCaption}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding SqlRecentConnections}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource GhostActionButton}"
                                                        Margin="0,0,8,6"
                                                        Padding="10,4"
                                                        Command="{Binding DataContext.ApplySqlRecentConnectionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="套用此连接">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="DatabaseCheckOutline" Width="14" Height="14" Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding ServerDisplay}" FontWeight="SemiBold" />
                                                        <TextBlock Text=" · " Opacity="0.55" />
                                                        <TextBlock Text="{Binding UsernameDisplay}" Opacity="0.75" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </materialDesign:Card>

                    <TabControl Grid.Row="1"
                                Style="{StaticResource MaterialDesignTabControl}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                MinHeight="260"
                                materialDesign:ColorZoneAssist.Mode="PrimaryMid">

                        <TabItem Header="使用说明">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <materialDesign:Card Padding="14" Margin="0,6,0,0">
                                    <StackPanel>
                                        <TextBlock Text="使用说明" Style="{StaticResource TextSubtitle}" FontWeight="Bold" />
                                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                                            支持 SQL Server / PostgreSQL / MySQL 账号密码连接。流程：测试连接 → 选择数据库 → 选择表 → 导出整表。
                                        </TextBlock>
                                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap">
                                            SQL 查询标签页支持执行任意查询语句，结果可直接导出 Excel。
                                        </TextBlock>
                                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap">
                                            目标表超过 Excel 单工作表上限 1,048,576 行时，程序会阻止导出并给出提示。
                                        </TextBlock>
                                    </StackPanel>
                                </materialDesign:Card>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="SQL 查询">
                            <Grid Margin="0,6,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <materialDesign:Card Grid.Row="0" Padding="8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="72" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox Grid.Row="0"
                                                 Text="{Binding SqlQueryText, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="NoWrap"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 VerticalScrollBarVisibility="Auto"
                                                 FontFamily="Consolas"
                                                 FontSize="12"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 materialDesign:HintAssist.Hint="输入 SQL 语句，例如：SELECT * FROM schema.table LIMIT 100" />

                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                                            <Button Width="100" Height="32"
                                                    Margin="0,0,8,0"
                                                    Content="执行查询"
                                                    Command="{Binding ExecuteSqlQueryCommand}"
                                                    Style="{StaticResource PrimaryActionButton}">
                                                <Button.ContentTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="Play" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </Button.ContentTemplate>
                                            </Button>
                                            <Button Width="116" Height="32"
                                                    Margin="0,0,8,0"
                                                    Content="导出 Excel"
                                                    Command="{Binding ExportQueryResultCommand}"
                                                    Style="{StaticResource GhostActionButton}">
                                                <Button.ContentTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="FileExcel" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </Button.ContentTemplate>
                                            </Button>
                                            <Button Width="108" Height="32"
                                                    Margin="0,0,8,0"
                                                    Content="导出 CSV"
                                                    Command="{Binding ExportQueryResultCsvCommand}"
                                                    Style="{StaticResource GhostActionButton}">
                                                <Button.ContentTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="FileDelimitedOutline" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </Button.ContentTemplate>
                                            </Button>
                                            <Button Width="108" Height="32"
                                                    Margin="0,0,12,0"
                                                    Content="复制结果"
                                                    Click="CopySqlQueryResultButton_OnClick"
                                                    Style="{StaticResource GhostActionButton}">
                                                <Button.ContentTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="ContentCopy" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </Button.ContentTemplate>
                                            </Button>
                                            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                         IsIndeterminate="True"
                                                         Width="18" Height="18"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,10,0"
                                                         Visibility="{Binding IsQueryBusy, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding QueryStatusMessage}"
                                                       Style="{StaticResource TextCaption}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Opacity="0.7" />
                                        </StackPanel>
                                    </Grid>
                                </materialDesign:Card>

                                <DataGrid Grid.Row="1"
                                          x:Name="SqlQueryResultGrid"
                                          ItemsSource="{Binding SqlQueryResult}"
                                          AutoGenerateColumns="True"
                                          IsReadOnly="True"
                                          ClipboardCopyMode="IncludeHeader"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserSortColumns="True"
                                          MinHeight="180"
                                          VerticalScrollBarVisibility="Visible"
                                          HorizontalScrollBarVisibility="Auto"
                                          SelectionMode="Extended"
                                          Style="{StaticResource MaterialDesignDataGrid}"
                                          materialDesign:DataGridAssist.CellPadding="8 4 8 4"
                                          materialDesign:DataGridAssist.ColumnHeaderPadding="8 4 8 4" />
                            </Grid>
                        </TabItem>

                    </TabControl>
                </Grid>
            </Grid>

            <!-- Screenshot Settings panel -->
            <Grid Margin="20">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="Screenshot">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,20"
                        CornerRadius="{StaticResource CornerRadiusCard}"
                        Padding="20,16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,0"
                                        Visibility="{Binding HasAudioRecordingIndicator, Converter={StaticResource BoolToVis}}">
                                <Ellipse Width="8" Height="8" Fill="#E53935" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding AudioRecordingIndicator}" Foreground="#C62828" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Style="{StaticResource PrimaryActionButton}"
                                    Command="{Binding TakeScreenshotNowCommand}"
                                    Margin="0,0,8,0"
                                    ToolTip="立即截图">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Camera" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="立即截图"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostActionButton}"
                                    Command="{Binding StartVideoRecordingCommand}"
                                    Margin="0,0,8,0"
                                    ToolTip="开启区域录像">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="RecordRec" Width="16" Height="16" Margin="0,0,6,0" Foreground="#E53935" />
                                    <TextBlock Text="开启录像"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostActionButton}"
                                    Command="{Binding ToggleAudioRecordingCommand}"
                                    Margin="0,0,8,0"
                                    ToolTip="开启或停止录音">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="Microphone" />
                                                <Setter Property="Foreground" Value="#E53935" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAudioRecording}" Value="True">
                                                        <Setter Property="Kind" Value="StopCircle" />
                                                        <Setter Property="Foreground" Value="#757575" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                    <TextBlock VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="开启录音" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAudioRecording}" Value="True">
                                                        <Setter Property="Text" Value="停止录音" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostActionButton}"
                                    Command="{Binding EditClipboardImageCommand}"
                                    ToolTip="打开编辑器编辑剪贴板中的图片">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ImageEdit" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="编辑剪贴板截图"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="7" Background="{StaticResource BrushAccentGradient}" Margin="0,0,9,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="CameraIris" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="截图工具" Style="{StaticResource TextHeadline}" />
                                <TextBlock Text="全屏截图 · 区域录像 · 独立录音" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Hotkey card -->
                        <materialDesign:Card Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="快捷键设置" Style="{StaticResource TextSubtitle}" FontWeight="Bold" Margin="0,0,0,8"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" BorderBrush="{DynamicResource MaterialDesignDivider}"
                                            BorderThickness="1" CornerRadius="4" Padding="10,6"
                                            Margin="0,0,8,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource MaterialDesignTextFieldBoxBackground}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCapturingHotkey}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Keyboard" Width="18" Height="18"
                                                                     VerticalAlignment="Center" Margin="0,0,10,0"
                                                                     Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                            <TextBlock VerticalAlignment="Center" FontSize="14">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding ScreenshotHotkeyText}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
                                                        <Setter Property="FontWeight" Value="Medium"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCapturingHotkey}" Value="True">
                                                                <Setter Property="Text" Value="请按下新快捷键组合..."/>
                                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                                <Setter Property="FontWeight" Value="Normal"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Margin="0,0,6,0"
                                                Command="{Binding StartCaptureHotkeyCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource GhostActionButton}">
                                                    <Setter Property="Content" Value="修改快捷键"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCapturingHotkey}" Value="True">
                                                            <Setter Property="Content" Value="监听中..."/>
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="取消"
                                                Command="{Binding CancelCaptureHotkeyCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource GhostActionButton}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCapturingHotkey}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="注意：快捷键需包含 Ctrl 或 Alt 之一，避免与系统快捷键冲突。快捷键在全局生效，包括窗口隐藏期间。"
                                           Style="{StaticResource TextCaption}"
                                           Opacity="0.55" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Behavior card -->
                        <materialDesign:Card Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="截图行为" Style="{StaticResource TextSubtitle}" FontWeight="Bold" Margin="0,0,0,8"/>

                                <TextBlock Text="截图范围" FontWeight="Medium" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <RadioButton GroupName="ScreenshotMode" Content="全屏" Margin="0,0,18,0"
                                                 IsChecked="{Binding IsScreenshotModeFullScreen}" />
                                    <RadioButton GroupName="ScreenshotMode" Content="划区域" Margin="0,0,18,0"
                                                 IsChecked="{Binding IsScreenshotModeRegion}" />
                                    <RadioButton GroupName="ScreenshotMode" Content="当前窗口"
                                                 IsChecked="{Binding IsScreenshotModeWindow}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource TextCaption}" Opacity="0.6" Margin="0,0,0,8" TextWrapping="Wrap"
                                           Text="全屏：直接截整个虚拟屏幕；划区域：弹出半透明蒙层让你拖动选区，Esc 取消；当前窗口：截按下快捷键时位于最前的那个窗口。" />

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="0"
                                                  IsChecked="{Binding IsGifRecordingMode}"
                                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                  VerticalAlignment="Top"
                                                  Margin="0,2,12,0" />
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="区域录像输出" Style="{StaticResource TextSubtitle}" FontWeight="Medium" Margin="0,0,8,0" />
                                            <Border Style="{StaticResource StatusPill}">
                                                <TextBlock Text="{Binding RecordingModeText}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding RecordingModeHint}"
                                                   Style="{StaticResource TextCaption}"
                                                   Opacity="0.6"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,20,0" />
                                    </StackPanel>
                                </Grid>

                                <UniformGrid Rows="1" Columns="2" Margin="0,0,0,10">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="录像帧率" Style="{StaticResource TextCaption}" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding RecordingFrameRateOptions}"
                                                  SelectedItem="{Binding RecordingFrameRateOption, Mode=TwoWay}"
                                                  Height="32" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="MP4 画质" Style="{StaticResource TextCaption}" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding RecordingQualityOptions}"
                                                  SelectedItem="{Binding RecordingQualityOption, Mode=TwoWay}"
                                                  Height="32" />
                                    </StackPanel>
                                </UniformGrid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding ShowEditorAfterCapture}"
                                              VerticalAlignment="Top"
                                              Margin="0,2,12,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="截图后打开编辑器"
                                                   Style="{StaticResource TextSubtitle}"
                                                   FontWeight="Medium"/>
                                        <TextBlock Margin="0,4,20,0" Opacity="0.6" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                                                    <Setter Property="Text" Value="截图后弹出编辑器进行标注；关闭编辑器时自动把编辑后的图写入剪贴板。"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowEditorAfterCapture}" Value="False">
                                                            <Setter Property="Text" Value="截图后直接写入剪贴板，不弹编辑器。"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Screenshot history -->
                        <materialDesign:Card Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Style="{StaticResource SectionHeaderRow}">
                                    <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource BrushTealGradient}" Margin="0,0,10,0">
                                        <materialDesign:PackIcon Kind="ImageMultiple" Width="14" Height="14" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="截图历史" Style="{StaticResource TextSubtitle}" />
                                        <TextBlock Text="{Binding ScreenshotHistorySummary}" Style="{StaticResource TextHint}" Margin="0,1,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="还没有截图历史。点击“立即截图”后会自动保存最近 20 张。"
                                           Style="{StaticResource TextHint}"
                                           Margin="0,12,0,12"
                                           HorizontalAlignment="Center"
                                           Visibility="{Binding HasScreenshotHistoryItems, Converter={StaticResource InverseBoolToVis}}" />

                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              Visibility="{Binding HasScreenshotHistoryItems, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl ItemsSource="{Binding ScreenshotHistoryItems}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="188" Margin="0,0,8,0" Padding="8"
                                                        BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7"
                                                        Background="#FAFBFC">
                                                    <StackPanel>
                                                        <Border Height="92" CornerRadius="5" Background="#E5E7EB" ClipToBounds="True">
                                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}" Style="{StaticResource TextBodyStandard}"
                                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,6,0,1" />
                                                        <TextBlock Style="{StaticResource TextHint}" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding TimeText}" /><Run Text=" · " /><Run Text="{Binding SizeText}" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding DimensionsText}" Style="{StaticResource TextHint}" TextTrimming="CharacterEllipsis" Margin="0,1,0,6" />
                                                        <WrapPanel>
                                                            <Button Style="{StaticResource GhostActionButton}"
                                                                    Height="26" MinWidth="46" Padding="6,0" Margin="0,0,5,5"
                                                                    Command="{Binding DataContext.CopyScreenshotHistoryItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <materialDesign:PackIcon Kind="ContentCopy" Width="13" Height="13" Margin="0,0,4,0" />
                                                                    <TextBlock Text="复制" />
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Style="{StaticResource GhostActionButton}"
                                                                    Height="26" MinWidth="46" Padding="6,0" Margin="0,0,5,5"
                                                                    Command="{Binding DataContext.EditScreenshotHistoryItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <materialDesign:PackIcon Kind="ImageEdit" Width="13" Height="13" Margin="0,0,4,0" />
                                                                    <TextBlock Text="编辑" />
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Style="{StaticResource GhostActionButton}"
                                                                    Height="26" MinWidth="46" Padding="6,0" Margin="0,0,5,5"
                                                                    Command="{Binding DataContext.OpenScreenshotHistoryItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <materialDesign:PackIcon Kind="OpenInNew" Width="13" Height="13" Margin="0,0,4,0" />
                                                                    <TextBlock Text="打开" />
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Style="{StaticResource GhostActionButton}"
                                                                    Height="26" MinWidth="46" Padding="6,0" Margin="0,0,5,5"
                                                                    Command="{Binding DataContext.DeleteScreenshotHistoryItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="13" Height="13" Margin="0,0,4,0" />
                                                                    <TextBlock Text="删除" />
                                                                </StackPanel>
                                                            </Button>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Recording output folders -->
                        <materialDesign:Card Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="录制输出目录" Style="{StaticResource TextSubtitle}" FontWeight="Bold" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="录像" Style="{StaticResource TextFieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding RecordingOutputFolderText}" Style="{StaticResource TextCaption}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="2" Style="{StaticResource GhostActionButton}"
                                            Command="{Binding SelectRecordingOutputFolderCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FolderCogOutline" Width="14" Height="14" Margin="0,0,6,0" />
                                            <TextBlock Text="更改" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="录音" Style="{StaticResource TextFieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding AudioOutputFolderText}" Style="{StaticResource TextCaption}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="2" Style="{StaticResource GhostActionButton}"
                                            Command="{Binding SelectAudioOutputFolderCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FolderCogOutline" Width="14" Height="14" Margin="0,0,6,0" />
                                            <TextBlock Text="更改" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Save button -->
                        <Button Style="{StaticResource PrimaryActionButton}"
                                Command="{Binding SaveScreenshotSettingsCommand}"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveOutline" Width="15" Height="15" Margin="0,0,6,0"/>
                                <TextBlock Text="保存设置"/>
                            </StackPanel>
                        </Button>

                        <!-- File Hash Calculator -->
                        <materialDesign:Card Padding="12,10" Margin="0,8,0,0">
                            <StackPanel>
                                <StackPanel Style="{StaticResource SectionHeaderRow}">
                                    <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource BrushBlueGradient}" Margin="0,0,10,0">
                                        <materialDesign:PackIcon Kind="ShieldKey" Width="14" Height="14" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="文件哈希校验" Style="{StaticResource TextSubtitle}" />
                                        <TextBlock Text="{Binding FileHashStatusMessage}" Style="{StaticResource TextHint}" Margin="0,1,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <Button Style="{StaticResource GhostActionButton}"
                                        Command="{Binding ComputeFileHashCommand}"
                                        HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileSearch" Width="14" Height="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="选择文件并计算"/>
                                    </StackPanel>
                                </Button>

                                <TextBox Text="{Binding ExpectedFileHash, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource StandardTextBox}"
                                         materialDesign:HintAssist.Hint="官方校验值（可选：MD5 / SHA-1 / SHA-256 / CRC32）"
                                         Margin="0,8,0,0" />

                                <Border Background="{DynamicResource BrushInfoSoft}"
                                        CornerRadius="6" Padding="10,7" Margin="0,8,0,0"
                                        Visibility="{Binding HasFileHashCompareResult, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="14" Height="14"
                                                                 Foreground="{DynamicResource BrushInfo}"
                                                                 Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding FileHashCompareResult}" Style="{StaticResource TextCaption}"
                                                   FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource MaterialDesignToolBarBackground}"
                                        CornerRadius="6" Padding="10,8" Margin="0,8,0,0"
                                        Visibility="{Binding FileHashResult, Converter={StaticResource StringNotEmptyToVisibility}}"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="FileHashResult_OnClick">
                                    <TextBlock Text="{Binding FileHashResult}" Style="{StaticResource TextMonoCode}"
                                               ToolTip="点击复制到剪贴板" />
                                </Border>
                            </StackPanel>
                        </materialDesign:Card>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Image viewer panel -->
            <Grid Margin="16">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="ImageViewer">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,12"
                        CornerRadius="{StaticResource CornerRadiusCard}"
                        Padding="12,8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimaryActionButton}"
                                    Command="{Binding OpenImageViewerFileCommand}"
                                    Height="34"
                                    Padding="12,0"
                                    Margin="0,0,8,0"
                                    ToolTip="打开图片">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderOpenOutline" Width="15" Height="15" Margin="0,0,6,0" />
                                    <TextBlock Text="打开" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostActionButton}"
                                    Command="{Binding CopyImageViewerImageCommand}"
                                    Height="34"
                                    Padding="12,0"
                                    Margin="0,0,8,0"
                                    ToolTip="复制当前图片到剪贴板">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentCopy" Width="15" Height="15" Margin="0,0,6,0" />
                                    <TextBlock Text="复制" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostActionButton}"
                                    Command="{Binding SaveImageViewerImageAsCommand}"
                                    Height="34"
                                    Padding="12,0"
                                    Margin="0,0,8,0"
                                    ToolTip="另存当前图片">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSaveOutline" Width="15" Height="15" Margin="0,0,6,0" />
                                    <TextBlock Text="另存" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostActionButton}"
                                    Command="{Binding EditImageViewerImageCommand}"
                                    Height="34"
                                    Padding="12,0"
                                    ToolTip="进入标注编辑器">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ImageEdit" Width="15" Height="15" Margin="0,0,6,0" />
                                    <TextBlock Text="标注" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource BrushTealGradient}" Margin="0,0,10,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Image" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="图片查看" Style="{StaticResource TextHeadline}" />
                                <TextBlock Text="{Binding ImageViewerStatusMessage}" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="175" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧文件夹树 -->
                    <materialDesign:Card Grid.Column="0" Padding="8" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="文件夹" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                       Margin="2,0,0,6" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto">
                                <TreeView ItemsSource="{Binding ImageFolderRoots}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          SelectedItemChanged="ImageFolderTree_SelectedItemChanged">
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                            <Setter Property="FontSize" Value="11" />
                                            <Setter Property="Padding" Value="2,2" />
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="FolderOutline" Width="13" Height="13"
                                                                         VerticalAlignment="Center" Margin="0,0,4,0"
                                                                         Foreground="{DynamicResource BrushAccentBlue}" />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </ScrollViewer>
                        </Grid>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Column="1" Padding="12" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                                <Button Style="{StaticResource GhostActionButton}"
                                        Command="{Binding OpenPreviousImageViewerFileCommand}"
                                        Width="34"
                                        Height="32"
                                        Padding="0"
                                        Margin="0,0,6,6"
                                        ToolTip="上一张">
                                    <materialDesign:PackIcon Kind="ChevronLeft" Width="16" Height="16" />
                                </Button>
                                <Button Style="{StaticResource GhostActionButton}"
                                        Command="{Binding OpenNextImageViewerFileCommand}"
                                        Width="34"
                                        Height="32"
                                        Padding="0"
                                        Margin="0,0,10,6"
                                        ToolTip="下一张">
                                    <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16" />
                                </Button>
                                <Button Style="{StaticResource GhostActionButton}"
                                        Command="{Binding ImageViewerZoomOutCommand}"
                                        Width="34"
                                        Height="32"
                                        Padding="0"
                                        Margin="0,0,6,6"
                                        ToolTip="缩小">
                                    <materialDesign:PackIcon Kind="MagnifyMinusOutline" Width="16" Height="16" />
                                </Button>
                                <Button Style="{StaticResource GhostActionButton}"
                                        Command="{Binding ImageViewerZoomActualCommand}"
                                        Height="32"
                                        Padding="10,0"
                                        Margin="0,0,6,6"
                                        ToolTip="实际大小">
                                    <TextBlock Text="{Binding ImageViewerZoomText}" />
                                </Button>
                                <Button Style="{StaticResource GhostActionButton}"
                                        Command="{Binding ImageViewerZoomInCommand}"
                                        Width="34"
                                        Height="32"
                                        Padding="0"
                                        Margin="0,0,6,6"
                                        ToolTip="放大">
                                    <materialDesign:PackIcon Kind="MagnifyPlusOutline" Width="16" Height="16" />
                                </Button>
                                <Button Style="{StaticResource GhostActionButton}"
                                        Command="{Binding ImageViewerFitToFrameCommand}"
                                        Height="32"
                                        Padding="10,0"
                                        Margin="0,0,10,6"
                                        ToolTip="满框显示（自动缩放以铺满预览区域）">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ImageSearchOutline" Width="15" Height="15" Margin="0,0,5,0" />
                                        <TextBlock Text="满框">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ImageViewerFitToFrame}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource BrushAccentBlue}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostActionButton}"
                                        Command="{Binding RotateImageViewerRightCommand}"
                                        Width="34"
                                        Height="32"
                                        Padding="0"
                                        Margin="0,0,10,6"
                                        ToolTip="顺时针旋转 90°">
                                    <materialDesign:PackIcon Kind="RotateRight" Width="16" Height="16" />
                                </Button>
                                <Button Style="{StaticResource GhostActionButton}"
                                        Command="{Binding FlipImageViewerHorizontalCommand}"
                                        Height="32"
                                        Padding="10,0"
                                        Margin="0,0,6,6"
                                        ToolTip="水平翻转">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="SwapHorizontal" Width="15" Height="15" Margin="0,0,5,0" />
                                        <TextBlock Text="水平" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostActionButton}"
                                        Command="{Binding FlipImageViewerVerticalCommand}"
                                        Height="32"
                                        Padding="10,0"
                                        Margin="0,0,10,6"
                                        ToolTip="垂直翻转">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="SwapVertical" Width="15" Height="15" Margin="0,0,5,0" />
                                        <TextBlock Text="垂直" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostActionButton}"
                                        Command="{Binding ToggleImageViewerGrayscaleCommand}"
                                        Height="32"
                                        Padding="10,0"
                                        Margin="0,0,6,6"
                                        ToolTip="切换灰度效果">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="InvertColorsOff" Width="15" Height="15" Margin="0,0,5,0" />
                                        <TextBlock Text="灰度" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <Border Grid.Row="1"
                                    Background="#121820"
                                    CornerRadius="6"
                                    ClipToBounds="True">
                                <Grid x:Name="ImageViewerPreviewHost">
                                    <ScrollViewer x:Name="ImageViewerScrollViewer"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto">
                                        <Grid MinHeight="360" MinWidth="500">
                                            <Image Source="{Binding ImageViewerPreviewImage}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="Stretch" Value="None" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ImageViewerFitToFrame}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                                <Image.LayoutTransform>
                                                    <ScaleTransform ScaleX="{Binding ImageViewerZoom}" ScaleY="{Binding ImageViewerZoom}" />
                                                </Image.LayoutTransform>
                                            </Image>
                                            <Image Source="{Binding ImageViewerPreviewImage}"
                                                   Width="{Binding ActualWidth, ElementName=ImageViewerScrollViewer}"
                                                   Height="{Binding ActualHeight, ElementName=ImageViewerScrollViewer}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ImageViewerFitToFrame}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Grid>
                                    </ScrollViewer>
                                    <Border Background="#CC121820"
                                            CornerRadius="6"
                                            Padding="18"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding HasImageViewerImage, Converter={StaticResource InverseBoolToVis}}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="ImageSearch" Width="42" Height="42" Foreground="#E5E7EB" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                            <TextBlock Text="打开图片开始查看"
                                                       Foreground="#F9FAFB"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="支持 PNG / JPG / BMP / GIF / TIFF"
                                                       Foreground="#CBD5E1"
                                                       Margin="0,4,0,0"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Column="2" Padding="14">
                        <StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="图片信息" Style="{StaticResource TextSubtitle}" FontWeight="Bold" Margin="0,0,0,8" />
                                    <TextBlock Text="文件名" Style="{StaticResource TextFieldLabel}" />
                                    <TextBlock Text="{Binding ImageViewerFileName}" TextWrapping="Wrap" Margin="0,1,0,7" FontSize="12" />
                                    <TextBlock Text="尺寸" Style="{StaticResource TextFieldLabel}" />
                                    <TextBlock Text="{Binding ImageViewerImageInfo}" Margin="0,1,0,7" FontSize="12" />
                                    <TextBlock Text="目录" Style="{StaticResource TextFieldLabel}" />
                                    <TextBlock Text="{Binding ImageViewerDirectoryPositionText}" Margin="0,1,0,7" FontSize="12" />
                                    <TextBlock Text="缩放" Style="{StaticResource TextFieldLabel}" />
                                    <TextBlock Text="{Binding ImageViewerZoomText}" Margin="0,1,0,7" FontSize="12" />
                                    <TextBlock Text="处理" Style="{StaticResource TextFieldLabel}" />
                                    <TextBlock Text="{Binding ImageViewerTransformText}" TextWrapping="Wrap" Margin="0,1,0,7" FontSize="12" />

                                    <Border Style="{StaticResource DividerLine}" Margin="0,4,0,8" />

                                    <TextBlock Text="轻编辑" Style="{StaticResource TextSubtitle}" FontWeight="Bold" Margin="0,0,0,8" />
                                    <TextBlock Text="中心裁剪" Style="{StaticResource TextFieldLabel}" />
                                    <ComboBox ItemsSource="{Binding ImageViewerCropModes}"
                                              SelectedItem="{Binding ImageViewerCropMode, Mode=TwoWay}"
                                              Style="{StaticResource StandardComboBox}"
                                              Margin="0,0,0,8" />

                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="亮度" Style="{StaticResource TextFieldLabel}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ImageViewerBrightnessText}" Style="{StaticResource TextHint}" />
                                    </Grid>
                                    <Slider Minimum="-100" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="False"
                                            Height="28"
                                            Value="{Binding ImageViewerBrightness, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                            PreviewMouseLeftButtonUp="ImageAdjustmentSlider_OnCommit"
                                            KeyUp="ImageAdjustmentSlider_OnCommit"
                                            LostFocus="ImageAdjustmentSlider_OnCommit"
                                            Margin="0,0,0,8" />

                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="对比度" Style="{StaticResource TextFieldLabel}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ImageViewerContrastText}" Style="{StaticResource TextHint}" />
                                    </Grid>
                                    <Slider Minimum="-100" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="False"
                                            Height="28"
                                            Value="{Binding ImageViewerContrast, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                            PreviewMouseLeftButtonUp="ImageAdjustmentSlider_OnCommit"
                                            KeyUp="ImageAdjustmentSlider_OnCommit"
                                            LostFocus="ImageAdjustmentSlider_OnCommit"
                                            Margin="0,0,0,8" />

                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="锐化" Style="{StaticResource TextFieldLabel}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ImageViewerSharpenText}" Style="{StaticResource TextHint}" />
                                    </Grid>
                                    <Slider Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="False"
                                            Height="28"
                                            Value="{Binding ImageViewerSharpenAmount, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                            PreviewMouseLeftButtonUp="ImageAdjustmentSlider_OnCommit"
                                            KeyUp="ImageAdjustmentSlider_OnCommit"
                                            LostFocus="ImageAdjustmentSlider_OnCommit"
                                            Margin="0,0,0,8" />

                                    <Button Style="{StaticResource GhostActionButton}"
                                            Command="{Binding ResetImageViewerAdjustmentsCommand}"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Restore" Width="14" Height="14" Margin="0,0,6,0" />
                                            <TextBlock Text="重置轻编辑" />
                                        </StackPanel>
                                    </Button>

                                    <TextBlock Text="路径" Style="{StaticResource TextFieldLabel}" />
                                    <TextBlock Text="{Binding ImageViewerFilePath}"
                                               TextWrapping="Wrap"
                                               Opacity="0.72"
                                               FontSize="11"
                                               Margin="0,1,0,8" />

                                    <Border Background="{DynamicResource MaterialDesignToolBarBackground}"
                                            CornerRadius="6"
                                            Padding="10"
                                            Margin="0,4,0,0">
                                        <TextBlock Text="{Binding ImageViewerStatusMessage}"
                                                   Style="{StaticResource TextCaption}"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>
            </Grid>

            <!-- Video viewer panel -->
            <views:VideoViewerPage x:Name="VideoViewerPage">
                <views:VideoViewerPage.Style>
                    <Style TargetType="views:VideoViewerPage">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="VideoViewer">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:VideoViewerPage.Style>
            </views:VideoViewerPage>

            <!-- Codex config profiles panel -->
            <Grid Margin="16">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="CodexProfiles">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,8"
                        CornerRadius="{StaticResource CornerRadiusCard}"
                        Padding="12,8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimaryActionButton}"
                                    Height="32"
                                    Padding="10,0"
                                    Command="{Binding ImportCodexProfileCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Import" Width="15" Height="15" Margin="0,0,5,0" />
                                    <TextBlock Text="导入" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource BrushTealGradient}" Margin="0,0,10,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="FolderCogOutline" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Codex 配置管理" Style="{StaticResource TextHeadline}" />
                                <TextBlock Text="一键切换 Codex 配置集" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,8"
                                Margin="0,0,0,8"
                                Background="{DynamicResource MaterialDesignPaper}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="拖入包含 config.toml 和 auth.json 的文件夹"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0" />
                                <Border Grid.Column="1" Style="{StaticResource BadgeInfo}" Padding="8,2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="InformationOutline" Width="12" Height="12" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding CodexProfilesStatusMessage}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding CodexProfiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <materialDesign:Card Padding="12,8" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <materialDesign:PackIcon Kind="FolderOutline"
                                                                             Width="16"
                                                                             Height="16"
                                                                             Margin="0,0,6,0"
                                                                             Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding FolderPath}"
                                                           FontSize="12"
                                                           Opacity="0.58"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding FolderPath}" />
                                                <TextBlock Text="{Binding ContentStorageSummary}"
                                                           FontSize="12"
                                                           Margin="0,2,0,0"
                                                           Opacity="0.72"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Style="{StaticResource BadgeInfo}" Margin="0,5,0,0" Padding="8,2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="InformationOutline" Width="12" Height="12" Margin="0,0,4,0" />
                                                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        Margin="0,0,12,0"
                                                        VerticalAlignment="Center">
                                                <TextBox Height="38"
                                                         MinWidth="220"
                                                         Text="{Binding Remark, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                         materialDesign:HintAssist.Hint="备注" />
                                                <TextBox Height="38"
                                                         MinWidth="220"
                                                         Margin="0,4,0,0"
                                                         Text="{Binding Tags, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                         materialDesign:HintAssist.Hint="标签（逗号分隔）" />
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <materialDesign:PackIcon Kind="ClockCheckOutline"
                                                                             Width="13"
                                                                             Height="13"
                                                                             Margin="0,0,5,0"
                                                                             Opacity="0.55" />
                                                    <TextBlock Text="{Binding LastAppliedText}"
                                                               FontSize="12"
                                                               Opacity="0.65" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                             IsIndeterminate="True"
                                                             Width="18"
                                                             Height="18"
                                                             Margin="0,0,8,0"
                                                             Visibility="{Binding IsApplying, Converter={StaticResource BoolToVis}}" />
                                                <Button Style="{StaticResource GhostActionButton}"
                                                        Height="32"
                                                        Padding="8,0"
                                                        Margin="0,0,6,0"
                                                        ToolTip="预览当前目录与该配置的差异"
                                                        Command="{Binding DataContext.PreviewCodexProfileDiffCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="TextBoxSearchOutline" Width="14" Height="14" Margin="0,0,5,0"/>
                                                        <TextBlock Text="差异"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource GhostActionButton}"
                                                        Height="32"
                                                        Padding="8,0"
                                                        Margin="0,0,6,0"
                                                        ToolTip="查看 / 编辑 config.toml"
                                                        Command="{Binding DataContext.EditCodexConfigTomlCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="FileDocumentEditOutline" Width="14" Height="14" Margin="0,0,5,0"/>
                                                        <TextBlock Text="config.toml"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource GhostActionButton}"
                                                        Height="32"
                                                        Padding="8,0"
                                                        Margin="0,0,6,0"
                                                        ToolTip="查看 / 编辑 auth.json"
                                                        Command="{Binding DataContext.EditCodexAuthJsonCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="KeyOutline" Width="14" Height="14" Margin="0,0,5,0"/>
                                                        <TextBlock Text="auth.json"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Height="32"
                                                        Padding="10,0"
                                                        Margin="0,0,6,0"
                                                        Command="{Binding DataContext.ApplyCodexProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource PrimaryActionButton}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Check" Width="15" Height="15" Margin="0,0,5,0"/>
                                                        <TextBlock Text="应用"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource GhostActionButton}"
                                                        Height="32"
                                                        Padding="10,0"
                                                        Margin="0,0,6,0"
                                                        Command="{Binding DataContext.ExportCodexProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Export" Width="15" Height="15" Margin="0,0,5,0"/>
                                                        <TextBlock Text="导出"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Height="32"
                                                        Width="32"
                                                        Padding="0"
                                                        Command="{Binding DataContext.DeleteCodexProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignIconButton}"
                                                        ToolTip="删除记录">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="17" Height="17"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </materialDesign:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- System Info module -->
            <Grid Margin="16">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="SystemInfo">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Margin="0,0,0,12"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="{StaticResource CornerRadiusCard}"
                        Padding="12,8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostActionButton}"
                                    Content="刷新硬件"
                                    Command="{Binding LoadSystemInfoCommand}"
                                    Margin="0,0,8,0" />
                            <Button Style="{StaticResource GhostActionButton}"
                                    Content="以管理员重启"
                                    Command="{Binding RestartAsAdminCommand}"
                                    Margin="0,0,8,0">
                                <Button.Visibility>
                                    <Binding Path="IsRunningAsAdmin" Converter="{StaticResource InverseBoolToVis}" />
                                </Button.Visibility>
                            </Button>
                            <Button Style="{StaticResource PrimaryActionButton}"
                                    Content="{Binding SensorsToggleLabel}"
                                    Command="{Binding ToggleHardwareSensorsCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource BrushBlueGradient}" Margin="0,0,10,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Chip" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="系统信息" Style="{StaticResource TextHeadline}" />
                                <TextBlock Text="{Binding SystemInfoStatusMessage}" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Hardware overview cards -->
                        <Grid Visibility="{Binding HasHardwareSummary, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- OS / Computer -->
                            <materialDesign:Card Grid.Row="0" Grid.Column="0" Padding="14,12" Margin="0,0,6,12">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource SectionHeaderRow}">
                                        <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource BrushBlueGradient}" Margin="0,0,8,0">
                                            <materialDesign:PackIcon Kind="MicrosoftWindows" Width="14" Height="14" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="系统与主板" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock><Run Text="计算机名：" FontWeight="SemiBold" /><Run Text="{Binding HardwareSummaryInfo.ComputerName}" /></TextBlock>
                                        <TextBlock><Run Text="操作系统：" FontWeight="SemiBold" /><Run Text="{Binding HardwareSummaryInfo.OsName}" /></TextBlock>
                                        <TextBlock><Run Text="版本：" FontWeight="SemiBold" /><Run Text="{Binding HardwareSummaryInfo.OsVersion}" /><Run Text=" · " /><Run Text="{Binding HardwareSummaryInfo.OsArchitecture}" /></TextBlock>
                                        <TextBlock><Run Text="制造商：" FontWeight="SemiBold" /><Run Text="{Binding HardwareSummaryInfo.Manufacturer}" /></TextBlock>
                                        <TextBlock><Run Text="型号：" FontWeight="SemiBold" /><Run Text="{Binding HardwareSummaryInfo.Model}" /></TextBlock>
                                        <TextBlock><Run Text="主板：" FontWeight="SemiBold" /><Run Text="{Binding HardwareSummaryInfo.MotherboardManufacturer}" /><Run Text=" " /><Run Text="{Binding HardwareSummaryInfo.MotherboardProduct}" /></TextBlock>
                                        <TextBlock><Run Text="BIOS：" FontWeight="SemiBold" /><Run Text="{Binding HardwareSummaryInfo.BiosVersion}" /><Run Text=" · " /><Run Text="{Binding HardwareSummaryInfo.BiosDate}" /></TextBlock>
                                        <TextBlock><Run Text="运行时间：" FontWeight="SemiBold" /><Run Text="{Binding HardwareSummaryInfo.SystemUpTime}" /></TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- Memory total -->
                            <materialDesign:Card Grid.Row="0" Grid.Column="1" Padding="14,12" Margin="6,0,0,12">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource SectionHeaderRow}">
                                        <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource BrushTealGradient}" Margin="0,0,8,0">
                                            <materialDesign:PackIcon Kind="Memory" Width="14" Height="14" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="内存" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                                        <TextBlock Style="{StaticResource TextCaption}" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <Run Text="总容量：" /><Run Text="{Binding HardwareSummaryInfo.TotalMemoryGb}" FontWeight="SemiBold" />
                                        </TextBlock>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding HardwareSummaryInfo.MemoryModules}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource MaterialDesignToolBarBackground}" CornerRadius="6" Padding="8,6" Margin="0,0,0,4">
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource TextBodyStandard}">
                                                            <Run Text="{Binding BankLabel}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding CapacityGb}" /><Run Text=" · " /><Run Text="{Binding MemoryType}" /><Run Text=" · " /><Run Text="{Binding SpeedMhz}" /><Run Text=" MHz" />
                                                        </TextBlock>
                                                        <TextBlock Style="{StaticResource TextHint}">
                                                            <Run Text="{Binding Manufacturer}" /><Run Text=" · " /><Run Text="{Binding PartNumber}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- CPUs -->
                            <materialDesign:Card Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Padding="14,12" Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource SectionHeaderRow}">
                                        <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource BrushAccentGradient}" Margin="0,0,8,0">
                                            <materialDesign:PackIcon Kind="Cpu64Bit" Width="14" Height="14" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="处理器" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding HardwareSummaryInfo.Cpus}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource MaterialDesignToolBarBackground}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource TextSubtitle}" />
                                                        <TextBlock Style="{StaticResource TextCaption}">
                                                            <Run Text="厂商：" /><Run Text="{Binding Manufacturer}" />
                                                            <Run Text="  ·  插槽：" /><Run Text="{Binding Socket}" />
                                                        </TextBlock>
                                                        <TextBlock Style="{StaticResource TextCaption}">
                                                            <Run Text="物理核心：" /><Run Text="{Binding Cores}" FontWeight="SemiBold" />
                                                            <Run Text="  ·  逻辑处理器：" /><Run Text="{Binding LogicalProcessors}" FontWeight="SemiBold" />
                                                            <Run Text="  ·  最大频率：" /><Run Text="{Binding MaxClockMhz}" /><Run Text=" MHz" />
                                                            <Run Text="  ·  当前：" /><Run Text="{Binding CurrentClockMhz}" /><Run Text=" MHz" />
                                                        </TextBlock>
                                                        <TextBlock Style="{StaticResource TextHint}">
                                                            <Run Text="L2：" /><Run Text="{Binding L2CacheKb}" /><Run Text=" KB · L3：" /><Run Text="{Binding L3CacheKb}" /><Run Text=" KB" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- GPUs -->
                            <materialDesign:Card Grid.Row="2" Grid.Column="0" Padding="14,12" Margin="0,0,6,12">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource SectionHeaderRow}">
                                        <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource BrushAccentGradient}" Margin="0,0,8,0">
                                            <materialDesign:PackIcon Kind="VideoOutline" Width="14" Height="14" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="显卡" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding HardwareSummaryInfo.Gpus}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource MaterialDesignToolBarBackground}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource TextSubtitle}" />
                                                        <TextBlock Style="{StaticResource TextCaption}">
                                                            <Run Text="厂商：" /><Run Text="{Binding Manufacturer}" />
                                                            <Run Text="  ·  显存：" /><Run Text="{Binding AdapterRamGb}" FontWeight="SemiBold" />
                                                        </TextBlock>
                                                        <TextBlock Style="{StaticResource TextHint}">
                                                            <Run Text="驱动：" /><Run Text="{Binding DriverVersion}" /><Run Text=" · " /><Run Text="{Binding DriverDate}" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding VideoMode}" Style="{StaticResource TextHint}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- Disks -->
                            <materialDesign:Card Grid.Row="2" Grid.Column="1" Padding="14,12" Margin="6,0,0,12">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource SectionHeaderRow}">
                                        <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource BrushTealGradient}" Margin="0,0,8,0">
                                            <materialDesign:PackIcon Kind="Harddisk" Width="14" Height="14" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="存储" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding HardwareSummaryInfo.Disks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource MaterialDesignToolBarBackground}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Model}" Style="{StaticResource TextSubtitle}" />
                                                        <TextBlock Style="{StaticResource TextCaption}">
                                                            <Run Text="容量：" /><Run Text="{Binding SizeGb}" FontWeight="SemiBold" />
                                                            <Run Text="  ·  接口：" /><Run Text="{Binding InterfaceType}" />
                                                            <Run Text="  ·  介质：" /><Run Text="{Binding MediaType}" />
                                                        </TextBlock>
                                                        <TextBlock Style="{StaticResource TextHint}">
                                                            <Run Text="序列号：" /><Run Text="{Binding SerialNumber}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- Network adapters + Monitors -->
                            <materialDesign:Card Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Padding="14,12">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource SectionHeaderRow}">
                                        <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource BrushBlueGradient}" Margin="0,0,8,0">
                                            <materialDesign:PackIcon Kind="LanConnect" Width="14" Height="14" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="网络适配器与显示器" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding HardwareSummaryInfo.NetworkAdapters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource TextCaption}" Margin="0,0,0,2">
                                                    <Run Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <Run Text=" · MAC " /><Run Text="{Binding MacAddress}" />
                                                    <Run Text=" · " /><Run Text="{Binding LinkSpeed}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding HardwareSummaryInfo.Monitors}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource TextCaption}" Margin="0,0,0,2">
                                                    <Run Text="显示器：" FontWeight="SemiBold" />
                                                    <Run Text="{Binding Name}" />
                                                    <Run Text=" · " /><Run Text="{Binding Manufacturer}" />
                                                    <Run Text=" · " /><Run Text="{Binding Resolution}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </materialDesign:Card>
                        </Grid>

                        <!-- Sensors live readings -->
                        <materialDesign:Card Padding="14,12" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Style="{StaticResource SectionHeaderRow}">
                                    <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource BrushAccentGradient}" Margin="0,0,8,0">
                                        <materialDesign:PackIcon Kind="ThermometerLines" Width="14" Height="14" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="实时传感器" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                                    <ComboBox Width="86" Height="28"
                                              Margin="10,0,0,0"
                                              ItemsSource="{Binding SensorRefreshModes}"
                                              SelectedItem="{Binding SensorRefreshMode, Mode=TwoWay}" />
                                    <Button Style="{StaticResource GhostActionButton}"
                                            Command="{Binding RefreshSensorsOnceCommand}"
                                            Margin="6,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" Margin="0,0,5,0" />
                                            <TextBlock Text="刷新" />
                                        </StackPanel>
                                    </Button>
                                    <Border Style="{StaticResource StatusPill}" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding SensorStatusMessage}" />
                                    </Border>
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding SensorReadings}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          MinHeight="180"
                                          MaxHeight="360">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="硬件" Binding="{Binding HardwareName}" Width="*" />
                                        <DataGridTextColumn Header="类型" Binding="{Binding HardwareKind}" Width="80" />
                                        <DataGridTextColumn Header="传感器" Binding="{Binding SensorName}" Width="*" />
                                        <DataGridTextColumn Header="种类" Binding="{Binding SensorKind}" Width="80" />
                                        <DataGridTextColumn Header="读数" Binding="{Binding Value}" Width="80" />
                                        <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="60" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="提示：温度/风扇/电压等需要 LibreHardwareMonitor 驱动权限，建议以管理员身份运行 MyTools 后再启用传感器。"
                                           Style="{StaticResource TextHint}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </materialDesign:Card>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- File Verify module -->
            <Grid Margin="16"
                  Background="Transparent"
                  AllowDrop="True"
                  DragEnter="FileVerify_OnDragOver"
                  DragOver="FileVerify_OnDragOver"
                  Drop="FileVerify_OnDrop">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="FileVerify">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Margin="0,0,0,12"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="{StaticResource CornerRadiusCard}"
                        Padding="12,8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimaryActionButton}"
                                    Command="{Binding VerifyFileCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileSearch" Width="14" Height="14" Margin="0,0,6,0" />
                                    <TextBlock Text="选择文件（可多选）" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource BrushTealGradient}" Margin="0,0,10,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="文件验证" Style="{StaticResource TextHeadline}" />
                                <TextBlock Text="{Binding FileHashStatusMessage}" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Margin="0,0,0,12" Padding="20,18" CornerRadius="8"
                                BorderThickness="2" BorderBrush="#5e72e4" Background="#F4F6FF">
                            <StackPanel HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="FileUploadOutline" Width="32" Height="32"
                                                         Foreground="#5e72e4" HorizontalAlignment="Center" />
                                <TextBlock Text="拖入一个或多个文件即可校验"
                                           FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="单文件可粘贴官方校验值；多文件可导出校验清单" FontSize="11" Opacity="0.6"
                                           Margin="0,4,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <materialDesign:Card Padding="14,12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="支持算法：MD5 / SHA-1 / SHA-256 / CRC32" Style="{StaticResource TextSubtitle}" />
                                <TextBlock Style="{StaticResource TextCaption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="选择任意文件后单遍计算 4 种校验值。粘贴官方校验值后会自动识别算法并判断匹配状态。" />
                                <TextBox Text="{Binding ExpectedFileHash, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource StandardTextBox}"
                                         materialDesign:HintAssist.Hint="官方校验值（可选，支持整行粘贴）"
                                         Margin="0,10,0,0" />
                                <Border Background="{DynamicResource BrushInfoSoft}"
                                        CornerRadius="6" Padding="10,7" Margin="0,8,0,0"
                                        Visibility="{Binding HasFileHashCompareResult, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="14" Height="14"
                                                                 Foreground="{DynamicResource BrushInfo}"
                                                                 Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding FileHashCompareResult}" Style="{StaticResource TextCaption}"
                                                   FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ProgressBar IsIndeterminate="True" Margin="0,10,0,0"
                                             Style="{StaticResource MaterialDesignLinearProgressBar}"
                                             Visibility="{Binding IsFileHashBusy, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </materialDesign:Card>

                        <materialDesign:Card Padding="14,12"
                                             Visibility="{Binding FileHashResult, Converter={StaticResource StringNotEmptyToVisibility}}">
                            <StackPanel>
                                <StackPanel Style="{StaticResource SectionHeaderRow}">
                                    <materialDesign:PackIcon Kind="ClipboardCheckOutline" Width="16" Height="16" Margin="0,0,8,0"
                                                              Foreground="{DynamicResource BrushSuccess}" VerticalAlignment="Center" />
                                    <TextBlock Text="校验结果" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Background="{DynamicResource MaterialDesignToolBarBackground}"
                                        CornerRadius="6" Padding="12,10"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="FileHashResult_OnClick"
                                        ToolTip="点击复制到剪贴板">
                                    <TextBlock Text="{Binding FileHashResult}" Style="{StaticResource TextMonoCode}" />
                                </Border>
                            </StackPanel>
                        </materialDesign:Card>

                        <materialDesign:Card Padding="14,12" Margin="0,12,0,0"
                                             Visibility="{Binding HasBatchFileHashResults, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostActionButton}"
                                                Margin="0,0,6,0"
                                                Command="{Binding CopyBatchFileHashColumnCommand}"
                                                CommandParameter="MD5"
                                                ToolTip="复制文件名和 MD5">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" Margin="0,0,5,0" />
                                                <TextBlock Text="MD5" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource GhostActionButton}"
                                                Margin="0,0,6,0"
                                                Command="{Binding CopyBatchFileHashColumnCommand}"
                                                CommandParameter="SHA-1"
                                                ToolTip="复制文件名和 SHA-1">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" Margin="0,0,5,0" />
                                                <TextBlock Text="SHA-1" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource GhostActionButton}"
                                                Margin="0,0,6,0"
                                                Command="{Binding CopyBatchFileHashColumnCommand}"
                                                CommandParameter="SHA-256"
                                                ToolTip="复制文件名和 SHA-256">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" Margin="0,0,5,0" />
                                                <TextBlock Text="SHA-256" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource GhostActionButton}"
                                                Margin="0,0,6,0"
                                                Command="{Binding CopyBatchFileHashColumnCommand}"
                                                CommandParameter="CRC32"
                                                ToolTip="复制文件名和 CRC32">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" Margin="0,0,5,0" />
                                                <TextBlock Text="CRC32" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource GhostActionButton}"
                                                Command="{Binding ImportFileHashListCommand}"
                                                Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="FileImportOutline" Width="14" Height="14" Margin="0,0,6,0" />
                                                <TextBlock Text="导入清单" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource GhostActionButton}"
                                                Command="{Binding ExportFileHashListCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="FileExportOutline" Width="14" Height="14" Margin="0,0,6,0" />
                                                <TextBlock Text="导出清单" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource SectionHeaderRow}">
                                        <materialDesign:PackIcon Kind="TableCheck" Width="16" Height="16" Margin="0,0,8,0"
                                                                 Foreground="{DynamicResource BrushSuccess}" VerticalAlignment="Center" />
                                        <TextBlock Text="批量校验结果" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding BatchFileHashResults}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          HeadersVisibility="Column"
                                          MinHeight="160"
                                          MaxHeight="280">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="文件" Binding="{Binding FileName}" Width="1.2*" />
                                        <DataGridTextColumn Header="比对" Binding="{Binding CompareStatus}" Width="86" />
                                        <DataGridTextColumn Header="清单算法" Binding="{Binding ExpectedHashKind}" Width="86" />
                                        <DataGridTextColumn Header="大小" Binding="{Binding FileSize}" Width="90" />
                                        <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" Width="2*" />
                                        <DataGridTextColumn Header="MD5" Binding="{Binding Md5}" Width="1.4*" />
                                        <DataGridTextColumn Header="CRC32" Binding="{Binding Crc32}" Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Convert module -->
            <Grid Margin="16">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="Convert">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Margin="0,0,0,12"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="{StaticResource CornerRadiusCard}"
                        Padding="12,8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#F59E0B" Offset="0" />
                                        <GradientStop Color="#EF4444" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <materialDesign:PackIcon Kind="SwapHorizontal" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="格式转换" Style="{StaticResource TextHeadline}" />
                                <TextBlock Text="{Binding ConvertStatusMessage}" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <materialDesign:Card Grid.Row="0" Grid.ColumnSpan="3" Padding="12,8" Margin="0,0,0,8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource GhostActionButton}"
                                            Command="{Binding SelectConvertOutputFolderCommand}"
                                            Visibility="{Binding HasConvertCustomOutputFolder, Converter={StaticResource BoolToVis}}"
                                            Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FolderCogOutline" Width="14" Height="14" Margin="0,0,6,0" />
                                            <TextBlock Text="选择目录" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{Binding ConvertOutputTargetText}" Style="{StaticResource TextCaption}"
                                               VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="输出" Style="{StaticResource TextFieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox Width="116" Height="30" SelectedValue="{Binding ConvertOutputMode, Mode=TwoWay}"
                                              SelectedValuePath="Content">
                                        <ComboBoxItem Content="同目录" IsSelected="True" />
                                        <ComboBoxItem Content="桌面" />
                                        <ComboBoxItem Content="指定目录" />
                                    </ComboBox>
                                </StackPanel>
                            </DockPanel>
                        </materialDesign:Card>

                        <!-- Image conversion card -->
                        <materialDesign:Card Grid.Row="1" Grid.Column="0" Padding="12,10" Margin="0">
                            <StackPanel>
                                <StackPanel Style="{StaticResource SectionHeaderRow}">
                                    <Border Width="24" Height="24" CornerRadius="6" Background="{StaticResource BrushTealGradient}" Margin="0,0,7,0">
                                        <materialDesign:PackIcon Kind="Image" Width="13" Height="13" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="图片转换" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                                    <TextBlock Text="内置" Style="{StaticResource TextHint}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="{StaticResource ThicknessFieldGap}">
                                        <TextBlock Text="格式" Style="{StaticResource TextFieldLabel}" />
                                        <TextBox Text="{Binding ImageOutputFormat, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="jpg"
                                                 Style="{StaticResource StandardTextBox}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1">
                                        <TextBlock Text="JPEG 质量" Style="{StaticResource TextFieldLabel}" />
                                        <TextBox Text="{Binding ImageQuality, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="85"
                                                 Style="{StaticResource StandardTextBox}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,8,0">
                                        <TextBlock Text="最大宽度" Style="{StaticResource TextFieldLabel}" />
                                        <TextBox Text="{Binding ImageMaxWidth, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="0=不限"
                                                 Style="{StaticResource StandardTextBox}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
                                        <TextBlock Text="最大高度" Style="{StaticResource TextFieldLabel}" />
                                        <TextBox Text="{Binding ImageMaxHeight, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="0=不限"
                                                 Style="{StaticResource StandardTextBox}" />
                                    </StackPanel>
                                </Grid>

                                <WrapPanel Margin="0,8,0,0">
                                    <Button Style="{StaticResource GhostActionButton}"
                                            Command="{Binding ApplyImageCompressPresetCommand}"
                                            Margin="0,0,6,6">
                                        <TextBlock Text="图片压缩" />
                                    </Button>
                                    <Button Style="{StaticResource GhostActionButton}"
                                            Command="{Binding ApplyImageAvatarPresetCommand}"
                                            Margin="0,0,6,6">
                                        <TextBlock Text="头像 512" />
                                    </Button>
                                </WrapPanel>

                                <Button Style="{StaticResource PrimaryActionButton}" Margin="0,10,0,0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding ConvertImageCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ImageMove" Width="14" Height="14" Margin="0,0,6,0" />
                                        <TextBlock Text="选择图片（可多选）" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Audio/Video conversion card -->
                        <materialDesign:Card Grid.Row="1" Grid.Column="2" Padding="12,10" Margin="0">
                            <StackPanel>
                                <StackPanel Style="{StaticResource SectionHeaderRow}">
                                    <Border Width="24" Height="24" CornerRadius="6" Background="{StaticResource BrushAccentGradient}" Margin="0,0,7,0">
                                        <materialDesign:PackIcon Kind="MovieOpenOutline" Width="13" Height="13" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="音视频转换" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                                    <Border Margin="8,0,0,0" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource BadgeSuccess}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFfmpegAvailable}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="FFmpeg" Foreground="White" FontWeight="Bold" FontSize="11" />
                                    </Border>
                                    <Border Margin="8,0,0,0" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource BadgeWarning}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFfmpegAvailable}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="未检测到 FFmpeg" Foreground="White" FontWeight="Bold" FontSize="11" />
                                    </Border>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="{StaticResource ThicknessFieldGap}">
                                        <TextBlock Text="格式" Style="{StaticResource TextFieldLabel}" />
                                        <TextBox Text="{Binding MediaOutputFormat, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="mp3"
                                                 Style="{StaticResource StandardTextBox}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="{StaticResource ThicknessFieldGap}">
                                        <TextBlock Text="FFmpeg 参数（可选）" Style="{StaticResource TextFieldLabel}" />
                                        <TextBox Text="{Binding MediaExtraArgs, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="-b:a 192k"
                                                 Style="{StaticResource StandardTextBox}" />
                                    </StackPanel>
                                </Grid>

                                <WrapPanel Margin="0,8,0,0">
                                    <Button Style="{StaticResource GhostActionButton}"
                                            Command="{Binding ApplyMediaMp4PresetCommand}"
                                            Margin="0,0,6,6">
                                        <TextBlock Text="视频转 MP4" />
                                    </Button>
                                    <Button Style="{StaticResource GhostActionButton}"
                                            Command="{Binding ApplyMediaMp3PresetCommand}"
                                            Margin="0,0,6,6">
                                        <TextBlock Text="音频转 MP3" />
                                    </Button>
                                </WrapPanel>

                                <Button Style="{StaticResource PrimaryActionButton}" Margin="0,10,0,0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding ConvertMediaCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileMusic" Width="14" Height="14" Margin="0,0,6,0" />
                                        <TextBlock Text="选择音视频（可多选）" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </materialDesign:Card>
                    </Grid>

                    <StackPanel Grid.Row="1">
                        <!-- Convert queue -->
                        <materialDesign:Card Padding="12,10" Margin="0,8,0,0"
                                             Visibility="{Binding HasConvertQueueItems, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostActionButton}"
                                                Command="{Binding ToggleConvertPauseCommand}"
                                                Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="PauseCircleOutline" Width="14" Height="14" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding ConvertPauseButtonText}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource GhostActionButton}"
                                                Command="{Binding ClearConvertQueueCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Broom" Width="14" Height="14" Margin="0,0,6,0" />
                                                <TextBlock Text="清空" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="可拖拽排序" Style="{StaticResource TextCaption}"
                                               Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel Style="{StaticResource SectionHeaderRow}">
                                        <materialDesign:PackIcon Kind="FormatListChecks" Width="16" Height="16" Margin="0,0,8,0"
                                                                 Foreground="{DynamicResource BrushAccentBlue}" VerticalAlignment="Center" />
                                        <TextBlock Text="转换队列" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>
                                <DataGrid x:Name="ConvertQueueGrid"
                                          ItemsSource="{Binding ConvertQueueItems}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          MinHeight="110"
                                          MaxHeight="220"
                                          PreviewMouseLeftButtonDown="ConvertQueueGrid_OnPreviewMouseLeftButtonDown"
                                          MouseMove="ConvertQueueGrid_OnMouseMove"
                                          Drop="ConvertQueueGrid_OnDrop"
                                          AllowDrop="True"
                                          Style="{StaticResource MaterialDesignDataGrid}"
                                          materialDesign:DataGridAssist.CellPadding="8 4 8 4"
                                          materialDesign:DataGridAssist.ColumnHeaderPadding="8 4 8 4">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="44" />
                                        <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="72" />
                                        <DataGridTextColumn Header="文件" Binding="{Binding FileName}" Width="1.2*" />
                                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="86" />
                                        <DataGridTextColumn Header="输出路径" Binding="{Binding OutputPath}" Width="1.7*" />
                                        <DataGridTextColumn Header="消息" Binding="{Binding Message}" Width="1.4*" />
                                        <DataGridTemplateColumn Header="操作" Width="222">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                                Width="30"
                                                                Height="30"
                                                                Command="{Binding DataContext.MoveConvertQueueItemUpCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="上移">
                                                            <materialDesign:PackIcon Kind="ArrowUp" Width="17" Height="17" />
                                                        </Button>
                                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                                Width="30"
                                                                Height="30"
                                                                Command="{Binding DataContext.MoveConvertQueueItemDownCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="下移">
                                                            <materialDesign:PackIcon Kind="ArrowDown" Width="17" Height="17" />
                                                        </Button>
                                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                                Width="30"
                                                                Height="30"
                                                                Command="{Binding DataContext.OpenConvertQueueOutputCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="打开输出位置">
                                                            <materialDesign:PackIcon Kind="FolderOpenOutline" Width="17" Height="17" />
                                                        </Button>
                                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                                Width="30"
                                                                Height="30"
                                                                Command="{Binding DataContext.CopyConvertQueueMessageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="复制消息">
                                                            <materialDesign:PackIcon Kind="ContentCopy" Width="17" Height="17" />
                                                        </Button>
                                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                                Width="30"
                                                                Height="30"
                                                                Command="{Binding DataContext.RetryConvertQueueItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="重试">
                                                            <materialDesign:PackIcon Kind="Refresh" Width="17" Height="17" />
                                                        </Button>
                                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                                Width="30"
                                                                Height="30"
                                                                Command="{Binding DataContext.RemoveConvertQueueItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="移除">
                                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="17" Height="17" />
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="暂停会在当前文件完成后暂停后续队列，避免中途截断输出。"
                                           Style="{StaticResource TextCaption}" Margin="0,6,0,0" />
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Convert result -->
                        <materialDesign:Card Padding="12,10" Margin="0,8,0,0"
                                                 Visibility="{Binding ConvertResult, Converter={StaticResource StringNotEmptyToVisibility}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Style="{StaticResource PrimaryActionButton}"
                                        Command="{Binding OpenConvertOutputFolderCommand}"
                                        Visibility="{Binding HasConvertOutputTarget, Converter={StaticResource BoolToVis}}"
                                        Margin="10,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FolderOpenOutline" Width="14" Height="14" Margin="0,0,6,0" />
                                        <TextBlock Text="打开位置" />
                                    </StackPanel>
                                </Button>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <materialDesign:PackIcon Kind="CheckCircleOutline" Width="15" Height="15" Margin="0,0,7,0"
                                                                  Foreground="{DynamicResource BrushSuccess}" VerticalAlignment="Center" />
                                        <TextBlock Text="转换结果" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ConvertResult}" Style="{StaticResource TextMonoCode}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </materialDesign:Card>

                        <DockPanel Margin="0,8,0,0"
                                   Visibility="{Binding IsConvertBusy, Converter={StaticResource BoolToVis}}">
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource GhostActionButton}"
                                    Command="{Binding CancelConvertCommand}"
                                    Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="StopCircleOutline" Width="14" Height="14" Margin="0,0,6,0" />
                                    <TextBlock Text="取消" />
                                </StackPanel>
                            </Button>
                            <ProgressBar IsIndeterminate="True"
                                         Style="{StaticResource MaterialDesignLinearProgressBar}"
                                         VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Benchmark module -->
            <Grid Margin="16">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="Benchmark">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Margin="0,0,0,12"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="{StaticResource CornerRadiusCard}"
                        Padding="12,8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimaryActionButton}"
                                    Command="{Binding RunAllBenchmarksCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Play" Width="14" Height="14" Margin="0,0,6,0" />
                                    <TextBlock Text="运行全部测试" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#F43F5E" Offset="0" />
                                        <GradientStop Color="#EC4899" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <materialDesign:PackIcon Kind="SpeedometerMedium" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="性能测试" Style="{StaticResource TextHeadline}" />
                                <TextBlock Text="{Binding BenchmarkStatusMessage}" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ProgressBar IsIndeterminate="True" Margin="0,0,0,10"
                                     Style="{StaticResource MaterialDesignLinearProgressBar}"
                                     Visibility="{Binding IsBenchmarkBusy, Converter={StaticResource BoolToVis}}" />

                        <!-- Individual test buttons -->
                        <materialDesign:Card Padding="14,12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="单项测试" Style="{StaticResource TextSubtitle}" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <Button Style="{StaticResource GhostActionButton}" Margin="0,0,8,8"
                                            Command="{Binding RunSingleBenchmarkCommand}" CommandParameter="CpuSingle">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Cpu64Bit" Width="14" Height="14" Margin="0,0,6,0" />
                                            <TextBlock Text="CPU 单线程" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostActionButton}" Margin="0,0,8,8"
                                            Command="{Binding RunSingleBenchmarkCommand}" CommandParameter="CpuMulti">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Cpu64Bit" Width="14" Height="14" Margin="0,0,6,0" />
                                            <TextBlock Text="CPU 多线程" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostActionButton}" Margin="0,0,8,8"
                                            Command="{Binding RunSingleBenchmarkCommand}" CommandParameter="MemBandwidth">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Memory" Width="14" Height="14" Margin="0,0,6,0" />
                                            <TextBlock Text="内存带宽" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostActionButton}" Margin="0,0,8,8"
                                            Command="{Binding RunSingleBenchmarkCommand}" CommandParameter="MemLatency">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Memory" Width="14" Height="14" Margin="0,0,6,0" />
                                            <TextBlock Text="内存延迟" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostActionButton}" Margin="0,0,8,8"
                                            Command="{Binding RunSingleBenchmarkCommand}" CommandParameter="GpuInfo">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="VideoOutline" Width="14" Height="14" Margin="0,0,6,0" />
                                            <TextBlock Text="GPU 信息" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Results DataGrid -->
                        <materialDesign:Card Padding="14,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostActionButton}"
                                                Command="{Binding CopyBenchmarkResultsCommand}"
                                                Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" Margin="0,0,6,0" />
                                                <TextBlock Text="复制" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource GhostActionButton}"
                                                Command="{Binding ExportBenchmarkResultsCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="FileExportOutline" Width="14" Height="14" Margin="0,0,6,0" />
                                                <TextBlock Text="导出" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource SectionHeaderRow}">
                                        <materialDesign:PackIcon Kind="ChartBar" Width="16" Height="16" Margin="0,0,8,0" Foreground="{DynamicResource BrushAccentBlue}" VerticalAlignment="Center" />
                                        <TextBlock Text="测试结果" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding BenchmarkResults}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          MinHeight="200">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="项目" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn Header="得分" Binding="{Binding Score}" Width="180">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="详情" Binding="{Binding Detail}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ============== Schedule module ============== -->
            <views:SchedulePage DataContext="{Binding Schedule}">
                <views:SchedulePage.Style>
                    <Style TargetType="views:SchedulePage">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.CurrentModule, RelativeSource={RelativeSource AncestorType=mah:MetroWindow}}" Value="Schedule">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:SchedulePage.Style>
            </views:SchedulePage>

            <!-- ============== System Settings module ============== -->
            <views:SystemSettingsPage DataContext="{Binding SystemSettings}">
                <views:SystemSettingsPage.Style>
                    <Style TargetType="views:SystemSettingsPage">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.CurrentModule, RelativeSource={RelativeSource AncestorType=mah:MetroWindow}}" Value="SystemSettings">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:SystemSettingsPage.Style>
            </views:SystemSettingsPage>

        </Grid>
    </Grid>
</mah:MetroWindow>

