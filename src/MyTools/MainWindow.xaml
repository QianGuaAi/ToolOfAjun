                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="{DynamicResource BrushSidebarTopColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource BrushSidebarColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="28" Height="28" CornerRadius="7" Background="#22FFFFFF" VerticalAlignment="Center">
