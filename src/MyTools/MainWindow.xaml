                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="阿君的工具" FontWeight="Bold" FontSize="14" Foreground="White" />
                            <TextBlock Text="MyTools" FontSize="10" Foreground="White" Opacity="0.45" Margin="0,-1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,5,0,0">

                    <Button Command="{Binding ShowHomeCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="Home">
                                        <Setter Property="Tag" Value="ActiveNetwork" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="HomeOutline" Width="17" Height="17" Margin="0,0,9,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentBlue}" />
                            <TextBlock Text="首页" VerticalAlignment="Center" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Border Height="1" Background="{DynamicResource BrushSidebarDivider}" Margin="14,4,14,4" Opacity="0.5" />

                    <Button Command="{Binding ShowNetworkCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="Network">
                                        <Setter Property="Tag" Value="ActiveNetwork" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="LanConnect" Width="17" Height="17" Margin="0,0,9,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentBlue}" />
                            <TextBlock Text="当前网络" VerticalAlignment="Center" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowStartupCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="Startup">
                                        <Setter Property="Tag" Value="ActiveStartup" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="RocketLaunchOutline" Width="17" Height="17" Margin="0,0,9,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentAmber}" />
                            <TextBlock Text="启动管理" VerticalAlignment="Center" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowSystemCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="System">
                                        <Setter Property="Tag" Value="ActiveSystem" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Tools" Width="17" Height="17" Margin="0,0,9,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentRose}" />
                            <TextBlock Text="系统优化" VerticalAlignment="Center" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowUninstallCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="Uninstall">
                                        <Setter Property="Tag" Value="ActiveUninstall" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PackageVariantRemove" Width="17" Height="17" Margin="0,0,9,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentLime}" />
                            <TextBlock Text="程序卸载" VerticalAlignment="Center" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowSqlExportCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="SqlExport">
                                        <Setter Property="Tag" Value="ActiveSqlExport" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DatabaseArrowDown" Width="17" Height="17" Margin="0,0,9,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentBlue}" />
                            <TextBlock Text="SQL 导出" VerticalAlignment="Center" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowScreenshotCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="Screenshot">
                                        <Setter Property="Tag" Value="ActiveScreenshot" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CameraIris" Width="17" Height="17" Margin="0,0,9,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentPurple}" />
                            <TextBlock Text="截图工具" VerticalAlignment="Center" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowImageViewerCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="ImageViewer">
                                        <Setter Property="Tag" Value="ActiveImageViewer" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Image" Width="17" Height="17" Margin="0,0,9,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentTeal}" />
                            <TextBlock Text="图片查看" VerticalAlignment="Center" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowVideoViewerCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="VideoViewer">
                                        <Setter Property="Tag" Value="ActiveVideoViewer" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="VideoOutline" Width="17" Height="17" Margin="0,0,9,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentAmber}" />
                            <TextBlock Text="音视频播放" VerticalAlignment="Center" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowCodexProfilesCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="CodexProfiles">
                                        <Setter Property="Tag" Value="ActiveCodexProfiles" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderCogOutline" Width="17" Height="17" Margin="0,0,9,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentTeal}" />
                            <TextBlock Text="Codex 配置" VerticalAlignment="Center" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowSystemInfoCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="SystemInfo">
                                        <Setter Property="Tag" Value="ActiveNetwork" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Chip" Width="17" Height="17" Margin="0,0,9,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentBlue}" />
                            <TextBlock Text="系统信息" VerticalAlignment="Center" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowFileVerifyCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="FileVerify">
                                        <Setter Property="Tag" Value="ActiveCodexProfiles" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="17" Height="17" Margin="0,0,9,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentTeal}" />
                            <TextBlock Text="文件验证" VerticalAlignment="Center" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowConvertCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="Convert">
                                        <Setter Property="Tag" Value="ActiveNetwork" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="SwapHorizontal" Width="17" Height="17" Margin="0,0,9,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentAmber}" />
                            <TextBlock Text="格式转换" VerticalAlignment="Center" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowBenchmarkCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="Benchmark">
                                        <Setter Property="Tag" Value="ActiveNetwork" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="SpeedometerMedium" Width="17" Height="17" Margin="0,0,9,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentRose}" />
                            <TextBlock Text="性能测试" VerticalAlignment="Center" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowScheduleCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="Schedule">
                                        <Setter Property="Tag" Value="ActiveNetwork" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CalendarMonth" Width="17" Height="17" Margin="0,0,9,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentTeal}" />
                            <TextBlock Text="排班" VerticalAlignment="Center" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowSystemSettingsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="SystemSettings">
                                        <Setter Property="Tag" Value="ActiveNetwork" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CogOutline" Width="17" Height="17" Margin="0,0,9,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentBlue}" />
                            <TextBlock Text="系统设置" VerticalAlignment="Center" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2" Margin="14,0,14,10"
                        Background="#0AFFFFFF" CornerRadius="6"
                        Padding="0,5" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding AppVersionText}"
                               FontSize="10" Opacity="0.5"
                               Foreground="{DynamicResource BrushSidebarText}"
                               HorizontalAlignment="Center"
                               Margin="12,0" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{DynamicResource MaterialDesignFlatBackground}">
