<Window x:Class="MyTools.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:viewModels="clr-namespace:MyTools.ViewModels"
                 xmlns:views="clr-namespace:MyTools.Views"
                 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                 Title="阿君的工具"
                 Width="1120"
                 Height="720"
                 MinWidth="980"
                 MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 Background="{StaticResource ShellPaperBrush}"
                 Icon="/Resources/AppIcon.ico"
                 AllowDrop="True"
                 PreviewDragOver="Window_PreviewDragOver"
                 PreviewDrop="Window_Drop"
                 PreviewKeyDown="Window_PreviewKeyDown">

    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme.xaml" />
                <ResourceDictionary Source="Resources/Illustrations.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        <DataTemplate x:Key="MainModulesViewTemplate">
            <views:MainModulesView />
        </DataTemplate>
        <DataTemplate x:Key="HomeViewTemplate">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate x:Key="HomeShellTemplate">
            <Grid Background="{StaticResource ShellFlatBackgroundBrush}">
                <StackPanel Width="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="阿君的工具"
                               Foreground="{StaticResource ShellBodyBrush}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8" />
                    <TextBlock Text="通过顶部菜单选择功能模块"
                               Foreground="{StaticResource ShellCaptionBrush}"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,18" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="NetworkViewTemplate">
            <views:NetworkView />
        </DataTemplate>
        <DataTemplate x:Key="StartupViewTemplate">
            <views:StartupView />
        </DataTemplate>
        <DataTemplate x:Key="UninstallViewTemplate">
            <views:UninstallView />
        </DataTemplate>
        <DataTemplate x:Key="SystemInfoViewTemplate">
            <views:SystemInfoView />
        </DataTemplate>
        <DataTemplate x:Key="BenchmarkViewTemplate">
            <views:BenchmarkView />
        </DataTemplate>
        <DataTemplate x:Key="SystemSettingsViewTemplate">
            <views:SystemSettingsPage Margin="16,12,16,16" DataContext="{Binding SystemSettings}" />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource TopMenuBarBorder}">
            <Menu Style="{StaticResource TopMenuBar}">
                <MenuItem Header="文件(_F)" Style="{StaticResource TopMenuItem}">
                    <MenuItem Header="首页(_H)" Command="{Binding ShowHomeCommand}" Style="{StaticResource TopMenuItem}" />
                    <Separator />
                    <MenuItem Header="退出(_X)" Command="{Binding ExitCommand}" Style="{StaticResource TopMenuItem}" />
                </MenuItem>
                <MenuItem Header="系统(_S)" Style="{StaticResource TopMenuItem}">
                    <MenuItem Header="系统优化(_O)" Command="{Binding ShowSystemCommand}" Style="{StaticResource TopMenuItem}" />
                    <MenuItem Header="当前网络(_N)" Command="{Binding ShowNetworkCommand}" Style="{StaticResource TopMenuItem}" />
                    <MenuItem Header="启动管理(_T)" Command="{Binding ShowStartupCommand}" Style="{StaticResource TopMenuItem}" />
                    <MenuItem Header="程序卸载(_U)" Command="{Binding ShowUninstallCommand}" Style="{StaticResource TopMenuItem}" />
                    <Separator />
                    <MenuItem Header="系统信息(_I)" Command="{Binding ShowSystemInfoCommand}" Style="{StaticResource TopMenuItem}" />
                    <MenuItem Header="性能测试(_B)" Command="{Binding ShowBenchmarkCommand}" Style="{StaticResource TopMenuItem}" />
                    <Separator />
                    <MenuItem Header="系统设置(_G)" Command="{Binding ShowSystemSettingsCommand}" Style="{StaticResource TopMenuItem}" />
                </MenuItem>
                <MenuItem Header="工具(_T)" Style="{StaticResource TopMenuItem}">
                    <MenuItem Header="多媒体(_M)" Command="{Binding ShowMultimediaCommand}" Style="{StaticResource TopMenuItem}" />
                    <MenuItem Header="截图工具(_S)" Command="{Binding ShowScreenshotCommand}" Style="{StaticResource TopMenuItem}" />
                    <Separator />
                    <MenuItem Header="SQL 导出(_Q)" Command="{Binding ShowSqlExportCommand}" Style="{StaticResource TopMenuItem}" />
                    <MenuItem Header="FRP 穿透(_F)" Command="{Binding ShowFrpCommand}" Style="{StaticResource TopMenuItem}" />
                    <MenuItem Header="Codex 配置(_C)" Command="{Binding ShowCodexProfilesCommand}" Style="{StaticResource TopMenuItem}" />
                    <MenuItem Header="文件验证(_V)" Command="{Binding ShowFileVerifyCommand}" Style="{StaticResource TopMenuItem}" />
                </MenuItem>
                <MenuItem Header="日程(_A)" Command="{Binding ShowScheduleCommand}" Style="{StaticResource TopMenuItem}" />
                <MenuItem Header="设置(_P)" Command="{Binding ShowSystemSettingsCommand}" Style="{StaticResource TopMenuItem}" />
                <MenuItem Header="帮助(_H)" Style="{StaticResource TopMenuItem}">
                    <MenuItem Header="关于(_A)" Click="MenuAbout_Click" Style="{StaticResource TopMenuItem}" />
                    <Separator />
                    <MenuItem Header="打开项目规范(_G)" Click="MenuOpenAgents_Click" Style="{StaticResource TopMenuItem}" />
                </MenuItem>
            </Menu>
        </Border>

        <Grid Grid.Row="1" Background="{StaticResource ShellFlatBackgroundBrush}">
            <ContentControl x:Name="HomeHost" Content="{Binding}" ContentTemplate="{StaticResource HomeShellTemplate}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="Home">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            <ContentControl x:Name="MainModulesHost" Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="ContentTemplate" Value="{x:Null}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="SqlExport">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="ContentTemplate" Value="{StaticResource MainModulesViewTemplate}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="Screenshot">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="ContentTemplate" Value="{StaticResource MainModulesViewTemplate}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="Frp">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="ContentTemplate" Value="{StaticResource MainModulesViewTemplate}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="Multimedia">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="ContentTemplate" Value="{StaticResource MainModulesViewTemplate}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="ImageViewer">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="ContentTemplate" Value="{StaticResource MainModulesViewTemplate}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="VideoViewer">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="ContentTemplate" Value="{StaticResource MainModulesViewTemplate}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="CodexProfiles">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="ContentTemplate" Value="{StaticResource MainModulesViewTemplate}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="FileVerify">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="ContentTemplate" Value="{StaticResource MainModulesViewTemplate}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="Convert">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="ContentTemplate" Value="{StaticResource MainModulesViewTemplate}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="Schedule">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="ContentTemplate" Value="{StaticResource MainModulesViewTemplate}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <!-- Independent system module panels -->
            <ContentControl x:Name="NetworkHost" Content="{Binding}" ContentTemplate="{StaticResource NetworkViewTemplate}" Panel.ZIndex="5">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="Network">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            <ContentControl x:Name="StartupHost" Content="{Binding}" ContentTemplate="{StaticResource StartupViewTemplate}" Panel.ZIndex="5">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="Startup">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            <ContentControl x:Name="UninstallHost" Content="{Binding}" ContentTemplate="{StaticResource UninstallViewTemplate}" Panel.ZIndex="5">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="Uninstall">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            <ContentControl x:Name="SystemInfoHost" Content="{Binding}" ContentTemplate="{StaticResource SystemInfoViewTemplate}" Panel.ZIndex="5">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="SystemInfo">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            <ContentControl x:Name="BenchmarkHost" Content="{Binding}" ContentTemplate="{StaticResource BenchmarkViewTemplate}" Panel.ZIndex="5">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="Benchmark">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            <ContentControl x:Name="SystemSettingsHost" Content="{Binding}" ContentTemplate="{StaticResource SystemSettingsViewTemplate}" Panel.ZIndex="5">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="SystemSettings">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            <ContentControl x:Name="OptimizationHost" Content="{Binding}" ContentTemplate="{StaticResource MainModulesViewTemplate}" Panel.ZIndex="5">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="ContentTemplate" Value="{x:Null}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="Optimization">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="ContentTemplate" Value="{StaticResource MainModulesViewTemplate}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

        </Grid>
        <StatusBar Grid.Row="2" Style="{StaticResource BottomStatusBar}">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0">
                <TextBlock Style="{StaticResource StatusBarText}"><Run Text="当前位置：" /><Run Text="{Binding CurrentNavigationText, Mode=OneWay}" /></TextBlock>
            </StatusBarItem>
            <StatusBarItem Grid.Column="1">
                <TextBlock Text="" />
            </StatusBarItem>
            <StatusBarItem Grid.Column="2" HorizontalAlignment="Right">
                <TextBlock Style="{StaticResource StatusBarText}"><Run Text="阿君的工具 · " /><Run Text="{Binding AppVersionText, Mode=OneWay}" /></TextBlock>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
