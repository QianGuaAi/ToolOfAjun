<mah:MetroWindow x:Class="MyTools.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                 xmlns:viewModels="clr-namespace:MyTools.ViewModels"
                 xmlns:views="clr-namespace:MyTools.Views"
                 xmlns:tb="clr-namespace:Hardcodet.Wpf.TaskbarNotification;assembly=Hardcodet.NotifyIcon.Wpf"
                 Title="阿君的工具"
                 Width="1180"
                 Height="760"
                 MinWidth="1080"
                 MinHeight="700"
                 WindowStartupLocation="CenterScreen"
                 GlowBrush="{x:Null}"
                 TitleCharacterCasing="Normal"
                 Background="{DynamicResource MaterialDesignPaper}"
                 Icon="/Resources/AppIcon.ico"
                 AllowDrop="True"
                 PreviewDragOver="Window_PreviewDragOver"
                 PreviewDrop="Window_Drop"
                 PreviewKeyDown="Window_PreviewKeyDown">

    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <viewModels:StatusToColorConverter x:Key="StatusToColorConverter" />
        <viewModels:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <viewModels:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility" />

        <Style x:Key="NavItemStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource BrushSidebarText}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" SnapsToDevicePixels="True"
                                Margin="6,1,6,1" CornerRadius="8">
                            <Grid>
                                <Rectangle x:Name="ActiveBar"
                                           Width="3"
                                           Height="18"
                                           RadiusX="1.5"
                                           RadiusY="1.5"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Fill="{DynamicResource BrushAccentBlue}"
                                           Visibility="Collapsed" />
                                <ContentPresenter Margin="18,0,12,0"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushSidebarHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushSidebarTextHover}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.85"
                                                             To="1"
                                                             Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushSidebarPressed}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="ActiveNetwork">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushSidebarActive}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushSidebarTextActive}" />
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ActiveBar" Property="Fill" Value="{DynamicResource BrushAccentBlue}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="ActiveStartup">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushSidebarActive}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushSidebarTextActive}" />
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ActiveBar" Property="Fill" Value="{DynamicResource BrushAccentAmber}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="ActiveSystem">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushSidebarActive}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushSidebarTextActive}" />
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ActiveBar" Property="Fill" Value="{DynamicResource BrushAccentRose}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="ActiveUninstall">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushSidebarActive}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushSidebarTextActive}" />
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ActiveBar" Property="Fill" Value="{DynamicResource BrushAccentLime}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="ActiveSqlExport">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushSidebarActive}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushSidebarTextActive}" />
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ActiveBar" Property="Fill" Value="{DynamicResource BrushAccentBlue}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="ActiveScreenshot">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushSidebarActive}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushSidebarTextActive}" />
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ActiveBar" Property="Fill" Value="{DynamicResource BrushAccentPurple}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="ActiveCodexProfiles">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushSidebarActive}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushSidebarTextActive}" />
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ActiveBar" Property="Fill" Value="{DynamicResource BrushAccentTeal}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HomeShortcutButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="{StaticResource CornerRadiusButton}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#14000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#24000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="TrayMenu" materialDesign:MenuAssist.TopLevelMenuItemHeight="40">
            <MenuItem Header="显示窗口" Command="{Binding RestoreCommand}">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="WindowMaximize" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Command="{Binding ToggleAutoStartCommand}">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="AutoStart" />
                </MenuItem.Icon>
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource MaterialDesignMenuItem}">
                        <Setter Property="Header" Value="开启 开机自启" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAutoStartEnabled}" Value="True">
                                <Setter Property="Header" Value="关闭 开机自启" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="打开日志目录" Command="{Binding OpenLogFolderCommand}">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FolderOpenOutline" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="退出程序" Command="{Binding ExitCommand}">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="ExitToApp" Foreground="Red" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <ContentControl x:Key="HomeView">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,18,24,18">
                    <!-- Hero -->
                    <Border CornerRadius="{StaticResource CornerRadiusCard}"
                            Margin="0,0,0,14" Padding="28,22"
                            Background="{StaticResource BrushHeroGradient}" ClipToBounds="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.12" Color="#475569" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="92" Height="92" VerticalAlignment="Center" Margin="0,0,20,0">
                                <Ellipse Fill="{StaticResource BrushAccentGradient}" Opacity="0.18" />
                                <Ellipse Width="74" Height="74" Fill="White" Opacity="0.6" />
                                <Image Source="{StaticResource HomeHero}" Width="64" Height="64" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="阿君的工具" Style="{StaticResource TextHeadline}" FontSize="22" />
                                <TextBlock Text="常用桌面工具集中管理 · 开箱即用 · 单 EXE 分发"
                                           Style="{StaticResource TextCaption}" Margin="0,3,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource StatusPill}" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="{DynamicResource BrushSuccess}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding OsDisplayName}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource StatusPill}">
                                        <TextBlock Text="{Binding AppVersionText}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Shortcut buttons -->
                    <UniformGrid Rows="1" Columns="4" Margin="0,0,0,10">
                        <Button Command="{Binding ShowNetworkCommand}" Margin="0,0,10,0" Style="{StaticResource HomeShortcutButtonStyle}">
                            <materialDesign:Card Padding="14,14" Margin="0">
                                <StackPanel>
                                    <Border Width="34" Height="34" Background="{StaticResource BrushBlueGradient}" CornerRadius="10">
                                        <materialDesign:PackIcon Kind="LanConnect" Width="18" Height="18" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="当前网络" Style="{StaticResource TextSubtitle}" Margin="0,10,0,2" />
                                    <TextBlock Text="网卡 · 网关 · DNS 状态" Style="{StaticResource TextHint}" TextWrapping="Wrap" />
                                </StackPanel>
                            </materialDesign:Card>
                        </Button>

                        <Button Command="{Binding ShowSystemCommand}" Margin="0,0,10,0" Style="{StaticResource HomeShortcutButtonStyle}">
                            <materialDesign:Card Padding="14,14" Margin="0">
                                <StackPanel>
                                    <Border Width="34" Height="34" CornerRadius="10">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#F43F5E" Offset="0" />
                                                <GradientStop Color="#F59E0B" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <materialDesign:PackIcon Kind="Tools" Width="18" Height="18" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="系统优化" Style="{StaticResource TextSubtitle}" Margin="0,10,0,2" />
                                    <TextBlock Text="清理 · 加固 · 自动化" Style="{StaticResource TextHint}" TextWrapping="Wrap" />
                                </StackPanel>
                            </materialDesign:Card>
                        </Button>

                        <Button Command="{Binding ShowSqlExportCommand}" Margin="0,0,10,0" Style="{StaticResource HomeShortcutButtonStyle}">
                            <materialDesign:Card Padding="14,14" Margin="0">
                                <StackPanel>
                                    <Border Width="34" Height="34" Background="{StaticResource BrushTealGradient}" CornerRadius="10">
                                        <materialDesign:PackIcon Kind="DatabaseArrowDown" Width="18" Height="18" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="SQL 导出" Style="{StaticResource TextSubtitle}" Margin="0,10,0,2" />
                                    <TextBlock Text="连接 · 查询 · 导出 Excel" Style="{StaticResource TextHint}" TextWrapping="Wrap" />
                                </StackPanel>
                            </materialDesign:Card>
                        </Button>

                        <Button Command="{Binding ShowScreenshotCommand}" Margin="0" Style="{StaticResource HomeShortcutButtonStyle}">
                            <materialDesign:Card Padding="14,14" Margin="0">
                                <StackPanel>
                                    <Border Width="34" Height="34" Background="{StaticResource BrushAccentGradient}" CornerRadius="10">
                                        <materialDesign:PackIcon Kind="CameraIris" Width="18" Height="18" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="截图工具" Style="{StaticResource TextSubtitle}" Margin="0,10,0,2" />
                                    <TextBlock Text="截图 · 录像 · 录音" Style="{StaticResource TextHint}" TextWrapping="Wrap" />
                                </StackPanel>
                            </materialDesign:Card>
                        </Button>
                    </UniformGrid>

                    <!-- System info card -->
                    <materialDesign:Card Style="{StaticResource SectionCardOutlined}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource SectionHeaderRow}">
                                <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource BrushTealGradient}" Margin="0,0,10,0">
                                    <materialDesign:PackIcon Kind="MonitorDashboard" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="系统概览" Style="{StaticResource TextSubtitle}" />
                                    <TextBlock Text="设备硬件与运行状态" Style="{StaticResource TextHint}" Margin="0,1,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="操作系统" Grid.Row="0" Grid.Column="0" Style="{StaticResource TextHint}" Margin="0,0,12,6" />
                                <TextBlock Text="{Binding SystemInfo.OsName}" Grid.Row="0" Grid.Column="1" Style="{StaticResource TextBodyStandard}" TextTrimming="CharacterEllipsis" Margin="0,0,20,6" />
                                <TextBlock Text="处理器" Grid.Row="0" Grid.Column="2" Style="{StaticResource TextHint}" Margin="0,0,12,6" />
                                <TextBlock Text="{Binding SystemInfo.CpuName}" Grid.Row="0" Grid.Column="3" Style="{StaticResource TextBodyStandard}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />
                                <TextBlock Text="内存" Grid.Row="1" Grid.Column="0" Style="{StaticResource TextHint}" Margin="0,0,12,6" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource TextBodyStandard}" Margin="0,0,20,6">
                                    <Run Text="{Binding SystemInfo.AvailableRam, Mode=OneTime}" /><Run Text=" / " /><Run Text="{Binding SystemInfo.TotalRam, Mode=OneTime}" />
                                </TextBlock>
                                <TextBlock Text="系统盘" Grid.Row="1" Grid.Column="2" Style="{StaticResource TextHint}" Margin="0,0,12,6" />
                                <TextBlock Text="{Binding SystemInfo.SystemDisk}" Grid.Row="1" Grid.Column="3" Style="{StaticResource TextBodyStandard}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />
                                <TextBlock Text="运行时间" Grid.Row="2" Grid.Column="0" Style="{StaticResource TextHint}" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding SystemInfo.Uptime}" Grid.Row="2" Grid.Column="1" Style="{StaticResource TextBodyStandard}" Margin="0,0,20,0" />
                                <TextBlock Text=".NET" Grid.Row="2" Grid.Column="2" Style="{StaticResource TextHint}" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding SystemInfo.DotNetVersion}" Grid.Row="2" Grid.Column="3" Style="{StaticResource TextBodyStandard}" />
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>

                    <TextBlock Text="提示：可通过左侧导航快速切换功能模块。"
                               HorizontalAlignment="Center"
                               Style="{StaticResource TextHint}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </ScrollViewer>
        </ContentControl>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="阿君的工具（双击恢复窗口）"
                        Visibility="Visible"
                        MenuActivation="LeftOrRightClick"
                        ContextMenu="{StaticResource TrayMenu}"
                        DoubleClickCommand="{Binding RestoreCommand}" />

        <Border Background="{DynamicResource BrushSidebar}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="16,16,16,12"
                        BorderBrush="{DynamicResource BrushSidebarDivider}" BorderThickness="0,0,0,1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="{DynamicResource BrushSidebarTopColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource BrushSidebarColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32" CornerRadius="8" Background="#22FFFFFF" VerticalAlignment="Center">
                            <Image Source="/Resources/AppIcon.png" Width="22" Height="22"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="阿君的工具" FontWeight="Bold" FontSize="15" Foreground="White" />
                            <TextBlock Text="MyTools" FontSize="10" Foreground="White" Opacity="0.45" Margin="0,-1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1" Margin="0,6,0,0">

                    <Button Command="{Binding ShowHomeCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="Home">
                                        <Setter Property="Tag" Value="ActiveNetwork" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="HomeOutline" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentBlue}" />
                            <TextBlock Text="首页" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Border Height="1" Background="{DynamicResource BrushSidebarDivider}" Margin="14,4,14,4" Opacity="0.5" />

                    <Button Command="{Binding ShowNetworkCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="Network">
                                        <Setter Property="Tag" Value="ActiveNetwork" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="LanConnect" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentBlue}" />
                            <TextBlock Text="当前网络" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowStartupCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="Startup">
                                        <Setter Property="Tag" Value="ActiveStartup" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="RocketLaunchOutline" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentAmber}" />
                            <TextBlock Text="启动管理" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowSystemCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="System">
                                        <Setter Property="Tag" Value="ActiveSystem" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Tools" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentRose}" />
                            <TextBlock Text="系统优化" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowUninstallCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="Uninstall">
                                        <Setter Property="Tag" Value="ActiveUninstall" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PackageVariantRemove" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentLime}" />
                            <TextBlock Text="程序卸载" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowSqlExportCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="SqlExport">
                                        <Setter Property="Tag" Value="ActiveSqlExport" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DatabaseArrowDown" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentBlue}" />
                            <TextBlock Text="SQL 导出" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowScreenshotCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="Screenshot">
                                        <Setter Property="Tag" Value="ActiveScreenshot" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CameraIris" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentPurple}" />
                            <TextBlock Text="截图工具" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowCodexProfilesCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="CodexProfiles">
                                        <Setter Property="Tag" Value="ActiveCodexProfiles" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderCogOutline" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentTeal}" />
                            <TextBlock Text="Codex 配置" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowSystemInfoCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="SystemInfo">
                                        <Setter Property="Tag" Value="ActiveNetwork" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Chip" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentBlue}" />
                            <TextBlock Text="系统信息" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowFileVerifyCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="FileVerify">
                                        <Setter Property="Tag" Value="ActiveCodexProfiles" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentTeal}" />
                            <TextBlock Text="文件验证" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowConvertCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="Convert">
                                        <Setter Property="Tag" Value="ActiveNetwork" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="SwapHorizontal" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentAmber}" />
                            <TextBlock Text="格式转换" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowBenchmarkCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="Benchmark">
                                        <Setter Property="Tag" Value="ActiveNetwork" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="SpeedometerMedium" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentRose}" />
                            <TextBlock Text="性能测试" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowScheduleCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="Schedule">
                                        <Setter Property="Tag" Value="ActiveNetwork" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CalendarMonth" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentTeal}" />
                            <TextBlock Text="排班" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowSystemSettingsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="SystemSettings">
                                        <Setter Property="Tag" Value="ActiveNetwork" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CogOutline" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentBlue}" />
                            <TextBlock Text="系统设置" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                </StackPanel>
                <Border Grid.Row="2" Margin="14,0,14,10"
                        Background="#0AFFFFFF" CornerRadius="6"
                        Padding="0,5" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding AppVersionText}"
                               FontSize="10" Opacity="0.5"
                               Foreground="{DynamicResource BrushSidebarText}"
                               HorizontalAlignment="Center"
                               Margin="12,0" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{DynamicResource MaterialDesignFlatBackground}">
            <ContentControl Content="{StaticResource HomeView}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="Home">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <Grid Margin="20">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="Network">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,10"
                        CornerRadius="{StaticResource CornerRadiusCard}"
                        Padding="14,10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding RefreshCommand}" ToolTip="刷新">
                            <materialDesign:PackIcon Kind="Refresh" Width="22" Height="22" />
                        </Button>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BrushBlueGradient}" Margin="0,0,12,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="LanConnect" Width="18" Height="18" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="当前网络" Style="{StaticResource TextHeadline}" />
                                <TextBlock Text="实时查看网卡、IP、网关与 DNS 信息。" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="NetworkListControl" ItemsSource="{Binding NetworkList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <materialDesign:Card Margin="0,0,0,10" Padding="12,10" materialDesign:ElevationAssist.Elevation="Dp1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <materialDesign:PackIcon Kind="Lan"
                                                                     Width="24" Height="24"
                                                                     VerticalAlignment="Top"
                                                                     HorizontalAlignment="Center"
                                                                     Margin="0,2,0,0"
                                                                     Foreground="{Binding Status, Converter={StaticResource StatusToColorConverter}}" />

                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource TextSubtitle}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource TextCaption}" Margin="0,1,0,6" TextTrimming="CharacterEllipsis" />

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Text="IP 地址：" Grid.Row="0" Style="{StaticResource TextHint}" Margin="0,0,10,3" />
                                                    <TextBlock Text="{Binding IpAddress}" Grid.Row="0" Grid.Column="1" Style="{StaticResource TextBodyStandard}" TextWrapping="Wrap" Margin="0,0,0,3" />

                                                    <TextBlock Text="网关：" Grid.Row="1" Style="{StaticResource TextHint}" Margin="0,0,10,3" />
                                                    <TextBlock Text="{Binding Gateway}" Grid.Row="1" Grid.Column="1" Style="{StaticResource TextBodyStandard}" TextWrapping="Wrap" Margin="0,0,0,3" />

                                                    <TextBlock Text="DNS：" Grid.Row="2" Style="{StaticResource TextHint}" Margin="0,0,10,3" />
                                                    <TextBlock Text="{Binding Dns}" Grid.Row="2" Grid.Column="1" Style="{StaticResource TextBodyStandard}" TextWrapping="Wrap" Margin="0,0,0,3" />

                                                    <TextBlock Text="MAC：" Grid.Row="3" Style="{StaticResource TextHint}" Margin="0,0,10,3" />
                                                    <TextBlock Text="{Binding MacAddress}" Grid.Row="3" Grid.Column="1" Style="{StaticResource TextBodyStandard}" Margin="0,0,0,3" />

                                                    <TextBlock Text="速率：" Grid.Row="4" Style="{StaticResource TextHint}" Margin="0,0,10,3" />
                                                    <TextBlock Text="{Binding LinkSpeed}" Grid.Row="4" Grid.Column="1" Style="{StaticResource TextBodyStandard}" Margin="0,0,0,3" />

                                                    <TextBlock Text="类型：" Grid.Row="5" Style="{StaticResource TextHint}" Margin="0,0,10,0" />
                                                    <TextBlock Text="{Binding AdapterType}" Grid.Row="5" Grid.Column="1" Style="{StaticResource TextBodyStandard}" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </materialDesign:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=NetworkListControl}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Image Source="{StaticResource NetworkEmpty}" Width="160" Height="120" HorizontalAlignment="Center" />
                        <TextBlock Text="No network entries available right now."
                                   Style="{StaticResource TextSubtitle}"
                                   HorizontalAlignment="Center"
                                   Opacity="0.4"
                                   Margin="0,12,0,0" />
                        <Button Content="刷新" HorizontalAlignment="Center"
                                Style="{StaticResource GhostActionButton}"
                                Command="{Binding RefreshCommand}"
                                Margin="0,12,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Margin="16">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="Uninstall">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,10"
                        CornerRadius="{StaticResource CornerRadiusCard}"
                        Padding="14,10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Style="{StaticResource BadgeInfo}"
                                    Margin="0,0,12,0"
                                    Background="{DynamicResource BrushAccentLime}">
                                <TextBlock Text="{Binding InstalledProgramsCountText}" />
                            </Border>
                            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                         IsIndeterminate="True"
                                         Width="22"
                                         Height="22"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding IsInstalledProgramsBusy, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                    Command="{Binding RefreshInstalledProgramsCommand}"
                                    ToolTip="刷新程序列表">
                                <materialDesign:PackIcon Kind="Refresh" Width="22" Height="22" />
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BrushTealGradient}" Margin="0,0,12,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="PackageVariantRemove" Width="18" Height="18" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="程序卸载" Style="{StaticResource TextHeadline}" />
                                <TextBlock Text="{Binding InstalledProgramsStatusMessage}" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1">
                    <DataGrid ItemsSource="{Binding InstalledPrograms}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              RowHeight="42"
                              Style="{StaticResource MaterialDesignDataGrid}"
                              materialDesign:DataGridAssist.CellPadding="10 4 10 4"
                              materialDesign:DataGridAssist.ColumnHeaderPadding="10 8 10 8">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="程序" Width="2.1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding DisplayName}" />
                                            <TextBlock Text="{Binding PublisherDisplay}"
                                                       FontSize="11"
                                                       Opacity="0.55"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="版本" Width="120" Binding="{Binding VersionDisplay}" />
                            <DataGridTextColumn Header="安装日期" Width="110" Binding="{Binding InstallDateDisplay}" />
                            <DataGridTextColumn Header="大小" Width="90" Binding="{Binding EstimatedSizeDisplay}" />
                            <DataGridTextColumn Header="来源" Width="120" Binding="{Binding Source}" />
                            <DataGridTextColumn Header="安装位置" Width="1.5*" Binding="{Binding InstallLocationDisplay}" />
                            <DataGridTemplateColumn Header="卸载" Width="86">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding DataContext.UninstallProgramCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding RequiresAdminDisplay}">
                                            <materialDesign:PackIcon Kind="TrashCanOutline"
                                                                     Width="20"
                                                                     Height="20"
                                                                     Foreground="{DynamicResource BrushError}" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding HasNoInstalledPrograms, Converter={StaticResource BoolToVis}}">
                        <materialDesign:PackIcon Kind="PackageVariant"
                                                 Width="76"
                                                 Height="76"
                                                 Opacity="0.28"
                                                 HorizontalAlignment="Center" />
                        <TextBlock Text="未加载可卸载程序"
                                   Style="{StaticResource TextSubtitle}"
                                   HorizontalAlignment="Center"
                                   Opacity="0.5"
                                   Margin="0,12,0,0" />
                        <Button Content="刷新列表"
                                Style="{StaticResource GhostActionButton}"
                                Command="{Binding RefreshInstalledProgramsCommand}"
                                Margin="0,12,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Margin="20">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="Startup">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,8"
                        CornerRadius="{StaticResource CornerRadiusCard}"
                        Padding="12,8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding RefreshCommand}" ToolTip="Refresh">
                            <materialDesign:PackIcon Kind="Refresh" Width="22" Height="22" />
                        </Button>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#F59E0B" Offset="0" />
                                        <GradientStop Color="#EF4444" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <materialDesign:PackIcon Kind="RocketLaunchOutline" Width="18" Height="18" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="启动项管理" Style="{StaticResource TextHeadline}" />
                                <TextBlock Text="管理 Windows 开机启动项" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding StartupList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <materialDesign:Card Margin="0,0,0,10" Padding="0"
                                                        materialDesign:ElevationAssist.Elevation="Dp1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="5" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" CornerRadius="4,0,0,4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#2E7D32" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                <Setter Property="Background" Value="#9E9E9E" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="12,12,8,12">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource TextSubtitle}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Command}" Style="{StaticResource TextCaption}" Opacity="0.6" Margin="0,4,0,4"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="AccountCircle" Width="12" Height="12" VerticalAlignment="Center" Opacity="0.5" />
                                                    <TextBlock Text="{Binding Location}" Style="{StaticResource TextCaption}" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="4,0,0,0" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Margin="0,0,8,0">
                                                <Button Command="{Binding DataContext.ToggleStartupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Width="80"
                                                        Margin="0,0,8,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource GhostActionButton}">
                                                            <Setter Property="Content" Value="禁用" />
                                                            <Setter Property="Foreground" Value="#C62828" />
                                                            <Setter Property="BorderBrush" Value="#C62828" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                    <Setter Property="Content" Value="启用" />
                                                                    <Setter Property="Foreground" Value="#2E7D32" />
                                                                    <Setter Property="BorderBrush" Value="#2E7D32" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        Command="{Binding DataContext.DeleteStartupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="永久删除（需确认）">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Foreground="#9E9E9E" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </materialDesign:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasNoStartupItems, Converter={StaticResource BoolToVis}}">
                        <Image Source="{StaticResource StartupEmpty}" Width="160" Height="120" HorizontalAlignment="Center" />
                        <TextBlock Text="未发现开机启动项" Style="{StaticResource TextSubtitle}"
                                   HorizontalAlignment="Center" Opacity="0.4" Margin="0,12,0,0" />
                        <TextBlock Text="点击刷新按钮重新扫描" Style="{StaticResource TextCaption}"
                                   HorizontalAlignment="Center" Opacity="0.3" Margin="0,4,0,0" />
                        <Button Content="Refresh"
                                Style="{StaticResource GhostActionButton}"
                                Command="{Binding RefreshCommand}"
                                Margin="0,12,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Margin="20">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="0,0,0,20" CornerRadius="{StaticResource CornerRadiusCard}" Padding="20,16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BrushTealGradient}" Margin="0,0,12,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ShieldLock" Width="18" Height="18" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="VPN 连接" Style="{StaticResource TextHeadline}" />
                        <TextBlock Text="快速连接与切换 WireGuard 隧道" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                    </StackPanel>
                    <Border Padding="10,3" Margin="20,0,0,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource BadgeInfo}">
                                <Setter Property="Background" Value="{DynamicResource BrushInfo}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWgConnected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrushSuccess}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsWgBusy}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrushWarning}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding WgStatusText}" Foreground="White" FontWeight="Bold" />
                    </Border>
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                 IsIndeterminate="True"
                                 Width="20" Height="20"
                                 Margin="12,0,0,0"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsWgBusy, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding ToggleWgSettingsCommand}" Margin="6,0,0,0" ToolTip="设置">
                        <materialDesign:PackIcon Kind="Settings" />
                    </Button>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <materialDesign:Card Grid.Row="0" Padding="12,10" Margin="0,0,0,10"
                                         Background="#FFF3E0"
                                         Visibility="{Binding WgExeNotFound, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="#E65100" Width="20" Height="20" VerticalAlignment="Center" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#BF360C">
                                <Run FontWeight="Bold" Text="WireGuard 未安装" />
                                <Run Text="— 请先安装 WireGuard for Windows，下载地址：https://www.wireguard.com/install/" />
                            </TextBlock>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Row="1" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBox materialDesign:HintAssist.Hint="接口名称 (例如 wg0)"
                                     Text="{Binding WgInterfaceName}"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Margin="0,0,0,10" />
                            <TextBlock Text="配置内容 (.conf):" Style="{StaticResource TextCaption}" Margin="0,10,0,5" />
                            <TextBox Text="{Binding WgConfig, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="200"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="[Interface]&#x0a;PrivateKey = ...&#x0a;Address = ...&#x0a;&#x0a;[Peer]&#x0a;PublicKey = ...&#x0a;Endpoint = ..." />
                        </StackPanel>
                    </materialDesign:Card>

                    <Button Grid.Row="3" Command="{Binding ToggleWireGuardCommand}" Height="44">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
                                <Setter Property="Content" Value="启动连接" />
                                <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWgConnected}" Value="True">
                                        <Setter Property="Content" Value="断开连接" />
                                        <Setter Property="Background" Value="#E53935" />
                                        <Setter Property="BorderBrush" Value="#E53935" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <materialDesign:Card Grid.Row="0"
                                         Grid.RowSpan="4"
                                         Background="{DynamicResource MaterialDesignPaper}"
                                         Visibility="{Binding IsWgSettingsOpen, Converter={StaticResource BoolToVis}}"
                                         materialDesign:ElevationAssist.Elevation="Dp8">
                        <Grid Margin="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding ToggleWgSettingsCommand}">
                                    <materialDesign:PackIcon Kind="ArrowLeft" />
                                </Button>
                                <TextBlock Text="VPN 高级设置" Style="{StaticResource TextHeadline}" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="1">
                                <TextBox materialDesign:HintAssist.Hint="服务器 Endpoint (IP:Port)"
                                         Text="{Binding WgEndpoint}"
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                         Margin="{StaticResource ThicknessFieldRow}" />
                                <TextBox materialDesign:HintAssist.Hint="本地 Address (例如 10.0.0.2/32)"
                                         Text="{Binding WgAddress}"
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                         Margin="{StaticResource ThicknessFieldRow}" />
                                <TextBox materialDesign:HintAssist.Hint="服务器 Public Key"
                                         Text="{Binding WgServerPublicKey}"
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                         Margin="{StaticResource ThicknessFieldRow}" />

                                <TextBlock Text="点击生成后会自动回填主配置框，PrivateKey 仍需手动补充。"
                                           Style="{StaticResource TextCaption}"
                                           Foreground="#F59E0B"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Button Grid.Row="2"
                                    Content="生成并应用配置"
                                    Command="{Binding GenerateConfigCommand}"
                                    Style="{StaticResource PrimaryActionButton}"
                                    Height="38" />
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </Grid>

            <Grid Margin="16">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="System">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,8"
                        CornerRadius="{StaticResource CornerRadiusCard}"
                        Padding="12,8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#F43F5E" Offset="0" />
                                    <GradientStop Color="#F59E0B" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <materialDesign:PackIcon Kind="Tools" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="系统优化" Style="{StaticResource TextHeadline}" />
                            <TextBlock Text="执行白名单维护与优化任务" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <materialDesign:Card Padding="14,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="锁定 Windows 10 版本 (22H2)" Style="{StaticResource TextSubtitle}" FontWeight="Bold" />
                                    <TextBlock Text="防止系统自动升级到 Windows 11 或更高版本，适用于希望继续停留在 Win10 22H2 的用户。"
                                               Style="{StaticResource TextCaption}"
                                               FontSize="12"
                                               Opacity="0.6"
                                               TextWrapping="Wrap"
                                               Margin="0,3,18,0" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Width="86"
                                        Height="32"
                                        Content="执行锁定"
                                        Command="{Binding LockWin10Command}"
                                        Style="{StaticResource PrimaryActionButton}" />
                            </Grid>
                        </materialDesign:Card>

                        <materialDesign:Card Padding="14,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Windows Defender 实时防护"
                                                   Style="{StaticResource TextSubtitle}"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center" />
                                        <Border Margin="8,0,0,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource BadgeSuccess}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDefenderEnabled}" Value="False">
                                                            <Setter Property="Background" Value="{DynamicResource BrushError}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Foreground="White" FontWeight="Bold" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="防护中" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDefenderEnabled}" Value="False">
                                                                <Setter Property="Text" Value="已关闭" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="关闭或恢复 Windows 安全中心的实时防护。Win11 需先在安全中心手动关闭「篡改保护」，否则命令将被拒绝。"
                                               Style="{StaticResource TextCaption}"
                                               FontSize="12"
                                               Opacity="0.6"
                                               TextWrapping="Wrap"
                                               Margin="0,0,18,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Width="86" Height="32" Margin="0,0,6,0" Command="{Binding ToggleDefenderCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource GhostActionButton}">
                                                <Setter Property="Content" Value="关闭防护" />
                                                <Setter Property="Foreground" Value="#C62828" />
                                                <Setter Property="BorderBrush" Value="#C62828" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDefenderEnabled}" Value="False">
                                                        <Setter Property="Content" Value="恢复防护" />
                                                        <Setter Property="Foreground" Value="#2E7D32" />
                                                        <Setter Property="BorderBrush" Value="#2E7D32" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Width="32"
                                            Height="32"
                                            Command="{Binding RefreshSystemStatusCommand}"
                                            ToolTip="刷新状态">
                                        <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>

                        <materialDesign:Card Padding="14,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Windows 自动更新"
                                                   Style="{StaticResource TextSubtitle}"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center" />
                                        <Border Margin="8,0,0,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource BadgeInfo}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAutoUpdateEnabled}" Value="False">
                                                            <Setter Property="Background" Value="{DynamicResource BrushWarning}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Foreground="White" FontWeight="Bold" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="自动更新中" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAutoUpdateEnabled}" Value="False">
                                                                <Setter Property="Text" Value="已停止" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="停止 Windows 后台自动更新，或手动触发立即检查并安装所有可用更新（以前台最高优先级下载安装，速度最快）。"
                                               Style="{StaticResource TextCaption}"
                                               FontSize="12"
                                               Opacity="0.6"
                                               TextWrapping="Wrap"
                                               Margin="0,0,18,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,0">
                                    <Button Width="86" Height="32" Margin="0,0,0,6" Command="{Binding ToggleAutoUpdateCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource GhostActionButton}">
                                                <Setter Property="Content" Value="停止更新" />
                                                <Setter Property="Foreground" Value="#C62828" />
                                                <Setter Property="BorderBrush" Value="#C62828" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAutoUpdateEnabled}" Value="False">
                                                        <Setter Property="Content" Value="恢复更新" />
                                                        <Setter Property="Foreground" Value="#1565C0" />
                                                        <Setter Property="BorderBrush" Value="#1565C0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Width="86"
                                            Height="32"
                                            Content="立即更新"
                                            Command="{Binding TriggerUpdateNowCommand}"
                                            Style="{StaticResource PrimaryActionButton}" />
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>

                        <TextBlock Text="{Binding SystemStatusMessage}"
                                   Style="{StaticResource TextCaption}"
                                   Opacity="0.7"
                                   TextWrapping="Wrap"
                                   Margin="4,0,0,8" />

                        <materialDesign:Card Padding="14,10" Margin="0,0,0,8" Background="{DynamicResource PrimaryHueLightBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="温馨提示" Style="{StaticResource TextSubtitle}" Foreground="White" FontWeight="Bold" Margin="0,0,14,0" />
                                <TextBlock Text="部分优化操作需要管理员权限，执行过程中请留意系统弹出的 UAC 授权窗口。"
                                           Grid.Column="1"
                                           Style="{StaticResource TextCaption}"
                                           FontSize="12"
                                           Foreground="White"
                                           Opacity="0.9"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </materialDesign:Card>

                        <materialDesign:Card Padding="14,10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="自动优化与报告"
                                           Style="{StaticResource TextSubtitle}"
                                           FontWeight="Bold" />
                                <TextBlock Text="按白名单步骤自动执行系统优化，完成后自动生成可追溯报告。"
                                           Style="{StaticResource TextCaption}"
                                           FontSize="12"
                                           Opacity="0.65"
                                           Margin="0,3,0,8"
                                           TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="开始自动优化"
                                            Height="32"
                                            Style="{StaticResource PrimaryActionButton}"
                                            Command="{Binding StartAutoOptimizeCommand}" />
                                    <ProgressBar Width="22" Height="22"
                                                 Margin="10,0,0,0"
                                                 IsIndeterminate="True"
                                                 Visibility="{Binding IsAutoOptimizeBusy, Converter={StaticResource BoolToVis}}"
                                                 Style="{StaticResource MaterialDesignCircularProgressBar}" />
                                </StackPanel>
                                <TextBlock Text="{Binding AutoOptimizeStatusMessage}"
                                           Style="{StaticResource TextCaption}"
                                           Margin="0,6,0,6"
                                           TextWrapping="Wrap" />

                                <DataGrid ItemsSource="{Binding OptimizationReports}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          SelectionMode="Single"
                                          MinHeight="120"
                                          MaxHeight="220"
                                          VerticalScrollBarVisibility="Auto"
                                          GridLinesVisibility="Horizontal"
                                          HeadersVisibility="Column"
                                          Margin="0,0,0,6">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="选择" Width="58">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="时间"
                                                            Width="165"
                                                            Binding="{Binding StartedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" />
                                        <DataGridTextColumn Header="类型" Width="92" Binding="{Binding ReportTypeDisplay}" />
                                        <DataGridTextColumn Header="释放空间" Width="120" Binding="{Binding TotalBytesFreedDisplay}" />
                                        <DataGridTextColumn Header="摘要" Width="*" Binding="{Binding Summary}" />
                                        <DataGridTemplateColumn Header="详情" Width="78">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="查看"
                                                            Padding="8,2"
                                                            Command="{Binding DataContext.ShowReportDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Button Content="删除选中"
                                        Width="96"
                                        Height="32"
                                        HorizontalAlignment="Right"
                                        Command="{Binding DeleteSelectedReportsCommand}" />
                            </StackPanel>
                        </materialDesign:Card>

                        <materialDesign:Card Padding="14,10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="垃圾清理"
                                           Style="{StaticResource TextSubtitle}"
                                           FontWeight="Bold" />
                                <TextBlock Text="扫描并清理白名单目录中的临时垃圾文件，执行前会进行二次确认。"
                                           Style="{StaticResource TextCaption}"
                                           FontSize="12"
                                           Opacity="0.65"
                                           Margin="0,3,0,8"
                                           TextWrapping="Wrap" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="开始扫描"
                                            Height="32"
                                            Style="{StaticResource PrimaryActionButton}"
                                            Command="{Binding StartJunkScanCommand}" />
                                    <Button Content="立即清理"
                                            Height="32"
                                            Margin="8,0,0,0"
                                            Command="{Binding RunJunkCleanupCommand}" />
                                    <ProgressBar Width="22" Height="22"
                                                 Margin="10,0,0,0"
                                                 IsIndeterminate="True"
                                                 Visibility="{Binding IsJunkBusy, Converter={StaticResource BoolToVis}}"
                                                 Style="{StaticResource MaterialDesignCircularProgressBar}" />
                                </StackPanel>

                                <TextBlock Text="{Binding JunkStatusMessage}"
                                           Style="{StaticResource TextCaption}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,6" />

                                <DataGrid ItemsSource="{Binding JunkCandidates}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          MinHeight="110"
                                          MaxHeight="210"
                                          VerticalScrollBarVisibility="Auto"
                                          GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="选择" Width="58">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="类别" Width="125" Binding="{Binding Category}" />
                                        <DataGridTextColumn Header="路径" Width="*" Binding="{Binding Path}" />
                                        <DataGridTextColumn Header="体积" Width="120" Binding="{Binding BytesDisplay}" />
                                        <DataGridTextColumn Header="说明" Width="230" Binding="{Binding Reason}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </materialDesign:Card>

                        <materialDesign:Card Padding="14,10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="微信清理"
                                           Style="{StaticResource TextSubtitle}"
                                           FontWeight="Bold" />
                                <TextBlock Text="微信运行中清理可能导致部分图片/视频缩略图丢失，建议先关闭微信后再清理。"
                                           Foreground="#C62828"
                                           Style="{StaticResource TextCaption}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,8" />

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <DatePicker Grid.Column="0" SelectedDate="{Binding WeChatCleanupStartDate}" />
                                    <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Text="~" />
                                    <DatePicker Grid.Column="2" SelectedDate="{Binding WeChatCleanupEndDate}" />
                                    <ComboBox Grid.Column="3" Margin="12,0,0,0"
                                              ItemsSource="{Binding WeChatRoots}"
                                              SelectedItem="{Binding SelectedWeChatRoot}"
                                              DisplayMemberPath="WxIdOrUserName" />
                                </Grid>

                                <WrapPanel Margin="0,0,0,6">
                                    <CheckBox Content="文字" IsChecked="{Binding WeChatCleanupIncludeText}" Margin="0,0,10,4" />
                                    <CheckBox Content="图像" IsChecked="{Binding WeChatCleanupIncludeImage}" Margin="0,0,10,4" />
                                    <CheckBox Content="视频" IsChecked="{Binding WeChatCleanupIncludeVideo}" Margin="0,0,10,4" />
                                    <CheckBox Content="语音" IsChecked="{Binding WeChatCleanupIncludeVoice}" Margin="0,0,10,4" />
                                    <CheckBox Content="其它文件" IsChecked="{Binding WeChatCleanupIncludeFile}" Margin="0,0,10,4" />
                                    <CheckBox Content="缓存" IsChecked="{Binding WeChatCleanupIncludeCache}" Margin="0,0,10,4" />
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="扫描" Height="32" Command="{Binding ScanWeChatCleanupCommand}" Style="{StaticResource PrimaryActionButton}" />
                                    <Button Content="开始清理" Height="32" Margin="8,0,0,0" Command="{Binding StartWeChatCleanupCommand}" />
                                    <ProgressBar Width="22" Height="22"
                                                 Margin="10,0,0,0"
                                                 IsIndeterminate="True"
                                                 Visibility="{Binding IsWeChatCleanupBusy, Converter={StaticResource BoolToVis}}"
                                                 Style="{StaticResource MaterialDesignCircularProgressBar}" />
                                </StackPanel>

                                <TextBlock Text="{Binding WeChatCleanupStatusMessage}"
                                           Style="{StaticResource TextCaption}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,6" />

                                <DataGrid ItemsSource="{Binding WeChatCleanupCandidates}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          MinHeight="120"
                                          MaxHeight="220"
                                          VerticalScrollBarVisibility="Auto"
                                          GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="选择" Width="58">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="类别" Width="100" Binding="{Binding Category}" />
                                        <DataGridTextColumn Header="时间" Width="160" Binding="{Binding LastWriteTime, StringFormat=yyyy-MM-dd HH:mm:ss}" />
                                        <DataGridTextColumn Header="体积" Width="110" Binding="{Binding BytesDisplay}" />
                                        <DataGridTextColumn Header="路径" Width="*" Binding="{Binding Path}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </materialDesign:Card>

                        <materialDesign:Card Padding="14,10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="微信备份"
                                           Style="{StaticResource TextSubtitle}"
                                           FontWeight="Bold" />
                                <TextBlock Text="按日期和类别备份为单个 ZIP，包含 manifest.json 与 SHA256 校验信息。"
                                           Style="{StaticResource TextCaption}"
                                           FontSize="12"
                                           Opacity="0.65"
                                           Margin="0,3,0,8"
                                           TextWrapping="Wrap" />

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <DatePicker Grid.Column="0" SelectedDate="{Binding WeChatBackupStartDate}" />
                                    <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Text="~" />
                                    <DatePicker Grid.Column="2" SelectedDate="{Binding WeChatBackupEndDate}" />
                                    <ComboBox Grid.Column="3" Margin="12,0,0,0"
                                              ItemsSource="{Binding WeChatRoots}"
                                              SelectedItem="{Binding SelectedWeChatRoot}"
                                              DisplayMemberPath="WxIdOrUserName" />
                                </Grid>

                                <WrapPanel Margin="0,0,0,6">
                                    <CheckBox Content="文字" IsChecked="{Binding WeChatBackupIncludeText}" Margin="0,0,10,4" />
                                    <CheckBox Content="图像" IsChecked="{Binding WeChatBackupIncludeImage}" Margin="0,0,10,4" />
                                    <CheckBox Content="视频" IsChecked="{Binding WeChatBackupIncludeVideo}" Margin="0,0,10,4" />
                                    <CheckBox Content="语音" IsChecked="{Binding WeChatBackupIncludeVoice}" Margin="0,0,10,4" />
                                    <CheckBox Content="其它文件" IsChecked="{Binding WeChatBackupIncludeFile}" Margin="0,0,10,4" />
                                    <CheckBox Content="缓存" IsChecked="{Binding WeChatBackupIncludeCache}" Margin="0,0,10,4" />
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="选择保存目录"
                                            Height="32"
                                            Command="{Binding SelectWeChatBackupOutputFolderCommand}"
                                            Style="{StaticResource GhostActionButton}" />
                                    <Button Content="开始备份"
                                            Height="32"
                                            Margin="8,0,0,0"
                                            Command="{Binding StartWeChatBackupCommand}"
                                            Style="{StaticResource PrimaryActionButton}" />
                                    <ProgressBar Width="22" Height="22"
                                                 Margin="10,0,0,0"
                                                 IsIndeterminate="True"
                                                 Visibility="{Binding IsWeChatBackupBusy, Converter={StaticResource BoolToVis}}"
                                                 Style="{StaticResource MaterialDesignCircularProgressBar}" />
                                </StackPanel>

                                <TextBlock Text="{Binding WeChatBackupOutputFolder}"
                                           Style="{StaticResource TextCaption}"
                                           Opacity="0.75"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding WeChatBackupStatusMessage}"
                                           Style="{StaticResource TextCaption}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </materialDesign:Card>

                        <materialDesign:Card Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="微信恢复"
                                           Style="{StaticResource TextSubtitle}"
                                           FontWeight="Bold" />
                                <TextBlock Text="从备份 ZIP 读取 manifest 后恢复到原路径或自定义目录；同名文件自动改名防覆盖。"
                                           Style="{StaticResource TextCaption}"
                                           FontSize="12"
                                           Opacity="0.65"
                                           Margin="0,3,0,8"
                                           TextWrapping="Wrap" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="选择备份文件"
                                            Height="32"
                                            Command="{Binding SelectWeChatRestoreZipCommand}"
                                            Style="{StaticResource GhostActionButton}" />
                                    <Button Content="选择恢复目录"
                                            Height="32"
                                            Margin="8,0,0,0"
                                            Command="{Binding SelectWeChatRestoreTargetRootCommand}"
                                            IsEnabled="{Binding RestoreToCustom}"
                                            Style="{StaticResource GhostActionButton}" />
                                    <Button Content="开始恢复"
                                            Height="32"
                                            Margin="8,0,0,0"
                                            Command="{Binding StartWeChatRestoreCommand}"
                                            Style="{StaticResource PrimaryActionButton}" />
                                    <ProgressBar Width="22" Height="22"
                                                 Margin="10,0,0,0"
                                                 IsIndeterminate="True"
                                                 Visibility="{Binding IsWeChatRestoreBusy, Converter={StaticResource BoolToVis}}"
                                                 Style="{StaticResource MaterialDesignCircularProgressBar}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <RadioButton Content="恢复到原微信目录"
                                                  IsChecked="{Binding RestoreToOriginal, Mode=TwoWay}"
                                                  GroupName="RestoreMode"
                                                  Margin="0,0,16,0" />
                                    <RadioButton Content="恢复到自定义目录"
                                                 IsChecked="{Binding RestoreToCustom, Mode=TwoWay}"
                                                 GroupName="RestoreMode" />
                                </StackPanel>

                                <TextBlock Text="{Binding WeChatRestoreZipPath}"
                                           Style="{StaticResource TextCaption}"
                                           Opacity="0.75"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding WeChatRestoreTargetRoot}"
                                           Style="{StaticResource TextCaption}"
                                           Opacity="0.75"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding WeChatRestoreManifestSummary}"
                                           Style="{StaticResource TextCaption}"
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding WeChatRestoreStatusMessage}"
                                           Style="{StaticResource TextCaption}"
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid Margin="20">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="SqlExport">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,20"
                        CornerRadius="{StaticResource CornerRadiusCard}"
                        Padding="20,16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <Border DockPanel.Dock="Right"
                                Margin="16,0,0,0"
                                Padding="8,3"
                                CornerRadius="12"
                                Background="#1F1976D2"
                                VerticalAlignment="Center">
                            <TextBlock Text="SQL Server / PostgreSQL / MySQL" Foreground="#1976D2" FontWeight="SemiBold" />
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource BrushBlueGradient}" Margin="0,0,10,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="DatabaseArrowDown" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SQL 导出工具" Style="{StaticResource TextHeadline}" />
                                <TextBlock Text="批量导出数据库表到 .xlsx" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <materialDesign:Card Padding="12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.7*" />
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="1.25*" />
                                <ColumnDefinition Width="1.25*" />
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Row="0"
                                      Grid.Column="0"
                                      Margin="0,0,8,6"
                                      ItemsSource="{Binding SqlProviderOptions}"
                                      SelectedValuePath="Kind"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValue="{Binding SelectedSqlProvider, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                      materialDesign:HintAssist.Hint="数据库类型" />

                            <ComboBox Grid.Row="0"
                                      Grid.Column="1"
                                      Margin="0,0,8,6"
                                      IsEditable="True"
                                      IsReadOnly="False"
                                      IsTextSearchEnabled="False"
                                      StaysOpenOnEdit="True"
                                      ItemsSource="{Binding SqlServerAddressHistory}"
                                      Text="{Binding SqlServerAddress, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                      materialDesign:HintAssist.Hint="服务器地址或 IP" />

                            <TextBox Grid.Row="0"
                                     Grid.Column="2"
                                     Margin="0,0,8,6"
                                     Text="{Binding SqlPort, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     materialDesign:HintAssist.Hint="{Binding SqlPortHint}" />

                            <ComboBox Grid.Row="0"
                                      Grid.Column="3"
                                      Margin="0,0,8,6"
                                      IsEditable="True"
                                      IsTextSearchEnabled="False"
                                      ItemsSource="{Binding SqlUsernameHistory}"
                                      Text="{Binding SqlUsername, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                      materialDesign:HintAssist.Hint="用户名" />

                            <Grid Grid.Row="0"
                                  Grid.Column="4"
                                  Margin="0,0,0,6">
                                <PasswordBox x:Name="SqlPasswordBox"
                                             Padding="0,0,38,0"
                                             Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                                             materialDesign:HintAssist.Hint="密码"
                                             PasswordChanged="SqlPasswordBox_OnPasswordChanged" />
                                <Button x:Name="SqlPasswordHistoryButton"
                                        Width="32"
                                        Height="32"
                                        Margin="0,18,0,0"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Click="SqlPasswordHistoryButton_OnClick"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="选择历史密码">
                                    <materialDesign:PackIcon Width="20" Height="20" Kind="ChevronDown" />
                                    <Button.ContextMenu>
                                        <ContextMenu ItemsSource="{Binding PlacementTarget.DataContext.SqlPasswordHistory, RelativeSource={RelativeSource Self}}"
                                                     materialDesign:MenuAssist.TopLevelMenuItemHeight="36">
                                            <ContextMenu.ItemContainerStyle>
                                                <Style TargetType="MenuItem">
                                                    <Setter Property="Header" Value="••••••••" />
                                                    <Setter Property="ToolTip" Value="使用此历史密码" />
                                                    <EventSetter Event="Click" Handler="SqlPasswordHistoryMenuItem_OnClick" />
                                                </Style>
                                            </ContextMenu.ItemContainerStyle>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </Grid>

                            <ComboBox Grid.Row="1"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="2"
                                      Margin="0,0,8,6"
                                      ItemsSource="{Binding SqlDatabaseList}"
                                      SelectedItem="{Binding SelectedSqlDatabase}"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource MaterialDesignFilledComboBox}"
                                      materialDesign:HintAssist.Hint="数据库" />

                            <ComboBox Grid.Row="1"
                                      Grid.Column="2"
                                      Grid.ColumnSpan="2"
                                      Margin="0,0,8,6"
                                      IsEditable="True"
                                      IsTextSearchEnabled="False"
                                      StaysOpenOnEdit="True"
                                      ItemsSource="{Binding FilteredSqlTableView}"
                                      SelectedItem="{Binding SelectedSqlTable, UpdateSourceTrigger=PropertyChanged}"
                                      Text="{Binding SqlTableSearchText, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="DisplayName"
                                      Style="{StaticResource MaterialDesignFilledComboBox}"
                                      materialDesign:HintAssist.Hint="数据表" />

                            <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal">
                                <Button Width="88"
                                        Height="34"
                                        Margin="0,0,8,0"
                                        Command="{Binding TestSqlConnectionCommand}"
                                        Style="{StaticResource PrimaryActionButton}"
                                        Content="测试连接" />

                                <Button Width="104"
                                        Height="34"
                                        Command="{Binding ExportSqlTableCommand}"
                                        Style="{StaticResource SuccessActionButton}"
                                        Content="导出为 Excel" />
                            </StackPanel>

                            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource BadgeInfo}" Padding="8,2">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="InformationOutline" Width="12" Height="12" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding SqlStatusMessage}" TextWrapping="Wrap" FontSize="12" />
                                    </StackPanel>
                                </Border>

                                <ProgressBar Grid.Column="1"
                                             Width="140"
                                             Height="5"
                                             Margin="12,0,0,0"
                                             VerticalAlignment="Center"
                                             IsIndeterminate="True"
                                             Visibility="{Binding IsSqlBusy, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Grid>
                    </materialDesign:Card>

                    <TabControl Grid.Row="1"
                                Style="{StaticResource MaterialDesignTabControl}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                MinHeight="260"
                                materialDesign:ColorZoneAssist.Mode="PrimaryMid">

                        <TabItem Header="使用说明">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <materialDesign:Card Padding="14" Margin="0,6,0,0">
                                    <StackPanel>
                                        <TextBlock Text="使用说明" Style="{StaticResource TextSubtitle}" FontWeight="Bold" />
                                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                                            支持 SQL Server / PostgreSQL / MySQL 账号密码连接。流程：测试连接 → 选择数据库 → 选择表 → 导出整表。
                                        </TextBlock>
                                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap">
                                            SQL 查询标签页支持执行任意查询语句，结果可直接导出 Excel。
                                        </TextBlock>
                                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap">
                                            目标表超过 Excel 单工作表上限 1,048,576 行时，程序会阻止导出并给出提示。
                                        </TextBlock>
                                    </StackPanel>
                                </materialDesign:Card>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="SQL 查询">
                            <Grid Margin="0,6,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <materialDesign:Card Grid.Row="0" Padding="8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="72" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox Grid.Row="0"
                                                 Text="{Binding SqlQueryText, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="NoWrap"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 VerticalScrollBarVisibility="Auto"
                                                 FontFamily="Consolas"
                                                 FontSize="12"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 materialDesign:HintAssist.Hint="输入 SQL 语句，例如：SELECT * FROM schema.table LIMIT 100" />

                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                                            <Button Width="100" Height="32"
                                                    Margin="0,0,8,0"
                                                    Content="执行查询"
                                                    Command="{Binding ExecuteSqlQueryCommand}"
                                                    Style="{StaticResource PrimaryActionButton}">
                                                <Button.ContentTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="Play" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </Button.ContentTemplate>
                                            </Button>
                                            <Button Width="116" Height="32"
                                                    Margin="0,0,12,0"
                                                    Content="导出结果"
                                                    Command="{Binding ExportQueryResultCommand}"
                                                    Style="{StaticResource GhostActionButton}">
                                                <Button.ContentTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="FileExcel" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </Button.ContentTemplate>
                                            </Button>
                                            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                         IsIndeterminate="True"
                                                         Width="18" Height="18"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,10,0"
                                                         Visibility="{Binding IsQueryBusy, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding QueryStatusMessage}"
                                                       Style="{StaticResource TextCaption}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Opacity="0.7" />
                                        </StackPanel>
                                    </Grid>
                                </materialDesign:Card>

                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding SqlQueryResult}"
                                          AutoGenerateColumns="True"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserSortColumns="True"
                                          MinHeight="180"
                                          VerticalScrollBarVisibility="Visible"
                                          HorizontalScrollBarVisibility="Auto"
                                          SelectionMode="Extended"
                                          Style="{StaticResource MaterialDesignDataGrid}"
                                          materialDesign:DataGridAssist.CellPadding="8 4 8 4"
                                          materialDesign:DataGridAssist.ColumnHeaderPadding="8 4 8 4" />
                            </Grid>
                        </TabItem>

                    </TabControl>
                </Grid>
            </Grid>

            <!-- Screenshot Settings panel -->
            <Grid Margin="20">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="Screenshot">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,20"
                        CornerRadius="{StaticResource CornerRadiusCard}"
                        Padding="20,16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,0"
                                        Visibility="{Binding HasAudioRecordingIndicator, Converter={StaticResource BoolToVis}}">
                                <Ellipse Width="8" Height="8" Fill="#E53935" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding AudioRecordingIndicator}" Foreground="#C62828" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Style="{StaticResource PrimaryActionButton}"
                                    Command="{Binding TakeScreenshotNowCommand}"
                                    Margin="0,0,8,0"
                                    Height="36" Padding="12,0"
                                    ToolTip="立即截图">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Camera" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="立即截图"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostActionButton}"
                                    Command="{Binding StartVideoRecordingCommand}"
                                    Margin="0,0,8,0"
                                    Height="36" Padding="12,0"
                                    ToolTip="开启区域录像">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="RecordRec" Width="16" Height="16" Margin="0,0,6,0" Foreground="#E53935" />
                                    <TextBlock Text="开启录像"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostActionButton}"
                                    Command="{Binding ToggleAudioRecordingCommand}"
                                    Margin="0,0,8,0"
                                    Height="36" Padding="12,0"
                                    ToolTip="开启或停止录音">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="Microphone" />
                                                <Setter Property="Foreground" Value="#E53935" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAudioRecording}" Value="True">
                                                        <Setter Property="Kind" Value="StopCircle" />
                                                        <Setter Property="Foreground" Value="#757575" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                    <TextBlock VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="开启录音" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAudioRecording}" Value="True">
                                                        <Setter Property="Text" Value="停止录音" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostActionButton}"
                                    Command="{Binding EditClipboardImageCommand}"
                                    Height="36" Padding="12,0"
                                    ToolTip="打开编辑器编辑剪贴板中的图片">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ImageEdit" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="编辑剪贴板截图"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BrushAccentGradient}" Margin="0,0,12,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="CameraIris" Width="18" Height="18" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="截图工具" Style="{StaticResource TextHeadline}" />
                                <TextBlock Text="全屏截图 · 区域录像 · 独立录音" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Hotkey card -->
                        <materialDesign:Card Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="快捷键设置" Style="{StaticResource TextSubtitle}" FontWeight="Bold" Margin="0,0,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" BorderBrush="{DynamicResource MaterialDesignDivider}"
                                            BorderThickness="1" CornerRadius="4" Padding="14,10"
                                            Margin="0,0,12,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource MaterialDesignTextFieldBoxBackground}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCapturingHotkey}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Keyboard" Width="18" Height="18"
                                                                     VerticalAlignment="Center" Margin="0,0,10,0"
                                                                     Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                            <TextBlock VerticalAlignment="Center" FontSize="14">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding ScreenshotHotkeyText}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
                                                        <Setter Property="FontWeight" Value="Medium"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCapturingHotkey}" Value="True">
                                                                <Setter Property="Text" Value="请按下新快捷键组合..."/>
                                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                                <Setter Property="FontWeight" Value="Normal"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Height="42" Padding="14,0" Margin="0,0,8,0"
                                                Command="{Binding StartCaptureHotkeyCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource GhostActionButton}">
                                                    <Setter Property="Content" Value="修改快捷键"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCapturingHotkey}" Value="True">
                                                            <Setter Property="Content" Value="监听中..."/>
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="取消" Height="42" Padding="14,0"
                                                Command="{Binding CancelCaptureHotkeyCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource GhostActionButton}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCapturingHotkey}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="注意：快捷键需包含 Ctrl 或 Alt 之一，避免与系统快捷键冲突。快捷键在全局生效，包括窗口隐藏期间。"
                                           Style="{StaticResource TextCaption}"
                                           Opacity="0.55" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Behavior card -->
                        <materialDesign:Card Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="截图行为" Style="{StaticResource TextSubtitle}" FontWeight="Bold" Margin="0,0,0,12"/>

                                <TextBlock Text="截图范围" FontWeight="Medium" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <RadioButton GroupName="ScreenshotMode" Content="全屏" Margin="0,0,18,0"
                                                 IsChecked="{Binding IsScreenshotModeFullScreen}" />
                                    <RadioButton GroupName="ScreenshotMode" Content="划区域" Margin="0,0,18,0"
                                                 IsChecked="{Binding IsScreenshotModeRegion}" />
                                    <RadioButton GroupName="ScreenshotMode" Content="当前窗口"
                                                 IsChecked="{Binding IsScreenshotModeWindow}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource TextCaption}" Opacity="0.6" Margin="0,0,0,14" TextWrapping="Wrap"
                                           Text="全屏：直接截整个虚拟屏幕；划区域：弹出半透明蒙层让你拖动选区，Esc 取消；当前窗口：截按下快捷键时位于最前的那个窗口。" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding ShowEditorAfterCapture}"
                                              VerticalAlignment="Top"
                                              Margin="0,2,12,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="截图后打开编辑器"
                                                   Style="{StaticResource TextSubtitle}"
                                                   FontWeight="Medium"/>
                                        <TextBlock Margin="0,4,20,0" Opacity="0.6" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                                                    <Setter Property="Text" Value="截图后弹出编辑器进行标注；关闭编辑器时自动把编辑后的图写入剪贴板。"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowEditorAfterCapture}" Value="False">
                                                            <Setter Property="Text" Value="截图后直接写入剪贴板，不弹编辑器。"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Save button -->
                        <Button Style="{StaticResource PrimaryActionButton}"
                                Command="{Binding SaveScreenshotSettingsCommand}"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveOutline" Width="15" Height="15" Margin="0,0,6,0"/>
                                <TextBlock Text="保存设置"/>
                            </StackPanel>
                        </Button>

                        <!-- File Hash Calculator -->
                        <materialDesign:Card Padding="14,12" Margin="0,14,0,0">
                            <StackPanel>
                                <StackPanel Style="{StaticResource SectionHeaderRow}">
                                    <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource BrushBlueGradient}" Margin="0,0,10,0">
                                        <materialDesign:PackIcon Kind="ShieldKey" Width="14" Height="14" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="文件哈希校验" Style="{StaticResource TextSubtitle}" />
                                        <TextBlock Text="{Binding FileHashStatusMessage}" Style="{StaticResource TextHint}" Margin="0,1,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <Button Style="{StaticResource GhostActionButton}"
                                        Command="{Binding ComputeFileHashCommand}"
                                        HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileSearch" Width="14" Height="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="选择文件并计算"/>
                                    </StackPanel>
                                </Button>

                                <Border Background="{DynamicResource MaterialDesignToolBarBackground}"
                                        CornerRadius="6" Padding="10,8" Margin="0,8,0,0"
                                        Visibility="{Binding FileHashResult, Converter={StaticResource StringNotEmptyToVisibility}}"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="FileHashResult_OnClick">
                                    <TextBlock Text="{Binding FileHashResult}" Style="{StaticResource TextMonoCode}"
                                               ToolTip="点击复制到剪贴板" />
                                </Border>
                            </StackPanel>
                        </materialDesign:Card>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Codex config profiles panel -->
            <Grid Margin="16">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="CodexProfiles">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,8"
                        CornerRadius="{StaticResource CornerRadiusCard}"
                        Padding="12,8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimaryActionButton}"
                                    Height="32"
                                    Padding="10,0"
                                    Command="{Binding ImportCodexProfileCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Import" Width="15" Height="15" Margin="0,0,5,0" />
                                    <TextBlock Text="导入" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource BrushTealGradient}" Margin="0,0,10,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="FolderCogOutline" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Codex 配置管理" Style="{StaticResource TextHeadline}" />
                                <TextBlock Text="一键切换 Codex 配置集" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,8"
                                Margin="0,0,0,8"
                                Background="{DynamicResource MaterialDesignPaper}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="拖入包含 config.toml 和 auth.json 的文件夹"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0" />
                                <Border Grid.Column="1" Style="{StaticResource BadgeInfo}" Padding="8,2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="InformationOutline" Width="12" Height="12" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding CodexProfilesStatusMessage}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding CodexProfiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <materialDesign:Card Padding="12,8" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <materialDesign:PackIcon Kind="FolderOutline"
                                                                             Width="16"
                                                                             Height="16"
                                                                             Margin="0,0,6,0"
                                                                             Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding FolderPath}"
                                                           FontSize="12"
                                                           Opacity="0.58"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding FolderPath}" />
                                                <TextBlock Text="{Binding ContentStorageSummary}"
                                                           FontSize="12"
                                                           Margin="0,2,0,0"
                                                           Opacity="0.72"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Style="{StaticResource BadgeInfo}" Margin="0,5,0,0" Padding="8,2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="InformationOutline" Width="12" Height="12" Margin="0,0,4,0" />
                                                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <TextBox Grid.Column="1"
                                                     Margin="0,0,12,0"
                                                     Height="42"
                                                     MinWidth="220"
                                                     VerticalAlignment="Center"
                                                     Text="{Binding Remark, UpdateSourceTrigger=LostFocus}"
                                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                     materialDesign:HintAssist.Hint="备注" />

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                             IsIndeterminate="True"
                                                             Width="18"
                                                             Height="18"
                                                             Margin="0,0,8,0"
                                                             Visibility="{Binding IsApplying, Converter={StaticResource BoolToVis}}" />
                                                <Button Style="{StaticResource GhostActionButton}"
                                                        Height="32"
                                                        Padding="8,0"
                                                        Margin="0,0,6,0"
                                                        ToolTip="查看 / 编辑 config.toml"
                                                        Command="{Binding DataContext.EditCodexConfigTomlCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="FileDocumentEditOutline" Width="14" Height="14" Margin="0,0,5,0"/>
                                                        <TextBlock Text="config.toml"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource GhostActionButton}"
                                                        Height="32"
                                                        Padding="8,0"
                                                        Margin="0,0,6,0"
                                                        ToolTip="查看 / 编辑 auth.json"
                                                        Command="{Binding DataContext.EditCodexAuthJsonCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="KeyOutline" Width="14" Height="14" Margin="0,0,5,0"/>
                                                        <TextBlock Text="auth.json"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Height="32"
                                                        Padding="10,0"
                                                        Margin="0,0,6,0"
                                                        Command="{Binding DataContext.ApplyCodexProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource PrimaryActionButton}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Check" Width="15" Height="15" Margin="0,0,5,0"/>
                                                        <TextBlock Text="应用"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource GhostActionButton}"
                                                        Height="32"
                                                        Padding="10,0"
                                                        Margin="0,0,6,0"
                                                        Command="{Binding DataContext.ExportCodexProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Export" Width="15" Height="15" Margin="0,0,5,0"/>
                                                        <TextBlock Text="导出"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Height="32"
                                                        Width="32"
                                                        Padding="0"
                                                        Command="{Binding DataContext.DeleteCodexProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignIconButton}"
                                                        ToolTip="删除记录">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="17" Height="17"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </materialDesign:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- System Info module -->
            <Grid Margin="16">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="SystemInfo">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Margin="0,0,0,12"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="{StaticResource CornerRadiusCard}"
                        Padding="12,8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostActionButton}"
                                    Content="刷新硬件"
                                    Command="{Binding LoadSystemInfoCommand}"
                                    Margin="0,0,8,0" />
                            <Button Style="{StaticResource GhostActionButton}"
                                    Content="以管理员重启"
                                    Command="{Binding RestartAsAdminCommand}"
                                    Margin="0,0,8,0">
                                <Button.Visibility>
                                    <Binding Path="IsRunningAsAdmin" Converter="{StaticResource InverseBoolToVis}" />
                                </Button.Visibility>
                            </Button>
                            <Button Style="{StaticResource PrimaryActionButton}"
                                    Content="{Binding SensorsToggleLabel}"
                                    Command="{Binding ToggleHardwareSensorsCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource BrushBlueGradient}" Margin="0,0,10,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Chip" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="系统信息" Style="{StaticResource TextHeadline}" />
                                <TextBlock Text="{Binding SystemInfoStatusMessage}" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Hardware overview cards -->
                        <Grid Visibility="{Binding HasHardwareSummary, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- OS / Computer -->
                            <materialDesign:Card Grid.Row="0" Grid.Column="0" Padding="14,12" Margin="0,0,6,12">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource SectionHeaderRow}">
                                        <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource BrushBlueGradient}" Margin="0,0,8,0">
                                            <materialDesign:PackIcon Kind="MicrosoftWindows" Width="14" Height="14" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="系统与主板" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock><Run Text="计算机名：" FontWeight="SemiBold" /><Run Text="{Binding HardwareSummaryInfo.ComputerName}" /></TextBlock>
                                        <TextBlock><Run Text="操作系统：" FontWeight="SemiBold" /><Run Text="{Binding HardwareSummaryInfo.OsName}" /></TextBlock>
                                        <TextBlock><Run Text="版本：" FontWeight="SemiBold" /><Run Text="{Binding HardwareSummaryInfo.OsVersion}" /><Run Text=" · " /><Run Text="{Binding HardwareSummaryInfo.OsArchitecture}" /></TextBlock>
                                        <TextBlock><Run Text="制造商：" FontWeight="SemiBold" /><Run Text="{Binding HardwareSummaryInfo.Manufacturer}" /></TextBlock>
                                        <TextBlock><Run Text="型号：" FontWeight="SemiBold" /><Run Text="{Binding HardwareSummaryInfo.Model}" /></TextBlock>
                                        <TextBlock><Run Text="主板：" FontWeight="SemiBold" /><Run Text="{Binding HardwareSummaryInfo.MotherboardManufacturer}" /><Run Text=" " /><Run Text="{Binding HardwareSummaryInfo.MotherboardProduct}" /></TextBlock>
                                        <TextBlock><Run Text="BIOS：" FontWeight="SemiBold" /><Run Text="{Binding HardwareSummaryInfo.BiosVersion}" /><Run Text=" · " /><Run Text="{Binding HardwareSummaryInfo.BiosDate}" /></TextBlock>
                                        <TextBlock><Run Text="运行时间：" FontWeight="SemiBold" /><Run Text="{Binding HardwareSummaryInfo.SystemUpTime}" /></TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- Memory total -->
                            <materialDesign:Card Grid.Row="0" Grid.Column="1" Padding="14,12" Margin="6,0,0,12">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource SectionHeaderRow}">
                                        <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource BrushTealGradient}" Margin="0,0,8,0">
                                            <materialDesign:PackIcon Kind="Memory" Width="14" Height="14" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="内存" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                                        <TextBlock Style="{StaticResource TextCaption}" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <Run Text="总容量：" /><Run Text="{Binding HardwareSummaryInfo.TotalMemoryGb}" FontWeight="SemiBold" />
                                        </TextBlock>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding HardwareSummaryInfo.MemoryModules}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource MaterialDesignToolBarBackground}" CornerRadius="6" Padding="8,6" Margin="0,0,0,4">
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource TextBodyStandard}">
                                                            <Run Text="{Binding BankLabel}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding CapacityGb}" /><Run Text=" · " /><Run Text="{Binding MemoryType}" /><Run Text=" · " /><Run Text="{Binding SpeedMhz}" /><Run Text=" MHz" />
                                                        </TextBlock>
                                                        <TextBlock Style="{StaticResource TextHint}">
                                                            <Run Text="{Binding Manufacturer}" /><Run Text=" · " /><Run Text="{Binding PartNumber}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- CPUs -->
                            <materialDesign:Card Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Padding="14,12" Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource SectionHeaderRow}">
                                        <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource BrushAccentGradient}" Margin="0,0,8,0">
                                            <materialDesign:PackIcon Kind="Cpu64Bit" Width="14" Height="14" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="处理器" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding HardwareSummaryInfo.Cpus}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource MaterialDesignToolBarBackground}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource TextSubtitle}" />
                                                        <TextBlock Style="{StaticResource TextCaption}">
                                                            <Run Text="厂商：" /><Run Text="{Binding Manufacturer}" />
                                                            <Run Text="  ·  插槽：" /><Run Text="{Binding Socket}" />
                                                        </TextBlock>
                                                        <TextBlock Style="{StaticResource TextCaption}">
                                                            <Run Text="物理核心：" /><Run Text="{Binding Cores}" FontWeight="SemiBold" />
                                                            <Run Text="  ·  逻辑处理器：" /><Run Text="{Binding LogicalProcessors}" FontWeight="SemiBold" />
                                                            <Run Text="  ·  最大频率：" /><Run Text="{Binding MaxClockMhz}" /><Run Text=" MHz" />
                                                            <Run Text="  ·  当前：" /><Run Text="{Binding CurrentClockMhz}" /><Run Text=" MHz" />
                                                        </TextBlock>
                                                        <TextBlock Style="{StaticResource TextHint}">
                                                            <Run Text="L2：" /><Run Text="{Binding L2CacheKb}" /><Run Text=" KB · L3：" /><Run Text="{Binding L3CacheKb}" /><Run Text=" KB" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- GPUs -->
                            <materialDesign:Card Grid.Row="2" Grid.Column="0" Padding="14,12" Margin="0,0,6,12">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource SectionHeaderRow}">
                                        <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource BrushAccentGradient}" Margin="0,0,8,0">
                                            <materialDesign:PackIcon Kind="VideoOutline" Width="14" Height="14" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="显卡" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding HardwareSummaryInfo.Gpus}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource MaterialDesignToolBarBackground}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource TextSubtitle}" />
                                                        <TextBlock Style="{StaticResource TextCaption}">
                                                            <Run Text="厂商：" /><Run Text="{Binding Manufacturer}" />
                                                            <Run Text="  ·  显存：" /><Run Text="{Binding AdapterRamGb}" FontWeight="SemiBold" />
                                                        </TextBlock>
                                                        <TextBlock Style="{StaticResource TextHint}">
                                                            <Run Text="驱动：" /><Run Text="{Binding DriverVersion}" /><Run Text=" · " /><Run Text="{Binding DriverDate}" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding VideoMode}" Style="{StaticResource TextHint}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- Disks -->
                            <materialDesign:Card Grid.Row="2" Grid.Column="1" Padding="14,12" Margin="6,0,0,12">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource SectionHeaderRow}">
                                        <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource BrushTealGradient}" Margin="0,0,8,0">
                                            <materialDesign:PackIcon Kind="Harddisk" Width="14" Height="14" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="存储" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding HardwareSummaryInfo.Disks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource MaterialDesignToolBarBackground}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Model}" Style="{StaticResource TextSubtitle}" />
                                                        <TextBlock Style="{StaticResource TextCaption}">
                                                            <Run Text="容量：" /><Run Text="{Binding SizeGb}" FontWeight="SemiBold" />
                                                            <Run Text="  ·  接口：" /><Run Text="{Binding InterfaceType}" />
                                                            <Run Text="  ·  介质：" /><Run Text="{Binding MediaType}" />
                                                        </TextBlock>
                                                        <TextBlock Style="{StaticResource TextHint}">
                                                            <Run Text="序列号：" /><Run Text="{Binding SerialNumber}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- Network adapters + Monitors -->
                            <materialDesign:Card Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Padding="14,12">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource SectionHeaderRow}">
                                        <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource BrushBlueGradient}" Margin="0,0,8,0">
                                            <materialDesign:PackIcon Kind="LanConnect" Width="14" Height="14" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="网络适配器与显示器" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding HardwareSummaryInfo.NetworkAdapters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource TextCaption}" Margin="0,0,0,2">
                                                    <Run Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <Run Text=" · MAC " /><Run Text="{Binding MacAddress}" />
                                                    <Run Text=" · " /><Run Text="{Binding LinkSpeed}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding HardwareSummaryInfo.Monitors}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource TextCaption}" Margin="0,0,0,2">
                                                    <Run Text="显示器：" FontWeight="SemiBold" />
                                                    <Run Text="{Binding Name}" />
                                                    <Run Text=" · " /><Run Text="{Binding Manufacturer}" />
                                                    <Run Text=" · " /><Run Text="{Binding Resolution}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </materialDesign:Card>
                        </Grid>

                        <!-- Sensors live readings -->
                        <materialDesign:Card Padding="14,12" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Style="{StaticResource SectionHeaderRow}">
                                    <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource BrushAccentGradient}" Margin="0,0,8,0">
                                        <materialDesign:PackIcon Kind="ThermometerLines" Width="14" Height="14" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="实时传感器" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource StatusPill}" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding SensorStatusMessage}" />
                                    </Border>
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding SensorReadings}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          MinHeight="180"
                                          MaxHeight="360">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="硬件" Binding="{Binding HardwareName}" Width="*" />
                                        <DataGridTextColumn Header="类型" Binding="{Binding HardwareKind}" Width="80" />
                                        <DataGridTextColumn Header="传感器" Binding="{Binding SensorName}" Width="*" />
                                        <DataGridTextColumn Header="种类" Binding="{Binding SensorKind}" Width="80" />
                                        <DataGridTextColumn Header="读数" Binding="{Binding Value}" Width="80" />
                                        <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="60" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="提示：温度/风扇/电压等需要 LibreHardwareMonitor 驱动权限，建议以管理员身份运行 MyTools 后再启用传感器。"
                                           Style="{StaticResource TextHint}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </materialDesign:Card>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- File Verify module -->
            <Grid Margin="16"
                  Background="Transparent"
                  AllowDrop="True"
                  DragEnter="FileVerify_OnDragOver"
                  DragOver="FileVerify_OnDragOver"
                  Drop="FileVerify_OnDrop">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="FileVerify">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Margin="0,0,0,12"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="{StaticResource CornerRadiusCard}"
                        Padding="12,8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimaryActionButton}"
                                    Command="{Binding VerifyFileCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileSearch" Width="14" Height="14" Margin="0,0,6,0" />
                                    <TextBlock Text="选择文件并校验" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource BrushTealGradient}" Margin="0,0,10,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="文件验证" Style="{StaticResource TextHeadline}" />
                                <TextBlock Text="{Binding FileHashStatusMessage}" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Margin="0,0,0,12" Padding="20,18" CornerRadius="8"
                                BorderThickness="2" BorderBrush="#5e72e4" Background="#F4F6FF">
                            <StackPanel HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="FileUploadOutline" Width="32" Height="32"
                                                         Foreground="#5e72e4" HorizontalAlignment="Center" />
                                <TextBlock Text="拖入文件到此处即可校验"
                                           FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="也可点击右上角【选择文件并校验】" FontSize="11" Opacity="0.6"
                                           Margin="0,4,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <materialDesign:Card Padding="14,12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="支持算法：MD5 / SHA-1 / SHA-256 / CRC32" Style="{StaticResource TextSubtitle}" />
                                <TextBlock Style="{StaticResource TextCaption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="选择任意文件后将依次计算 4 种校验值，结果为大写十六进制。结果块支持点击复制全部内容到剪贴板，可直接与官方校验值比对。" />
                                <ProgressBar IsIndeterminate="True" Margin="0,10,0,0"
                                             Style="{StaticResource MaterialDesignLinearProgressBar}"
                                             Visibility="{Binding IsFileHashBusy, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </materialDesign:Card>

                        <materialDesign:Card Padding="14,12"
                                             Visibility="{Binding FileHashResult, Converter={StaticResource StringNotEmptyToVisibility}}">
                            <StackPanel>
                                <StackPanel Style="{StaticResource SectionHeaderRow}">
                                    <materialDesign:PackIcon Kind="ClipboardCheckOutline" Width="16" Height="16" Margin="0,0,8,0"
                                                              Foreground="{DynamicResource BrushSuccess}" VerticalAlignment="Center" />
                                    <TextBlock Text="校验结果" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Background="{DynamicResource MaterialDesignToolBarBackground}"
                                        CornerRadius="6" Padding="12,10"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="FileHashResult_OnClick"
                                        ToolTip="点击复制到剪贴板">
                                    <TextBlock Text="{Binding FileHashResult}" Style="{StaticResource TextMonoCode}" />
                                </Border>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Convert module -->
            <Grid Margin="16">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="Convert">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Margin="0,0,0,12"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="{StaticResource CornerRadiusCard}"
                        Padding="12,8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#F59E0B" Offset="0" />
                                        <GradientStop Color="#EF4444" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <materialDesign:PackIcon Kind="SwapHorizontal" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="格式转换" Style="{StaticResource TextHeadline}" />
                                <TextBlock Text="{Binding ConvertStatusMessage}" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Image conversion card -->
                        <materialDesign:Card Padding="14,12" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Style="{StaticResource SectionHeaderRow}">
                                    <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource BrushTealGradient}" Margin="0,0,8,0">
                                        <materialDesign:PackIcon Kind="Image" Width="14" Height="14" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="图片转换" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                                    <TextBlock Text="（内置，无需外部依赖）" Style="{StaticResource TextHint}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="支持 JPG / PNG / BMP / GIF / TIFF 互转，可设置最大尺寸和 JPEG 质量。"
                                           Style="{StaticResource TextCaption}" Margin="0,4,0,10" TextWrapping="Wrap" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="{StaticResource ThicknessFieldGap}">
                                        <TextBlock Text="输出格式" Style="{StaticResource TextFieldLabel}" />
                                        <TextBox Text="{Binding ImageOutputFormat, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="jpg"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="{StaticResource ThicknessFieldGap}">
                                        <TextBlock Text="最大宽度 (0=不限)" Style="{StaticResource TextFieldLabel}" />
                                        <TextBox Text="{Binding ImageMaxWidth, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="0"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="{StaticResource ThicknessFieldGap}">
                                        <TextBlock Text="最大高度 (0=不限)" Style="{StaticResource TextFieldLabel}" />
                                        <TextBox Text="{Binding ImageMaxHeight, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="0"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="JPEG 质量 (1-100)" Style="{StaticResource TextFieldLabel}" />
                                        <TextBox Text="{Binding ImageQuality, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="85"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                                    </StackPanel>
                                </Grid>

                                <Button Style="{StaticResource PrimaryActionButton}" Margin="0,12,0,0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding ConvertImageCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ImageMove" Width="14" Height="14" Margin="0,0,6,0" />
                                        <TextBlock Text="选择图片并转换" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Audio/Video conversion card -->
                        <materialDesign:Card Padding="14,12" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Style="{StaticResource SectionHeaderRow}">
                                    <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource BrushAccentGradient}" Margin="0,0,8,0">
                                        <materialDesign:PackIcon Kind="MovieOpenOutline" Width="14" Height="14" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="音视频转换" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                                    <Border Margin="8,0,0,0" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource BadgeSuccess}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFfmpegAvailable}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="FFmpeg 就绪" Foreground="White" FontWeight="Bold" FontSize="11" />
                                    </Border>
                                    <Border Margin="8,0,0,0" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource BadgeWarning}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFfmpegAvailable}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="FFmpeg 未检测到" Foreground="White" FontWeight="Bold" FontSize="11" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="需要系统已安装 FFmpeg（加入 PATH 或放在程序同级目录）。支持 MP4/MKV/AVI/MOV/MP3/WAV/AAC/FLAC/OGG 等常见格式互转。"
                                           Style="{StaticResource TextCaption}" Margin="0,4,0,10" TextWrapping="Wrap" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="{StaticResource ThicknessFieldGap}">
                                        <TextBlock Text="输出格式" Style="{StaticResource TextFieldLabel}" />
                                        <TextBox Text="{Binding MediaOutputFormat, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="mp3"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="FFmpeg 附加参数（可选）" Style="{StaticResource TextFieldLabel}" />
                                        <TextBox Text="{Binding MediaExtraArgs, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="-b:a 192k"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                                    </StackPanel>
                                </Grid>

                                <Button Style="{StaticResource PrimaryActionButton}" Margin="0,12,0,0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding ConvertMediaCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileMusic" Width="14" Height="14" Margin="0,0,6,0" />
                                        <TextBlock Text="选择音视频并转换" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Convert result -->
                        <materialDesign:Card Padding="14,12"
                                             Visibility="{Binding ConvertResult, Converter={StaticResource StringNotEmptyToVisibility}}">
                            <StackPanel>
                                <StackPanel Style="{StaticResource SectionHeaderRow}">
                                    <materialDesign:PackIcon Kind="CheckCircleOutline" Width="16" Height="16" Margin="0,0,8,0"
                                                              Foreground="{DynamicResource BrushSuccess}" VerticalAlignment="Center" />
                                    <TextBlock Text="转换结果" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding ConvertResult}" Style="{StaticResource TextMonoCode}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </materialDesign:Card>

                        <ProgressBar IsIndeterminate="True" Margin="0,10,0,0"
                                     Style="{StaticResource MaterialDesignLinearProgressBar}"
                                     Visibility="{Binding IsConvertBusy, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Benchmark module -->
            <Grid Margin="16">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="Benchmark">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Margin="0,0,0,12"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="{StaticResource CornerRadiusCard}"
                        Padding="12,8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimaryActionButton}"
                                    Command="{Binding RunAllBenchmarksCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Play" Width="14" Height="14" Margin="0,0,6,0" />
                                    <TextBlock Text="运行全部测试" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#F43F5E" Offset="0" />
                                        <GradientStop Color="#EC4899" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <materialDesign:PackIcon Kind="SpeedometerMedium" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="性能测试" Style="{StaticResource TextHeadline}" />
                                <TextBlock Text="{Binding BenchmarkStatusMessage}" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ProgressBar IsIndeterminate="True" Margin="0,0,0,10"
                                     Style="{StaticResource MaterialDesignLinearProgressBar}"
                                     Visibility="{Binding IsBenchmarkBusy, Converter={StaticResource BoolToVis}}" />

                        <!-- Individual test buttons -->
                        <materialDesign:Card Padding="14,12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="单项测试" Style="{StaticResource TextSubtitle}" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <Button Style="{StaticResource GhostActionButton}" Margin="0,0,8,8"
                                            Command="{Binding RunSingleBenchmarkCommand}" CommandParameter="CpuSingle">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Cpu64Bit" Width="14" Height="14" Margin="0,0,6,0" />
                                            <TextBlock Text="CPU 单线程" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostActionButton}" Margin="0,0,8,8"
                                            Command="{Binding RunSingleBenchmarkCommand}" CommandParameter="CpuMulti">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Cpu64Bit" Width="14" Height="14" Margin="0,0,6,0" />
                                            <TextBlock Text="CPU 多线程" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostActionButton}" Margin="0,0,8,8"
                                            Command="{Binding RunSingleBenchmarkCommand}" CommandParameter="MemBandwidth">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Memory" Width="14" Height="14" Margin="0,0,6,0" />
                                            <TextBlock Text="内存带宽" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostActionButton}" Margin="0,0,8,8"
                                            Command="{Binding RunSingleBenchmarkCommand}" CommandParameter="MemLatency">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Memory" Width="14" Height="14" Margin="0,0,6,0" />
                                            <TextBlock Text="内存延迟" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostActionButton}" Margin="0,0,8,8"
                                            Command="{Binding RunSingleBenchmarkCommand}" CommandParameter="GpuInfo">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="VideoOutline" Width="14" Height="14" Margin="0,0,6,0" />
                                            <TextBlock Text="GPU 信息" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Results DataGrid -->
                        <materialDesign:Card Padding="14,12">
                            <StackPanel>
                                <StackPanel Style="{StaticResource SectionHeaderRow}">
                                    <materialDesign:PackIcon Kind="ChartBar" Width="16" Height="16" Margin="0,0,8,0" Foreground="{DynamicResource BrushAccentBlue}" VerticalAlignment="Center" />
                                    <TextBlock Text="测试结果" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding BenchmarkResults}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          MinHeight="200">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="项目" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn Header="得分" Binding="{Binding Score}" Width="180">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="详情" Binding="{Binding Detail}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ============== Schedule module ============== -->
            <views:SchedulePage DataContext="{Binding Schedule}">
                <views:SchedulePage.Style>
                    <Style TargetType="views:SchedulePage">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.CurrentModule, RelativeSource={RelativeSource AncestorType=mah:MetroWindow}}" Value="Schedule">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:SchedulePage.Style>
            </views:SchedulePage>

            <!-- ============== System Settings module ============== -->
            <views:SystemSettingsPage DataContext="{Binding SystemSettings}">
                <views:SystemSettingsPage.Style>
                    <Style TargetType="views:SystemSettingsPage">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.CurrentModule, RelativeSource={RelativeSource AncestorType=mah:MetroWindow}}" Value="SystemSettings">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:SystemSettingsPage.Style>
            </views:SystemSettingsPage>

        </Grid>
    </Grid>
</mah:MetroWindow>
