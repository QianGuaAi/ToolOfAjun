<mah:MetroWindow x:Class="MyTools.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                 xmlns:viewModels="clr-namespace:MyTools.ViewModels"
                 xmlns:tb="clr-namespace:Hardcodet.Wpf.TaskbarNotification;assembly=Hardcodet.NotifyIcon.Wpf"
                 Title="MyTools"
                 Width="1180"
                 Height="760"
                 MinWidth="1080"
                 MinHeight="700"
                 WindowStartupLocation="CenterScreen"
                 GlowBrush="{x:Null}"
                 TitleCharacterCasing="Normal"
                 Background="{DynamicResource MaterialDesignPaper}"
                 Icon="/Resources/AppIcon.ico"
                 AllowDrop="True"
                 PreviewDragOver="Window_PreviewDragOver"
                 PreviewDrop="Window_Drop"
                 PreviewKeyDown="Window_PreviewKeyDown">

    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <viewModels:StatusToColorConverter x:Key="StatusToColorConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="NavItemStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource BrushSidebarText}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <Grid>
                                <Rectangle x:Name="ActiveBar"
                                           Width="4"
                                           RadiusX="2"
                                           RadiusY="2"
                                           HorizontalAlignment="Left"
                                           Fill="{DynamicResource BrushAccentBlue}"
                                           Visibility="Collapsed" />
                                <ContentPresenter Margin="22,0,12,0"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushSidebarHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushSidebarTextHover}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.85"
                                                             To="1"
                                                             Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushSidebarPressed}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="ActiveNetwork">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushSidebarActive}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushSidebarTextActive}" />
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ActiveBar" Property="Fill" Value="{DynamicResource BrushAccentBlue}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="ActiveStartup">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushSidebarActive}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushSidebarTextActive}" />
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ActiveBar" Property="Fill" Value="{DynamicResource BrushAccentAmber}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="ActiveSystem">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushSidebarActive}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushSidebarTextActive}" />
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ActiveBar" Property="Fill" Value="{DynamicResource BrushAccentRose}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="ActiveSqlExport">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushSidebarActive}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushSidebarTextActive}" />
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ActiveBar" Property="Fill" Value="{DynamicResource BrushAccentBlue}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="ActiveScreenshot">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushSidebarActive}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushSidebarTextActive}" />
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ActiveBar" Property="Fill" Value="{DynamicResource BrushAccentPurple}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="ActiveCodexProfiles">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushSidebarActive}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushSidebarTextActive}" />
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ActiveBar" Property="Fill" Value="{DynamicResource BrushAccentTeal}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HomeShortcutButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="{StaticResource CornerRadiusButton}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#14000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#24000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="TrayMenu" materialDesign:MenuAssist.TopLevelMenuItemHeight="40">
            <MenuItem Header="显示窗口" Command="{Binding RestoreCommand}">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="WindowMaximize" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="退出程序" Command="{Binding ExitCommand}">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="ExitToApp" Foreground="Red" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <ContentControl x:Key="HomeView">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="36,24,36,24">
                    <Border Padding="30,24"
                            CornerRadius="{StaticResource CornerRadiusCard}"
                            Margin="0,0,0,18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                                <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel HorizontalAlignment="Center">
                            <Image Source="{StaticResource HomeHero}" Width="260" Height="180" />
                            <TextBlock Text="欢迎使用 MyTools"
                                       Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,4" />
                            <TextBlock Text="常用桌面工具集中管理，开箱即用。"
                                       Opacity="0.58"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <UniformGrid Rows="1" Columns="4" Margin="0,0,0,10">
                        <Button Command="{Binding ShowNetworkCommand}" Margin="0,0,14,0" Style="{StaticResource HomeShortcutButtonStyle}">
                            <materialDesign:Card Padding="18" Margin="0">
                                <StackPanel>
                                    <Border Width="34" Height="34" Background="{DynamicResource BrushAccentBlue}" CornerRadius="17">
                                        <materialDesign:PackIcon Kind="LanConnect" Width="18" Height="18" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="当前网络" FontWeight="SemiBold" Margin="0,12,0,4" />
                                    <TextBlock Text="快速查看网卡、网关与 DNS 状态。" Opacity="0.62" TextWrapping="Wrap" />
                                </StackPanel>
                            </materialDesign:Card>
                        </Button>

                        <Button Command="{Binding ShowSystemCommand}" Margin="0,0,14,0" Style="{StaticResource HomeShortcutButtonStyle}">
                            <materialDesign:Card Padding="18" Margin="0">
                                <StackPanel>
                                    <Border Width="34" Height="34" Background="{DynamicResource BrushAccentRose}" CornerRadius="17">
                                        <materialDesign:PackIcon Kind="Tools" Width="18" Height="18" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="系统优化" FontWeight="SemiBold" Margin="0,12,0,4" />
                                    <TextBlock Text="清理、加固与自动化操作入口。" Opacity="0.62" TextWrapping="Wrap" />
                                </StackPanel>
                            </materialDesign:Card>
                        </Button>

                        <Button Command="{Binding ShowSqlExportCommand}" Margin="0,0,14,0" Style="{StaticResource HomeShortcutButtonStyle}">
                            <materialDesign:Card Padding="18" Margin="0">
                                <StackPanel>
                                    <Border Width="34" Height="34" Background="{DynamicResource BrushAccentBlue}" CornerRadius="17">
                                        <materialDesign:PackIcon Kind="DatabaseArrowDown" Width="18" Height="18" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="SQL 导出" FontWeight="SemiBold" Margin="0,12,0,4" />
                                    <TextBlock Text="连接数据库、执行查询并导出 Excel。" Opacity="0.62" TextWrapping="Wrap" />
                                </StackPanel>
                            </materialDesign:Card>
                        </Button>

                        <Button Command="{Binding ShowScreenshotCommand}" Margin="0" Style="{StaticResource HomeShortcutButtonStyle}">
                            <materialDesign:Card Padding="18" Margin="0">
                                <StackPanel>
                                    <Border Width="34" Height="34" Background="{DynamicResource BrushAccentPurple}" CornerRadius="17">
                                        <materialDesign:PackIcon Kind="CameraIris" Width="18" Height="18" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="截图工具" FontWeight="SemiBold" Margin="0,12,0,4" />
                                    <TextBlock Text="支持截图、区域录像与独立录音。" Opacity="0.62" TextWrapping="Wrap" />
                                </StackPanel>
                            </materialDesign:Card>
                        </Button>
                    </UniformGrid>

                    <TextBlock Text="提示：可通过左侧导航快速切换功能模块。"
                               HorizontalAlignment="Center"
                               Opacity="0.45"
                               Margin="0,4,0,0" />
                </StackPanel>
            </ScrollViewer>
        </ContentControl>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="MyTools - 个人工具集（双击恢复窗口）"
                        Visibility="Visible"
                        MenuActivation="LeftOrRightClick"
                        ContextMenu="{StaticResource TrayMenu}"
                        DoubleClickCommand="{Binding RestoreCommand}" />

        <Border Background="{DynamicResource BrushSidebar}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="20,22,20,18"
                        BorderBrush="{DynamicResource BrushSidebarDivider}" BorderThickness="0,0,0,1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="{DynamicResource BrushSidebarTopColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource BrushSidebarColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Resources/AppIcon.png" Width="26" Height="26"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   VerticalAlignment="Center" />
                            <TextBlock Text="MyTools" FontWeight="Bold" FontSize="17"
                                       Foreground="White" VerticalAlignment="Center"
                                       Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="个人工具集"
                                   FontSize="11"
                                   Opacity="0.6"
                                   Foreground="{DynamicResource BrushSidebarTextHover}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1" Margin="0,8,0,0">

                    <Button Command="{Binding ShowNetworkCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="Network">
                                        <Setter Property="Tag" Value="ActiveNetwork" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="LanConnect" Width="22" Height="22" Margin="0,0,14,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentBlue}" />
                            <TextBlock Text="当前网络" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowStartupCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="Startup">
                                        <Setter Property="Tag" Value="ActiveStartup" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="RocketLaunchOutline" Width="22" Height="22" Margin="0,0,14,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentAmber}" />
                            <TextBlock Text="启动管理" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowSystemCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="System">
                                        <Setter Property="Tag" Value="ActiveSystem" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Tools" Width="22" Height="22" Margin="0,0,14,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentRose}" />
                            <TextBlock Text="系统优化" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowSqlExportCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="SqlExport">
                                        <Setter Property="Tag" Value="ActiveSqlExport" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DatabaseArrowDown" Width="22" Height="22" Margin="0,0,14,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentBlue}" />
                            <TextBlock Text="SQL 导出" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowScreenshotCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="Screenshot">
                                        <Setter Property="Tag" Value="ActiveScreenshot" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CameraIris" Width="22" Height="22" Margin="0,0,14,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentPurple}" />
                            <TextBlock Text="截图工具" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowCodexProfilesCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentModule}" Value="CodexProfiles">
                                        <Setter Property="Tag" Value="ActiveCodexProfiles" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderCogOutline" Width="22" Height="22" Margin="0,0,14,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentTeal}" />
                            <TextBlock Text="Codex 配置" VerticalAlignment="Center" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                </StackPanel>
                <TextBlock Grid.Row="2"
                           Text="{Binding AppVersionText}"
                           FontSize="11"
                           Opacity="0.45"
                           Foreground="{DynamicResource BrushSidebarText}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12" />
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{DynamicResource MaterialDesignFlatBackground}">
            <ContentControl Content="{StaticResource HomeView}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="Home">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <Grid Margin="20">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="Network">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,20"
                        CornerRadius="{StaticResource CornerRadiusCard}"
                        Padding="20,16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding RefreshCommand}" ToolTip="刷新">
                            <materialDesign:PackIcon Kind="Refresh" Width="22" Height="22" />
                        </Button>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="LanConnect" Width="32" Height="32" Margin="0,0,14,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentBlue}" />
                            <StackPanel>
                                <TextBlock Text="当前网络" Style="{StaticResource MaterialDesignHeadline5TextBlock}" />
                                <TextBlock Text="实时查看网卡、IP、网关与 DNS 信息。" Opacity="0.55" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="NetworkListControl" ItemsSource="{Binding NetworkList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <materialDesign:Card Margin="0,0,0,15" Padding="15" materialDesign:ElevationAssist.Elevation="Dp2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <materialDesign:PackIcon Kind="Lan"
                                                                     Width="32"
                                                                     Height="32"
                                                                     VerticalAlignment="Top"
                                                                     HorizontalAlignment="Center"
                                                                     Foreground="{Binding Status, Converter={StaticResource StatusToColorConverter}}" />

                                            <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource MaterialDesignCaptionTextBlock}" Opacity="0.6" Margin="0,2,0,10" />

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Text="IP ???:" Grid.Row="0" Style="{StaticResource MaterialDesignCaptionTextBlock}" Margin="0,0,10,0" />
                                                    <TextBlock Text="{Binding IpAddress}" Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,5" />

                                                    <TextBlock Text="???:" Grid.Row="1" Style="{StaticResource MaterialDesignCaptionTextBlock}" Margin="0,0,10,0" />
                                                    <TextBlock Text="{Binding Gateway}" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,5" />

                                                    <TextBlock Text="DNS:" Grid.Row="2" Style="{StaticResource MaterialDesignCaptionTextBlock}" Margin="0,0,10,0" />
                                                    <TextBlock Text="{Binding Dns}" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </materialDesign:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=NetworkListControl}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Image Source="{StaticResource NetworkEmpty}" Width="160" Height="120" HorizontalAlignment="Center" />
                        <TextBlock Text="No network entries available right now."
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   HorizontalAlignment="Center"
                                   Opacity="0.4"
                                   Margin="0,12,0,0" />
                        <Button Content="刷新"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding RefreshCommand}"
                                Margin="0,12,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Margin="20">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="Startup">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,20"
                        CornerRadius="{StaticResource CornerRadiusCard}"
                        Padding="20,16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding RefreshCommand}" ToolTip="Refresh">
                            <materialDesign:PackIcon Kind="Refresh" Width="22" Height="22" />
                        </Button>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="RocketLaunchOutline" Width="32" Height="32" Margin="0,0,14,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentAmber}" />
                            <StackPanel>
                                <TextBlock Text="Startup Manager" Style="{StaticResource MaterialDesignHeadline5TextBlock}" />
                                <TextBlock Text="Manage Windows startup items and speed up boot." Opacity="0.55" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding StartupList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <materialDesign:Card Margin="0,0,0,10" Padding="0"
                                                        materialDesign:ElevationAssist.Elevation="Dp1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="5" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" CornerRadius="4,0,0,4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#2E7D32" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                <Setter Property="Background" Value="#9E9E9E" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="12,12,8,12">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Command}" Style="{StaticResource MaterialDesignCaptionTextBlock}" Opacity="0.6" Margin="0,4,0,4"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="AccountCircle" Width="12" Height="12" VerticalAlignment="Center" Opacity="0.5" />
                                                    <TextBlock Text="{Binding Location}" Style="{StaticResource MaterialDesignCaptionTextBlock}" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="4,0,0,0" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Margin="0,0,8,0">
                                                <Button Command="{Binding DataContext.ToggleStartupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Width="80"
                                                        Margin="0,0,8,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                                            <Setter Property="Content" Value="禁用" />
                                                            <Setter Property="Foreground" Value="#C62828" />
                                                            <Setter Property="BorderBrush" Value="#C62828" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                    <Setter Property="Content" Value="启用" />
                                                                    <Setter Property="Foreground" Value="#2E7D32" />
                                                                    <Setter Property="BorderBrush" Value="#2E7D32" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                        Command="{Binding DataContext.DeleteStartupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="永久删除（需确认）">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Foreground="#9E9E9E" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </materialDesign:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasNoStartupItems, Converter={StaticResource BoolToVis}}">
                        <Image Source="{StaticResource StartupEmpty}" Width="160" Height="120" HorizontalAlignment="Center" />
                        <TextBlock Text="未发现开机启动项" Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   HorizontalAlignment="Center" Opacity="0.4" Margin="0,12,0,0" />
                        <TextBlock Text="点击刷新按钮重新扫描" Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   HorizontalAlignment="Center" Opacity="0.3" Margin="0,4,0,0" />
                        <Button Content="Refresh"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding RefreshCommand}"
                                Margin="0,12,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Margin="20">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="0,0,0,20" CornerRadius="{StaticResource CornerRadiusCard}" Padding="20,16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ShieldLock" Width="32" Height="32" Margin="0,0,14,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentTeal}" />
                    <StackPanel>
                        <TextBlock Text="VPN Connection" Style="{StaticResource MaterialDesignHeadline5TextBlock}" VerticalAlignment="Center" />
                        <TextBlock Text="Quickly connect and switch WireGuard tunnels" Opacity="0.55" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border Padding="10,3" Margin="20,0,0,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource BadgeInfo}">
                                <Setter Property="Background" Value="{DynamicResource BrushInfo}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWgConnected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrushSuccess}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsWgBusy}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrushWarning}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding WgStatusText}" Foreground="White" FontWeight="Bold" />
                    </Border>
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                 IsIndeterminate="True"
                                 Width="20" Height="20"
                                 Margin="12,0,0,0"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsWgBusy, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding ToggleWgSettingsCommand}" Margin="6,0,0,0" ToolTip="设置">
                        <materialDesign:PackIcon Kind="Settings" />
                    </Button>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <materialDesign:Card Grid.Row="0" Padding="12,10" Margin="0,0,0,10"
                                         Background="#FFF3E0"
                                         Visibility="{Binding WgExeNotFound, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="#E65100" Width="20" Height="20" VerticalAlignment="Center" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#BF360C">
                                <Run FontWeight="Bold" Text="WireGuard 未安装" />
                                <Run Text="— 请先安装 WireGuard for Windows，下载地址：https://www.wireguard.com/install/" />
                            </TextBlock>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Row="1" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBox materialDesign:HintAssist.Hint="接口名称 (例如 wg0)"
                                     Text="{Binding WgInterfaceName}"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Margin="0,0,0,10" />
                            <TextBlock Text="配置内容 (.conf):" Style="{StaticResource MaterialDesignCaptionTextBlock}" Margin="0,10,0,5" />
                            <TextBox Text="{Binding WgConfig, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="200"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="[Interface]&#x0a;PrivateKey = ...&#x0a;Address = ...&#x0a;&#x0a;[Peer]&#x0a;PublicKey = ...&#x0a;Endpoint = ..." />
                        </StackPanel>
                    </materialDesign:Card>

                    <Button Grid.Row="3" Command="{Binding ToggleWireGuardCommand}" Height="50">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                <Setter Property="Content" Value="启动连接" />
                                <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWgConnected}" Value="True">
                                        <Setter Property="Content" Value="断开连接" />
                                        <Setter Property="Background" Value="#E53935" />
                                        <Setter Property="BorderBrush" Value="#E53935" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <materialDesign:Card Grid.Row="0"
                                         Grid.RowSpan="4"
                                         Background="{DynamicResource MaterialDesignPaper}"
                                         Visibility="{Binding IsWgSettingsOpen, Converter={StaticResource BoolToVis}}"
                                         materialDesign:ElevationAssist.Elevation="Dp8">
                        <Grid Margin="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding ToggleWgSettingsCommand}">
                                    <materialDesign:PackIcon Kind="ArrowLeft" />
                                </Button>
                                <TextBlock Text="VPN 高级设置" Style="{StaticResource MaterialDesignHeadline6TextBlock}" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="1">
                                <TextBox materialDesign:HintAssist.Hint="服务器 Endpoint (IP:Port)"
                                         Text="{Binding WgEndpoint}"
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                         Margin="0,0,0,20" />
                                <TextBox materialDesign:HintAssist.Hint="本地 Address (例如 10.0.0.2/32)"
                                         Text="{Binding WgAddress}"
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                         Margin="0,0,0,20" />
                                <TextBox materialDesign:HintAssist.Hint="服务器 Public Key"
                                         Text="{Binding WgServerPublicKey}"
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                         Margin="0,0,0,20" />

                                <TextBlock Text="点击生成后会自动回填主配置框，PrivateKey 仍需手动补充。"
                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                           Foreground="Orange"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Button Grid.Row="2"
                                    Content="生成并应用配置"
                                    Command="{Binding GenerateConfigCommand}"
                                    Style="{StaticResource MaterialDesignRaisedAccentButton}"
                                    Height="45" />
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </Grid>

            <Grid Margin="20">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="System">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,20"
                        CornerRadius="{StaticResource CornerRadiusCard}"
                        Padding="20,16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Tools" Width="32" Height="32" Margin="0,0,14,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentRose}" />
                        <StackPanel>
                            <TextBlock Text="系统优化" Style="{StaticResource MaterialDesignHeadline5TextBlock}" />
                            <TextBlock Text="执行白名单维护与优化任务。" Opacity="0.55" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <materialDesign:Card Padding="20" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="锁定 Windows 10 版本 (22H2)" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" FontWeight="Bold" />
                                    <TextBlock Text="防止系统自动升级到 Windows 11 或更高版本，适用于希望继续停留在 Win10 22H2 的用户。"
                                               Style="{StaticResource MaterialDesignBody2TextBlock}"
                                               Opacity="0.6"
                                               TextWrapping="Wrap"
                                               Margin="0,5,20,0" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="执行锁定"
                                        Command="{Binding LockWin10Command}"
                                        Style="{StaticResource MaterialDesignRaisedButton}" />
                            </Grid>
                        </materialDesign:Card>

                        <materialDesign:Card Padding="20" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="Windows Defender 实时防护"
                                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center" />
                                        <Border CornerRadius="4" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#2E7D32" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDefenderEnabled}" Value="False">
                                                            <Setter Property="Background" Value="#757575" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Foreground="White" FontWeight="Bold" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="防护中" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDefenderEnabled}" Value="False">
                                                                <Setter Property="Text" Value="已关闭" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="关闭或恢复 Windows 安全中心的实时防护。Win11 需先在安全中心手动关闭「篡改保护」，否则命令将被拒绝。"
                                               Style="{StaticResource MaterialDesignBody2TextBlock}"
                                               Opacity="0.6"
                                               TextWrapping="Wrap"
                                               Margin="0,0,20,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Width="90" Margin="0,0,8,0" Command="{Binding ToggleDefenderCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                                <Setter Property="Content" Value="关闭防护" />
                                                <Setter Property="Foreground" Value="#C62828" />
                                                <Setter Property="BorderBrush" Value="#C62828" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDefenderEnabled}" Value="False">
                                                        <Setter Property="Content" Value="恢复防护" />
                                                        <Setter Property="Foreground" Value="#2E7D32" />
                                                        <Setter Property="BorderBrush" Value="#2E7D32" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Command="{Binding RefreshSystemStatusCommand}"
                                            ToolTip="刷新状态">
                                        <materialDesign:PackIcon Kind="Refresh" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>

                        <materialDesign:Card Padding="20" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="Windows 自动更新"
                                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center" />
                                        <Border CornerRadius="4" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1565C0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAutoUpdateEnabled}" Value="False">
                                                            <Setter Property="Background" Value="#757575" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Foreground="White" FontWeight="Bold" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="自动更新中" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAutoUpdateEnabled}" Value="False">
                                                                <Setter Property="Text" Value="已停止" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="停止 Windows 后台自动更新，或手动触发立即检查并安装所有可用更新（以前台最高优先级下载安装，速度最快）。"
                                               Style="{StaticResource MaterialDesignBody2TextBlock}"
                                               Opacity="0.6"
                                               TextWrapping="Wrap"
                                               Margin="0,0,20,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,0">
                                    <Button Width="90" Margin="0,0,0,8" Command="{Binding ToggleAutoUpdateCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                                <Setter Property="Content" Value="停止更新" />
                                                <Setter Property="Foreground" Value="#C62828" />
                                                <Setter Property="BorderBrush" Value="#C62828" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAutoUpdateEnabled}" Value="False">
                                                        <Setter Property="Content" Value="恢复更新" />
                                                        <Setter Property="Foreground" Value="#1565C0" />
                                                        <Setter Property="BorderBrush" Value="#1565C0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Width="90"
                                            Content="立即更新"
                                            Command="{Binding TriggerUpdateNowCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}" />
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>

                        <TextBlock Text="{Binding SystemStatusMessage}"
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   Opacity="0.7"
                                   TextWrapping="Wrap"
                                   Margin="4,0,0,16" />

                        <materialDesign:Card Padding="20" Background="{DynamicResource PrimaryHueLightBrush}">
                            <StackPanel>
                                <TextBlock Text="温馨提示" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Foreground="White" FontWeight="Bold" />
                                <TextBlock Text="部分优化操作需要管理员权限，执行过程中请留意系统弹出的 UAC 授权窗口。"
                                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                                           Foreground="White"
                                           Opacity="0.9"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </materialDesign:Card>

                        <materialDesign:Card Padding="20" Margin="0,16,0,16">
                            <StackPanel>
                                <TextBlock Text="自动优化与报告"
                                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                           FontWeight="Bold" />
                                <TextBlock Text="按白名单步骤自动执行系统优化，完成后自动生成可追溯报告。"
                                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                                           Opacity="0.65"
                                           Margin="0,6,0,12"
                                           TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="开始自动优化"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Command="{Binding StartAutoOptimizeCommand}" />
                                    <ProgressBar Width="28" Height="28"
                                                 Margin="12,0,0,0"
                                                 IsIndeterminate="True"
                                                 Visibility="{Binding IsAutoOptimizeBusy, Converter={StaticResource BoolToVis}}"
                                                 Style="{StaticResource MaterialDesignCircularProgressBar}" />
                                </StackPanel>
                                <TextBlock Text="{Binding AutoOptimizeStatusMessage}"
                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                           Margin="0,10,0,10"
                                           TextWrapping="Wrap" />

                                <DataGrid ItemsSource="{Binding OptimizationReports}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          SelectionMode="Single"
                                          MinHeight="180"
                                          GridLinesVisibility="Horizontal"
                                          HeadersVisibility="Column"
                                          Margin="0,0,0,10">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="选择" Width="58">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="时间"
                                                            Width="165"
                                                            Binding="{Binding StartedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" />
                                        <DataGridTextColumn Header="类型" Width="92" Binding="{Binding ReportTypeDisplay}" />
                                        <DataGridTextColumn Header="释放空间" Width="120" Binding="{Binding TotalBytesFreedDisplay}" />
                                        <DataGridTextColumn Header="摘要" Width="*" Binding="{Binding Summary}" />
                                        <DataGridTemplateColumn Header="详情" Width="78">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="查看"
                                                            Padding="8,2"
                                                            Command="{Binding DataContext.ShowReportDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Button Content="删除选中"
                                        Width="110"
                                        HorizontalAlignment="Right"
                                        Command="{Binding DeleteSelectedReportsCommand}" />
                            </StackPanel>
                        </materialDesign:Card>

                        <materialDesign:Card Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="垃圾清理"
                                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                           FontWeight="Bold" />
                                <TextBlock Text="扫描并清理白名单目录中的临时垃圾文件，执行前会进行二次确认。"
                                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                                           Opacity="0.65"
                                           Margin="0,6,0,12"
                                           TextWrapping="Wrap" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="开始扫描"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Command="{Binding StartJunkScanCommand}" />
                                    <Button Content="立即清理"
                                            Margin="10,0,0,0"
                                            Command="{Binding RunJunkCleanupCommand}" />
                                    <ProgressBar Width="28" Height="28"
                                                 Margin="12,0,0,0"
                                                 IsIndeterminate="True"
                                                 Visibility="{Binding IsJunkBusy, Converter={StaticResource BoolToVis}}"
                                                 Style="{StaticResource MaterialDesignCircularProgressBar}" />
                                </StackPanel>

                                <TextBlock Text="{Binding JunkStatusMessage}"
                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10" />

                                <DataGrid ItemsSource="{Binding JunkCandidates}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          MinHeight="140"
                                          GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="选择" Width="58">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="类别" Width="125" Binding="{Binding Category}" />
                                        <DataGridTextColumn Header="路径" Width="*" Binding="{Binding Path}" />
                                        <DataGridTextColumn Header="体积" Width="120" Binding="{Binding BytesDisplay}" />
                                        <DataGridTextColumn Header="说明" Width="230" Binding="{Binding Reason}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </materialDesign:Card>

                        <materialDesign:Card Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="微信清理"
                                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                           FontWeight="Bold" />
                                <TextBlock Text="微信运行中清理可能导致部分图片/视频缩略图丢失，建议先关闭微信后再清理。"
                                           Foreground="#C62828"
                                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,12" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <DatePicker Grid.Column="0" SelectedDate="{Binding WeChatCleanupStartDate}" />
                                    <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Text="~" />
                                    <DatePicker Grid.Column="2" SelectedDate="{Binding WeChatCleanupEndDate}" />
                                    <ComboBox Grid.Column="3" Margin="12,0,0,0"
                                              ItemsSource="{Binding WeChatRoots}"
                                              SelectedItem="{Binding SelectedWeChatRoot}"
                                              DisplayMemberPath="WxIdOrUserName" />
                                </Grid>

                                <WrapPanel Margin="0,0,0,10">
                                    <CheckBox Content="文字" IsChecked="{Binding WeChatCleanupIncludeText}" Margin="0,0,12,6" />
                                    <CheckBox Content="图像" IsChecked="{Binding WeChatCleanupIncludeImage}" Margin="0,0,12,6" />
                                    <CheckBox Content="视频" IsChecked="{Binding WeChatCleanupIncludeVideo}" Margin="0,0,12,6" />
                                    <CheckBox Content="语音" IsChecked="{Binding WeChatCleanupIncludeVoice}" Margin="0,0,12,6" />
                                    <CheckBox Content="其它文件" IsChecked="{Binding WeChatCleanupIncludeFile}" Margin="0,0,12,6" />
                                    <CheckBox Content="缓存" IsChecked="{Binding WeChatCleanupIncludeCache}" Margin="0,0,12,6" />
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="扫描" Command="{Binding ScanWeChatCleanupCommand}" Style="{StaticResource MaterialDesignRaisedButton}" />
                                    <Button Content="开始清理" Margin="10,0,0,0" Command="{Binding StartWeChatCleanupCommand}" />
                                    <ProgressBar Width="28" Height="28"
                                                 Margin="12,0,0,0"
                                                 IsIndeterminate="True"
                                                 Visibility="{Binding IsWeChatCleanupBusy, Converter={StaticResource BoolToVis}}"
                                                 Style="{StaticResource MaterialDesignCircularProgressBar}" />
                                </StackPanel>

                                <TextBlock Text="{Binding WeChatCleanupStatusMessage}"
                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10" />

                                <DataGrid ItemsSource="{Binding WeChatCleanupCandidates}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          MinHeight="160"
                                          GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="选择" Width="58">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="类别" Width="100" Binding="{Binding Category}" />
                                        <DataGridTextColumn Header="时间" Width="160" Binding="{Binding LastWriteTime, StringFormat=yyyy-MM-dd HH:mm:ss}" />
                                        <DataGridTextColumn Header="体积" Width="110" Binding="{Binding BytesDisplay}" />
                                        <DataGridTextColumn Header="路径" Width="*" Binding="{Binding Path}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </materialDesign:Card>

                        <materialDesign:Card Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="微信备份"
                                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                           FontWeight="Bold" />
                                <TextBlock Text="按日期和类别备份为单个 ZIP，包含 manifest.json 与 SHA256 校验信息。"
                                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                                           Opacity="0.65"
                                           Margin="0,6,0,12"
                                           TextWrapping="Wrap" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <DatePicker Grid.Column="0" SelectedDate="{Binding WeChatBackupStartDate}" />
                                    <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Text="~" />
                                    <DatePicker Grid.Column="2" SelectedDate="{Binding WeChatBackupEndDate}" />
                                    <ComboBox Grid.Column="3" Margin="12,0,0,0"
                                              ItemsSource="{Binding WeChatRoots}"
                                              SelectedItem="{Binding SelectedWeChatRoot}"
                                              DisplayMemberPath="WxIdOrUserName" />
                                </Grid>

                                <WrapPanel Margin="0,0,0,10">
                                    <CheckBox Content="文字" IsChecked="{Binding WeChatBackupIncludeText}" Margin="0,0,12,6" />
                                    <CheckBox Content="图像" IsChecked="{Binding WeChatBackupIncludeImage}" Margin="0,0,12,6" />
                                    <CheckBox Content="视频" IsChecked="{Binding WeChatBackupIncludeVideo}" Margin="0,0,12,6" />
                                    <CheckBox Content="语音" IsChecked="{Binding WeChatBackupIncludeVoice}" Margin="0,0,12,6" />
                                    <CheckBox Content="其它文件" IsChecked="{Binding WeChatBackupIncludeFile}" Margin="0,0,12,6" />
                                    <CheckBox Content="缓存" IsChecked="{Binding WeChatBackupIncludeCache}" Margin="0,0,12,6" />
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="选择保存目录"
                                            Command="{Binding SelectWeChatBackupOutputFolderCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                                    <Button Content="开始备份"
                                            Margin="10,0,0,0"
                                            Command="{Binding StartWeChatBackupCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}" />
                                    <ProgressBar Width="28" Height="28"
                                                 Margin="12,0,0,0"
                                                 IsIndeterminate="True"
                                                 Visibility="{Binding IsWeChatBackupBusy, Converter={StaticResource BoolToVis}}"
                                                 Style="{StaticResource MaterialDesignCircularProgressBar}" />
                                </StackPanel>

                                <TextBlock Text="{Binding WeChatBackupOutputFolder}"
                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                           Opacity="0.75"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding WeChatBackupStatusMessage}"
                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </materialDesign:Card>

                        <materialDesign:Card Padding="20">
                            <StackPanel>
                                <TextBlock Text="微信恢复"
                                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                           FontWeight="Bold" />
                                <TextBlock Text="从备份 ZIP 读取 manifest 后恢复到原路径或自定义目录；同名文件自动改名防覆盖。"
                                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                                           Opacity="0.65"
                                           Margin="0,6,0,12"
                                           TextWrapping="Wrap" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="选择备份文件"
                                            Command="{Binding SelectWeChatRestoreZipCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                                    <Button Content="选择恢复目录"
                                            Margin="10,0,0,0"
                                            Command="{Binding SelectWeChatRestoreTargetRootCommand}"
                                            IsEnabled="{Binding RestoreToCustom}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                                    <Button Content="开始恢复"
                                            Margin="10,0,0,0"
                                            Command="{Binding StartWeChatRestoreCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}" />
                                    <ProgressBar Width="28" Height="28"
                                                 Margin="12,0,0,0"
                                                 IsIndeterminate="True"
                                                 Visibility="{Binding IsWeChatRestoreBusy, Converter={StaticResource BoolToVis}}"
                                                 Style="{StaticResource MaterialDesignCircularProgressBar}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <RadioButton Content="恢复到原微信目录"
                                                 IsChecked="{Binding RestoreToOriginal, Mode=TwoWay}"
                                                 GroupName="RestoreMode"
                                                 Margin="0,0,20,0" />
                                    <RadioButton Content="恢复到自定义目录"
                                                 IsChecked="{Binding RestoreToCustom, Mode=TwoWay}"
                                                 GroupName="RestoreMode" />
                                </StackPanel>

                                <TextBlock Text="{Binding WeChatRestoreZipPath}"
                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                           Opacity="0.75"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding WeChatRestoreTargetRoot}"
                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                           Opacity="0.75"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding WeChatRestoreManifestSummary}"
                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding WeChatRestoreStatusMessage}"
                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid Margin="20">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="SqlExport">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,20"
                        CornerRadius="{StaticResource CornerRadiusCard}"
                        Padding="20,16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <Border DockPanel.Dock="Right"
                                Margin="16,0,0,0"
                                Padding="10,4"
                                CornerRadius="12"
                                Background="#1F1976D2"
                                VerticalAlignment="Center">
                            <TextBlock Text="SQL Server / PostgreSQL / MySQL" Foreground="#1976D2" FontWeight="SemiBold" />
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DatabaseArrowDown" Width="32" Height="32" Margin="0,0,14,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentBlue}" />
                            <StackPanel>
                                <TextBlock Text="SQL Export Toolkit" Style="{StaticResource MaterialDesignHeadline5TextBlock}" />
                                <TextBlock Text="Batch export database tables to .xlsx." Opacity="0.55" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <materialDesign:Card Padding="20" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,12,12">
                                <ComboBox Margin="0,0,0,8"
                                          ItemsSource="{Binding SqlProviderOptions}"
                                          SelectedValuePath="Kind"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValue="{Binding SelectedSqlProvider, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                          materialDesign:HintAssist.Hint="数据库类型" />
                                <ComboBox IsEditable="True"
                                          IsReadOnly="False"
                                          IsTextSearchEnabled="False"
                                          StaysOpenOnEdit="True"
                                          ItemsSource="{Binding SqlServerAddressHistory}"
                                          Text="{Binding SqlServerAddress, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                          materialDesign:HintAssist.Hint="服务器地址或 IP" />
                            </StackPanel>

                            <TextBox Grid.Row="0"
                             Grid.Column="1"
                             Margin="0,0,12,12"
                             Text="{Binding SqlPort, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     materialDesign:HintAssist.Hint="{Binding SqlPortHint}" />

                            <ComboBox Grid.Row="0"
                                      Grid.Column="2"
                                      Margin="0,0,12,12"
                                      IsEditable="True"
                                      IsTextSearchEnabled="False"
                                      ItemsSource="{Binding SqlUsernameHistory}"
                                      Text="{Binding SqlUsername, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                      materialDesign:HintAssist.Hint="用户名" />

                            <Grid Grid.Row="0"
                                  Grid.Column="3"
                                  Margin="0,0,0,12">
                                <PasswordBox x:Name="SqlPasswordBox"
                                             Padding="0,0,38,0"
                                             Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                                             materialDesign:HintAssist.Hint="密码"
                                             PasswordChanged="SqlPasswordBox_OnPasswordChanged" />
                                <Button x:Name="SqlPasswordHistoryButton"
                                        Width="32"
                                        Height="32"
                                        Margin="0,18,0,0"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Click="SqlPasswordHistoryButton_OnClick"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="选择历史密码">
                                    <materialDesign:PackIcon Width="20" Height="20" Kind="ChevronDown" />
                                    <Button.ContextMenu>
                                        <ContextMenu ItemsSource="{Binding PlacementTarget.DataContext.SqlPasswordHistory, RelativeSource={RelativeSource Self}}"
                                                     materialDesign:MenuAssist.TopLevelMenuItemHeight="36">
                                            <ContextMenu.ItemContainerStyle>
                                                <Style TargetType="MenuItem">
                                                    <Setter Property="Header" Value="••••••••" />
                                                    <Setter Property="ToolTip" Value="使用此历史密码" />
                                                    <EventSetter Event="Click" Handler="SqlPasswordHistoryMenuItem_OnClick" />
                                                </Style>
                                            </ContextMenu.ItemContainerStyle>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </Grid>

                            <ComboBox Grid.Row="1"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="2"
                                      Margin="0,0,12,12"
                                      ItemsSource="{Binding SqlDatabaseList}"
                                      SelectedItem="{Binding SelectedSqlDatabase}"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource MaterialDesignFilledComboBox}"
                                      materialDesign:HintAssist.Hint="数据库" />

                            <ComboBox Grid.Row="1"
                                      Grid.Column="2"
                                      Grid.ColumnSpan="2"
                                      Margin="0,0,0,12"
                                      IsEditable="True"
                                      IsTextSearchEnabled="False"
                                      StaysOpenOnEdit="True"
                                      ItemsSource="{Binding FilteredSqlTableView}"
                                      SelectedItem="{Binding SelectedSqlTable, UpdateSourceTrigger=PropertyChanged}"
                                      Text="{Binding SqlTableSearchText, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="DisplayName"
                                      Style="{StaticResource MaterialDesignFilledComboBox}"
                                      materialDesign:HintAssist.Hint="数据表" />

                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal">
                                <Button Width="150"
                                        Height="42"
                                        Margin="0,0,12,0"
                                        Command="{Binding TestSqlConnectionCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Content="测试连接" />

                                <Button Width="160"
                                        Height="42"
                                        Command="{Binding ExportSqlTableCommand}"
                                        Style="{StaticResource MaterialDesignRaisedAccentButton}"
                                        Content="导出为 Excel" />
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Row="1" Padding="16" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="状态" FontWeight="Bold" />
                                <Border Style="{StaticResource BadgeInfo}" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="InformationOutline" Width="12" Height="12" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding SqlStatusMessage}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <ProgressBar Grid.Column="1"
                                         Width="180"
                                         Height="6"
                                         Margin="20,0,0,0"
                                         VerticalAlignment="Center"
                                         IsIndeterminate="True"
                                         Visibility="{Binding IsSqlBusy, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </materialDesign:Card>

                    <TabControl Grid.Row="2"
                                Style="{StaticResource MaterialDesignTabControl}"
                                materialDesign:ColorZoneAssist.Mode="PrimaryMid">

                        <TabItem Header="使用说明">
                            <materialDesign:Card Padding="20" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="使用说明" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" FontWeight="Bold" />
                                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap">
                                        支持 SQL Server / PostgreSQL / MySQL 账号密码连接。流程：测试连接 → 选择数据库 → 选择表 → 导出整表。
                                    </TextBlock>
                                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap">
                                            SQL 查询标签页支持执行任意查询语句，结果可直接导出 Excel。
                                        </TextBlock>
                                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap">
                                        目标表超过 Excel 单工作表上限 1,048,576 行时，程序会阻止导出并给出提示。
                                    </TextBlock>
                                </StackPanel>
                            </materialDesign:Card>
                        </TabItem>

                        <TabItem Header="SQL 查询">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <materialDesign:Card Grid.Row="0" Padding="16" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="130" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox Grid.Row="0"
                                                 Text="{Binding SqlQueryText, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="NoWrap"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 VerticalScrollBarVisibility="Auto"
                                                 FontFamily="Consolas"
                                                 FontSize="13"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 materialDesign:HintAssist.Hint="输入 SQL 语句，例如：SELECT * FROM schema.table LIMIT 100" />

                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Width="110" Height="38"
                                                    Margin="0,0,10,0"
                                                    Content="执行查询"
                                                    Command="{Binding ExecuteSqlQueryCommand}"
                                                    Style="{StaticResource MaterialDesignRaisedButton}">
                                                <Button.ContentTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="Play" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </Button.ContentTemplate>
                                            </Button>
                                            <Button Width="130" Height="38"
                                                    Margin="0,0,16,0"
                                                    Content="导出结果"
                                                    Command="{Binding ExportQueryResultCommand}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}">
                                                <Button.ContentTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="FileExcel" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </Button.ContentTemplate>
                                            </Button>
                                            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                         IsIndeterminate="True"
                                                         Width="20" Height="20"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,12,0"
                                                         Visibility="{Binding IsQueryBusy, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding QueryStatusMessage}"
                                                       Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                       VerticalAlignment="Center"
                                                       Opacity="0.7" />
                                        </StackPanel>
                                    </Grid>
                                </materialDesign:Card>

                                <DataGrid Grid.Row="2"
                                          ItemsSource="{Binding SqlQueryResult}"
                                          AutoGenerateColumns="True"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserSortColumns="True"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto"
                                          SelectionMode="Extended"
                                          Style="{StaticResource MaterialDesignDataGrid}"
                                          materialDesign:DataGridAssist.CellPadding="8 4 8 4"
                                          materialDesign:DataGridAssist.ColumnHeaderPadding="8 4 8 4" />
                            </Grid>
                        </TabItem>

                    </TabControl>
                </Grid>
            </Grid>

            <!-- Screenshot Settings panel -->
            <Grid Margin="20">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="Screenshot">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,20"
                        CornerRadius="{StaticResource CornerRadiusCard}"
                        Padding="20,16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,0"
                                        Visibility="{Binding HasAudioRecordingIndicator, Converter={StaticResource BoolToVis}}">
                                <Ellipse Width="8" Height="8" Fill="#E53935" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding AudioRecordingIndicator}" Foreground="#C62828" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                    Command="{Binding TakeScreenshotNowCommand}"
                                    Margin="0,0,8,0"
                                    Height="36" Padding="12,0"
                                    ToolTip="立即截图">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Camera" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="立即截图"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Command="{Binding StartVideoRecordingCommand}"
                                    Margin="0,0,8,0"
                                    Height="36" Padding="12,0"
                                    ToolTip="开启区域录像">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="RecordRec" Width="16" Height="16" Margin="0,0,6,0" Foreground="#E53935" />
                                    <TextBlock Text="开启录像"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Command="{Binding ToggleAudioRecordingCommand}"
                                    Margin="0,0,8,0"
                                    Height="36" Padding="12,0"
                                    ToolTip="开启或停止录音">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="Microphone" />
                                                <Setter Property="Foreground" Value="#E53935" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAudioRecording}" Value="True">
                                                        <Setter Property="Kind" Value="StopCircle" />
                                                        <Setter Property="Foreground" Value="#757575" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                    <TextBlock VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="开启录音" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAudioRecording}" Value="True">
                                                        <Setter Property="Text" Value="停止录音" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Command="{Binding EditClipboardImageCommand}"
                                    Height="36" Padding="12,0"
                                    ToolTip="打开编辑器编辑剪贴板中的图片">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ImageEdit" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="编辑剪贴板截图"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CameraIris" Width="32" Height="32" Margin="0,0,14,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentPurple}" />
                            <StackPanel>
                                <TextBlock Text="截图工具" Style="{StaticResource MaterialDesignHeadline5TextBlock}" />
                                <TextBlock Text="支持全屏截图、区域录像与独立录音。" Opacity="0.55" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Hotkey card -->
                        <materialDesign:Card Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="快捷键设置" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" FontWeight="Bold" Margin="0,0,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" BorderBrush="{DynamicResource MaterialDesignDivider}"
                                            BorderThickness="1" CornerRadius="4" Padding="14,10"
                                            Margin="0,0,12,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource MaterialDesignTextFieldBoxBackground}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCapturingHotkey}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Keyboard" Width="18" Height="18"
                                                                     VerticalAlignment="Center" Margin="0,0,10,0"
                                                                     Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                            <TextBlock VerticalAlignment="Center" FontSize="14">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding ScreenshotHotkeyText}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
                                                        <Setter Property="FontWeight" Value="Medium"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCapturingHotkey}" Value="True">
                                                                <Setter Property="Text" Value="请按下新快捷键组合..."/>
                                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                                <Setter Property="FontWeight" Value="Normal"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Height="42" Padding="14,0" Margin="0,0,8,0"
                                                Command="{Binding StartCaptureHotkeyCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                                    <Setter Property="Content" Value="修改快捷键"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCapturingHotkey}" Value="True">
                                                            <Setter Property="Content" Value="监听中..."/>
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="取消" Height="42" Padding="14,0"
                                                Command="{Binding CancelCaptureHotkeyCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCapturingHotkey}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="注意：快捷键需包含 Ctrl 或 Alt 之一，避免与系统快捷键冲突。快捷键在全局生效，包括窗口隐藏期间。"
                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                           Opacity="0.55" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Behavior card -->
                        <materialDesign:Card Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="截图行为" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" FontWeight="Bold" Margin="0,0,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="截图后打开编辑器"
                                                   Style="{StaticResource MaterialDesignSubtitle2TextBlock}" FontWeight="Medium"/>
                                        <TextBlock Margin="0,4,20,0" Opacity="0.6" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignBody2TextBlock}">
                                                    <Setter Property="Text" Value="\u622a\u56fe\u540e\u81ea\u52a8\u6253\u5f00\u7f16\u8f91\u5668\u7a97\u53e3\uff0c\u53ef\u7528\u5212\u7b14\u6807\u6ce8\u5e76\u4fdd\u5b58\u3002"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowEditorAfterCapture}" Value="False">
                                                            <Setter Property="Text" Value="\u622a\u56fe\u540e\u76f4\u63a5\u5c06\u56fe\u7247\u590d\u5236\u5230\u526a\u8d34\u677f\uff0c\u4e0d\u6253\u5f00\u7f16\u8f91\u5668\u3002"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" VerticalAlignment="Center"
                                                  IsChecked="{Binding ShowEditorAfterCapture}" />
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Save button -->
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding SaveScreenshotSettingsCommand}"
                                Height="44" Width="160"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                                <TextBlock Text="保存设置"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Codex config profiles panel -->
            <Grid Margin="20">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="CodexProfiles">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,20"
                        CornerRadius="{StaticResource CornerRadiusCard}"
                        Padding="20,16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                    Height="36"
                                    Padding="12,0"
                                    Margin="0,0,8,0"
                                    Command="{Binding ImportCodexProfileCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Import" Width="16" Height="16" Margin="0,0,6,0" />
                                    <TextBlock Text="导入" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderCogOutline" Width="32" Height="32" Margin="0,0,14,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentTeal}" />
                            <StackPanel>
                                <TextBlock Text="Codex Profiles" Style="{StaticResource MaterialDesignHeadline5TextBlock}" />
                                <TextBlock Text="Switch between Codex profile sets in one click." Opacity="0.55" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="18"
                                Margin="0,0,0,16"
                                Background="{DynamicResource MaterialDesignPaper}">
                            <StackPanel>
                                <TextBlock Text="将包含 config.toml 和 auth.json 的文件夹拖入窗口"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6" />
                                <Border Style="{StaticResource BadgeInfo}" Margin="0,2,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="InformationOutline" Width="12" Height="12" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding CodexProfilesStatusMessage}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding CodexProfiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <materialDesign:Card Padding="16" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <materialDesign:PackIcon Kind="FolderOutline"
                                                                             Width="20"
                                                                             Height="20"
                                                                             Margin="0,0,8,0"
                                                                             Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding FolderPath}"
                                                           Opacity="0.58"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding ContentStorageSummary}"
                                                           Margin="0,4,0,0"
                                                           Opacity="0.72"
                                                           TextWrapping="Wrap" />
                                                <Border Style="{StaticResource BadgeInfo}" Margin="0,8,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="InformationOutline" Width="12" Height="12" Margin="0,0,4,0" />
                                                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <TextBox Grid.Column="1"
                                                     Margin="0,0,16,0"
                                                     MinWidth="220"
                                                     Text="{Binding Remark, UpdateSourceTrigger=LostFocus}"
                                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                     materialDesign:HintAssist.Hint="备注" />

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                             IsIndeterminate="True"
                                                             Width="22"
                                                             Height="22"
                                                             Margin="0,0,10,0"
                                                             Visibility="{Binding IsApplying, Converter={StaticResource BoolToVis}}" />
                                                <Button Height="36"
                                                        Padding="12,0"
                                                        Margin="0,0,8,0"
                                                        Command="{Binding DataContext.ApplyCodexProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignRaisedButton}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Check" Width="16" Height="16" Margin="0,0,6,0"/>
                                                        <TextBlock Text="应用"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                                        Height="36"
                                                        Padding="12,0"
                                                        Margin="0,0,8,0"
                                                        Command="{Binding DataContext.ExportCodexProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Export" Width="16" Height="16" Margin="0,0,6,0"/>
                                                        <TextBlock Text="导出"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Height="36"
                                                        Width="36"
                                                        Padding="0"
                                                        Command="{Binding DataContext.DeleteCodexProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignIconButton}"
                                                        ToolTip="删除记录">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </materialDesign:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

        </Grid>
    </Grid>
</mah:MetroWindow>
