<UserControl x:Class="MyTools.Views.FrpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewModels="clr-namespace:MyTools.ViewModels"
             Loaded="FrpView_OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <viewModels:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,0,0,12" CornerRadius="{StaticResource CornerRadiusCard}" Padding="12,8">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                    <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource StatusPill}" Margin="12,0,0,0">
                    <TextBlock Text="{Binding ConnectionStatusText}" />
                </Border>
                <StackPanel Orientation="Horizontal">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource BrushAccentGradient}" Margin="0,0,10,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="VpnKey" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="隧道穿透" Style="{StaticResource TextHeadline}" />
                        <TextBlock Text="frp 内网穿透 · 指定本机端口映射到公网服务器" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <materialDesign:Card Grid.Row="0" Grid.Column="0" Style="{StaticResource SectionCardOutlined}" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="服务器配置" Style="{StaticResource TextSubtitle}" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="132" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Row="0"
                                     Grid.Column="0"
                                     Text="{Binding FrpServerAddress, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource StandardTextBox}"
                                     materialDesign:HintAssist.Hint="公网 IP 或域名"
                                     materialDesign:HintAssist.IsFloating="False" />

                            <TextBox Grid.Row="0"
                                     Grid.Column="2"
                                     Text="{Binding FrpServerPort, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource StandardTextBox}"
                                     materialDesign:HintAssist.Hint="端口，默认 7000"
                                     materialDesign:HintAssist.IsFloating="False" />

                            <PasswordBox x:Name="FrpTokenBox"
                                         Grid.Row="1"
                                         Grid.ColumnSpan="3"
                                         Height="36"
                                         Margin="0,10,0,0"
                                         Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                         materialDesign:HintAssist.Hint="frps.ini 里 token = 后面的密码"
                                         materialDesign:HintAssist.IsFloating="False"
                                         PasswordChanged="FrpTokenBox_OnPasswordChanged" />

                            <TextBlock Grid.Row="2"
                                       Grid.ColumnSpan="3"
                                       Text="Token 已使用 Windows DPAPI 加密保存，仅当前 Windows 用户可解密。"
                                       Style="{StaticResource TextHint}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </Grid>

                        <Button Command="{Binding SaveConfigCommand}" Style="{StaticResource GhostActionButton}" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveOutline" Width="15" Height="15" Margin="0,0,6,0" />
                                <TextBlock Text="保存配置" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Row="0" Grid.Column="2" Style="{StaticResource SectionCardOutlined}" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="添加规则" Style="{StaticResource TextSubtitle}" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Row="0"
                                     Grid.Column="0"
                                     Text="{Binding DraftRule.LocalPort, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource StandardTextBox}"
                                     materialDesign:HintAssist.Hint="本机端口，如 3389"
                                     materialDesign:HintAssist.IsFloating="False" />

                            <TextBox Grid.Row="0"
                                     Grid.Column="2"
                                     Text="{Binding DraftRule.RemotePort, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource StandardTextBox}"
                                     materialDesign:HintAssist.Hint="公网端口，如 33890"
                                     materialDesign:HintAssist.IsFloating="False" />

                            <TextBox Grid.Row="1"
                                     Grid.ColumnSpan="3"
                                     Text="{Binding DraftRule.Description, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource StandardTextBox}"
                                     Margin="0,10,0,0"
                                     materialDesign:HintAssist.Hint="备注说明，如 远程桌面"
                                     materialDesign:HintAssist.IsFloating="False" />
                        </Grid>

                        <TextBlock Text="服务器安全组必须放行远程端口；远程端口不能与其他电脑重复。"
                                   Style="{StaticResource TextHint}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />

                        <Button Command="{Binding AddRuleCommand}" Style="{StaticResource GhostActionButton}" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="15" Height="15" Margin="0,0,6,0" />
                                <TextBlock Text="添加规则" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource SectionCardOutlined}" Padding="14,12" Margin="0,4,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PublicAddressPreview}" Style="{StaticResource TextHint}" VerticalAlignment="Center" />
                            <TextBlock Text="隧道规则" Style="{StaticResource TextSubtitle}" FontWeight="SemiBold" />
                        </DockPanel>

                        <TextBlock Grid.Row="1"
                                   Text="暂无隧道规则，请先添加本地端口和远程端口。"
                                   Style="{StaticResource TextHint}"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,18"
                                   Visibility="{Binding HasRules, Converter={StaticResource InverseBoolToVis}}" />

                        <ItemsControl Grid.Row="2" ItemsSource="{Binding FrpRules}" Visibility="{Binding HasRules, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="42" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="127.0.0.1:" Style="{StaticResource TextCaption}" />
                                                <TextBlock Text="{Binding LocalPort}" Style="{StaticResource TextCaption}" FontWeight="SemiBold" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="→" Style="{StaticResource TextCaption}" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DataContext.FrpServerAddress, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource TextCaption}" MaxWidth="112" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text=":" Style="{StaticResource TextCaption}" />
                                                <TextBlock Text="{Binding RemotePort}" Style="{StaticResource TextCaption}" FontWeight="SemiBold" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding Description}"
                                                       Style="{StaticResource TextHint}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0" />

                                            <Button Grid.Column="5"
                                                    Width="32"
                                                    MinWidth="32"
                                                    Height="28"
                                                    Padding="0"
                                                    Style="{StaticResource GhostActionButton}"
                                                    Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="14" Height="14" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </materialDesign:Card>

                <materialDesign:Card Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource SectionCardOutlined}" Padding="0" Margin="0,4,0,0">
                    <Expander>
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ServerOutline" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource BrushAccentAmber}" />
                                <TextBlock Text="服务器端配置说明（阿里云 Ubuntu）" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="16,4,16,16">

                            <TextBlock Text="第一步：安装 frps" Style="{StaticResource TextBodyStandard}" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Style="{StaticResource TextHint}" TextWrapping="Wrap" Margin="0,0,0,4">
                                <Run>SSH 登录阿里云，执行以下命令（使用 v0.50.0，与客户端版本一致）：</Run>
                            </TextBlock>
                            <Border Background="{DynamicResource MaterialDesignDivider}" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                                <TextBlock FontFamily="Consolas, Courier New" FontSize="11" Foreground="{DynamicResource MaterialDesignBody}" TextWrapping="Wrap" xml:space="preserve">wget https://github.com/fatedier/frp/releases/download/v0.50.0/frp_0.50.0_linux_amd64.tar.gz
tar -xzf frp_0.50.0_linux_amd64.tar.gz
sudo cp frp_0.50.0_linux_amd64/frps /usr/local/bin/</TextBlock>
                            </Border>

                            <TextBlock Text="第二步：写配置文件 /etc/frps.ini" Style="{StaticResource TextBodyStandard}" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <Border Background="{DynamicResource MaterialDesignDivider}" CornerRadius="4" Padding="10,8" Margin="0,0,0,4">
                                <TextBlock FontFamily="Consolas, Courier New" FontSize="11" Foreground="{DynamicResource MaterialDesignBody}" TextWrapping="Wrap" xml:space="preserve">[common]
bind_port = 7000
token = 你自己设一个强密码</TextBlock>
                            </Border>
                            <TextBlock Text="⚠ token 就是上方「Token」框里要填的密码，请设为较复杂的字符串。" Style="{StaticResource TextHint}" TextWrapping="Wrap" Margin="0,0,0,10" />

                            <TextBlock Text="第三步：设置开机自启（systemd）" Style="{StaticResource TextBodyStandard}" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <Border Background="{DynamicResource MaterialDesignDivider}" CornerRadius="4" Padding="10,8" Margin="0,0,0,4">
                                <TextBlock FontFamily="Consolas, Courier New" FontSize="11" Foreground="{DynamicResource MaterialDesignBody}" TextWrapping="Wrap" xml:space="preserve">sudo tee /etc/systemd/system/frps.service &lt;&lt;'EOF'
[Unit]
Description=frps
After=network.target
[Service]
ExecStart=/usr/local/bin/frps -c /etc/frps.ini
Restart=always
[Install]
WantedBy=multi-user.target
EOF
sudo systemctl enable --now frps</TextBlock>
                            </Border>
                            <TextBlock Text="验证是否运行：sudo systemctl status frps" FontFamily="Consolas, Courier New" FontSize="11" Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,10" />

                            <TextBlock Text="第四步：阿里云安全组放行端口" Style="{StaticResource TextBodyStandard}" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Style="{StaticResource TextHint}" TextWrapping="Wrap">
                                <Run>进入阿里云控制台 → 安全组 → 入方向规则，放行以下端口（协议 TCP）：</Run>
                            </TextBlock>
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Style="{StaticResource TextHint}" TextWrapping="Wrap"><Run FontWeight="SemiBold">7000</Run><Run> — frpc 客户端连接 frps 的控制端口（必须放行）</Run></TextBlock>
                                <TextBlock Style="{StaticResource TextHint}" TextWrapping="Wrap" Margin="0,2,0,0"><Run FontWeight="SemiBold">你在「添加规则」里填的每个公网端口</Run><Run> — 如 33890、8081 等</Run></TextBlock>
                            </StackPanel>

                        </StackPanel>
                    </Expander>
                </materialDesign:Card>

                <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Padding="2,8,2,0">
                    <TextBlock Text="启动成功不代表公网可访问；请确认本机服务正在监听、阿里云安全组已放行远程端口，多台电脑不要复用同一个远程端口。"
                               Style="{StaticResource TextHint}"
                               TextWrapping="Wrap" />
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,10" Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="{StaticResource CornerRadiusCard}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Command="{Binding StartTunnelCommand}" IsEnabled="{Binding CanStart}" Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PlayCircleOutline" Width="15" Height="15" Margin="0,0,6,0" />
                            <TextBlock Text="启动隧道" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding StopTunnelCommand}" IsEnabled="{Binding CanStop}" Style="{StaticResource GhostActionButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="StopCircleOutline" Width="15" Height="15" Margin="0,0,6,0" />
                            <TextBlock Text="停止隧道" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding PublicAddressPreview}" Style="{StaticResource TextCaption}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusHint}" Style="{StaticResource TextHint}" TextWrapping="Wrap" Margin="0,2,16,0" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
