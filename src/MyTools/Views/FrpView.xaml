<UserControl x:Class="MyTools.Views.FrpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewModels="clr-namespace:MyTools.ViewModels"
             Loaded="FrpView_OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <viewModels:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <SolidColorBrush x:Key="FrpInputForeground" Color="#111827" />
        <SolidColorBrush x:Key="FrpInputBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="FrpInputBorder" Color="#64748B" />
        <SolidColorBrush x:Key="FrpInputHint" Color="#475569" />
        <SolidColorBrush x:Key="FrpInputSelection" Color="#BFDBFE" />
        <SolidColorBrush x:Key="FrpInputDisabledBackground" Color="#F1F5F9" />
        <SolidColorBrush x:Key="FrpInputDisabledForeground" Color="#64748B" />

        <Style x:Key="FrpVisibleTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource FrpInputForeground}" />
            <Setter Property="Background" Value="{StaticResource FrpInputBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource FrpInputBorder}" />
            <Setter Property="BorderThickness" Value="1.25" />
            <Setter Property="CaretBrush" Value="{StaticResource FrpInputForeground}" />
            <Setter Property="SelectionBrush" Value="{StaticResource FrpInputSelection}" />
            <Setter Property="SelectionTextBrush" Value="{StaticResource FrpInputForeground}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource FrpInputForeground}" />
            <Setter Property="materialDesign:HintAssist.Foreground" Value="{StaticResource FrpInputHint}" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BrushAccentPurple}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource FrpInputDisabledBackground}" />
                    <Setter Property="Foreground" Value="{StaticResource FrpInputDisabledForeground}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource FrpInputDisabledForeground}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FrpVisiblePasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource FrpInputForeground}" />
            <Setter Property="Background" Value="{StaticResource FrpInputBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource FrpInputBorder}" />
            <Setter Property="BorderThickness" Value="1.25" />
            <Setter Property="SelectionBrush" Value="{StaticResource FrpInputSelection}" />
            <Setter Property="SelectionTextBrush" Value="{StaticResource FrpInputForeground}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource FrpInputForeground}" />
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
            <Setter Property="materialDesign:HintAssist.Foreground" Value="{StaticResource FrpInputHint}" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BrushAccentPurple}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource FrpInputDisabledBackground}" />
                    <Setter Property="Foreground" Value="{StaticResource FrpInputDisabledForeground}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource FrpInputDisabledForeground}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FrpVisibleComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource FrpInputForeground}" />
            <Setter Property="Background" Value="{StaticResource FrpInputBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource FrpInputBorder}" />
            <Setter Property="BorderThickness" Value="1.25" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource FrpInputForeground}" />
            <Setter Property="materialDesign:HintAssist.Foreground" Value="{StaticResource FrpInputHint}" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BrushAccentPurple}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource FrpInputDisabledBackground}" />
                    <Setter Property="Foreground" Value="{StaticResource FrpInputDisabledForeground}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource FrpInputDisabledForeground}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FrpVisibleComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource FrpInputForeground}" />
            <Setter Property="Background" Value="{StaticResource FrpInputBackground}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#EEF2FF" />
                    <Setter Property="Foreground" Value="{StaticResource FrpInputForeground}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E0E7FF" />
                    <Setter Property="Foreground" Value="{StaticResource FrpInputForeground}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Premium dark header for consistency with System Optimization -->
        <Border Grid.Row="0" Margin="0,0,0,12" CornerRadius="12" Padding="14,10"
                Background="#1E293B" BorderThickness="0">
            <DockPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource StatusPill}" Margin="12,0,0,0">
                    <TextBlock Text="{Binding ConnectionStatusText}" />
                </Border>
                <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BrushAccentGradient}" Margin="0,0,12,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="VpnKey" Width="18" Height="18" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="隧道穿透" Style="{StaticResource TextHeadline}" Foreground="White" />
                        <TextBlock Text="frp 内网穿透 · 指定本机端口映射到公网服务器" Foreground="#94A3B8" Style="{StaticResource TextCaption}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <materialDesign:Card Grid.Row="0" Grid.Column="0" Style="{StaticResource SectionCardOutlined}" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="服务器配置" Style="{StaticResource TextSubtitle}" FontWeight="SemiBold" Margin="0,0,0,8" />

                        <ComboBox ItemsSource="{Binding ServerPresets}"
                                  SelectedItem="{Binding SelectedServerPreset, Mode=TwoWay}"
                                  Style="{StaticResource FrpVisibleComboBox}"
                                  ItemContainerStyle="{StaticResource FrpVisibleComboBoxItem}"
                                  materialDesign:HintAssist.Hint="选择服务器预设（自动填入地址和端口）"
                                  materialDesign:HintAssist.IsFloating="False"
                                  Margin="0,0,0,8">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource FrpInputForeground}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Border Background="{DynamicResource MaterialDesignDivider}" CornerRadius="6" Padding="8,5" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="当前服务器：" Style="{StaticResource TextHint}" />
                                <TextBlock Text="{Binding CurrentServerSummary}" Style="{StaticResource TextCaption}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="132" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Row="0"
                                     Grid.Column="0"
                                     Text="{Binding FrpServerAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FrpVisibleTextBox}"
                                     ToolTip="公网 IP 或域名" />

                            <TextBox Grid.Row="0"
                                     Grid.Column="2"
                                     Text="{Binding FrpServerPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FrpVisibleTextBox}"
                                     ToolTip="端口，默认 7000" />

                            <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <PasswordBox x:Name="FrpTokenBox"
                                                 Style="{StaticResource FrpVisiblePasswordBox}"
                                                 materialDesign:HintAssist.Hint="frps.ini 里 token = 后面的密码"
                                                 materialDesign:HintAssist.IsFloating="False"
                                                 PasswordChar="*"
                                                 PasswordChanged="FrpTokenBox_OnPasswordChanged" />

                                    <TextBlock x:Name="FrpTokenMaskText"
                                               Text="{Binding FrpTokenMask}"
                                               Foreground="#111827"
                                               Background="#FFFFFF"
                                               Margin="8,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False" />
                                </Grid>

                                <TextBox x:Name="FrpTokenVisibleBox"
                                         Grid.Column="0"
                                         Text="{Binding FrpToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FrpVisibleTextBox}"
                                         Visibility="Collapsed"
                                         ToolTip="frps.ini 里 token = 后面的密码" />

                                <ToggleButton x:Name="ShowFrpTokenButton"
                                              Grid.Column="2"
                                              Height="36"
                                              Content="显示Token"
                                              Checked="ShowFrpTokenButton_OnChecked"
                                              Unchecked="ShowFrpTokenButton_OnUnchecked" />
                            </Grid>

                            <TextBlock Grid.Row="2"
                                       Grid.ColumnSpan="3"
                                       Text="Token 已使用 Windows DPAPI 加密保存，仅当前 Windows 用户可解密。"
                                       Style="{StaticResource TextHint}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </Grid>

                        <Button Command="{Binding SaveConfigCommand}" Style="{StaticResource GhostActionButton}" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveOutline" Width="15" Height="15" Margin="0,0,6,0" />
                                <TextBlock Text="保存配置" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Row="0" Grid.Column="2" Style="{StaticResource SectionCardOutlined}" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="添加规则" Style="{StaticResource TextSubtitle}" FontWeight="SemiBold" Margin="0,0,0,8" />

                        <ComboBox ItemsSource="{Binding PortPresets}"
                                  SelectedItem="{Binding SelectedPortPreset, Mode=TwoWay}"
                                  Style="{StaticResource FrpVisibleComboBox}"
                                  ItemContainerStyle="{StaticResource FrpVisibleComboBoxItem}"
                                  materialDesign:HintAssist.Hint="选择常用预设（自动填入下方端口）"
                                  materialDesign:HintAssist.IsFloating="False"
                                  Margin="0,0,0,8">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource FrpInputForeground}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Border Background="{DynamicResource MaterialDesignDivider}" CornerRadius="6" Padding="8,5" Margin="0,0,0,10">
                            <TextBlock Text="{Binding CurrentPortPresetSummary}" Style="{StaticResource TextCaption}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </Border>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Row="0"
                                     Grid.Column="0"
                                     Text="{Binding DraftRule.LocalPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FrpVisibleTextBox}"
                                     ToolTip="本机端口，如 3389" />

                            <TextBox Grid.Row="0"
                                     Grid.Column="2"
                                     Text="{Binding DraftRule.RemotePort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FrpVisibleTextBox}"
                                     ToolTip="公网端口，如 33890" />

                            <TextBox Grid.Row="1"
                                     Grid.ColumnSpan="3"
                                     Text="{Binding DraftRule.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FrpVisibleTextBox}"
                                     Margin="0,10,0,0"
                                     ToolTip="备注说明，如 远程桌面" />
                        </Grid>

                        <TextBlock Text="服务器安全组必须放行远程端口；远程端口不能与其他电脑重复。"
                                   Style="{StaticResource TextHint}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />

                        <Button Command="{Binding AddRuleCommand}" Style="{StaticResource GhostActionButton}" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="15" Height="15" Margin="0,0,6,0" />
                                <TextBlock Text="添加规则" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource SectionCardOutlined}" Padding="14,12" Margin="0,4,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PublicAddressPreview}" Style="{StaticResource TextHint}" VerticalAlignment="Center" />
                            <TextBlock Text="隧道规则" Style="{StaticResource TextSubtitle}" FontWeight="SemiBold" />
                        </DockPanel>

                        <TextBlock Grid.Row="1"
                                   Text="暂无隧道规则，请先添加本地端口和远程端口。"
                                   Style="{StaticResource TextHint}"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,18"
                                   Visibility="{Binding HasRules, Converter={StaticResource InverseBoolToVis}}" />

                        <ItemsControl Grid.Row="2" ItemsSource="{Binding FrpRules}" Visibility="{Binding HasRules, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="42" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="127.0.0.1:" Style="{StaticResource TextCaption}" />
                                                <TextBlock Text="{Binding LocalPort}" Style="{StaticResource TextCaption}" FontWeight="SemiBold" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="→" Style="{StaticResource TextCaption}" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DataContext.FrpServerAddress, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource TextCaption}" MaxWidth="112" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text=":" Style="{StaticResource TextCaption}" />
                                                <TextBlock Text="{Binding RemotePort}" Style="{StaticResource TextCaption}" FontWeight="SemiBold" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding Description}"
                                                       Style="{StaticResource TextHint}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0" />

                                            <Button Grid.Column="5"
                                                    Width="32"
                                                    MinWidth="32"
                                                    Height="28"
                                                    Padding="0"
                                                    Style="{StaticResource GhostActionButton}"
                                                    Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="14" Height="14" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </materialDesign:Card>

                <materialDesign:Card Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource SectionCardOutlined}" Padding="0" Margin="0,4,0,0">
                    <Expander>
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ServerOutline" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource BrushAccentAmber}" />
                                <TextBlock Text="服务器端配置说明（阿里云 Ubuntu）" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="16,4,16,16">

                            <TextBlock Text="第一步：安装 frps" Style="{StaticResource TextBodyStandard}" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Style="{StaticResource TextHint}" TextWrapping="Wrap" Margin="0,0,0,4">
                                <Run>SSH 登录阿里云，执行以下命令（使用 v0.50.0，与客户端版本一致）：</Run>
                            </TextBlock>
                            <Border Background="{DynamicResource MaterialDesignDivider}" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                                <TextBlock FontFamily="Consolas, Courier New" FontSize="11" Foreground="{DynamicResource MaterialDesignBody}" TextWrapping="Wrap" xml:space="preserve">wget https://github.com/fatedier/frp/releases/download/v0.50.0/frp_0.50.0_linux_amd64.tar.gz
tar -xzf frp_0.50.0_linux_amd64.tar.gz
sudo cp frp_0.50.0_linux_amd64/frps /usr/local/bin/</TextBlock>
                            </Border>

                            <TextBlock Text="第二步：写配置文件 /etc/frps.ini" Style="{StaticResource TextBodyStandard}" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <Border Background="{DynamicResource MaterialDesignDivider}" CornerRadius="4" Padding="10,8" Margin="0,0,0,4">
                                <TextBlock FontFamily="Consolas, Courier New" FontSize="11" Foreground="{DynamicResource MaterialDesignBody}" TextWrapping="Wrap" xml:space="preserve">[common]
bind_port = 7000
token = 你自己设一个强密码</TextBlock>
                            </Border>
                            <TextBlock Text="⚠ token 就是上方「Token」框里要填的密码，请设为较复杂的字符串。" Style="{StaticResource TextHint}" TextWrapping="Wrap" Margin="0,0,0,10" />

                            <TextBlock Text="第三步：设置开机自启（systemd）" Style="{StaticResource TextBodyStandard}" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <Border Background="{DynamicResource MaterialDesignDivider}" CornerRadius="4" Padding="10,8" Margin="0,0,0,4">
                                <TextBlock FontFamily="Consolas, Courier New" FontSize="11" Foreground="{DynamicResource MaterialDesignBody}" TextWrapping="Wrap" xml:space="preserve">sudo tee /etc/systemd/system/frps.service &lt;&lt;'EOF'
[Unit]
Description=frps
After=network.target
[Service]
ExecStart=/usr/local/bin/frps -c /etc/frps.ini
Restart=always
[Install]
WantedBy=multi-user.target
EOF
sudo systemctl enable --now frps</TextBlock>
                            </Border>
                            <TextBlock Text="验证是否运行：sudo systemctl status frps" FontFamily="Consolas, Courier New" FontSize="11" Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,10" />

                            <TextBlock Text="第四步：阿里云安全组放行端口" Style="{StaticResource TextBodyStandard}" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Style="{StaticResource TextHint}" TextWrapping="Wrap">
                                <Run>进入阿里云控制台 → 安全组 → 入方向规则，放行以下端口（协议 TCP）：</Run>
                            </TextBlock>
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Style="{StaticResource TextHint}" TextWrapping="Wrap"><Run FontWeight="SemiBold">7000</Run><Run> — frpc 客户端连接 frps 的控制端口（必须放行）</Run></TextBlock>
                                <TextBlock Style="{StaticResource TextHint}" TextWrapping="Wrap" Margin="0,2,0,0"><Run FontWeight="SemiBold">你在「添加规则」里填的每个公网端口</Run><Run> — 如 33890、8081 等</Run></TextBlock>
                            </StackPanel>

                        </StackPanel>
                    </Expander>
                </materialDesign:Card>

                <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Padding="2,8,2,0">
                    <TextBlock Text="启动成功不代表公网可访问；请确认本机服务正在监听、阿里云安全组已放行远程端口，多台电脑不要复用同一个远程端口。"
                               Style="{StaticResource TextHint}"
                               TextWrapping="Wrap" />
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,10" Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="{StaticResource CornerRadiusCard}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Command="{Binding StartTunnelCommand}" IsEnabled="{Binding CanStart}" Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PlayCircleOutline" Width="15" Height="15" Margin="0,0,6,0" />
                            <TextBlock Text="启动隧道" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding StopTunnelCommand}" IsEnabled="{Binding CanStop}" Style="{StaticResource GhostActionButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="StopCircleOutline" Width="15" Height="15" Margin="0,0,6,0" />
                            <TextBlock Text="停止隧道" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding PublicAddressPreview}" Style="{StaticResource TextCaption}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusHint}" Style="{StaticResource TextHint}" TextWrapping="Wrap" Margin="0,2,16,0" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
