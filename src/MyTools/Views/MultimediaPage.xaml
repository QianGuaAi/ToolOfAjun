<UserControl x:Class="MyTools.Views.MultimediaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewModels="clr-namespace:MyTools.ViewModels"
             Focusable="True"
             Loaded="MultimediaPage_OnLoaded"
             Unloaded="MultimediaPage_OnUnloaded"
             PreviewKeyDown="MultimediaPage_OnPreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="FolderTreeExpanderStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="ExpanderBox"
                                Width="13"
                                Height="13"
                                CornerRadius="2"
                                Background="{DynamicResource MaterialDesignCardBackground}"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="1">
                            <TextBlock x:Name="ExpanderGlyph"
                                       Text="+"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,-2,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ExpanderGlyph" Property="Text" Value="-" />
                                <Setter TargetName="ExpanderGlyph" Property="Margin" Value="0,-3,0,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ExpanderBox" Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ConnectedFolderTreeItemStyle" TargetType="{x:Type TreeViewItem}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TreeViewItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="0"
                                    Width="1"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource MaterialDesignDivider}" />
                            <Border Grid.Row="0"
                                    Grid.Column="0"
                                    Height="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource MaterialDesignDivider}" />
                            <ToggleButton x:Name="Expander"
                                          Grid.Row="0"
                                          Grid.Column="0"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          ClickMode="Press"
                                          Style="{StaticResource FolderTreeExpanderStyle}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Border x:Name="HeaderBorder"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Padding="2,3"
                                    CornerRadius="4"
                                    Background="Transparent">
                                <ContentPresenter x:Name="PART_Header"
                                                  ContentSource="Header"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="0,1,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#225E72E4" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#125E72E4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="Expanded" Handler="FolderTreeItem_OnExpanded" />
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type viewModels:MediaFolderNode}" ItemsSource="{Binding Children}" ItemContainerStyle="{StaticResource ConnectedFolderTreeItemStyle}">
            <StackPanel Orientation="Horizontal" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="FolderNodeHeader_OnMouseLeftButtonDown">
                <materialDesign:PackIcon Kind="FolderOutline" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentAmber}" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            </StackPanel>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,0,0,12" CornerRadius="{StaticResource CornerRadiusCard}" Padding="12,8">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                    <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource StatusPill}" Margin="0,0,10,0">
                        <TextBlock Text="{Binding StatusMessage}" />
                    </Border>
                    <Button Style="{StaticResource GhostActionButton}" Command="{Binding ExitMultimediaCommand}" Height="34" Padding="12,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close" Width="15" Height="15" Margin="0,0,6,0" />
                            <TextBlock Text="退出多媒体" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource BrushAccentGradient}" Margin="0,0,10,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ImageMultipleOutline" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="多媒体" Style="{StaticResource TextHeadline}" />
                        <TextBlock Text="图片查看 · 音视频播放 · 格式转换" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Visibility="{Binding IsExplorerMode, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220" MaxWidth="520" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="220" MinHeight="140" MaxHeight="420" />
                </Grid.RowDefinitions>

                <materialDesign:Card Grid.Row="0" Padding="10" Margin="0,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="文件夹" Style="{StaticResource TextSubtitle}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TreeView x:Name="FolderTree" Grid.Row="1" ItemsSource="{Binding FolderTreeNodes}" SelectedItemChanged="FolderTree_OnSelectedItemChanged" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource ConnectedFolderTreeItemStyle}" />
                    </Grid>
                </materialDesign:Card>

                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" Background="Transparent" />

                <materialDesign:Card Grid.Row="2" Padding="10" Margin="0,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="预览" Style="{StaticResource TextSubtitle}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <Grid Grid.Row="1">
                            <TextBlock Text="单击右侧媒体文件进行预览" Style="{StaticResource TextHint}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="{Binding IsPreviewEmpty, Converter={StaticResource BoolToVis}}" />

                            <Grid Visibility="{Binding IsPreviewImage, Converter={StaticResource BoolToVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Background="{DynamicResource MaterialDesignToolBarBackground}" CornerRadius="8" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding PreviewImageSource}" Stretch="Uniform" />
                                        <Button Style="{StaticResource PrimaryActionButton}" Command="{Binding PreviousImageCommand}" HorizontalAlignment="Left" VerticalAlignment="Center" Height="30" Padding="10,0" Margin="8,0,0,0">
                                            <TextBlock Text="上一张" />
                                        </Button>
                                        <Button Style="{StaticResource PrimaryActionButton}" Command="{Binding NextImageCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Height="30" Padding="10,0" Margin="0,0,8,0">
                                            <TextBlock Text="下一张" />
                                        </Button>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding SelectedMediaFile.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding PreviewImageInfo}" Style="{StaticResource TextHint}" />
                                </StackPanel>
                            </Grid>

                            <Grid Visibility="{Binding IsPreviewVideo, Converter={StaticResource BoolToVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Background="Black" CornerRadius="8" ClipToBounds="True">
                                    <MediaElement x:Name="PreviewMediaElement" Source="{Binding PreviewMediaSource}" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform" MediaEnded="PreviewMediaElement_OnMediaEnded" />
                                </Border>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{StaticResource GhostActionButton}" Click="PreviewPlayPause_OnClick" Padding="10,0" Height="30">
                                        <materialDesign:PackIcon Kind="PlayPause" Width="15" Height="15" />
                                    </Button>
                                    <Slider x:Name="PreviewPositionSlider" Minimum="0" Maximum="1" Value="0" VerticalAlignment="Center" Margin="8,0" Width="110" />
                                    <Button Style="{StaticResource GhostActionButton}" Click="PreviewMute_OnClick" Padding="10,0" Height="30">
                                        <materialDesign:PackIcon Kind="VolumeMute" Width="15" Height="15" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Grid Visibility="{Binding IsPreviewAudio, Converter={StaticResource BoolToVis}}">
                                <StackPanel VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="MusicCircleOutline" Width="44" Height="44" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                    <TextBlock Text="{Binding SelectedMediaFile.Name}" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,8,0,8" />
                                    <MediaElement x:Name="PreviewAudioElement" Source="{Binding PreviewMediaSource}" LoadedBehavior="Manual" UnloadedBehavior="Manual" Visibility="Collapsed" MediaEnded="PreviewMediaElement_OnMediaEnded" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource GhostActionButton}" Click="PreviewAudioPlayPause_OnClick" Padding="10,0" Height="30">
                                            <materialDesign:PackIcon Kind="PlayPause" Width="15" Height="15" />
                                        </Button>
                                        <Slider x:Name="PreviewAudioPositionSlider" Minimum="0" Maximum="1" Value="0" VerticalAlignment="Center" Margin="8,0" Width="110" />
                                        <Button Style="{StaticResource GhostActionButton}" Click="PreviewAudioMute_OnClick" Padding="10,0" Height="30">
                                            <materialDesign:PackIcon Kind="VolumeMute" Width="15" Height="15" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </materialDesign:Card>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Background="Transparent" />

            <materialDesign:Card Grid.Column="2" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">

                        <TextBlock Text="媒体文件" Style="{StaticResource TextSubtitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ListView x:Name="MediaFileList" Grid.Row="1" ItemsSource="{Binding MediaFiles}" SelectedItem="{Binding SelectedMediaFile, Mode=TwoWay}" MouseDoubleClick="MediaFileList_OnMouseDoubleClick" PreviewMouseRightButtonDown="MediaFileList_OnPreviewMouseRightButtonDown" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="格式转换" Command="{Binding PlacementTarget.DataContext.OpenConvertDialogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="图片转 PDF" Command="{Binding PlacementTarget.DataContext.ConvertImageToPdfCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="PDF 转图片" Command="{Binding PlacementTarget.DataContext.ConvertPdfToImagesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="外部打开" Command="{Binding PlacementTarget.DataContext.OpenExternalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="选择" Width="54">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="文件名" DisplayMemberBinding="{Binding Name}" Width="260" />
                                <GridViewColumn Header="类型" DisplayMemberBinding="{Binding KindText}" Width="72" />
                                <GridViewColumn Header="大小" DisplayMemberBinding="{Binding SizeText}" Width="90" />
                                <GridViewColumn Header="修改时间" DisplayMemberBinding="{Binding ModifiedText}" Width="140" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBlock Grid.Row="2" Text="{Binding SelectedFolderPath}" Style="{StaticResource TextHint}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                </Grid>
            </materialDesign:Card>
        </Grid>

        <Grid Grid.Row="1" Visibility="{Binding IsImmersive, Converter={StaticResource BoolToVis}}">
            <Border Background="#F0000000" CornerRadius="{StaticResource CornerRadiusCard}" Padding="12">
                <Grid>
                    <Button Style="{StaticResource GhostActionButton}" Command="{Binding ExitImmersiveCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Height="34" Padding="12,0" Panel.ZIndex="2">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="KeyboardEsc" Width="15" Height="15" Margin="0,0,6,0" />
                            <TextBlock Text="返回列表" />
                        </StackPanel>
                    </Button>

                    <Grid Visibility="{Binding IsImmersiveImage, Converter={StaticResource BoolToVis}}">
                        <Image Source="{Binding ImmersiveImageSource}" Stretch="Uniform" />
                        <Button Style="{StaticResource PrimaryActionButton}" Command="{Binding PreviousImageCommand}" HorizontalAlignment="Left" VerticalAlignment="Center" Height="44" Padding="16,0" Margin="24,0,0,0" Panel.ZIndex="3">
                            <TextBlock Text="上一张" FontWeight="SemiBold" />
                        </Button>
                        <Button Style="{StaticResource PrimaryActionButton}" Command="{Binding NextImageCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Height="44" Padding="16,0" Margin="0,0,24,0" Panel.ZIndex="3">
                            <TextBlock Text="下一张" FontWeight="SemiBold" />
                        </Button>
                    </Grid>

                    <Grid Visibility="{Binding IsImmersiveVideo, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <MediaElement x:Name="ImmersiveMediaElement" Source="{Binding ImmersiveMediaSource}" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform" MediaEnded="ImmersiveMediaElement_OnMediaEnded" />
                        <Border Grid.Row="1" Background="#CC111111" CornerRadius="8" Padding="10" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource GhostActionButton}" Click="ImmersivePlayPause_OnClick" Padding="12,0" Height="34">
                                    <materialDesign:PackIcon Kind="PlayPause" Width="16" Height="16" />
                                </Button>
                                <Slider x:Name="ImmersivePositionSlider" Minimum="0" Maximum="1" Value="0" Width="360" Margin="10,0" VerticalAlignment="Center" />
                                <Button Style="{StaticResource GhostActionButton}" Click="ImmersiveMute_OnClick" Padding="12,0" Height="34">
                                    <materialDesign:PackIcon Kind="VolumeMute" Width="16" Height="16" />
                                </Button>
                                <TextBlock Text="{Binding SelectedMediaFile.Name}" Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Visibility="{Binding IsImmersiveAudio, Converter={StaticResource BoolToVis}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="520">
                            <materialDesign:PackIcon Kind="MusicCircle" Width="96" Height="96" HorizontalAlignment="Center" Foreground="White" Opacity="0.92" />
                            <TextBlock Text="{Binding SelectedMediaFile.Name}" Foreground="White" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,14,0,12" />
                            <MediaElement x:Name="ImmersiveAudioElement" Source="{Binding ImmersiveMediaSource}" LoadedBehavior="Manual" UnloadedBehavior="Manual" Visibility="Collapsed" MediaEnded="ImmersiveMediaElement_OnMediaEnded" />
                            <Slider x:Name="ImmersiveAudioPositionSlider" Minimum="0" Maximum="1" Value="0" Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource PrimaryActionButton}" Click="ImmersiveAudioPlayPause_OnClick" Width="96" Height="44" Padding="12,0">
                                    <materialDesign:PackIcon Kind="PlayPause" Width="20" Height="20" />
                                </Button>
                                <Button Style="{StaticResource GhostActionButton}" Click="ImmersiveAudioMute_OnClick" Height="44" Padding="14,0" Margin="10,0,0,0">
                                    <materialDesign:PackIcon Kind="VolumeMute" Width="18" Height="18" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
