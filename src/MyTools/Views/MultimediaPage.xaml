<UserControl x:Class="MyTools.Views.MultimediaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewModels="clr-namespace:MyTools.ViewModels"
             Focusable="True"
             Loaded="MultimediaPage_OnLoaded"
             Unloaded="MultimediaPage_OnUnloaded"
             PreviewKeyDown="MultimediaPage_OnPreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <viewModels:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility" />
        <Style x:Key="FolderTreeExpanderStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="ExpanderBox"
                                Width="13"
                                Height="13"
                                CornerRadius="2"
                                Background="{DynamicResource MaterialDesignCardBackground}"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="1">
                            <TextBlock x:Name="ExpanderGlyph"
                                       Text="+"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,-2,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ExpanderGlyph" Property="Text" Value="-" />
                                <Setter TargetName="ExpanderGlyph" Property="Margin" Value="0,-3,0,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ExpanderBox" Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ConnectedFolderTreeItemStyle" TargetType="{x:Type TreeViewItem}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TreeViewItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="0"
                                    Width="1"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource MaterialDesignDivider}" />
                            <Border Grid.Row="0"
                                    Grid.Column="0"
                                    Height="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource MaterialDesignDivider}" />
                            <ToggleButton x:Name="Expander"
                                          Grid.Row="0"
                                          Grid.Column="0"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          ClickMode="Press"
                                          Style="{StaticResource FolderTreeExpanderStyle}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Border x:Name="HeaderBorder"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Padding="2,3"
                                    CornerRadius="4"
                                    Background="Transparent">
                                <ContentPresenter x:Name="PART_Header"
                                                  ContentSource="Header"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="0,1,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#225E72E4" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#125E72E4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="Expanded" Handler="FolderTreeItem_OnExpanded" />
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type viewModels:MediaFolderNode}" ItemsSource="{Binding Children}" ItemContainerStyle="{StaticResource ConnectedFolderTreeItemStyle}">
            <StackPanel Orientation="Horizontal" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="FolderNodeHeader_OnMouseLeftButtonDown">
                <materialDesign:PackIcon Kind="FolderOutline" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccentAmber}" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            </StackPanel>
        </HierarchicalDataTemplate>
        <Style x:Key="CompactMediaCard" TargetType="materialDesign:Card">
            <Setter Property="UniformCornerRadius" Value="10" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="materialDesign:ShadowAssist.ShadowDepth" Value="Depth4" />
            <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        </Style>
        <Style x:Key="CompactMediaListViewItem" TargetType="ListViewItem" BasedOn="{StaticResource PremiumListViewItem}">
            <Setter Property="Padding" Value="1,0" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="CompactMediaColumnHeader" TargetType="GridViewColumnHeader">
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Padding" Value="2,1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        </Style>
        <ContextMenu x:Key="MediaFileContextMenu" x:Shared="False">
            <MenuItem Header="格式转换"
                      Command="{Binding PlacementTarget.DataContext.OpenConvertDialogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="图片转 PDF"
                      Command="{Binding PlacementTarget.DataContext.ConvertImageToPdfCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="PDF 转图片"
                      Command="{Binding PlacementTarget.DataContext.ConvertPdfToImagesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="外部打开"
                      Command="{Binding PlacementTarget.DataContext.OpenExternalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>
        <Style x:Key="MediaFileListBase" TargetType="ListView">
            <Setter Property="ItemsSource" Value="{Binding MediaFiles}" />
            <Setter Property="SelectedItem" Value="{Binding SelectedMediaFile, Mode=TwoWay}" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource CompactMediaListViewItem}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ContextMenu" Value="{StaticResource MediaFileContextMenu}" />
        </Style>
        <DataTemplate x:Key="MediaFileKindIconTemplate">
            <Grid Width="{Binding RelativeSource={RelativeSource AncestorType=ContentControl}, Path=Tag}"
                  Height="{Binding RelativeSource={RelativeSource AncestorType=ContentControl}, Path=Tag}">
                <Border Background="#F1F5F9"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="{Binding Thumbnail, Converter={StaticResource NullOrEmptyToVisibility}}">
                    <TextBlock Text="{Binding ExtensionText}"
                               Foreground="#64748B"
                               FontSize="10"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Border>
                <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="MediaFileCompactItemTemplate">
            <Grid Margin="1" Height="34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Margin="4,0,4,0" />
                <ContentControl Grid.Column="1"
                                Content="{Binding}"
                                ContentTemplate="{StaticResource MediaFileKindIconTemplate}"
                                Tag="24"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding KindText}" Style="{StaticResource TextHint}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="MediaFileLargeIconItemTemplate">
            <Grid Width="120" Height="132" Margin="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="86" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <CheckBox HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          Margin="0,4,4,0"
                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                          Panel.ZIndex="2" />
                <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="7" BorderBrush="#E2E8F0" BorderThickness="1" Margin="4">
                    <ContentControl Content="{Binding}"
                                    ContentTemplate="{StaticResource MediaFileKindIconTemplate}"
                                    Tag="68"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Row="1"
                           Text="{Binding Name}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           MaxHeight="36"
                           Margin="4,2,4,0" />
                <TextBlock Grid.Row="2"
                           Text="{Binding SizeText}"
                           Style="{StaticResource TextHint}"
                           TextAlignment="Center"
                           Margin="4,0,4,4" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,0,0,4" CornerRadius="{StaticResource CornerRadiusCard}" Padding="8,4">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                    <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource StatusPill}" Margin="0,0,6,0">
                        <TextBlock Text="{Binding StatusMessage}" />
                    </Border>
                    <Button Style="{StaticResource GhostActionButton}" Command="{Binding ExitMultimediaCommand}" Height="30" Padding="8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close" Width="15" Height="15" Margin="0,0,4,0" />
                            <TextBlock Text="退出多媒体" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource BrushAccentGradient}" Margin="0,0,6,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ImageMultipleOutline" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="多媒体" Style="{StaticResource TextHeadline}" />
                        <TextBlock Text="图片查看 · 音视频播放 · 文档预览 · 格式转换" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Visibility="{Binding IsExplorerMode, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220" MaxWidth="520" />
                <ColumnDefinition Width="2" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="2" />
                    <RowDefinition Height="220" MinHeight="140" MaxHeight="420" />
                </Grid.RowDefinitions>

                <materialDesign:Card Grid.Row="0" Style="{StaticResource CompactMediaCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="文件夹" Style="{StaticResource TextSubtitle}" FontWeight="SemiBold" Margin="0,0,0,2" />
                        <TreeView x:Name="FolderTree" Grid.Row="1" ItemsSource="{Binding FolderTreeNodes}" SelectedItemChanged="FolderTree_OnSelectedItemChanged" BorderThickness="0" Padding="0" Background="Transparent" ItemContainerStyle="{StaticResource ConnectedFolderTreeItemStyle}" />
                    </Grid>
                </materialDesign:Card>

                <GridSplitter Grid.Row="1" Height="2" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" Background="Transparent" />

                <materialDesign:Card Grid.Row="2" Style="{StaticResource CompactMediaCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="预览" Style="{StaticResource TextSubtitle}" FontWeight="SemiBold" Margin="0,0,0,2" />
                        <Grid Grid.Row="1">
                            <TextBlock Text="单击右侧文件进行预览" Style="{StaticResource TextHint}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="{Binding IsPreviewEmpty, Converter={StaticResource BoolToVis}}" />

                            <Grid Visibility="{Binding IsPreviewImage, Converter={StaticResource BoolToVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Background="{DynamicResource MaterialDesignToolBarBackground}" CornerRadius="8" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding PreviewImageSource}" Stretch="Uniform" />
                                        <Button Style="{StaticResource PrimaryActionButton}" Command="{Binding PreviousImageCommand}" HorizontalAlignment="Left" VerticalAlignment="Center" Height="28" Padding="8,0" Margin="2,0,0,0">
                                            <TextBlock Text="上一张" />
                                        </Button>
                                        <Button Style="{StaticResource PrimaryActionButton}" Command="{Binding NextImageCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Height="28" Padding="8,0" Margin="0,0,2,0">
                                            <TextBlock Text="下一张" />
                                        </Button>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding SelectedMediaFile.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding PreviewImageInfo}" Style="{StaticResource TextHint}" />
                                </StackPanel>
                            </Grid>

                            <Grid Visibility="{Binding IsPreviewVideo, Converter={StaticResource BoolToVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Background="Black" CornerRadius="8" ClipToBounds="True">
                                    <MediaElement x:Name="PreviewMediaElement" Source="{Binding PreviewMediaSource}" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform" MediaOpened="MediaElement_OnMediaOpened" MediaEnded="PreviewMediaElement_OnMediaEnded" />
                                </Border>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                                    <Button Style="{StaticResource GhostActionButton}" Click="PreviewPlayPause_OnClick" Padding="10,0" Height="30">
                                        <materialDesign:PackIcon Kind="PlayPause" Width="15" Height="15" />
                                    </Button>
                                    <Slider x:Name="PreviewPositionSlider"
                                            Minimum="0"
                                            Maximum="1"
                                            Value="0"
                                            VerticalAlignment="Center"
                                            Margin="8,0"
                                            Width="96"
                                            PreviewMouseLeftButtonDown="PositionSlider_OnPreviewMouseLeftButtonDown"
                                            PreviewMouseLeftButtonUp="PositionSlider_OnPreviewMouseLeftButtonUp"
                                            LostMouseCapture="PositionSlider_OnLostMouseCapture"
                                            KeyUp="PositionSlider_OnKeyUp" />
                                    <Button Style="{StaticResource GhostActionButton}" Click="PreviewMute_OnClick" Padding="10,0" Height="30">
                                        <materialDesign:PackIcon Kind="VolumeMute" Width="15" Height="15" />
                                    </Button>
                                    <Slider x:Name="PreviewVolumeSlider"
                                            Minimum="0"
                                            Maximum="1"
                                            Value="1"
                                            VerticalAlignment="Center"
                                            Margin="6,0,0,0"
                                            Width="54"
                                            ValueChanged="VolumeSlider_OnValueChanged" />
                                </StackPanel>
                            </Grid>

                            <Grid Visibility="{Binding IsPreviewAudio, Converter={StaticResource BoolToVis}}">
                                <StackPanel VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="MusicCircleOutline" Width="44" Height="44" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                    <TextBlock Text="{Binding SelectedMediaFile.Name}" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,8,0,8" />
                                    <MediaElement x:Name="PreviewAudioElement" Source="{Binding PreviewMediaSource}" LoadedBehavior="Manual" UnloadedBehavior="Manual" Visibility="Collapsed" MediaOpened="MediaElement_OnMediaOpened" MediaEnded="PreviewMediaElement_OnMediaEnded" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource GhostActionButton}" Click="PreviewAudioPlayPause_OnClick" Padding="10,0" Height="30">
                                            <materialDesign:PackIcon Kind="PlayPause" Width="15" Height="15" />
                                        </Button>
                                        <Slider x:Name="PreviewAudioPositionSlider"
                                                Minimum="0"
                                                Maximum="1"
                                                Value="0"
                                                VerticalAlignment="Center"
                                                Margin="8,0"
                                                Width="96"
                                                PreviewMouseLeftButtonDown="PositionSlider_OnPreviewMouseLeftButtonDown"
                                                PreviewMouseLeftButtonUp="PositionSlider_OnPreviewMouseLeftButtonUp"
                                                LostMouseCapture="PositionSlider_OnLostMouseCapture"
                                                KeyUp="PositionSlider_OnKeyUp" />
                                        <Button Style="{StaticResource GhostActionButton}" Click="PreviewAudioMute_OnClick" Padding="10,0" Height="30">
                                            <materialDesign:PackIcon Kind="VolumeMute" Width="15" Height="15" />
                                        </Button>
                                        <Slider x:Name="PreviewAudioVolumeSlider"
                                                Minimum="0"
                                                Maximum="1"
                                                Value="1"
                                                VerticalAlignment="Center"
                                                Margin="6,0,0,0"
                                                Width="54"
                                                ValueChanged="VolumeSlider_OnValueChanged" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <Grid Visibility="{Binding IsPreviewDocument, Converter={StaticResource BoolToVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding SelectedMediaFile.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding PreviewDocumentInfo}" Style="{StaticResource TextHint}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Row="1"
                                        Background="#F8FAFC"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Visibility="{Binding IsPreviewTextDocument, Converter={StaticResource BoolToVis}}">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                        <TextBox Text="{Binding PreviewDocumentText, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 FontFamily="Consolas, 'Microsoft YaHei UI'"
                                                 FontSize="11"
                                                 TextWrapping="NoWrap"
                                                 AcceptsReturn="True"
                                                 Padding="6" />
                                    </ScrollViewer>
                                </Border>
                                <Border Grid.Row="1"
                                        Background="#F8FAFC"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="12"
                                        Visibility="{Binding IsPreviewOfficeDocument, Converter={StaticResource BoolToVis}}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="200">
                                        <Border Width="54" Height="54" CornerRadius="10" Background="#EEF2FF" BorderBrush="#CBD5E1" BorderThickness="1">
                                            <TextBlock Text="{Binding SelectedMediaFile.ExtensionText}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#475569"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding SelectedMediaFile.KindText}"
                                                   Style="{StaticResource TextSubtitle}"
                                                   TextAlignment="Center"
                                                   Margin="0,8,0,2" />
                                        <TextBlock Text="{Binding PreviewDocumentInfo}"
                                                   Style="{StaticResource TextHint}"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <Button Style="{StaticResource GhostActionButton}"
                                                Command="{Binding OpenExternalCommand}"
                                                Height="30"
                                                Margin="0,10,0,0"
                                                Padding="10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="OpenInNew" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                <TextBlock Text="外部打开" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </materialDesign:Card>
            </Grid>

            <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Background="Transparent" />

            <materialDesign:Card Grid.Column="2" Style="{StaticResource CompactMediaCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right"
                                Height="28"
                                MinWidth="92"
                                Padding="8,0"
                                FontSize="{StaticResource FontSizeBody}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FormatListBulleted" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding FileViewModeText}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="详细信息" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.IsDetailsView, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="列表" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.IsListView, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="大图标" IsCheckable="True" IsChecked="{Binding PlacementTarget.DataContext.IsLargeIconsView, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostActionButton}">
                                    <EventSetter Event="Click" Handler="ViewModeButton_OnClick" />
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Text="文件内容" Style="{StaticResource TextSubtitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <ListView x:Name="MediaFileList"
                                  Style="{StaticResource MediaFileListBase}"
                                  MouseDoubleClick="MediaFileList_OnMouseDoubleClick"
                                  PreviewMouseRightButtonDown="MediaFileList_OnPreviewMouseRightButtonDown"
                                  Visibility="{Binding IsDetailsView, Converter={StaticResource BoolToVis}}">
                            <ListView.View>
                                <GridView ColumnHeaderContainerStyle="{StaticResource CompactMediaColumnHeader}">
                                    <GridViewColumn Header="选择" Width="54">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" HorizontalAlignment="Center" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="预览" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentControl Content="{Binding}"
                                                                ContentTemplate="{StaticResource MediaFileKindIconTemplate}"
                                                                Tag="54"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="文件名" DisplayMemberBinding="{Binding Name}" Width="260" />
                                    <GridViewColumn Header="类型" DisplayMemberBinding="{Binding KindText}" Width="72" />
                                    <GridViewColumn Header="大小" DisplayMemberBinding="{Binding SizeText}" Width="90" />
                                    <GridViewColumn Header="修改时间" DisplayMemberBinding="{Binding ModifiedText}" Width="140" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <ListView x:Name="MediaFileCompactList"
                                  Style="{StaticResource MediaFileListBase}"
                                  ItemTemplate="{StaticResource MediaFileCompactItemTemplate}"
                                  MouseDoubleClick="MediaFileList_OnMouseDoubleClick"
                                  PreviewMouseRightButtonDown="MediaFileList_OnPreviewMouseRightButtonDown"
                                  Visibility="{Binding IsListView, Converter={StaticResource BoolToVis}}">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                        </ListView>
                        <ListView x:Name="MediaFileLargeIconList"
                                  Style="{StaticResource MediaFileListBase}"
                                  ItemTemplate="{StaticResource MediaFileLargeIconItemTemplate}"
                                  MouseDoubleClick="MediaFileList_OnMouseDoubleClick"
                                  PreviewMouseRightButtonDown="MediaFileList_OnPreviewMouseRightButtonDown"
                                  Visibility="{Binding IsLargeIconsView, Converter={StaticResource BoolToVis}}"
                                  ScrollViewer.CanContentScroll="False">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource CompactMediaListViewItem}">
                                    <Setter Property="Width" Value="128" />
                                    <Setter Property="Height" Value="140" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"
                                               ItemWidth="128"
                                               ItemHeight="140"
                                               Width="{Binding RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}, Path=ActualWidth}" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                        </ListView>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="{Binding SelectedFolderPath}" Style="{StaticResource TextHint}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </Grid>
            </materialDesign:Card>
        </Grid>

        <Grid Grid.Row="1" Visibility="{Binding IsImmersive, Converter={StaticResource BoolToVis}}">
            <!-- Premium immersive overlay -->
            <Border Background="#CC0F172A" CornerRadius="14" Padding="16">
                <Grid>
                    <Button Style="{StaticResource GhostActionButton}" Command="{Binding ExitImmersiveCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Height="34" Padding="12,0" Panel.ZIndex="2">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="KeyboardEsc" Width="15" Height="15" Margin="0,0,6,0" />
                            <TextBlock Text="返回列表" />
                        </StackPanel>
                    </Button>

                    <Grid Visibility="{Binding IsImmersiveImage, Converter={StaticResource BoolToVis}}">
                        <Image Source="{Binding ImmersiveImageSource}" Stretch="Uniform" />
                        <Button Style="{StaticResource PrimaryActionButton}" Command="{Binding PreviousImageCommand}" HorizontalAlignment="Left" VerticalAlignment="Center" Height="44" Padding="16,0" Margin="24,0,0,0" Panel.ZIndex="3">
                            <TextBlock Text="上一张" FontWeight="SemiBold" />
                        </Button>
                        <Button Style="{StaticResource PrimaryActionButton}" Command="{Binding NextImageCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Height="44" Padding="16,0" Margin="0,0,24,0" Panel.ZIndex="3">
                            <TextBlock Text="下一张" FontWeight="SemiBold" />
                        </Button>
                    </Grid>

                    <Grid Visibility="{Binding IsImmersiveVideo, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <MediaElement x:Name="ImmersiveMediaElement" Source="{Binding ImmersiveMediaSource}" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform" MediaOpened="MediaElement_OnMediaOpened" MediaEnded="ImmersiveMediaElement_OnMediaEnded" />
                        <materialDesign:Card Grid.Row="1" Style="{StaticResource PremiumCard}" Background="#1E293B" Padding="12" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource GhostActionButton}" Click="ImmersivePlayPause_OnClick" Padding="12,0" Height="34">
                                    <materialDesign:PackIcon Kind="PlayPause" Width="16" Height="16" />
                                </Button>
                                <Slider x:Name="ImmersivePositionSlider"
                                        Minimum="0"
                                        Maximum="1"
                                        Value="0"
                                        Width="320"
                                        Margin="10,0"
                                        VerticalAlignment="Center"
                                        PreviewMouseLeftButtonDown="PositionSlider_OnPreviewMouseLeftButtonDown"
                                        PreviewMouseLeftButtonUp="PositionSlider_OnPreviewMouseLeftButtonUp"
                                        LostMouseCapture="PositionSlider_OnLostMouseCapture"
                                        KeyUp="PositionSlider_OnKeyUp" />
                                <Button Style="{StaticResource GhostActionButton}" Click="ImmersiveMute_OnClick" Padding="12,0" Height="34">
                                    <materialDesign:PackIcon Kind="VolumeMute" Width="16" Height="16" />
                                </Button>
                                <Slider x:Name="ImmersiveVolumeSlider"
                                        Minimum="0"
                                        Maximum="1"
                                        Value="1"
                                        Width="72"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        ValueChanged="VolumeSlider_OnValueChanged" />
                                <TextBlock Text="{Binding SelectedMediaFile.Name}" Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                            </StackPanel>
                        </materialDesign:Card>
                    </Grid>

                    <Grid Visibility="{Binding IsImmersiveAudio, Converter={StaticResource BoolToVis}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="520">
                            <materialDesign:PackIcon Kind="MusicCircle" Width="96" Height="96" HorizontalAlignment="Center" Foreground="White" Opacity="0.92" />
                            <TextBlock Text="{Binding SelectedMediaFile.Name}" Foreground="White" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,14,0,12" />
                            <MediaElement x:Name="ImmersiveAudioElement" Source="{Binding ImmersiveMediaSource}" LoadedBehavior="Manual" UnloadedBehavior="Manual" Visibility="Collapsed" MediaOpened="MediaElement_OnMediaOpened" MediaEnded="ImmersiveMediaElement_OnMediaEnded" />
                            <Slider x:Name="ImmersiveAudioPositionSlider"
                                    Minimum="0"
                                    Maximum="1"
                                    Value="0"
                                    Margin="0,0,0,12"
                                    PreviewMouseLeftButtonDown="PositionSlider_OnPreviewMouseLeftButtonDown"
                                    PreviewMouseLeftButtonUp="PositionSlider_OnPreviewMouseLeftButtonUp"
                                    LostMouseCapture="PositionSlider_OnLostMouseCapture"
                                    KeyUp="PositionSlider_OnKeyUp" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource PrimaryActionButton}" Click="ImmersiveAudioPlayPause_OnClick" Width="96" Height="44" Padding="12,0">
                                    <materialDesign:PackIcon Kind="PlayPause" Width="20" Height="20" />
                                </Button>
                                <Button Style="{StaticResource GhostActionButton}" Click="ImmersiveAudioMute_OnClick" Height="44" Padding="14,0" Margin="10,0,0,0">
                                    <materialDesign:PackIcon Kind="VolumeMute" Width="18" Height="18" />
                                </Button>
                                <Slider x:Name="ImmersiveAudioVolumeSlider"
                                        Minimum="0"
                                        Maximum="1"
                                        Value="1"
                                        Width="120"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        ValueChanged="VolumeSlider_OnValueChanged" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
