<UserControl x:Class="MyTools.Views.SystemSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Margin="0,0,0,12"
                CornerRadius="8"
                Padding="16,12"
                Background="{DynamicResource MaterialDesignCardBackground}">
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="10" Background="#5e72e4" Margin="0,0,12,0" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="CogOutline" Width="22" Height="22" Foreground="White"
                                             VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="系统设置" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="备份 / 迁移程序数据与依赖文件" FontSize="12" Opacity="0.7" Margin="0,2,0,0" />
                </StackPanel>
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True" Width="22" Height="22"
                             Margin="16,0,0,0" VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>

        <!-- Status -->
        <Border Grid.Row="1"
                Margin="0,0,0,12"
                Padding="14,10"
                CornerRadius="6"
                Background="{DynamicResource MaterialDesignChipBackground}">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12" />
        </Border>

        <!-- Cards -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Export -->
            <materialDesign:Card Grid.Column="0" Padding="20" VerticalAlignment="Top">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <materialDesign:PackIcon Kind="Export" Width="22" Height="22" Foreground="#5e72e4" VerticalAlignment="Center" />
                        <TextBlock Text="导出" FontSize="16" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.85" Margin="0,0,0,10"
                               Text="将以下内容打包到所选文件夹下的时间戳子目录：" />
                    <StackPanel Margin="6,0,0,12">
                        <TextBlock FontSize="12" Margin="0,1" Text="• 程序设置（MyTools.settings.json）" />
                        <TextBlock FontSize="12" Margin="0,1" Text="• SQL 连接历史（MyTools.sqlhistory.json）" />
                        <TextBlock FontSize="12" Margin="0,1" Text="• Codex 配置（~\.codex\config.toml + auth.json）" />
                        <TextBlock FontSize="12" Margin="0,1" Text="• 排班数据 / 节假日（%LOCALAPPDATA%\MyTools）" />
                        <TextBlock FontSize="12" Margin="0,1" Text="• WireGuard 配置（Configs\）" />
                        <TextBlock FontSize="12" Margin="0,1" Text="• 录像解码依赖（NativeBinaries\ffmpeg\ffmpeg.exe 等）" />
                    </StackPanel>
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#5e72e4" BorderBrush="#5e72e4"
                            HorizontalAlignment="Left"
                            MinWidth="140" Height="36"
                            Command="{Binding ExportCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderUpload" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="选择文件夹并导出" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </materialDesign:Card>

            <!-- Import -->
            <materialDesign:Card Grid.Column="2" Padding="20" VerticalAlignment="Top">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <materialDesign:PackIcon Kind="Import" Width="22" Height="22" Foreground="#11cdef" VerticalAlignment="Center" />
                        <TextBlock Text="导入" FontSize="16" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.85" Margin="0,0,0,10"
                               Text="选择之前导出的备份文件夹（含 manifest.json）。导入后会覆盖当前同名文件，建议导入完成后重启程序。" />
                    <Border Background="#FFF8E1" Padding="10" CornerRadius="6" Margin="0,0,0,12">
                        <TextBlock FontSize="11" TextWrapping="Wrap"
                                   Text="MyTools.settings.json / MyTools.sqlhistory.json 使用 Windows DPAPI（当前用户）加密，仅在同一 Windows 账户上能解密；跨账户导入时密码 / Codex 凭据将失效。" />
                    </Border>
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#11cdef" BorderBrush="#11cdef"
                            HorizontalAlignment="Left"
                            MinWidth="140" Height="36"
                            Command="{Binding ImportCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderDownload" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="选择备份并导入" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
