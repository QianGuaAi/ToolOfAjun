<UserControl x:Class="MyTools.Views.SystemSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,8"
                Padding="12,9"
                CornerRadius="{StaticResource CornerRadiusCard}"
                Background="{DynamicResource MaterialDesignCardBackground}">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right"
                             Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True"
                             Width="20"
                             Height="20"
                             Margin="10,0,0,0"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <StackPanel Orientation="Horizontal">
                    <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource BrushAccentBlue}" Margin="0,0,8,0">
                        <materialDesign:PackIcon Kind="CogOutline" Width="16" Height="16" Foreground="White"
                                                 VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="系统设置" Style="{StaticResource TextSubtitle}" />
                        <TextBlock Text="数据迁移、备份恢复、文件关联" Style="{StaticResource TextHint}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="0,0,0,8"
                Padding="10,6"
                CornerRadius="6"
                Background="{DynamicResource MaterialDesignChipBackground}">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11" TextWrapping="Wrap" />
        </Border>

        <TabControl Grid.Row="2"
                    Style="{StaticResource MaterialDesignTabControl}"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    materialDesign:ColorZoneAssist.Mode="PrimaryMid">
            <TabItem Header="备份恢复">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <materialDesign:Card Grid.Row="0" Grid.Column="0" Style="{StaticResource SectionCardDense}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <materialDesign:PackIcon Kind="FolderUpload" Width="18" Height="18" Foreground="{DynamicResource BrushAccentBlue}" VerticalAlignment="Center" />
                        <TextBlock Text="导出备份" Style="{StaticResource TextSubtitle}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="打包当前程序数据，适合换电脑前保存。"
                                   Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Text="导出范围" Style="{StaticResource TextHint}" Margin="0,0,0,4" />
                        <WrapPanel>
                            <CheckBox Content="设置与历史" IsChecked="{Binding BackupSettings}" Margin="0,0,10,4" />
                            <CheckBox Content="排班本地数据" IsChecked="{Binding BackupLocalData}" Margin="0,0,10,4" />
                            <CheckBox Content="Codex" IsChecked="{Binding BackupCodex}" Margin="0,0,10,4" />
                            <CheckBox Content="WireGuard" IsChecked="{Binding BackupWireGuard}" Margin="0,0,10,4" />
                            <CheckBox Content="FFmpeg" IsChecked="{Binding BackupNativeBinaries}" Margin="0,0,10,4" />
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostActionButton}"
                                Margin="0,0,8,0"
                                Command="{Binding PreviewExportCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TextBoxSearchOutline" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="预检" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryActionButton}"
                                Command="{Binding ExportCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Export" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="选择文件夹导出" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Grid.Row="0" Grid.Column="2" Style="{StaticResource SectionCardDense}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <materialDesign:PackIcon Kind="FolderDownload" Width="18" Height="18" Foreground="{DynamicResource BrushAccentTeal}" VerticalAlignment="Center" />
                        <TextBlock Text="导入恢复" Style="{StaticResource TextSubtitle}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="选择带 manifest.json 的备份文件夹，导入会覆盖当前同名数据。"
                                   Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <Border Background="#FFF8E1" Padding="8,6" CornerRadius="6">
                            <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="#7A5200"
                                       Text="密码和 Codex 凭据使用当前 Windows 账户加密；跨账户导入时需要重新登录或重新保存密码。" />
                        </Border>
                        <TextBlock Text="恢复范围" Style="{StaticResource TextHint}" Margin="0,8,0,4" />
                        <WrapPanel>
                            <CheckBox Content="设置与历史" IsChecked="{Binding RestoreSettings}" Margin="0,0,10,4" />
                            <CheckBox Content="排班本地数据" IsChecked="{Binding RestoreLocalData}" Margin="0,0,10,4" />
                            <CheckBox Content="Codex" IsChecked="{Binding RestoreCodex}" Margin="0,0,10,4" />
                            <CheckBox Content="WireGuard" IsChecked="{Binding RestoreWireGuard}" Margin="0,0,10,4" />
                            <CheckBox Content="FFmpeg" IsChecked="{Binding RestoreNativeBinaries}" Margin="0,0,10,4" />
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostActionButton}"
                                Margin="0,0,8,0"
                                Command="{Binding PreviewImportCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TextBoxSearchOutline" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="预览" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostActionButton}"
                                Margin="0,0,8,0"
                                Command="{Binding VerifyBackupCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="校验" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryActionButton}"
                                Background="{DynamicResource BrushAccentTeal}"
                                BorderBrush="{DynamicResource BrushAccentTeal}"
                                Command="{Binding ImportCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Import" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="选择备份导入" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource SectionCardDense}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="30" Height="30" CornerRadius="7" Background="{DynamicResource BrushAccentAmber}" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="FileVideoOutline" Width="16" Height="16" Foreground="White"
                                                 VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="音视频文件关联" Style="{StaticResource TextSubtitle}" />
                        <TextBlock Text="关联 MP4、MKV、MOV、AVI、MP3、WAV、FLAC、M4A 等常见格式，双击直接进入内置播放器。"
                                   Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,1,0,0" />
                        <TextBlock Text="{Binding MediaAssociationStatusMessage}"
                                   Style="{StaticResource TextHint}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <WrapPanel Grid.Column="2"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right">
                        <Button Style="{StaticResource GhostActionButton}"
                                Margin="0,0,6,4"
                                Command="{Binding RefreshMediaAssociationStatusCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="刷新" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostActionButton}"
                                Margin="0,0,6,4"
                                Command="{Binding AssociateVideoFilesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="VideoOutline" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="关联视频" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostActionButton}"
                                Margin="0,0,6,4"
                                Command="{Binding AssociateAudioFilesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Music" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="关联音频" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryActionButton}"
                                Background="{DynamicResource BrushAccentAmber}"
                                BorderBrush="{DynamicResource BrushAccentAmber}"
                                Foreground="White"
                                Margin="0,0,6,4"
                                Command="{Binding AssociateMediaFilesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="LinkVariant" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="关联全部音视频" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostActionButton}"
                                Margin="0,0,0,4"
                                Command="{Binding RestoreMediaAssociationCommand}"
                                ToolTip="移除 MyTools 写入的音视频文件关联，让 Windows 恢复原默认程序或重新询问。">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Restore" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="取消 MyTools 关联" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostActionButton}"
                                Margin="6,0,0,4"
                                Command="{Binding OpenDefaultAppsSettingsCommand}"
                                ToolTip="打开 Windows 设置里的默认应用页面，手动选择每种文件类型的默认程序。">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CogOutline" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="打开 Windows 默认应用" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </materialDesign:Card>

        </Grid>
            </TabItem>
            <TabItem Header="桌面背景">
            <!-- ============== Wallpaper Library ============== -->
            <materialDesign:Card Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource SectionCardDense}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <materialDesign:PackIcon Kind="ImageMultipleOutline" Width="18" Height="18"
                                                 Foreground="{DynamicResource BrushAccentBlue}" VerticalAlignment="Center" />
                        <TextBlock Text="桌面背景" Style="{StaticResource TextSubtitle}" Margin="7,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="（Win7/8/10/11 通用）" Style="{StaticResource TextCaption}" Opacity="0.7"
                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Toolbar -->
                    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                        <Button Style="{StaticResource GhostActionButton}" Margin="0,0,6,4"
                                Command="{Binding ImportWallpapersCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ImagePlusOutline" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="导入图片" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostActionButton}" Margin="0,0,6,4"
                                Command="{Binding SaveCurrentWallpaperCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="MonitorScreenshot" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="保存当前桌面到图库" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryActionButton}" Margin="0,0,6,4"
                                Command="{Binding ApplyWallpaperCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Wallpaper" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="设为桌面" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostActionButton}" Margin="0,0,6,4"
                                Command="{Binding BrowseWallpaperInImageViewerCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ImageSearchOutline" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="在看图模块浏览" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostActionButton}" Margin="0,0,6,4"
                                Command="{Binding RemoveWallpaperCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="移除选中" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostActionButton}" Margin="0,0,6,4"
                                Command="{Binding RefreshWallpaperLibraryCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="刷新" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostActionButton}" Margin="0,0,0,4"
                                Command="{Binding OpenWallpaperFolderCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderOpenOutline" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="打开图库文件夹" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <!-- Style selector -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="显示方式：" Style="{StaticResource TextHint}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <RadioButton GroupName="WallpaperStyle" Content="填充" Margin="0,0,12,0"
                                     IsChecked="{Binding IsStyleFill}" />
                        <RadioButton GroupName="WallpaperStyle" Content="适应" Margin="0,0,12,0"
                                     IsChecked="{Binding IsStyleFit}" />
                        <RadioButton GroupName="WallpaperStyle" Content="拉伸" Margin="0,0,12,0"
                                     IsChecked="{Binding IsStyleStretch}" />
                        <RadioButton GroupName="WallpaperStyle" Content="平铺" Margin="0,0,12,0"
                                     IsChecked="{Binding IsStyleTile}" />
                        <RadioButton GroupName="WallpaperStyle" Content="居中"
                                     IsChecked="{Binding IsStyleCenter}" />
                    </StackPanel>

                    <!-- Status -->
                    <TextBlock Grid.Row="3" Text="{Binding WallpaperStatusMessage}"
                               Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,0,0,6" />

                    <!-- Thumbnails grid -->
                    <Border Grid.Row="4" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
                            CornerRadius="6" Background="{DynamicResource MaterialDesignChipBackground}"
                            MinHeight="220">
                        <ListBox ItemsSource="{Binding Wallpapers}"
                                 SelectedItem="{Binding SelectedWallpaper, Mode=TwoWay}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MaxHeight="520"
                                 Background="Transparent" BorderThickness="0" Padding="6">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="4" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Background" Value="White" />
                                    <Setter Property="BorderThickness" Value="2" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush"
                                                                Value="{DynamicResource BrushAccentBlue}" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#FFF7FAFF" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="160" ToolTip="{Binding FileName}">
                                        <Image Source="{Binding Thumbnail}" Width="150" Height="95"
                                               Stretch="UniformToFill" Margin="5,5,5,3" />
                                        <TextBlock Text="{Binding FileName}" FontSize="10"
                                                   TextTrimming="CharacterEllipsis" Margin="5,0,5,5"
                                                   HorizontalAlignment="Center" />
                                        <StackPanel.InputBindings>
                                            <MouseBinding MouseAction="LeftDoubleClick"
                                                          Command="{Binding DataContext.BrowseWallpaperInImageViewerCommand,
                                                                            RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </StackPanel.InputBindings>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </materialDesign:Card>
            </TabItem>
            <TabItem Header="Windows 调整">
            <!-- ============== Windows 调整 ============== -->
            <materialDesign:Card Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource SectionCardDense}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostActionButton}" Margin="6,0,0,0"
                                Command="{Binding RestartExplorerCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="重启资源管理器" />
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostActionButton}" Margin="0,0,6,0"
                                Command="{Binding RefreshTweaksCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="刷新" />
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CogOutline" Width="18" Height="18"
                                                     Foreground="{DynamicResource BrushAccentBlue}" VerticalAlignment="Center" />
                            <TextBlock Text="Windows 调整" Style="{StaticResource TextSubtitle}" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Tweaks 主体 -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 列1：时钟 + 托盘 -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="任务栏" Style="{StaticResource TextHint}" Margin="0,0,0,4" />
                            <CheckBox Content="时钟显示秒（仅 Win11 22H2+）"
                                      IsChecked="{Binding ShowSecondsInClock, Mode=TwoWay}"
                                      IsEnabled="{Binding SupportsSecondsInClock}"
                                      Margin="0,0,0,6" />
                            <CheckBox Content="显示所有托盘图标（禁止隐藏未活动图标）"
                                      IsChecked="{Binding TrayShowAll, Mode=TwoWay}"
                                      Margin="0,0,0,6" />
                            <CheckBox Content="右键直接显示完整菜单（取消“显示更多选项”）"
                                      IsChecked="{Binding UseClassicContextMenu, Mode=TwoWay}"
                                      IsEnabled="{Binding IsWindows11}"
                                      ToolTip="勾选后，Win11 右键直接显示完整菜单；取消勾选会恢复 Windows 11 默认右键菜单。"
                                      Margin="0,0,0,6" />
                        </StackPanel>

                        <!-- 列2：任务栏合并 -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="任务栏按钮合并" Style="{StaticResource TextHint}" Margin="0,0,0,4" />
                            <RadioButton Content="始终合并并隐藏标签"
                                         IsChecked="{Binding IsGlomAlways, Mode=TwoWay}"
                                         Margin="0,0,0,4" />
                            <RadioButton Content="任务栏满时合并"
                                         IsChecked="{Binding IsGlomWhenFull, Mode=TwoWay}"
                                         Margin="0,0,0,4" />
                            <RadioButton Content="从不合并"
                                         IsChecked="{Binding IsGlomNever, Mode=TwoWay}"
                                         Margin="0,0,0,4" />
                        </StackPanel>

                        <!-- 列3：桌面图标 -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="桌面图标" Style="{StaticResource TextHint}" Margin="0,0,0,4" />
                            <CheckBox Content="计算机" IsChecked="{Binding ShowComputer, Mode=TwoWay}" Margin="0,0,0,4" />
                            <CheckBox Content="回收站" IsChecked="{Binding ShowRecycleBin, Mode=TwoWay}" Margin="0,0,0,4" />
                            <CheckBox Content="控制面板" IsChecked="{Binding ShowControlPanel, Mode=TwoWay}" Margin="0,0,0,4" />
                            <CheckBox Content="用户的文件" IsChecked="{Binding ShowUserFiles, Mode=TwoWay}" Margin="0,0,0,4" />
                            <CheckBox Content="网络" IsChecked="{Binding ShowNetwork, Mode=TwoWay}" Margin="0,0,0,4" />
                        </StackPanel>
                    </Grid>

                    <!-- 状态提示 -->
                    <Border Grid.Row="2" Background="{DynamicResource MaterialDesignChipBackground}"
                            Padding="8,5" CornerRadius="5" Margin="0,10,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding TweaksHint}" FontSize="10"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                       TextWrapping="Wrap" HorizontalAlignment="Right" MaxWidth="400" />
                            <TextBlock Text="{Binding TweaksStatusMessage}" FontSize="11" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                </Grid>
            </materialDesign:Card>

            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
