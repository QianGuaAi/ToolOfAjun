<UserControl x:Class="MyTools.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewModels="clr-namespace:MyTools.ViewModels">
    <UserControl.Resources>
        <viewModels:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16,12,16,12">

    <!-- Hero -->
    <Border CornerRadius="14"
    Margin="0,0,0,14" Padding="20,16"
    Background="{StaticResource BrushHeroGradient}" ClipToBounds="True">
    <Border.Effect>
    <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.15" Color="#475569" />
    </Border.Effect>
    <Grid>
    <Grid.ColumnDefinitions>
    <ColumnDefinition Width="Auto" />
    <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid Width="64" Height="64" VerticalAlignment="Center" Margin="0,0,14,0">
    <Ellipse Fill="{StaticResource BrushAccentGradient}" Opacity="0.18" />
    <Ellipse Width="52" Height="52" Fill="White" Opacity="0.6" />
    <Image Source="{StaticResource HomeHero}" Width="44" Height="44" />
    </Grid>
    <StackPanel Grid.Column="1" VerticalAlignment="Center">
    <TextBlock Text="阿君的工具" Style="{StaticResource TextHeadline}" />
    <TextBlock Text="常用桌面工具集中管理 · 开箱即用 · 单 EXE 分发"
    Style="{StaticResource TextCaption}" Margin="0,3,0,8" />
    <StackPanel Orientation="Horizontal">
    <Border Style="{StaticResource StatusPill}" Margin="0,0,8,0">
    <StackPanel Orientation="Horizontal">
    <Ellipse Width="6" Height="6" Fill="{DynamicResource BrushSuccess}" Margin="0,0,5,0" VerticalAlignment="Center" />
    <TextBlock Text="{Binding OsDisplayName}" />
    </StackPanel>
    </Border>
    <Border Style="{StaticResource StatusPill}">
    <TextBlock Text="{Binding AppVersionText}" />
    </Border>
    </StackPanel>
    </StackPanel>
    </Grid>
    </Border>

    <!-- Command search and recent items -->
    <Grid Margin="0,0,0,8">
    <Grid.ColumnDefinitions>
    <ColumnDefinition Width="1.25*" />
    <ColumnDefinition Width="0.95*" />
    </Grid.ColumnDefinitions>

    <materialDesign:Card Grid.Column="0" Style="{StaticResource SectionCardOutlined}" Margin="0,0,8,0" Padding="12,10">
    <StackPanel>
    <StackPanel Style="{StaticResource SectionHeaderRow}">
    <Border Width="24" Height="24" CornerRadius="6" Background="{StaticResource BrushBlueGradient}" Margin="0,0,8,0">
    <materialDesign:PackIcon Kind="Magnify" Width="14" Height="14" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </Border>
    <StackPanel VerticalAlignment="Center">
    <TextBlock Text="功能搜索" Style="{StaticResource TextSubtitle}" />
    <TextBlock Text="输入关键词直接跳转模块" Style="{StaticResource TextHint}" Margin="0,1,0,0" />
    </StackPanel>
    </StackPanel>

    <TextBox Text="{Binding HomeCommandSearchText, UpdateSourceTrigger=PropertyChanged}"
    Style="{StaticResource StandardTextBox}"
    materialDesign:HintAssist.Hint="录像 / 导出 / 转换 / 排班"
    Margin="0,0,0,8" />

    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
    <ItemsControl ItemsSource="{Binding FilteredHomeCommandView}">
    <ItemsControl.ItemTemplate>
    <DataTemplate>
    <Button Command="{Binding DataContext.ExecuteHomeCommandItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
    CommandParameter="{Binding}"
    Style="{StaticResource HomeShortcutButtonStyle}"
    Margin="0,0,0,5">
    <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="9,7" Background="#FAFBFC">
    <Grid>
    <Grid.ColumnDefinitions>
    <ColumnDefinition Width="Auto" />
    <ColumnDefinition Width="*" />
    <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <materialDesign:PackIcon Kind="Flash" Width="16" Height="16" Foreground="{DynamicResource BrushAccentTeal}" VerticalAlignment="Center" Margin="0,0,8,0" />
    <StackPanel Grid.Column="1">
    <TextBlock Text="{Binding Title}" Style="{StaticResource TextBodyStandard}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource TextHint}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
    </StackPanel>
    <materialDesign:PackIcon Grid.Column="2" Kind="ChevronRight" Width="16" Height="16" Foreground="#94A3B8" VerticalAlignment="Center" />
    </Grid>
    </Border>
    </Button>
    </DataTemplate>
    </ItemsControl.ItemTemplate>
    </ItemsControl>
    </ScrollViewer>
    </StackPanel>
    </materialDesign:Card>

    <materialDesign:Card Grid.Column="1" Style="{StaticResource SectionCardOutlined}" Margin="0" Padding="12,10">
    <StackPanel>
    <StackPanel Style="{StaticResource SectionHeaderRow}">
    <Border Width="24" Height="24" CornerRadius="6" Background="{StaticResource BrushAccentGradient}" Margin="0,0,8,0">
    <materialDesign:PackIcon Kind="History" Width="14" Height="14" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </Border>
    <StackPanel VerticalAlignment="Center">
    <TextBlock Text="最近使用" Style="{StaticResource TextSubtitle}" />
    <TextBlock Text="图片、音视频、转换输出和排班入口" Style="{StaticResource TextHint}" Margin="0,1,0,0" />
    </StackPanel>
    </StackPanel>

    <TextBlock Text="暂无最近记录"
    Style="{StaticResource TextHint}"
    HorizontalAlignment="Center"
    Margin="0,28,0,28"
    Visibility="{Binding HasHomeRecentItems, Converter={StaticResource InverseBoolToVis}}" />

    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto"
    Visibility="{Binding HasHomeRecentItems, Converter={StaticResource BoolToVis}}">
    <ItemsControl ItemsSource="{Binding HomeRecentItems}">
    <ItemsControl.ItemTemplate>
    <DataTemplate>
    <Button Command="{Binding DataContext.OpenHomeRecentItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
    CommandParameter="{Binding}"
    Style="{StaticResource HomeShortcutButtonStyle}"
    Margin="0,0,0,5">
    <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="9,7" Background="#FAFBFC">
    <Grid>
    <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*" />
    <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <StackPanel>
    <TextBlock Text="{Binding Title}" Style="{StaticResource TextBodyStandard}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource TextHint}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
    </StackPanel>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
    <TextBlock Text="{Binding ActionText}" Foreground="{DynamicResource BrushAccentBlue}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
    <TextBlock Text="{Binding TimeText}" Style="{StaticResource TextHint}" FontSize="10" HorizontalAlignment="Right" />
    </StackPanel>
    </Grid>
    </Border>
    </Button>
    </DataTemplate>
    </ItemsControl.ItemTemplate>
    </ItemsControl>
    </ScrollViewer>
    </StackPanel>
    </materialDesign:Card>
    </Grid>

    <TextBlock Text="提示：可通过顶部菜单快速切换功能模块。"
    HorizontalAlignment="Center"
    Style="{StaticResource TextHint}"
    Margin="0,2,0,0" />
    </StackPanel>
    </ScrollViewer>
</UserControl>
