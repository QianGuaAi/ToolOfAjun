<UserControl x:Class="MyTools.Views.VideoViewerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:MyTools.ViewModels"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Focusable="True"
             PreviewKeyDown="VideoViewerPage_OnPreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <viewModels:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <viewModels:VideoWaveformPositionConverter x:Key="VideoWaveformPositionConverter" />
        <viewModels:VideoWaveformRangeConverter x:Key="VideoWaveformRangeConverter" />
    </UserControl.Resources>
    <Grid x:Name="VideoViewerRoot" Margin="16">
    
    <Grid.RowDefinitions>
    <RowDefinition Height="Auto" />
    <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    
    <Border x:Name="VideoViewerHeader" Grid.Row="0"
    Margin="0,0,0,12"
    CornerRadius="{StaticResource CornerRadiusCard}"
    Padding="12,8">
    <Border.Background>
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
    <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
    </LinearGradientBrush>
    </Border.Background>
    <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Style="{StaticResource PrimaryActionButton}"
    Command="{Binding OpenVideoViewerFileCommand}"
    Height="34"
    Padding="12,0"
    Margin="0,0,8,0"
    ToolTip="打开音频或视频">
    <StackPanel Orientation="Horizontal">
    <materialDesign:PackIcon Kind="FolderOpenOutline" Width="15" Height="15" Margin="0,0,6,0" />
    <TextBlock Text="打开" />
    </StackPanel>
    </Button>
    <Button Style="{StaticResource GhostActionButton}"
    Command="{Binding OpenVideoViewerInExternalPlayerCommand}"
    Height="34"
    Padding="12,0"
    Margin="0,0,8,0"
    ToolTip="用系统默认播放器打开">
    <StackPanel Orientation="Horizontal">
    <materialDesign:PackIcon Kind="OpenInNew" Width="15" Height="15" Margin="0,0,6,0" />
    <TextBlock Text="外部打开" />
    </StackPanel>
    </Button>
    <Button Style="{StaticResource GhostActionButton}"
    Command="{Binding CaptureVideoViewerFrameCommand}"
    Height="34"
    Padding="12,0"
    Margin="0,0,8,0"
    ToolTip="截取当前帧并在图片查看中打开">
    <StackPanel Orientation="Horizontal">
    <materialDesign:PackIcon Kind="CameraOutline" Width="15" Height="15" Margin="0,0,6,0" />
    <TextBlock Text="{Binding VideoViewerFrameCaptureText}" />
    </StackPanel>
    </Button>
    <Button Style="{StaticResource GhostActionButton}"
    Command="{Binding GenerateVideoViewerWaveformCommand}"
    Height="34"
    Padding="12,0"
    Margin="0,0,8,0"
    ToolTip="生成音频波形图">
    <StackPanel Orientation="Horizontal">
    <materialDesign:PackIcon Kind="Waveform" Width="15" Height="15" Margin="0,0,6,0" />
    <TextBlock Text="{Binding VideoViewerWaveformText}" />
    </StackPanel>
    </Button>
    <Button Style="{StaticResource GhostActionButton}"
    Height="34"
    Padding="12,0"
    Margin="0,0,8,0"
    Click="VideoOnlyButton_OnClick"
    ToolTip="只显示视频框，按 Esc 恢复">
    <StackPanel Orientation="Horizontal">
    <materialDesign:PackIcon Kind="FullscreenExit" Width="15" Height="15" Margin="0,0,6,0" />
    <TextBlock x:Name="VideoOnlyButtonText" Text="纯视频" />
    </StackPanel>
    </Button>
    <Button Style="{StaticResource GhostActionButton}"
    Height="34"
    Padding="12,0"
    Margin="0,0,8,0"
    Click="VideoStretchButton_OnClick"
    ToolTip="切换视频拉伸铺满">
    <StackPanel Orientation="Horizontal">
    <materialDesign:PackIcon Kind="ArrowExpandAll" Width="15" Height="15" Margin="0,0,6,0" />
    <TextBlock x:Name="VideoStretchButtonText" Text="拉伸" />
    </StackPanel>
    </Button>
    <Button Style="{StaticResource GhostActionButton}"
    Height="34"
    Padding="12,0"
    Click="VideoFullscreenButton_OnClick"
    ToolTip="全屏播放，Esc 或双击退出">
    <StackPanel Orientation="Horizontal">
    <materialDesign:PackIcon Kind="Fullscreen" Width="15" Height="15" Margin="0,0,6,0" />
    <TextBlock Text="全屏" />
    </StackPanel>
    </Button>
    </StackPanel>
    <StackPanel Orientation="Horizontal">
    <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center">
    <Border.Background>
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#F59E0B" Offset="0" />
    <GradientStop Color="#EF4444" Offset="1" />
    </LinearGradientBrush>
    </Border.Background>
    <materialDesign:PackIcon Kind="VideoOutline" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </Border>
    <StackPanel VerticalAlignment="Center">
    <TextBlock Text="音视频播放" Style="{StaticResource TextHeadline}" />
    <TextBlock Text="{Binding VideoViewerStatusMessage}" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
    </StackPanel>
    </StackPanel>
    </DockPanel>
    </Border>
    
    <Grid x:Name="VideoViewerLayout" Grid.Row="1">
    <Grid.ColumnDefinitions>
    <ColumnDefinition x:Name="VideoViewerMainColumn" Width="*" />
    <ColumnDefinition x:Name="VideoViewerSideColumn" Width="220" />
    </Grid.ColumnDefinitions>
    
    <materialDesign:Card x:Name="VideoViewerMainCard" Grid.Column="0" Padding="12" Margin="0,0,12,0">
    <Grid>
    <Grid.RowDefinitions>
    <RowDefinition Height="*" />
    <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    
    <Border x:Name="VideoSurfaceBorder" Grid.Row="0"
    Background="#0B0F14"
    CornerRadius="6"
    ClipToBounds="True"
    MouseLeftButtonDown="VideoSurface_OnMouseLeftButtonDown">
    <Grid x:Name="VideoSurfaceContent">
    <MediaElement x:Name="VideoPlayer"
    Source="{Binding VideoViewerSource}"
    LoadedBehavior="Manual"
    UnloadedBehavior="Manual"
    Stretch="Uniform"
    Volume="{Binding VideoViewerVolume}"
    IsMuted="{Binding VideoViewerIsMuted}"
    MediaOpened="VideoPlayer_MediaOpened"
    MediaEnded="VideoPlayer_MediaEnded"
    MediaFailed="VideoPlayer_MediaFailed" />
    <Border Background="#B0000000"
    CornerRadius="5"
    Padding="12,7"
    Margin="18"
    HorizontalAlignment="Center"
    VerticalAlignment="Bottom"
    MaxWidth="720"
    Visibility="{Binding HasVideoViewerSubtitleText, Converter={StaticResource BoolToVis}}">
    <TextBlock Text="{Binding VideoViewerSubtitleText}"
    Foreground="#F9FAFB"
    FontSize="{Binding VideoViewerSubtitleFontSize}"
    FontWeight="SemiBold"
    TextAlignment="Center"
    TextWrapping="Wrap"
    LineStackingStrategy="BlockLineHeight"
    LineHeight="{Binding VideoViewerSubtitleLineHeight}" />
    </Border>
    <Border Background="#CC0B0F14"
    CornerRadius="6"
    Padding="18"
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    Visibility="{Binding HasVideoViewerVideo, Converter={StaticResource InverseBoolToVis}}">
    <StackPanel HorizontalAlignment="Center">
    <materialDesign:PackIcon Kind="VideoOutline" Width="42" Height="42" Foreground="#E5E7EB" HorizontalAlignment="Center" Margin="0,0,0,8" />
    <TextBlock Text="打开音频或视频开始播放"
    Foreground="#F9FAFB"
    FontSize="15"
    FontWeight="SemiBold"
    HorizontalAlignment="Center" />
    <TextBlock Text="支持 MP4 / MOV / WMV / AVI / MKV / MP3 / WAV / FLAC 等常见文件"
    Foreground="#CBD5E1"
    Margin="0,4,0,0"
    HorizontalAlignment="Center" />
    </StackPanel>
    </Border>
    </Grid>
    </Border>
    
    <Grid x:Name="VideoControlsPanel" Grid.Row="1" Margin="0,12,0,0">
    <Grid.RowDefinitions>
    <RowDefinition Height="Auto" />
    <RowDefinition Height="Auto" />
    <RowDefinition Height="Auto" />
    <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
    <ColumnDefinition Width="Auto" />
    <ColumnDefinition Width="*" />
    <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    
    <Border x:Name="VideoWaveformPanel" Grid.Row="0"
    Grid.ColumnSpan="3"
    Background="{DynamicResource MaterialDesignToolBarBackground}"
    CornerRadius="6"
    Padding="8"
    Margin="0,0,0,8"
    Visibility="{Binding HasVideoViewerWaveform, Converter={StaticResource BoolToVis}}">
    <Grid>
    <Image x:Name="VideoWaveformImage"
    Source="{Binding VideoViewerWaveformImage}"
    Height="72"
    Stretch="Fill"
    Cursor="Hand"
    MouseLeftButtonDown="VideoWaveform_OnMouseLeftButtonDown"
    MouseRightButtonDown="VideoWaveform_OnMouseRightButtonDown"
    MouseMove="VideoWaveform_OnMouseMove"
    MouseLeftButtonUp="VideoWaveform_OnMouseLeftButtonUp"
    MouseRightButtonUp="VideoWaveform_OnMouseRightButtonUp"
    SnapsToDevicePixels="True"
    RenderOptions.BitmapScalingMode="HighQuality"
    ToolTip="点击或拖拽定位；Shift+左拖或右键拖拽可设置 A/B 循环区间；拖动选区边缘可微调 A/B 点" />
    <Border Height="72"
    Background="#335B8DEF"
    BorderBrush="#FF5B8DEF"
    BorderThickness="1"
    HorizontalAlignment="Left"
    VerticalAlignment="Center"
    IsHitTestVisible="False"
    Visibility="{Binding HasVideoViewerWaveformLoopRange, Converter={StaticResource BoolToVis}}">
    <Border.Width>
    <MultiBinding Converter="{StaticResource VideoWaveformRangeConverter}" ConverterParameter="Width">
    <Binding ElementName="VideoWaveformImage" Path="ActualWidth" />
    <Binding Path="VideoViewerLoopStartSeconds" />
    <Binding Path="VideoViewerLoopEndSeconds" />
    <Binding Path="VideoViewerDurationSeconds" />
    </MultiBinding>
    </Border.Width>
    <Border.Margin>
    <MultiBinding Converter="{StaticResource VideoWaveformRangeConverter}">
    <Binding ElementName="VideoWaveformImage" Path="ActualWidth" />
    <Binding Path="VideoViewerLoopStartSeconds" />
    <Binding Path="VideoViewerLoopEndSeconds" />
    <Binding Path="VideoViewerDurationSeconds" />
    </MultiBinding>
    </Border.Margin>
    </Border>
    <Border Width="10"
    Height="72"
    Background="#885B8DEF"
    BorderBrush="#FFFFFFFF"
    BorderThickness="1,0,1,0"
    HorizontalAlignment="Left"
    VerticalAlignment="Center"
    Cursor="SizeWE"
    Visibility="{Binding HasVideoViewerWaveformLoopRange, Converter={StaticResource BoolToVis}}"
    ToolTip="拖动微调 A 点"
    MouseLeftButtonDown="VideoWaveformStartHandle_OnMouseLeftButtonDown"
    MouseMove="VideoWaveformHandle_OnMouseMove"
    MouseLeftButtonUp="VideoWaveformHandle_OnMouseLeftButtonUp">
    <Border.Margin>
    <MultiBinding Converter="{StaticResource VideoWaveformRangeConverter}" ConverterParameter="StartHandle">
    <Binding ElementName="VideoWaveformImage" Path="ActualWidth" />
    <Binding Path="VideoViewerLoopStartSeconds" />
    <Binding Path="VideoViewerLoopEndSeconds" />
    <Binding Path="VideoViewerDurationSeconds" />
    </MultiBinding>
    </Border.Margin>
    </Border>
    <Border Width="10"
    Height="72"
    Background="#885B8DEF"
    BorderBrush="#FFFFFFFF"
    BorderThickness="1,0,1,0"
    HorizontalAlignment="Left"
    VerticalAlignment="Center"
    Cursor="SizeWE"
    Visibility="{Binding HasVideoViewerWaveformLoopRange, Converter={StaticResource BoolToVis}}"
    ToolTip="拖动微调 B 点"
    MouseLeftButtonDown="VideoWaveformEndHandle_OnMouseLeftButtonDown"
    MouseMove="VideoWaveformHandle_OnMouseMove"
    MouseLeftButtonUp="VideoWaveformHandle_OnMouseLeftButtonUp">
    <Border.Margin>
    <MultiBinding Converter="{StaticResource VideoWaveformRangeConverter}" ConverterParameter="EndHandle">
    <Binding ElementName="VideoWaveformImage" Path="ActualWidth" />
    <Binding Path="VideoViewerLoopStartSeconds" />
    <Binding Path="VideoViewerLoopEndSeconds" />
    <Binding Path="VideoViewerDurationSeconds" />
    </MultiBinding>
    </Border.Margin>
    </Border>
    <Border Width="2"
    Height="72"
    Background="#EF4444"
    HorizontalAlignment="Left"
    VerticalAlignment="Center"
    IsHitTestVisible="False">
    <Border.Margin>
    <MultiBinding Converter="{StaticResource VideoWaveformPositionConverter}">
    <Binding ElementName="VideoWaveformImage" Path="ActualWidth" />
    <Binding Path="VideoViewerPositionSeconds" />
    <Binding Path="VideoViewerDurationSeconds" />
    </MultiBinding>
    </Border.Margin>
    </Border>
    </Grid>
    </Border>
    
    <StackPanel x:Name="VideoPlaybackButtonsPanel" Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0">
    <Button Style="{StaticResource GhostActionButton}"
    Width="36"
    Height="34"
    Padding="0"
    Margin="0,0,8,0"
    Command="{Binding OpenPreviousVideoViewerPlaylistItemCommand}"
    ToolTip="上一项">
    <materialDesign:PackIcon Kind="SkipPrevious" Width="16" Height="16" />
    </Button>
    <Button Style="{StaticResource PrimaryActionButton}"
    Width="40"
    Height="34"
    Padding="0"
    Click="VideoPlayPauseButton_OnClick"
    ToolTip="播放或暂停">
    <materialDesign:PackIcon Width="17" Height="17">
    <materialDesign:PackIcon.Style>
    <Style TargetType="materialDesign:PackIcon">
    <Setter Property="Kind" Value="Play" />
    <Style.Triggers>
    <DataTrigger Binding="{Binding IsVideoViewerPlaying}" Value="True">
    <Setter Property="Kind" Value="Pause" />
    </DataTrigger>
    </Style.Triggers>
    </Style>
    </materialDesign:PackIcon.Style>
    </materialDesign:PackIcon>
    </Button>
    <Button Style="{StaticResource GhostActionButton}"
    Width="40"
    Height="34"
    Padding="0"
    Margin="8,0,0,0"
    Click="VideoStopButton_OnClick"
    ToolTip="停止">
    <materialDesign:PackIcon Kind="Stop" Width="17" Height="17" />
    </Button>
    <Button Style="{StaticResource GhostActionButton}"
    Width="36"
    Height="34"
    Padding="0"
    Margin="8,0,0,0"
    Command="{Binding OpenNextVideoViewerPlaylistItemCommand}"
    ToolTip="下一项">
    <materialDesign:PackIcon Kind="SkipNext" Width="16" Height="16" />
    </Button>
    </StackPanel>
    
    <Slider x:Name="VideoProgressSlider"
    Grid.Row="1"
    Grid.Column="1"
    Minimum="0"
    Maximum="{Binding VideoViewerDurationSeconds}"
    Value="{Binding VideoViewerPositionSeconds, Mode=TwoWay}"
    VerticalAlignment="Center"
    PreviewMouseLeftButtonDown="VideoProgressSlider_OnPreviewMouseLeftButtonDown"
    PreviewMouseLeftButtonUp="VideoProgressSlider_OnPreviewMouseLeftButtonUp" />
    
    <StackPanel x:Name="VideoVolumeSpeedPanel" Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
    <Button Style="{StaticResource GhostActionButton}"
    Width="36"
    Height="32"
    Padding="0"
    Command="{Binding ToggleVideoViewerMuteCommand}"
    ToolTip="{Binding VideoViewerMuteText}">
    <materialDesign:PackIcon Width="16" Height="16">
    <materialDesign:PackIcon.Style>
    <Style TargetType="materialDesign:PackIcon">
    <Setter Property="Kind" Value="VolumeHigh" />
    <Style.Triggers>
    <DataTrigger Binding="{Binding VideoViewerIsMuted}" Value="True">
    <Setter Property="Kind" Value="VolumeOff" />
    </DataTrigger>
    </Style.Triggers>
    </Style>
    </materialDesign:PackIcon.Style>
    </materialDesign:PackIcon>
    </Button>
    <Slider Width="90"
    Minimum="0"
    Maximum="1"
    Value="{Binding VideoViewerVolume, Mode=TwoWay}"
    VerticalAlignment="Center"
    Margin="8,0,0,0" />
    <ComboBox Width="74"
    Height="30"
    Margin="10,0,0,0"
    SelectedValue="{Binding VideoViewerSpeedRatio, Mode=TwoWay}"
    SelectedValuePath="Tag"
    SelectionChanged="VideoSpeedComboBox_OnSelectionChanged"
    ToolTip="播放速度">
    <ComboBoxItem Content="0.5x" Tag="0.5" />
    <ComboBoxItem Content="1x" Tag="1" IsSelected="True" />
    <ComboBoxItem Content="1.5x" Tag="1.5" />
    <ComboBoxItem Content="2x" Tag="2" />
    </ComboBox>
    </StackPanel>
    
    <StackPanel x:Name="VideoStatusLinePanel" Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,6,0,0">
    <TextBlock Text="{Binding VideoViewerPositionText}" Style="{StaticResource TextCaption}" />
    <TextBlock Text=" / " Style="{StaticResource TextCaption}" Opacity="0.7" />
    <TextBlock Text="{Binding VideoViewerDurationText}" Style="{StaticResource TextCaption}" />
    <TextBlock Text="  ·  音量 " Style="{StaticResource TextCaption}" Opacity="0.7" Margin="8,0,0,0" />
    <TextBlock Text="{Binding VideoViewerVolumeText}" Style="{StaticResource TextCaption}" />
    <TextBlock Text="  ·  速度 " Style="{StaticResource TextCaption}" Opacity="0.7" Margin="8,0,0,0" />
    <TextBlock Text="{Binding VideoViewerSpeedText}" Style="{StaticResource TextCaption}" />
    <TextBlock Text="  ·  " Style="{StaticResource TextCaption}" Opacity="0.7" Margin="8,0,0,0" />
    <TextBlock Text="{Binding VideoViewerPlaylistText}" Style="{StaticResource TextCaption}" />
    <TextBlock Text="  ·  " Style="{StaticResource TextCaption}" Opacity="0.7" Margin="8,0,0,0" />
    <TextBlock Text="{Binding VideoViewerPlayModeText}" Style="{StaticResource TextCaption}" />
    <TextBlock Text="  ·  " Style="{StaticResource TextCaption}" Opacity="0.7" Margin="8,0,0,0" />
    <TextBlock Text="{Binding VideoViewerLoopStatusText}" Style="{StaticResource TextCaption}" />
    </StackPanel>
    <StackPanel x:Name="VideoLoopActionsPanel" Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,6,0,0">
    <Button Style="{StaticResource GhostActionButton}"
    Height="28"
    Padding="8,0"
    Margin="0,0,6,0"
    Command="{Binding SetVideoViewerLoopStartCommand}"
    ToolTip="把当前位置设为 A 点">
    <StackPanel Orientation="Horizontal">
    <materialDesign:PackIcon Kind="FlagOutline" Width="13" Height="13" Margin="0,0,4,0" />
    <TextBlock Text="{Binding VideoViewerLoopStartText}" />
    </StackPanel>
    </Button>
    <Button Style="{StaticResource GhostActionButton}"
    Height="28"
    Padding="8,0"
    Margin="0,0,6,0"
    Command="{Binding SetVideoViewerLoopEndCommand}"
    ToolTip="把当前位置设为 B 点">
    <StackPanel Orientation="Horizontal">
    <materialDesign:PackIcon Kind="FlagCheckered" Width="13" Height="13" Margin="0,0,4,0" />
    <TextBlock Text="{Binding VideoViewerLoopEndText}" />
    </StackPanel>
    </Button>
    <Button Style="{StaticResource GhostActionButton}"
    Height="28"
    Padding="8,0"
    Margin="0,0,6,0"
    Command="{Binding ToggleVideoViewerLoopCommand}"
    ToolTip="开启或关闭 A/B 片段循环">
    <StackPanel Orientation="Horizontal">
    <materialDesign:PackIcon Kind="Repeat" Width="13" Height="13" Margin="0,0,4,0" />
    <TextBlock Text="{Binding VideoViewerLoopStatusText}" />
    </StackPanel>
    </Button>
    <Button Style="{StaticResource GhostActionButton}"
    Height="28"
    Padding="8,0"
    Margin="0,0,6,0"
    Command="{Binding SaveVideoViewerLoopRangeCommand}"
    ToolTip="保存当前 A/B 区间到右侧区间列表">
    <StackPanel Orientation="Horizontal">
    <materialDesign:PackIcon Kind="ContentSaveOutline" Width="13" Height="13" Margin="0,0,4,0" />
    <TextBlock Text="区间" />
    </StackPanel>
    </Button>
    <Button Style="{StaticResource GhostActionButton}"
    Height="28"
    Padding="8,0"
    Margin="0,0,6,0"
    Command="{Binding ClearVideoViewerLoopCommand}"
    ToolTip="清除 A/B 循环点">
    <materialDesign:PackIcon Kind="Close" Width="13" Height="13" />
    </Button>
    <Button Style="{StaticResource GhostActionButton}"
    Height="28"
    Padding="8,0"
    Margin="0,0,6,0"
    Command="{Binding CaptureVideoViewerFrameCommand}"
    ToolTip="截取当前帧并在图片查看中打开">
    <StackPanel Orientation="Horizontal">
    <materialDesign:PackIcon Kind="CameraOutline" Width="13" Height="13" Margin="0,0,4,0" />
    <TextBlock Text="{Binding VideoViewerFrameCaptureText}" />
    </StackPanel>
    </Button>
    <Button Style="{StaticResource GhostActionButton}"
    Height="28"
    Padding="8,0"
    Margin="0,0,6,0"
    Command="{Binding GenerateVideoViewerWaveformCommand}"
    ToolTip="生成音频波形图">
    <StackPanel Orientation="Horizontal">
    <materialDesign:PackIcon Kind="Waveform" Width="13" Height="13" Margin="0,0,4,0" />
    <TextBlock Text="{Binding VideoViewerWaveformText}" />
    </StackPanel>
    </Button>
    <Button Style="{StaticResource GhostActionButton}"
    Height="28"
    Padding="8,0"
    Command="{Binding AddVideoViewerBookmarkCommand}"
    ToolTip="把当前位置加入书签">
    <StackPanel Orientation="Horizontal">
    <materialDesign:PackIcon Kind="BookmarkPlusOutline" Width="13" Height="13" Margin="0,0,4,0" />
    <TextBlock Text="书签" />
    </StackPanel>
    </Button>
    </StackPanel>
    </Grid>
    </Grid>
    </materialDesign:Card>
    
    <materialDesign:Card x:Name="VideoViewerSideCard" Grid.Column="1" Padding="14">
    <StackPanel>
    <TextBlock Text="媒体信息" Style="{StaticResource TextSubtitle}" FontWeight="Bold" Margin="0,0,0,8" />
    <TextBlock Text="文件名" Style="{StaticResource TextFieldLabel}" />
    <TextBlock Text="{Binding VideoViewerFileName}" TextWrapping="Wrap" Margin="0,1,0,7" FontSize="12" />
    <TextBlock Text="时长" Style="{StaticResource TextFieldLabel}" />
    <TextBlock Text="{Binding VideoViewerDurationText}" Margin="0,1,0,7" FontSize="12" />
    <TextBlock Text="状态" Style="{StaticResource TextFieldLabel}" />
    <TextBlock Text="{Binding VideoViewerPlaybackText}" Margin="0,1,0,7" FontSize="12" />
    <TextBlock Text="速度" Style="{StaticResource TextFieldLabel}" />
    <TextBlock Text="{Binding VideoViewerSpeedText}" Margin="0,1,0,7" FontSize="12" />
    <TextBlock Text="片段循环" Style="{StaticResource TextFieldLabel}" />
    <Grid Margin="0,1,0,7">
    <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*" />
    <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <TextBlock Text="{Binding VideoViewerLoopRangeText}" FontSize="12" VerticalAlignment="Center" />
    <TextBlock Grid.Column="1" Text="{Binding VideoViewerLoopStatusText}" Style="{StaticResource TextHint}" Margin="8,0,0,0" VerticalAlignment="Center" />
    </Grid>
    <TextBlock Text="播放列表" Style="{StaticResource TextFieldLabel}" />
    <Grid Margin="0,1,0,7">
    <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*" />
    <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <TextBlock Text="{Binding VideoViewerPlaylistText}" FontSize="12" VerticalAlignment="Center" />
    <StackPanel Grid.Column="1" Orientation="Horizontal">
    <Button Style="{StaticResource GhostActionButton}"
    Width="30"
    Height="26"
    Padding="0"
    Margin="0,0,4,0"
    Command="{Binding LoadVideoViewerPlaylistCommand}"
    ToolTip="载入 M3U/M3U8 播放列表">
    <materialDesign:PackIcon Kind="PlaylistPlus" Width="14" Height="14" />
    </Button>
    <Button Style="{StaticResource GhostActionButton}"
    Width="30"
    Height="26"
    Padding="0"
    Margin="0,0,4,0"
    Command="{Binding SaveVideoViewerPlaylistCommand}"
    ToolTip="保存当前播放列表为 M3U8">
    <materialDesign:PackIcon Kind="ContentSaveOutline" Width="14" Height="14" />
    </Button>
    <Button Style="{StaticResource GhostActionButton}"
    Width="30"
    Height="26"
    Padding="0"
    Margin="0,0,4,0"
    Command="{Binding CopyVideoViewerPlaylistCommand}"
    ToolTip="复制播放列表完整路径">
    <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" />
    </Button>
    <Button Style="{StaticResource GhostActionButton}"
    Width="30"
    Height="26"
    Padding="0"
    Margin="0,0,4,0"
    Command="{Binding FavoriteVideoViewerPlaylistCommand}"
    ToolTip="收藏当前播放列表">
    <materialDesign:PackIcon Kind="StarOutline" Width="14" Height="14" />
    </Button>
    <Button Style="{StaticResource GhostActionButton}"
    Width="30"
    Height="26"
    Padding="0"
    Margin="0,0,4,0"
    Command="{Binding CleanInvalidVideoViewerPlaylistItemsCommand}"
    ToolTip="清理不存在或不支持的条目">
    <materialDesign:PackIcon Kind="PlaylistCheck" Width="14" Height="14" />
    </Button>
    <Button Style="{StaticResource GhostActionButton}"
    Width="30"
    Height="26"
    Padding="0"
    Command="{Binding ClearVideoViewerPlaylistCommand}"
    ToolTip="清空播放列表">
    <materialDesign:PackIcon Kind="PlaylistRemove" Width="14" Height="14" />
    </Button>
    </StackPanel>
    </Grid>
    <TextBlock Text="播放模式" Style="{StaticResource TextFieldLabel}" />
    <ComboBox ItemsSource="{Binding VideoViewerPlayModes}"
    SelectedItem="{Binding VideoViewerPlayMode, Mode=TwoWay}"
    Style="{StaticResource StandardComboBox}"
    Height="30"
    Margin="0,1,0,8"
    ToolTip="设置列表播放方式" />
    <Grid Margin="0,0,0,6">
    <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*" />
    <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <TextBox Text="{Binding VideoViewerPlaylistSearchText, UpdateSourceTrigger=PropertyChanged}"
    Style="{StaticResource StandardTextBox}"
    Height="28"
    materialDesign:HintAssist.Hint="搜索播放列表"
    Padding="8,0" />
    <TextBlock Grid.Column="1"
    Text="{Binding VideoViewerPlaylistFilterText}"
    Style="{StaticResource TextHint}"
    Margin="8,0,0,0"
    VerticalAlignment="Center" />
    </Grid>
    <ListBox x:Name="VideoPlaylistListBox"
    ItemsSource="{Binding FilteredVideoViewerPlaylistView}"
    MaxHeight="150"
    Margin="0,0,0,8"
    BorderThickness="0"
    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
    PreviewMouseLeftButtonDown="VideoPlaylistListBox_OnPreviewMouseLeftButtonDown"
    MouseMove="VideoPlaylistListBox_OnMouseMove"
    Drop="VideoPlaylistListBox_OnDrop"
    AllowDrop="True">
    <ListBox.ItemContainerStyle>
    <Style TargetType="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,3" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="ToolTip" Value="{Binding FilePath}" />
    <EventSetter Event="MouseDoubleClick" Handler="VideoPlaylistItem_OnMouseDoubleClick" />
    </Style>
    </ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate>
    <DataTemplate>
    <Border CornerRadius="5" Padding="7,5" Background="{DynamicResource MaterialDesignToolBarBackground}">
    <Border.Style>
    <Style TargetType="Border">
    <Setter Property="BorderThickness" Value="0" />
    <Style.Triggers>
    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
    <Setter Property="Background" Value="#1F2563EB" />
    <Setter Property="BorderBrush" Value="#802563EB" />
    <Setter Property="BorderThickness" Value="1" />
    </DataTrigger>
    </Style.Triggers>
    </Style>
    </Border.Style>
    <Grid>
    <Grid.ColumnDefinitions>
    <ColumnDefinition Width="26" />
    <ColumnDefinition Width="*" />
    <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <TextBlock Text="{Binding IndexText}" Style="{StaticResource TextHint}" VerticalAlignment="Center" />
    <StackPanel Grid.Column="1">
    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontSize="12" />
    <TextBlock Text="{Binding DirectoryPath}" TextTrimming="CharacterEllipsis" FontSize="10" Opacity="0.55" />
    </StackPanel>
    <Button Grid.Column="2"
    Style="{StaticResource GhostActionButton}"
    Width="26"
    Height="24"
    Padding="0"
    Margin="6,0,0,0"
    VerticalAlignment="Center"
    Command="{Binding DataContext.RemoveVideoViewerPlaylistItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
    CommandParameter="{Binding}"
    ToolTip="从播放列表移除">
    <materialDesign:PackIcon Kind="Close" Width="12" Height="12" />
    </Button>
    </Grid>
    </Border>
    </DataTemplate>
    </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Margin="0,0,0,8"
    Visibility="{Binding HasVideoViewerFavoritePlaylists, Converter={StaticResource BoolToVis}}">
    <TextBlock Text="收藏列表" Style="{StaticResource TextFieldLabel}" Margin="0,0,0,4" />
    <ItemsControl ItemsSource="{Binding VideoViewerFavoritePlaylists}">
    <ItemsControl.ItemTemplate>
    <DataTemplate>
    <Grid Margin="0,0,0,3">
    <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*" />
    <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Button Style="{StaticResource GhostActionButton}"
    Height="32"
    Padding="7,0"
    HorizontalContentAlignment="Stretch"
    Command="{Binding DataContext.OpenFavoriteVideoViewerPlaylistCommand, RelativeSource={RelativeSource AncestorType=Window}}"
    CommandParameter="{Binding}"
    ToolTip="{Binding FullPathText}">
    <Grid>
    <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*" />
    <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <StackPanel>
    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="11" />
    <TextBlock Text="{Binding PreviewText}" TextTrimming="CharacterEllipsis" FontSize="9.5" Opacity="0.55" />
    </StackPanel>
    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
    <TextBlock Text="{Binding CountText}" Style="{StaticResource TextHint}" HorizontalAlignment="Right" />
    <TextBlock Text="{Binding TimeText}" Style="{StaticResource TextHint}" HorizontalAlignment="Right" FontSize="9.5" />
    </StackPanel>
    </Grid>
    </Button>
    <Button Grid.Column="1"
    Style="{StaticResource GhostActionButton}"
    Width="24"
    Height="24"
    Padding="0"
    Margin="4,4,0,0"
    Command="{Binding DataContext.RemoveFavoriteVideoViewerPlaylistCommand, RelativeSource={RelativeSource AncestorType=Window}}"
    CommandParameter="{Binding}"
    ToolTip="移除收藏">
    <materialDesign:PackIcon Kind="Close" Width="12" Height="12" />
    </Button>
    </Grid>
    </DataTemplate>
    </ItemsControl.ItemTemplate>
    </ItemsControl>
    </StackPanel>
    <StackPanel Margin="0,0,0,8"
    Visibility="{Binding HasVideoViewerLoopRanges, Converter={StaticResource BoolToVis}}">
    <TextBlock Text="A/B 区间" Style="{StaticResource TextFieldLabel}" Margin="0,0,0,4" />
    <ListBox ItemsSource="{Binding VideoViewerLoopRanges}"
    MaxHeight="104"
    BorderThickness="0"
    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListBox.ItemContainerStyle>
    <Style TargetType="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,3" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <EventSetter Event="MouseDoubleClick" Handler="VideoLoopRangeItem_OnMouseDoubleClick" />
    </Style>
    </ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate>
    <DataTemplate>
    <Border CornerRadius="5" Padding="7,4" Background="{DynamicResource MaterialDesignToolBarBackground}">
    <Grid>
    <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*" />
    <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <StackPanel>
    <TextBlock Text="{Binding RangeText}" FontSize="12" FontWeight="SemiBold" />
    <TextBlock Text="{Binding DurationText}" TextTrimming="CharacterEllipsis" FontSize="10" Opacity="0.55" />
    </StackPanel>
    <Button Grid.Column="1"
    Style="{StaticResource GhostActionButton}"
    Width="24"
    Height="24"
    Padding="0"
    Margin="0,0,4,0"
    Command="{Binding DataContext.OpenVideoViewerLoopRangeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
    CommandParameter="{Binding}"
    Click="VideoLoopRangeOpenButton_OnClick"
    ToolTip="套用并跳到 A 点">
    <materialDesign:PackIcon Kind="RepeatVariant" Width="12" Height="12" />
    </Button>
    <Button Grid.Column="1"
    Style="{StaticResource GhostActionButton}"
    Width="24"
    Height="24"
    Padding="0"
    Margin="28,0,0,0"
    Command="{Binding DataContext.RemoveVideoViewerLoopRangeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
    CommandParameter="{Binding}"
    ToolTip="移除区间">
    <materialDesign:PackIcon Kind="Close" Width="12" Height="12" />
    </Button>
    </Grid>
    </Border>
    </DataTemplate>
    </ListBox.ItemTemplate>
    </ListBox>
    </StackPanel>
    <StackPanel Margin="0,0,0,8"
    Visibility="{Binding HasVideoViewerBookmarks, Converter={StaticResource BoolToVis}}">
    <TextBlock Text="书签点" Style="{StaticResource TextFieldLabel}" Margin="0,0,0,4" />
    <ListBox ItemsSource="{Binding VideoViewerBookmarks}"
    MaxHeight="92"
    BorderThickness="0"
    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListBox.ItemContainerStyle>
    <Style TargetType="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,3" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <EventSetter Event="MouseDoubleClick" Handler="VideoBookmarkItem_OnMouseDoubleClick" />
    </Style>
    </ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate>
    <DataTemplate>
    <Border CornerRadius="5" Padding="7,4" Background="{DynamicResource MaterialDesignToolBarBackground}">
    <Grid>
    <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*" />
    <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <StackPanel>
    <TextBlock Text="{Binding TimeText}" FontSize="12" FontWeight="SemiBold" />
    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontSize="10" Opacity="0.55" />
    </StackPanel>
    <Button Grid.Column="1"
    Style="{StaticResource GhostActionButton}"
    Width="24"
    Height="24"
    Padding="0"
    Margin="0,0,4,0"
    Command="{Binding DataContext.OpenVideoViewerBookmarkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
    CommandParameter="{Binding}"
    Click="VideoBookmarkJumpButton_OnClick"
    ToolTip="跳转到书签">
    <materialDesign:PackIcon Kind="Play" Width="12" Height="12" />
    </Button>
    <Button Grid.Column="1"
    Style="{StaticResource GhostActionButton}"
    Width="24"
    Height="24"
    Padding="0"
    Margin="28,0,0,0"
    Command="{Binding DataContext.RemoveVideoViewerBookmarkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
    CommandParameter="{Binding}"
    ToolTip="移除书签">
    <materialDesign:PackIcon Kind="Close" Width="12" Height="12" />
    </Button>
    </Grid>
    </Border>
    </DataTemplate>
    </ListBox.ItemTemplate>
    </ListBox>
    </StackPanel>
    <StackPanel Margin="0,0,0,8"
    Visibility="{Binding HasVideoViewerRecentPlaylists, Converter={StaticResource BoolToVis}}">
    <TextBlock Text="最近列表" Style="{StaticResource TextFieldLabel}" Margin="0,0,0,4" />
    <ItemsControl ItemsSource="{Binding VideoViewerRecentPlaylists}">
    <ItemsControl.ItemTemplate>
    <DataTemplate>
    <Button Style="{StaticResource GhostActionButton}"
    Height="30"
    Padding="7,0"
    Margin="0,0,0,3"
    HorizontalContentAlignment="Stretch"
    Command="{Binding DataContext.OpenRecentVideoViewerPlaylistCommand, RelativeSource={RelativeSource AncestorType=Window}}"
    CommandParameter="{Binding}"
    ToolTip="{Binding FilePath}">
    <Grid>
    <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*" />
    <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="11" VerticalAlignment="Center" />
    <TextBlock Grid.Column="1" Text="{Binding TimeText}" Style="{StaticResource TextHint}" Margin="8,0,0,0" VerticalAlignment="Center" />
    </Grid>
    </Button>
    </DataTemplate>
    </ItemsControl.ItemTemplate>
    </ItemsControl>
    </StackPanel>
    
    <Separator Margin="0,2,0,9" />
    <TextBlock Text="字幕" Style="{StaticResource TextFieldLabel}" />
    <TextBlock Text="{Binding VideoViewerSubtitleFileName}" TextWrapping="Wrap" Margin="0,1,0,7" FontSize="12" />
    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
    <Button Style="{StaticResource GhostActionButton}"
    Height="30"
    Padding="10,0"
    Margin="0,0,8,0"
    Command="{Binding LoadVideoViewerSubtitleCommand}"
    ToolTip="选择外挂 SRT 字幕">
    <StackPanel Orientation="Horizontal">
    <materialDesign:PackIcon Kind="SubtitlesOutline" Width="14" Height="14" Margin="0,0,5,0" />
    <TextBlock Text="选择" />
    </StackPanel>
    </Button>
    <Button Style="{StaticResource GhostActionButton}"
    Height="30"
    Padding="10,0"
    Command="{Binding ClearVideoViewerSubtitleCommand}"
    ToolTip="清除当前字幕">
    <StackPanel Orientation="Horizontal">
    <materialDesign:PackIcon Kind="Close" Width="14" Height="14" Margin="0,0,5,0" />
    <TextBlock Text="清除" />
    </StackPanel>
    </Button>
    </StackPanel>
    <TextBlock Text="{Binding VideoViewerSubtitleStatus}" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="11" Opacity="0.72" />
    
    <Grid Margin="0,0,0,2">
    <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*" />
    <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <TextBlock Text="时间偏移" Style="{StaticResource TextFieldLabel}" />
    <TextBlock Grid.Column="1" Text="{Binding VideoViewerSubtitleOffsetText}" Style="{StaticResource TextHint}" />
    </Grid>
    <Slider Minimum="-10" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True"
    Value="{Binding VideoViewerSubtitleOffsetSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
    Margin="0,0,0,8"
    ToolTip="正数让字幕更晚出现，负数让字幕更早出现" />
    
    <Grid Margin="0,0,0,2">
    <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*" />
    <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <TextBlock Text="字号" Style="{StaticResource TextFieldLabel}" />
    <TextBlock Grid.Column="1" Text="{Binding VideoViewerSubtitleFontSizeText}" Style="{StaticResource TextHint}" />
    </Grid>
    <Slider Minimum="12" Maximum="28" TickFrequency="1" IsSnapToTickEnabled="True"
    Value="{Binding VideoViewerSubtitleFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
    Margin="0,0,0,8"
    ToolTip="调整画面底部字幕字号" />
    
    <TextBlock Text="路径" Style="{StaticResource TextFieldLabel}" />
    <TextBlock Text="{Binding VideoViewerFilePath}"
    TextWrapping="Wrap"
    Opacity="0.72"
    FontSize="11"
    Margin="0,1,0,8" />
    
    <Border Background="{DynamicResource MaterialDesignToolBarBackground}"
    CornerRadius="6"
    Padding="10"
    Margin="0,4,0,0">
    <TextBlock Text="{Binding VideoViewerStatusMessage}"
    Style="{StaticResource TextCaption}"
    TextWrapping="Wrap" />
    </Border>
    </StackPanel>
    </materialDesign:Card>
    </Grid>
    </Grid>
    
</UserControl>
