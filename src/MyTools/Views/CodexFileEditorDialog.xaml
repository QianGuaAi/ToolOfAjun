<Window x:Class="MyTools.Views.CodexFileEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="编辑 Codex 配置文件"
        Height="560" Width="780"
        MinHeight="320" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource MaterialDesignFont}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontSize="13"
        Background="{DynamicResource MaterialDesignPaper}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Premium Header -->
        <Border Grid.Row="0" Margin="0,0,0,12" CornerRadius="10" Padding="14,10" Background="#1E293B">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon x:Name="HeaderIcon" Kind="FileDocumentOutline" Width="24" Height="24"
                                         Foreground="White" VerticalAlignment="Center" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitle" FontSize="16" FontWeight="SemiBold" Foreground="White" Text="config.toml" />
                    <TextBlock x:Name="HeaderSub" FontSize="12" Foreground="#94A3B8" Text="" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Editor - Premium Card -->
        <materialDesign:Card Grid.Row="1" Style="{StaticResource PremiumCard}" Padding="0">
            <TextBox x:Name="EditorBox"
                     AcceptsReturn="True" AcceptsTab="True"
                     TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas,Cascadia Mono,Menlo,monospace"
                     FontSize="13"
                     BorderThickness="0"
                     Padding="12"
                     Background="Transparent" />
        </materialDesign:Card>

        <!-- Info - Premium Warning -->
        <materialDesign:Card Grid.Row="2" Style="{StaticResource SectionCardDense}" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" Padding="10" Margin="0,12,0,0">
            <TextBlock FontSize="11" TextWrapping="Wrap"
                       Text="保存后内容会以 Windows DPAPI（当前用户）加密写入 MyTools.settings.json。若需同步到 ~\.codex\，请回到列表点【应用】。" />
        </materialDesign:Card>

        <!-- Buttons - Premium -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelButton" Content="关闭" Click="CancelButton_Click"
                    Style="{StaticResource GhostActionButton}"
                    MinWidth="80" Margin="0,0,8,0" IsCancel="True" />
            <Button x:Name="SaveButton" Content="保存" Click="SaveButton_Click"
                    Style="{StaticResource PrimaryActionButton}"
                    MinWidth="80" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
