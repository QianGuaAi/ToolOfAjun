<Window x:Class="MyTools.Views.NewScheduleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="新建排班"
        Height="260" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource MaterialDesignFont}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontSize="13"
        Background="{DynamicResource MaterialDesignPaper}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="选择月份并输入版本名称" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />

        <StackPanel Grid.Row="1">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="YearBox" materialDesign:HintAssist.Hint="年份"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                <ComboBox Grid.Column="2" x:Name="MonthBox" materialDesign:HintAssist.Hint="月份"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}" />
            </Grid>

            <TextBox x:Name="VersionBox" materialDesign:HintAssist.Hint="版本名称（如 v1 / 初稿 / 终版）"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Text="v1" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="取消" Click="CancelButton_Click"
                    Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" />
            <Button x:Name="OkButton" Content="确定" Click="OkButton_Click" IsDefault="True"
                    Style="{StaticResource MaterialDesignRaisedButton}" />
        </StackPanel>
    </Grid>
</Window>
