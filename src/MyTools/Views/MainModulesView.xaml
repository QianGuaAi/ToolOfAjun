                                                    </StackPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                        
                                        <Grid Grid.Row="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                        
                                            <materialDesign:Card Style="{StaticResource PremiumCard}" Padding="12" Margin="0,0,0,8">
