                                <Setter Property="ContentTemplate" Value="{StaticResource FrpViewTemplate}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <ContentControl Content="{Binding}">
