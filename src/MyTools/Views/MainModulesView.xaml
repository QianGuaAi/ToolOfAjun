                                                            <TextBlock Text="{Binding ImageViewerDirectoryPositionText}" Margin="0,1,0,7" FontSize="12" />
                                                            <TextBlock Text="缩放" Style="{StaticResource TextFieldLabel}" />
                                                            <TextBlock Text="{Binding ImageViewerZoomText}" Margin="0,1,0,7" FontSize="12" />
                                                            <TextBlock Text="处理" Style="{StaticResource TextFieldLabel}" />
                                                            <TextBlock Text="{Binding ImageViewerTransformText}" TextWrapping="Wrap" Margin="0,1,0,7" FontSize="12" />
                        
                                                            <Border Style="{StaticResource DividerLine}" Margin="0,4,0,8" />
                                                            <TextBlock Text="路径" Style="{StaticResource TextFieldLabel}" />
                                                            <TextBlock Text="{Binding ImageViewerFilePath}"
                                                                       TextWrapping="Wrap"
                                                                       Opacity="0.72"
                                                                       FontSize="11"
                                                                       Margin="0,1,0,8" />
                        
                                                            <Border Background="{DynamicResource MaterialDesignToolBarBackground}"
                                                                    CornerRadius="6"
                                                                    Padding="10"
                                                                    Margin="0,4,0,0">
                                                                <TextBlock Text="{Binding ImageViewerStatusMessage}"
                                                                           Style="{StaticResource TextCaption}"
                                                                           TextWrapping="Wrap" />
                                                            </Border>
                                                        </StackPanel>
                                                    </TabItem>
                                                    <TabItem Header="轻编辑">
                                                        <StackPanel>
                                                            <TextBlock Text="轻编辑" Style="{StaticResource TextSubtitle}" FontWeight="Bold" Margin="0,0,0,8" />
