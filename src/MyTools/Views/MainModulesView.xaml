                                                                            <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="12" Height="12" VerticalAlignment="Center" Opacity="0.5" Margin="14,0,0,0" />
                                                                            <TextBlock Text="{Binding SignatureStatusDisplay}" Margin="4,0,0,0"
                                                                                       ToolTip="{Binding SignatureDetailDisplay}">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                                                                                        <Setter Property="Foreground" Value="#E65100" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsDigitallySigned}" Value="True">
                                                                                                <Setter Property="Foreground" Value="#2E7D32" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding ExecutableExists}" Value="False">
                                                                                                <Setter Property="Foreground" Value="#757575" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                            <materialDesign:PackIcon Kind="ShieldLockOutline" Width="12" Height="12" VerticalAlignment="Center" Opacity="0.5" Margin="14,0,0,0" />
                                                                            <TextBlock Text="{Binding SignatureTrustStatus}" Margin="4,0,0,0"
                                                                                       ToolTip="{Binding SignatureDetailDisplay}">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                                                                                        <Setter Property="Foreground" Value="#757575" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsSignatureChainTrusted}" Value="True">
                                                                                                <Setter Property="Foreground" Value="#2E7D32" />
                                                                                            </DataTrigger>
                                                                                            <MultiDataTrigger>
                                                                                                <MultiDataTrigger.Conditions>
                                                                                                    <Condition Binding="{Binding IsDigitallySigned}" Value="True" />
                                                                                                    <Condition Binding="{Binding IsSignatureChainTrusted}" Value="False" />
                                                                                                </MultiDataTrigger.Conditions>
                                                                                                <Setter Property="Foreground" Value="#C62828" />
                                                                                            </MultiDataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                    </StackPanel>
                        
                                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Margin="0,0,8,0">
                                                                        <Button Command="{Binding DataContext.ToggleStartupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                CommandParameter="{Binding}"
                                                                                Width="80"
                                                                                Margin="0,0,8,0">
                                                                            <Button.Style>
                                                                                <Style TargetType="Button" BasedOn="{StaticResource GhostActionButton}">
                                                                                    <Setter Property="Content" Value="禁用" />
                                                                                    <Setter Property="Foreground" Value="#C62828" />
                                                                                    <Setter Property="BorderBrush" Value="#C62828" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                                            <Setter Property="Content" Value="启用" />
                                                                                            <Setter Property="Foreground" Value="#2E7D32" />
                                                                                            <Setter Property="BorderBrush" Value="#2E7D32" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Button.Style>
                                                                        </Button>
                        
                                                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                                                Command="{Binding DataContext.DeleteStartupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                CommandParameter="{Binding}"
                                                                                ToolTip="永久删除（需确认）">
                                                                            <materialDesign:PackIcon Kind="DeleteOutline" Foreground="#9E9E9E" />
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </materialDesign:Card>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                        
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                        Visibility="{Binding HasNoStartupItems, Converter={StaticResource BoolToVis}}">
                                                <Image Source="{StaticResource StartupEmpty}" Width="160" Height="120" HorizontalAlignment="Center" />
                                                <TextBlock Text="未发现匹配的启动项" Style="{StaticResource TextSubtitle}"
                                                           HorizontalAlignment="Center" Opacity="0.4" Margin="0,12,0,0" />
                                                <TextBlock Text="可清空搜索或点击刷新重新扫描" Style="{StaticResource TextCaption}"
                                                           HorizontalAlignment="Center" Opacity="0.3" Margin="0,4,0,0" />
                                                <Button Content="刷新"
                                                        Style="{StaticResource GhostActionButton}"
                                                        Command="{Binding RefreshCommand}"
                                                        Margin="0,12,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                        
                    </DataTemplate>
                </ContentControl.Resources>
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="ContentTemplate" Value="{x:Null}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSystemStartupVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="ContentTemplate" Value="{StaticResource StartupDeferredTemplate}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            <ContentControl x:Name="OptimizationHost" Content="{Binding}">
                <ContentControl.Resources>
                    <DataTemplate x:Key="OptimizationDeferredTemplate">
                        <!-- GIANT CONTENT REMOVED (2026-05-27 XAML split per AGENTS.md 9.3)
                             All 8 tabs (系统锁定/安全防护/自动更新/自动优化/垃圾清理/微信清理/备份/恢复) now live in
                             src/MyTools/Views/SystemOptimizationView.xaml (662 lines, loaded on-demand only).
                             This placeholder keeps the template shell for easy rollback if needed.
                             The old host is force-collapsed; new <views:SystemOptimizationView/> handles rendering.
                             MainModulesView.xaml line count reduced significantly. -->
                    </DataTemplate>
                </ContentControl.Resources>
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="ContentTemplate" Value="{x:Null}" />
                        <Style.Triggers>
                            <!-- Legacy giant template kept for rollback safety but FORCED collapsed when new extracted view is active (perf) -->
                            <DataTrigger Binding="{Binding IsSystemOptimizationVisible}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="ContentTemplate" Value="{x:Null}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <!-- Extracted SystemOptimizationView host (AGENTS.md 9.3 compliant, defers heavy XAML parse & instantiation) -->
            <ContentControl>
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSystemOptimizationVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Content">
