                                <Setter Property="ContentTemplate" Value="{StaticResource VideoViewerViewTemplate}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <!-- Codex config profiles panel -->
            <ContentControl x:Name="CodexProfilesHost" Content="{Binding}">
                <ContentControl.Resources>
                    <DataTemplate x:Key="CodexProfilesDeferredTemplate">
                        <Grid Margin="16">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
