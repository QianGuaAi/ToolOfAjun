                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                        
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="175" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="260" />
                                            </Grid.ColumnDefinitions>
                        
                                            <!-- 左侧文件夹树 -->
                                            <materialDesign:Card Grid.Column="0" Padding="8" Margin="0,0,12,0">
