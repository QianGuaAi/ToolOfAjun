                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <ContentControl x:Name="SqlExportHost" Content="{Binding}">
                <ContentControl.Resources>
                    <DataTemplate x:Key="SqlExportDeferredTemplate">
                                    <Grid Margin="20">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentModule}" Value="SqlExport">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                        
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                        
                                        <Border Grid.Row="0"
                                                Margin="0,0,0,10"
                                                CornerRadius="{StaticResource CornerRadiusCard}"
                                                Padding="12,8">
