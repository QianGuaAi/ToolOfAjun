                                        <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <DockPanel LastChildFill="True">
                                    <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <Button Style="{StaticResource PrimaryActionButton}"
