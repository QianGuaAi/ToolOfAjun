                                                <materialDesign:Card Padding="12,10" Margin="0,8,0,0">
                                                    <StackPanel>
                                                        <StackPanel Style="{StaticResource SectionHeaderRow}">
                                                            <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource BrushBlueGradient}" Margin="0,0,10,0">
                                                                <materialDesign:PackIcon Kind="ShieldKey" Width="14" Height="14" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                            </Border>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="文件哈希校验" Style="{StaticResource TextSubtitle}" />
                                                                <TextBlock Text="{Binding FileHashStatusMessage}" Style="{StaticResource TextHint}" Margin="0,1,0,0" />
                                                            </StackPanel>
                                                        </StackPanel>
                        
                                                        <Button Style="{StaticResource GhostActionButton}"
                                                                Command="{Binding ComputeFileHashCommand}"
                                                                HorizontalAlignment="Left">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="FileSearch" Width="14" Height="14" Margin="0,0,6,0"/>
                                                                <TextBlock Text="选择文件并计算"/>
                                                            </StackPanel>
                                                        </Button>
                        
                                                        <TextBox Text="{Binding ExpectedFileHash, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource StandardTextBox}"
                                                                 materialDesign:HintAssist.Hint="官方校验值（可选：MD5 / SHA-1 / SHA-256 / CRC32）"
                                                                 Margin="0,8,0,0" />
                        
                                                        <Border Background="{DynamicResource BrushInfoSoft}"
                                                                CornerRadius="6" Padding="10,7" Margin="0,8,0,0"
                                                                Visibility="{Binding HasFileHashCompareResult, Converter={StaticResource BoolToVis}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="14" Height="14"
                                                                                         Foreground="{DynamicResource BrushInfo}"
                                                                                         Margin="0,0,7,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding FileHashCompareResult}" Style="{StaticResource TextCaption}"
                                                                           FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                        
                                                        <Border Background="{DynamicResource MaterialDesignToolBarBackground}"
                                                                CornerRadius="6" Padding="10,8" Margin="0,8,0,0"
                                                                Visibility="{Binding FileHashResult, Converter={StaticResource StringNotEmptyToVisibility}}"
                                                                Cursor="Hand"
                                                                MouseLeftButtonUp="FileHashResult_OnClick">
                                                            <TextBlock Text="{Binding FileHashResult}" Style="{StaticResource TextMonoCode}"
                                                                       ToolTip="点击复制到剪贴板" />
                                                        </Border>
                                                    </StackPanel>
                                                </materialDesign:Card>
                        
                                                </StackPanel>
                                            </TabItem>
                                        </TabControl>
                                    </Grid>
                        
                    </DataTemplate>
                </ContentControl.Resources>
                <ContentControl.Style>
