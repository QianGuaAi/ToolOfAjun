                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="SwapHorizontal" Width="15" Height="15" Margin="0,0,5,0" />
                                                                <TextBlock Text="水平" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource GhostActionButton}"
                                                                Command="{Binding FlipImageViewerVerticalCommand}"
                                                                Height="32"
                                                                Padding="10,0"
                                                                Margin="0,0,10,6"
