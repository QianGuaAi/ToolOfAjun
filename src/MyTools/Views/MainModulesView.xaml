<UserControl x:Class="MyTools.Views.MainModulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewModels="clr-namespace:MyTools.ViewModels"
             xmlns:views="clr-namespace:MyTools.Views">
    <UserControl.Resources>
        <viewModels:StatusToColorConverter x:Key="StatusToColorConverter" />
        <viewModels:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <viewModels:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility" />
        <viewModels:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility" />
        <viewModels:VideoWaveformPositionConverter x:Key="VideoWaveformPositionConverter" />
        <viewModels:VideoWaveformRangeConverter x:Key="VideoWaveformRangeConverter" />
        <DataTemplate x:Key="FrpViewTemplate">
            <views:FrpView DataContext="{Binding Frp}" />
        </DataTemplate>
        <DataTemplate x:Key="MultimediaViewTemplate">
            <views:MultimediaPage DataContext="{Binding Multimedia}" />
        </DataTemplate>
        <DataTemplate x:Key="VideoViewerViewTemplate">
            <views:VideoViewerPage />
        </DataTemplate>
        <DataTemplate x:Key="ScheduleViewTemplate">
            <views:SchedulePage DataContext="{Binding Schedule}" />
        </DataTemplate>
    </UserControl.Resources>
    <Grid Background="{DynamicResource MaterialDesignFlatBackground}">
    <!-- Extracted SystemOptimizationView host (AGENTS.md 9.3 compliant, defers heavy XAML parse & instantiation) -->
    <ContentControl>
        <ContentControl.Style>
            <Style TargetType="ContentControl">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentModule}" Value="Optimization">
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="Content">
                            <Setter.Value>
                                <views:SystemOptimizationView />
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ContentControl.Style>
    </ContentControl>

    <ContentControl x:Name="SqlExportHost" Content="{Binding}">
        <ContentControl.Resources>
            <DataTemplate x:Key="SqlExportDeferredTemplate">
                            <Grid Margin="20">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentModule}" Value="SqlExport">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                
                                <Border Grid.Row="0"
                                        Margin="0,0,0,10"
                                        CornerRadius="{StaticResource CornerRadiusCard}"
                                        Padding="12,8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right"
                                                Margin="16,0,0,0"
                                                Padding="8,3"
                                                CornerRadius="12"
                                                Background="#1F1976D2"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="SQL Server / PostgreSQL / MySQL" Foreground="#1976D2" FontWeight="SemiBold" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource BrushBlueGradient}" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="DatabaseArrowDown" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="SQL 导出工具" Style="{StaticResource TextHeadline}" />
                                                <TextBlock Text="批量导出数据库表到 .xlsx" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                
                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                
                                    <materialDesign:Card Style="{StaticResource PremiumCard}" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.1*" />
                                                <ColumnDefinition Width="1.7*" />
                                                <ColumnDefinition Width="86" />
                                                <ColumnDefinition Width="1.25*" />
                                                <ColumnDefinition Width="1.25*" />
                                            </Grid.ColumnDefinitions>
                
                                            <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,8,6">
                                                <ComboBox x:Name="SqlProviderBox"
                                                          ItemsSource="{Binding SqlProviderOptions}"
                                                          SelectedValuePath="Kind"
                                                          DisplayMemberPath="DisplayName"
                                                          SelectedValue="{Binding SelectedSqlProvider, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource StandardComboBox}" />
                                                <TextBlock Text="选择数据库类型"
                                                           Margin="12,0,28,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                           FontSize="12"
                                                           Opacity="0.72"
                                                           IsHitTestVisible="False"
                                                           Visibility="{Binding SelectedItem, ElementName=SqlProviderBox, Converter={StaticResource NullOrEmptyToVisibility}}" />
                                            </Grid>
                
                                            <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,8,6">
                                                <ComboBox x:Name="SqlServerAddressBox"
                                                          IsEditable="True"
                                                          IsReadOnly="False"
                                                          IsTextSearchEnabled="False"
                                                          StaysOpenOnEdit="True"
                                                          ItemsSource="{Binding SqlServerAddressHistory}"
                                                          Text="{Binding SqlServerAddress, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource StandardComboBox}" />
                                                <TextBlock Text="输入服务器地址或 IP"
                                                           Margin="12,0,28,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                           FontSize="12"
                                                           Opacity="0.72"
                                                           IsHitTestVisible="False"
                                                           Visibility="{Binding SqlServerAddress, Converter={StaticResource NullOrEmptyToVisibility}}" />
                                            </Grid>
                
                                            <Grid Grid.Row="0" Grid.Column="2" Margin="0,0,8,6">
                                                <TextBox Text="{Binding SqlPort, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource StandardTextBox}" />
                                                <TextBlock Text="{Binding SqlPortHint}"
                                                           Margin="12,0,8,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                           FontSize="12"
                                                           Opacity="0.72"
                                                           IsHitTestVisible="False"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding SqlPort, Converter={StaticResource NullOrEmptyToVisibility}}" />
                                            </Grid>
                
                                            <Grid Grid.Row="0" Grid.Column="3" Margin="0,0,8,6">
                                                <ComboBox x:Name="SqlUsernameBox"
                                                          IsEditable="True"
                                                          IsTextSearchEnabled="False"
                                                          ItemsSource="{Binding SqlUsernameHistory}"
                                                          Text="{Binding SqlUsername, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource StandardComboBox}" />
                                                <TextBlock Text="输入数据库用户名"
                                                           Margin="12,0,28,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                           FontSize="12"
                                                           Opacity="0.72"
                                                           IsHitTestVisible="False"
                                                           Visibility="{Binding SqlUsername, Converter={StaticResource NullOrEmptyToVisibility}}" />
                                            </Grid>
                
                                            <Grid Grid.Row="0"
                                                  Grid.Column="4"
                                                  Margin="0,0,0,6">
                                                <PasswordBox x:Name="SqlPasswordBox"
                                                             Height="36"
                                                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                                             Loaded="SqlPasswordBox_OnLoaded"
                                                             PasswordChanged="SqlPasswordBox_OnPasswordChanged" />
                                                <TextBlock Text="输入数据库密码"
                                                           Margin="12,0,34,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                           FontSize="12"
                                                           Opacity="0.72"
                                                           IsHitTestVisible="False"
                                                           Visibility="{Binding SqlPassword, Converter={StaticResource NullOrEmptyToVisibility}}" />
                                                <Button x:Name="SqlPasswordHistoryButton"
                                                        Width="32"
                                                        Height="32"
                                                        Padding="0"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Click="SqlPasswordHistoryButton_OnClick"
                                                        Style="{StaticResource MaterialDesignIconButton}"
                                                        ToolTip="选择历史密码">
                                                    <materialDesign:PackIcon Width="20" Height="20" Kind="ChevronDown" />
                                                    <Button.ContextMenu>
                                                        <ContextMenu ItemsSource="{Binding PlacementTarget.DataContext.SqlPasswordHistory, RelativeSource={RelativeSource Self}}"
                                                                     materialDesign:MenuAssist.TopLevelMenuItemHeight="36">
                                                            <ContextMenu.ItemContainerStyle>
                                                                <Style TargetType="MenuItem">
                                                                    <Setter Property="Header" Value="••••••••" />
                                                                    <Setter Property="ToolTip" Value="使用此历史密码" />
                                                                    <EventSetter Event="Click" Handler="SqlPasswordHistoryMenuItem_OnClick" />
                                                                </Style>
                                                            </ContextMenu.ItemContainerStyle>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </Grid>
                
                                            <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,8,6">
                                                <ComboBox x:Name="SqlDatabaseBox"
                                                          ItemsSource="{Binding SqlDatabaseList}"
                                                          SelectedItem="{Binding SelectedSqlDatabase}"
                                                          DisplayMemberPath="Name"
                                                          Style="{StaticResource StandardComboBox}" />
                                                <TextBlock Text="测试连接后选择数据库"
                                                           Margin="12,0,28,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                           FontSize="12"
                                                           Opacity="0.72"
                                                           IsHitTestVisible="False"
                                                           Visibility="{Binding SelectedSqlDatabase, Converter={StaticResource NullOrEmptyToVisibility}}" />
                                            </Grid>
                
                                            <Grid Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Margin="0,0,0,6">
                                                <ComboBox x:Name="SqlTableBox"
                                                          IsEditable="True"
                                                          IsTextSearchEnabled="False"
                                                          StaysOpenOnEdit="True"
                                                          ItemsSource="{Binding FilteredSqlTableView}"
                                                          SelectedItem="{Binding SelectedSqlTable, UpdateSourceTrigger=PropertyChanged}"
                                                          Text="{Binding SqlTableSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                          DisplayMemberPath="DisplayName"
                                                          Style="{StaticResource StandardComboBox}" />
                                                <TextBlock Text="选择或输入要导出的数据表"
                                                           Margin="12,0,28,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                           FontSize="12"
                                                           Opacity="0.72"
                                                           IsHitTestVisible="False"
                                                           Visibility="{Binding SqlTableSearchText, Converter={StaticResource NullOrEmptyToVisibility}}" />
                                            </Grid>
                                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5"
                                                        Orientation="Horizontal" HorizontalAlignment="Right"
                                                        Margin="0,0,0,6">
                                                <Button Width="88"
                                                        Height="34"
                                                        Margin="0,0,8,0"
                                                        Command="{Binding TestSqlConnectionCommand}"
                                                        Style="{StaticResource PrimaryActionButton}"
                                                        Content="测试连接" />
                
                                                <Button Width="116"
                                                        Height="34"
                                                        Margin="0,0,8,0"
                                                        Command="{Binding ExportSqlTableCommand}"
                                                        Style="{StaticResource SuccessActionButton}"
                                                        Content="导出为 Excel" />
                
                                                <Button Width="72"
                                                        Height="34"
                                                        Command="{Binding CancelSqlExportCommand}"
                                                        Style="{StaticResource GhostActionButton}"
                                                        Content="取消" />
                                            </StackPanel>
                
                                            <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource BadgeInfo}" Padding="8,2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="InformationOutline" Width="12" Height="12" Margin="0,0,4,0" />
                                                        <TextBlock Text="{Binding SqlStatusMessage}" TextWrapping="Wrap" FontSize="12" />
                                                    </StackPanel>
                                                </Border>
                
                                                <ProgressBar Grid.Column="1"
                                                             Width="140"
                                                             Height="5"
                                                             Margin="12,0,0,0"
                                                             VerticalAlignment="Center"
                                                             IsIndeterminate="True"
                                                             Visibility="{Binding IsSqlBusy, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                
                                            <Border Grid.Row="4"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="5"
                                                    Margin="0,8,0,0"
                                                    Visibility="{Binding HasSqlRecentConnections, Converter={StaticResource BoolToVis}}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <materialDesign:PackIcon Kind="History" Width="14" Height="14"
                                                                                 Foreground="{DynamicResource BrushAccentBlue}"
                                                                                 Margin="0,0,6,0"
                                                                                 VerticalAlignment="Center" />
                                                        <TextBlock Text="最近连接" Style="{StaticResource TextCaption}" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                    <ItemsControl ItemsSource="{Binding SqlRecentConnections}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Style="{StaticResource GhostActionButton}"
                                                                        Margin="0,0,8,6"
                                                                        Padding="10,4"
                                                                        Command="{Binding DataContext.ApplySqlRecentConnectionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip="套用此连接">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <materialDesign:PackIcon Kind="DatabaseCheckOutline" Width="14" Height="14" Margin="0,0,6,0" />
                                                                        <TextBlock Text="{Binding ServerDisplay}" FontWeight="SemiBold" />
                                                                        <TextBlock Text=" · " Opacity="0.55" />
                                                                        <TextBlock Text="{Binding UsernameDisplay}" Opacity="0.75" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </materialDesign:Card>
                
                                    <TabControl Grid.Row="1"
                                                Style="{StaticResource MaterialDesignTabControl}"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                MinHeight="260"
                                                materialDesign:ColorZoneAssist.Mode="PrimaryMid">
                
                                        <TabItem Header="使用说明">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <materialDesign:Card Padding="14" Margin="0,6,0,0">
                                                    <StackPanel>
                                                        <TextBlock Text="使用说明" Style="{StaticResource TextSubtitle}" FontWeight="Bold" />
                                                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                                                            支持 SQL Server / PostgreSQL / MySQL 账号密码连接。流程：测试连接 → 选择数据库 → 选择表 → 导出整表。
                                                        </TextBlock>
                                                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap">
                                                            SQL 查询标签页支持执行任意查询语句，结果可直接导出 Excel。
                                                        </TextBlock>
                                                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap">
                                                            目标表超过 Excel 单工作表上限 1,048,576 行时，程序会阻止导出并给出提示。
                                                        </TextBlock>
                                                    </StackPanel>
                                                </materialDesign:Card>
                                            </ScrollViewer>
                                        </TabItem>
                
                                        <TabItem Header="SQL 查询">
                                            <Grid Margin="0,6,0,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                
                                                <materialDesign:Card Grid.Row="0" Padding="8" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="72" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBox Grid.Row="0"
                                                                 Text="{Binding SqlQueryText, UpdateSourceTrigger=PropertyChanged}"
                                                                 AcceptsReturn="True"
                                                                 TextWrapping="NoWrap"
                                                                 HorizontalScrollBarVisibility="Auto"
                                                                 VerticalScrollBarVisibility="Auto"
                                                                 FontFamily="Consolas"
                                                                 FontSize="12"
                                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                                 materialDesign:HintAssist.Hint="输入 SQL 语句，例如：SELECT * FROM schema.table LIMIT 100" />
                
                                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                                                            <Button Width="100" Height="32"
                                                                    Margin="0,0,8,0"
                                                                    Content="执行查询"
                                                                    Command="{Binding ExecuteSqlQueryCommand}"
                                                                    Style="{StaticResource PrimaryActionButton}">
                                                                <Button.ContentTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <materialDesign:PackIcon Kind="Play" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </Button.ContentTemplate>
                                                            </Button>
                                                            <Button Width="116" Height="32"
                                                                    Margin="0,0,8,0"
                                                                    Content="导出 Excel"
                                                                    Command="{Binding ExportQueryResultCommand}"
                                                                    Style="{StaticResource GhostActionButton}">
                                                                <Button.ContentTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <materialDesign:PackIcon Kind="FileExcel" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </Button.ContentTemplate>
                                                            </Button>
                                                            <Button Width="108" Height="32"
                                                                    Margin="0,0,8,0"
                                                                    Content="导出 CSV"
                                                                    Command="{Binding ExportQueryResultCsvCommand}"
                                                                    Style="{StaticResource GhostActionButton}">
                                                                <Button.ContentTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <materialDesign:PackIcon Kind="FileDelimitedOutline" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </Button.ContentTemplate>
                                                            </Button>
                                                            <Button Width="108" Height="32"
                                                                    Margin="0,0,12,0"
                                                                    Content="复制结果"
                                                                    Click="CopySqlQueryResultButton_OnClick"
                                                                    Style="{StaticResource GhostActionButton}">
                                                                <Button.ContentTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <materialDesign:PackIcon Kind="ContentCopy" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </Button.ContentTemplate>
                                                            </Button>
                                                            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                                         IsIndeterminate="True"
                                                                         Width="18" Height="18"
                                                                         VerticalAlignment="Center"
                                                                         Margin="0,0,10,0"
                                                                         Visibility="{Binding IsQueryBusy, Converter={StaticResource BoolToVis}}" />
                                                            <TextBlock Text="{Binding QueryStatusMessage}"
                                                                       Style="{StaticResource TextCaption}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Opacity="0.7" />
                                                        </StackPanel>
                                                    </Grid>
                                                </materialDesign:Card>
                
                                                <DataGrid Grid.Row="1"
                                                          x:Name="SqlQueryResultGrid"
                                                          ItemsSource="{Binding SqlQueryResult}"
                                                          AutoGenerateColumns="True"
                                                          IsReadOnly="True"
                                                          ClipboardCopyMode="IncludeHeader"
                                                          CanUserAddRows="False"
                                                          CanUserDeleteRows="False"
                                                          CanUserSortColumns="True"
                                                          MinHeight="180"
                                                          VerticalScrollBarVisibility="Visible"
                                                          HorizontalScrollBarVisibility="Auto"
                                                          SelectionMode="Extended"
                                                          Style="{StaticResource MaterialDesignDataGrid}"
                                                          materialDesign:DataGridAssist.CellPadding="8 4 8 4"
                                                          materialDesign:DataGridAssist.ColumnHeaderPadding="8 4 8 4" />
                                            </Grid>
                                        </TabItem>
                
                                    </TabControl>
                                </Grid>
                            </Grid>
                
            </DataTemplate>
        </ContentControl.Resources>
        <ContentControl.Style>
            <Style TargetType="ContentControl">
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="ContentTemplate" Value="{x:Null}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentModule}" Value="SqlExport">
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="ContentTemplate" Value="{StaticResource SqlExportDeferredTemplate}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ContentControl.Style>
    </ContentControl>
    <!-- Screenshot Settings panel -->
    <ContentControl x:Name="ScreenshotHost" Content="{Binding}">
        <ContentControl.Resources>
            <DataTemplate x:Key="ScreenshotDeferredTemplate">
                            <Grid Margin="20">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentModule}" Value="Screenshot">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                
                                <Border Grid.Row="0"
                                        Margin="0,0,0,20"
                                        CornerRadius="{StaticResource CornerRadiusCard}"
                                        Padding="20,16">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,12,0"
                                                        Visibility="{Binding HasAudioRecordingIndicator, Converter={StaticResource BoolToVis}}">
                                                <Ellipse Width="8" Height="8" Fill="#E53935" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding AudioRecordingIndicator}" Foreground="#C62828" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Button Style="{StaticResource PrimaryActionButton}"
                                                    Command="{Binding TakeScreenshotNowCommand}"
                                                    Margin="0,0,8,0"
                                                    ToolTip="立即截图">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Camera" Width="16" Height="16" Margin="0,0,6,0"/>
                                                    <TextBlock Text="立即截图"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource GhostActionButton}"
                                                    Command="{Binding StartVideoRecordingCommand}"
                                                    Margin="0,0,8,0"
                                                    ToolTip="开启区域录像">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="RecordRec" Width="16" Height="16" Margin="0,0,6,0" Foreground="#E53935" />
                                                    <TextBlock Text="开启录像"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource GhostActionButton}"
                                                    Command="{Binding ToggleAudioRecordingCommand}"
                                                    Margin="0,0,8,0"
                                                    ToolTip="开启或停止录音">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Kind" Value="Microphone" />
                                                                <Setter Property="Foreground" Value="#E53935" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAudioRecording}" Value="True">
                                                                        <Setter Property="Kind" Value="StopCircle" />
                                                                        <Setter Property="Foreground" Value="#757575" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                    <TextBlock VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="开启录音" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAudioRecording}" Value="True">
                                                                        <Setter Property="Text" Value="停止录音" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource GhostActionButton}"
                                                    Command="{Binding EditClipboardImageCommand}"
                                                    ToolTip="打开编辑器编辑剪贴板中的图片">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="ImageEdit" Width="16" Height="16" Margin="0,0,6,0"/>
