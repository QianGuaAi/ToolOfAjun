<UserControl x:Class="MyTools.Views.MainModulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewModels="clr-namespace:MyTools.ViewModels"
             xmlns:views="clr-namespace:MyTools.Views">
    <UserControl.Resources>
        <viewModels:StatusToColorConverter x:Key="StatusToColorConverter" />
        <viewModels:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <viewModels:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility" />
        <viewModels:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility" />
        <viewModels:VideoWaveformPositionConverter x:Key="VideoWaveformPositionConverter" />
        <viewModels:VideoWaveformRangeConverter x:Key="VideoWaveformRangeConverter" />
        <DataTemplate x:Key="FrpViewTemplate">
            <views:FrpView DataContext="{Binding Frp}" />
        </DataTemplate>
        <DataTemplate x:Key="MultimediaViewTemplate">
            <views:MultimediaPage DataContext="{Binding Multimedia}" />
        </DataTemplate>
        <DataTemplate x:Key="VideoViewerViewTemplate">
            <views:VideoViewerPage />
        </DataTemplate>
        <DataTemplate x:Key="ScheduleViewTemplate">
            <views:SchedulePage DataContext="{Binding Schedule}" />
        </DataTemplate>
        <DataTemplate x:Key="SystemSettingsViewTemplate">
            <views:SystemSettingsPage Margin="16,58,16,16" DataContext="{Binding SystemSettings}" />
        </DataTemplate>
        <DataTemplate x:Key="SystemSectionTabs">
            <TabControl SelectedIndex="{Binding SelectedSystemSectionIndex, Mode=TwoWay}"
                        Style="{StaticResource PremiumMaterialTabControl}"
                        Height="34"
                        Margin="0,0,0,8">
                <TabItem Header="系统优化" />
                <TabItem Header="当前网络" />
                <TabItem Header="启动管理" />
                <TabItem Header="程序卸载" />
                <TabItem Header="系统信息" />
                <TabItem Header="性能测试" />
                <TabItem Header="系统设置" />
            </TabControl>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource MaterialDesignFlatBackground}">
            <ContentControl Content="{Binding}"
                            ContentTemplate="{StaticResource SystemSectionTabs}"
                            Panel.ZIndex="10"
                            VerticalAlignment="Top"
                            Margin="16,12,16,0">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="System">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <ContentControl x:Name="NetworkHost" Content="{Binding}">
                <ContentControl.Resources>
                    <DataTemplate x:Key="NetworkDeferredTemplate">
                                    <Grid Margin="16,58,16,16">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSystemNetworkVisible}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                        
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                        
                                        <Border Grid.Row="0"
                                                Margin="0,0,0,10"
                                                CornerRadius="{StaticResource CornerRadiusCard}"
                                                Padding="14,10">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                                                    <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right"
                                                        Style="{StaticResource MaterialDesignIconButton}"
                                                        Command="{Binding RefreshCommand}" ToolTip="刷新">
                                                    <materialDesign:PackIcon Kind="Refresh" Width="22" Height="22" />
                                                </Button>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BrushBlueGradient}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="LanConnect" Width="18" Height="18" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="当前网络" Style="{StaticResource TextHeadline}" />
                                                        <TextBlock Text="实时查看网卡、IP、网关与 DNS 信息。" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                        
                                        <Grid Grid.Row="1">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl x:Name="NetworkListControl" ItemsSource="{Binding NetworkList}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <materialDesign:Card Style="{StaticResource PremiumCard}" Padding="12,10" Margin="0,0,0,10">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                        
                                                                    <materialDesign:PackIcon Kind="Lan"
                                                                                             Width="24" Height="24"
                                                                                             VerticalAlignment="Top"
                                                                                             HorizontalAlignment="Center"
                                                                                             Margin="0,2,0,0"
                                                                                             Foreground="{Binding Status, Converter={StaticResource StatusToColorConverter}}" />
                        
                                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource TextSubtitle}" FontWeight="Bold" />
                                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource TextCaption}" Margin="0,1,0,6" TextTrimming="CharacterEllipsis" />
                        
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                                <RowDefinition Height="Auto" />
                                                                            </Grid.RowDefinitions>
                        
                                                                            <TextBlock Text="IP 地址：" Grid.Row="0" Style="{StaticResource TextHint}" Margin="0,0,10,3" />
                                                                            <TextBlock Text="{Binding IpAddress}" Grid.Row="0" Grid.Column="1" Style="{StaticResource TextBodyStandard}" TextWrapping="Wrap" Margin="0,0,0,3" />
                        
                                                                            <TextBlock Text="网关：" Grid.Row="1" Style="{StaticResource TextHint}" Margin="0,0,10,3" />
                                                                            <TextBlock Text="{Binding Gateway}" Grid.Row="1" Grid.Column="1" Style="{StaticResource TextBodyStandard}" TextWrapping="Wrap" Margin="0,0,0,3" />
                        
                                                                            <TextBlock Text="DNS：" Grid.Row="2" Style="{StaticResource TextHint}" Margin="0,0,10,3" />
                                                                            <TextBlock Text="{Binding Dns}" Grid.Row="2" Grid.Column="1" Style="{StaticResource TextBodyStandard}" TextWrapping="Wrap" Margin="0,0,0,3" />
                        
                                                                            <TextBlock Text="MAC：" Grid.Row="3" Style="{StaticResource TextHint}" Margin="0,0,10,3" />
                                                                            <TextBlock Text="{Binding MacAddress}" Grid.Row="3" Grid.Column="1" Style="{StaticResource TextBodyStandard}" Margin="0,0,0,3" />
                        
                                                                            <TextBlock Text="速率：" Grid.Row="4" Style="{StaticResource TextHint}" Margin="0,0,10,3" />
                                                                            <TextBlock Text="{Binding LinkSpeed}" Grid.Row="4" Grid.Column="1" Style="{StaticResource TextBodyStandard}" Margin="0,0,0,3" />
                        
                                                                            <TextBlock Text="类型：" Grid.Row="5" Style="{StaticResource TextHint}" Margin="0,0,10,0" />
                                                                            <TextBlock Text="{Binding AdapterType}" Grid.Row="5" Grid.Column="1" Style="{StaticResource TextBodyStandard}" />
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </materialDesign:Card>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                        
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasItems, ElementName=NetworkListControl}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Image Source="{StaticResource NetworkEmpty}" Width="160" Height="120" HorizontalAlignment="Center" />
                                                <TextBlock Text="No network entries available right now."
                                                           Style="{StaticResource TextSubtitle}"
                                                           HorizontalAlignment="Center"
                                                           Opacity="0.4"
                                                           Margin="0,12,0,0" />
                                                <Button Content="刷新" HorizontalAlignment="Center"
                                                        Style="{StaticResource GhostActionButton}"
                                                        Command="{Binding RefreshCommand}"
                                                        Margin="0,12,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                        
                    </DataTemplate>
                </ContentControl.Resources>
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="ContentTemplate" Value="{x:Null}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSystemNetworkVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="ContentTemplate" Value="{StaticResource NetworkDeferredTemplate}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            <ContentControl x:Name="UninstallHost" Content="{Binding}">
                <ContentControl.Resources>
                    <DataTemplate x:Key="UninstallDeferredTemplate">
                                    <Grid Margin="16,58,16,16">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSystemUninstallVisible}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                        
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                        
                                        <Border Grid.Row="0"
                                                Margin="0,0,0,10"
                                                CornerRadius="{StaticResource CornerRadiusCard}"
                                                Padding="14,10">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                                                    <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Border Style="{StaticResource BadgeInfo}"
                                                            Margin="0,0,12,0"
                                                            Background="{DynamicResource BrushAccentLime}">
                                                        <TextBlock Text="{Binding InstalledProgramsCountText}" />
                                                    </Border>
                                                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                                 IsIndeterminate="True"
                                                                 Width="22"
                                                                 Height="22"
                                                                 Margin="0,0,8,0"
                                                                 VerticalAlignment="Center"
                                                                 Visibility="{Binding IsInstalledProgramsBusy, Converter={StaticResource BoolToVis}}" />
                                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                                            Command="{Binding RefreshInstalledProgramsCommand}"
                                                            ToolTip="刷新程序列表">
                                                        <materialDesign:PackIcon Kind="Refresh" Width="22" Height="22" />
                                                    </Button>
                                                </StackPanel>
                                                <StackPanel DockPanel.Dock="Right"
                                                            Orientation="Horizontal"
                                                            Margin="0,0,12,0">
                                                    <TextBox Width="190"
                                                             Margin="0,0,8,0"
                                                             Text="{Binding InstalledProgramSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource StandardTextBox}"
                                                             materialDesign:HintAssist.Hint="搜索程序/发布者/路径" />
                                                    <ComboBox Width="126"
                                                              Height="32"
                                                              Margin="0,0,8,0"
                                                              ItemsSource="{Binding InstalledProgramSortOptions}"
                                                              SelectedItem="{Binding InstalledProgramSortMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              ToolTip="排序" />
                                                    <ComboBox Width="112"
                                                              Height="32"
                                                              Margin="0,0,8,0"
                                                              ItemsSource="{Binding InstalledProgramSizeFilterOptions}"
                                                              SelectedItem="{Binding InstalledProgramSizeFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              ToolTip="按大小筛选" />
                                                    <ComboBox Width="112"
                                                              Height="32"
                                                              ItemsSource="{Binding InstalledProgramDateFilterOptions}"
                                                              SelectedItem="{Binding InstalledProgramDateFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              ToolTip="按安装日期筛选" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BrushTealGradient}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="PackageVariantRemove" Width="18" Height="18" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="程序卸载" Style="{StaticResource TextHeadline}" />
                                                        <TextBlock Text="{Binding InstalledProgramsStatusMessage}" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                        
                                        <DockPanel Grid.Row="1" Margin="0,0,0,8">
                                            <Border DockPanel.Dock="Right" Style="{StaticResource BadgeInfo}" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding SelectedInstalledProgramsCountText}" />
                                            </Border>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource GhostActionButton}"
                                                        Command="{Binding SelectFilteredInstalledProgramsCommand}"
                                                        Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="CheckCircleOutline" Width="14" Height="14" Margin="0,0,6,0" />
                                                        <TextBlock Text="全选筛选" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource GhostActionButton}"
                                                        Command="{Binding ClearInstalledProgramSelectionCommand}"
                                                        Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Broom" Width="14" Height="14" Margin="0,0,6,0" />
                                                        <TextBlock Text="清除选择" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource GhostActionButton}"
                                                        Command="{Binding ExportInstalledProgramListCommand}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="FileExportOutline" Width="14" Height="14" Margin="0,0,6,0" />
                                                        <TextBlock Text="导出清单" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </DockPanel>
                        
                                        <Grid Grid.Row="2">
                                            <DataGrid ItemsSource="{Binding FilteredInstalledProgramsView}"
                                                      AutoGenerateColumns="False"
                                                      CanUserAddRows="False"
                                                      CanUserDeleteRows="False"
                                                      IsReadOnly="False"
                                                      GridLinesVisibility="Horizontal"
                                                      HeadersVisibility="Column"
                                                      RowHeight="42"
                                                      Style="{StaticResource MaterialDesignDataGrid}"
                                                      materialDesign:DataGridAssist.CellPadding="10 4 10 4"
                                                      materialDesign:DataGridAssist.ColumnHeaderPadding="10 8 10 8">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="" Width="42" IsReadOnly="False">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="程序" Width="2.1*" IsReadOnly="True">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                               FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               ToolTip="{Binding DisplayName}" />
                                                                    <TextBlock Text="{Binding PublisherDisplay}"
                                                                               FontSize="11"
                                                                               Opacity="0.55"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="版本" Width="120" Binding="{Binding VersionDisplay}" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="安装日期" Width="110" Binding="{Binding InstallDateDisplay}" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="大小" Width="90" Binding="{Binding EstimatedSizeDisplay}" IsReadOnly="True" />
                                                    <DataGridTextColumn Header="来源" Width="120" Binding="{Binding Source}" IsReadOnly="True" />
                                                    <DataGridTemplateColumn Header="静默" Width="102" IsReadOnly="True">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding SilentUninstallDisplay}"
                                                                           ToolTip="{Binding SilentUninstallDetail}"
                                                                           TextTrimming="CharacterEllipsis">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBodyStandard}">
                                                                            <Setter Property="Foreground" Value="#64748B" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSilentUninstallCandidate}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource BrushAccentTeal}" />
                                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="安装位置" Width="1.3*" Binding="{Binding InstallLocationDisplay}" IsReadOnly="True" />
                                                    <DataGridTemplateColumn Header="卸载" Width="86" IsReadOnly="True">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                                                        Command="{Binding DataContext.UninstallProgramCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip="{Binding RequiresAdminDisplay}">
                                                                    <materialDesign:PackIcon Kind="TrashCanOutline"
                                                                                             Width="20"
                                                                                             Height="20"
                                                                                             Foreground="{DynamicResource BrushError}" />
                                                                </Button>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                        
                                            <StackPanel VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                        Visibility="{Binding HasNoInstalledPrograms, Converter={StaticResource BoolToVis}}">
                                                <materialDesign:PackIcon Kind="PackageVariant"
                                                                         Width="76"
                                                                         Height="76"
                                                                         Opacity="0.28"
                                                                         HorizontalAlignment="Center" />
                                                <TextBlock Text="未发现匹配的程序"
                                                           Style="{StaticResource TextSubtitle}"
                                                           HorizontalAlignment="Center"
                                                           Opacity="0.5"
                                                           Margin="0,12,0,0" />
                                                <Button Content="刷新列表"
                                                        Style="{StaticResource GhostActionButton}"
                                                        Command="{Binding RefreshInstalledProgramsCommand}"
                                                        Margin="0,12,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                        
                    </DataTemplate>
                </ContentControl.Resources>
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="ContentTemplate" Value="{x:Null}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSystemUninstallVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="ContentTemplate" Value="{StaticResource UninstallDeferredTemplate}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            <ContentControl x:Name="StartupHost" Content="{Binding}">
                <ContentControl.Resources>
                    <DataTemplate x:Key="StartupDeferredTemplate">
                                    <Grid Margin="20">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSystemStartupVisible}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                        
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                        
                                        <Border Grid.Row="0"
                                                Margin="0,0,0,12"
                                                CornerRadius="12"
                                                Padding="14,10"
                                                BorderBrush="#E2E8F0"
                                                BorderThickness="0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                                                    <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <TextBox Width="220"
                                                             Margin="0,0,10,0"
                                                             Text="{Binding StartupSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource StandardTextBox}"
                                                             materialDesign:HintAssist.Hint="搜索名称/发布者/命令/位置/来源" />
                                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                                            Command="{Binding RefreshCommand}"
                                                            ToolTip="刷新启动项">
                                                        <materialDesign:PackIcon Kind="Refresh" Width="22" Height="22" />
                                                    </Button>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#F59E0B" Offset="0" />
                                                                <GradientStop Color="#EF4444" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <materialDesign:PackIcon Kind="RocketLaunchOutline" Width="18" Height="18" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="启动项管理" Style="{StaticResource TextHeadline}" />
                                                        <TextBlock Text="管理 Windows 开机启动项" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                        
                                        <Grid Grid.Row="1">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding FilteredStartupView}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <materialDesign:Card Style="{StaticResource PremiumCard}" Padding="0" Margin="0,0,0,10">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="5" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                        
                                                                    <Border Grid.Column="0" CornerRadius="4,0,0,4">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Background" Value="#2E7D32" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                                        <Setter Property="Background" Value="#9E9E9E" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                    </Border>
                        
                                                                    <StackPanel Grid.Column="1" Margin="12,12,8,12">
                                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource TextSubtitle}" FontWeight="Bold" />
                                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                            <materialDesign:PackIcon Kind="CertificateOutline" Width="12" Height="12" VerticalAlignment="Center" Opacity="0.5" />
                                                                            <TextBlock Text="{Binding PublisherDisplay}"
                                                                                       Style="{StaticResource TextCaption}"
