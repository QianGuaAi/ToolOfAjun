                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="30" Height="30" CornerRadius="7" Background="{StaticResource BrushAccentGradient}" Margin="0,0,9,0" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="CameraIris" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="截图工具" Style="{StaticResource TextHeadline}" />
                                                <TextBlock Text="全屏截图 · 区域录像 · 独立录音" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                
                                <TabControl Grid.Row="1"
                                            Style="{StaticResource MaterialDesignTabControl}"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            materialDesign:ColorZoneAssist.Mode="PrimaryMid">
                                    <TabItem Header="截图设置">
                                        <StackPanel>
                
                                        <!-- Hotkey card -->
                                        <materialDesign:Card Style="{StaticResource PremiumCard}" Padding="12,10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="快捷键设置" Style="{StaticResource TextSubtitle}" FontWeight="Bold" Margin="0,0,0,8"/>
                
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                
                                                    <Border Grid.Column="0" BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                            BorderThickness="1" CornerRadius="4" Padding="10,6"
                                                            Margin="0,0,8,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource MaterialDesignTextFieldBoxBackground}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCapturingHotkey}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                                        <Setter Property="BorderThickness" Value="2"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="Keyboard" Width="18" Height="18"
                                                                                     VerticalAlignment="Center" Margin="0,0,10,0"
                                                                                     Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                            <TextBlock VerticalAlignment="Center" FontSize="14">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="{Binding ScreenshotHotkeyText}"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
                                                                        <Setter Property="FontWeight" Value="Medium"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCapturingHotkey}" Value="True">
                                                                                <Setter Property="Text" Value="请按下新快捷键组合..."/>
                                                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                                                <Setter Property="FontWeight" Value="Normal"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Button Margin="0,0,6,0"
                                                                Command="{Binding StartCaptureHotkeyCommand}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource GhostActionButton}">
                                                                    <Setter Property="Content" Value="修改快捷键"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCapturingHotkey}" Value="True">
                                                                            <Setter Property="Content" Value="监听中..."/>
                                                                            <Setter Property="IsEnabled" Value="False"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="取消"
                                                                Command="{Binding CancelCaptureHotkeyCommand}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource GhostActionButton}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCapturingHotkey}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                
                                                <TextBlock Text="注意：快捷键需包含 Ctrl 或 Alt 之一，避免与系统快捷键冲突。快捷键在全局生效，包括窗口隐藏期间。"
                                                           Style="{StaticResource TextCaption}"
                                                           Opacity="0.55" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </materialDesign:Card>
                
                                        <!-- Behavior card -->
                                        <materialDesign:Card Style="{StaticResource PremiumCard}" Padding="12,10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="截图行为" Style="{StaticResource TextSubtitle}" FontWeight="Bold" Margin="0,0,0,8"/>
                
                                                <TextBlock Text="截图范围" FontWeight="Medium" Margin="0,0,0,6" />
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <RadioButton GroupName="ScreenshotMode" Content="全屏" Margin="0,0,18,0"
                                                                 IsChecked="{Binding IsScreenshotModeFullScreen}" />
                                                    <RadioButton GroupName="ScreenshotMode" Content="划区域" Margin="0,0,18,0"
                                                                 IsChecked="{Binding IsScreenshotModeRegion}" />
                                                    <RadioButton GroupName="ScreenshotMode" Content="当前窗口"
                                                                 IsChecked="{Binding IsScreenshotModeWindow}" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource TextCaption}" Opacity="0.6" Margin="0,0,0,8" TextWrapping="Wrap"
                                                           Text="全屏：直接截整个虚拟屏幕；划区域：弹出半透明蒙层让你拖动选区，Esc 取消；当前窗口：截按下快捷键时位于最前的那个窗口。" />
                
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ToggleButton Grid.Column="0"
                                                                  IsChecked="{Binding IsGifRecordingMode}"
                                                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                                  VerticalAlignment="Top"
                                                                  Margin="0,2,12,0" />
                                                    <StackPanel Grid.Column="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="区域录像输出" Style="{StaticResource TextSubtitle}" FontWeight="Medium" Margin="0,0,8,0" />
                                                            <Border Style="{StaticResource StatusPill}">
                                                                <TextBlock Text="{Binding RecordingModeText}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding RecordingModeHint}"
                                                                   Style="{StaticResource TextCaption}"
                                                                   Opacity="0.6"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,4,20,0" />
                                                    </StackPanel>
                                                </Grid>
                
                                                <UniformGrid Rows="1" Columns="2" Margin="0,0,0,10">
                                                    <StackPanel Margin="0,0,8,0">
                                                        <TextBlock Text="录像帧率" Style="{StaticResource TextCaption}" Margin="0,0,0,4" />
                                                        <ComboBox ItemsSource="{Binding RecordingFrameRateOptions}"
                                                                  SelectedItem="{Binding RecordingFrameRateOption, Mode=TwoWay}"
                                                                  Height="32" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="MP4 画质" Style="{StaticResource TextCaption}" Margin="0,0,0,4" />
                                                        <ComboBox ItemsSource="{Binding RecordingQualityOptions}"
                                                                  SelectedItem="{Binding RecordingQualityOption, Mode=TwoWay}"
                                                                  Height="32" />
                                                    </StackPanel>
                                                </UniformGrid>
                
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding ShowEditorAfterCapture}"
                                                              VerticalAlignment="Top"
                                                              Margin="0,2,12,0" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="截图后打开编辑器"
                                                                   Style="{StaticResource TextSubtitle}"
                                                                   FontWeight="Medium"/>
                                                        <TextBlock Margin="0,4,20,0" Opacity="0.6" TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                                                                    <Setter Property="Text" Value="截图后弹出编辑器进行标注；关闭编辑器时自动把编辑后的图写入剪贴板。"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ShowEditorAfterCapture}" Value="False">
                                                                            <Setter Property="Text" Value="截图后直接写入剪贴板，不弹编辑器。"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </materialDesign:Card>
                
                                        </StackPanel>
                                    </TabItem>
                                    <TabItem Header="截图历史">
                                        <StackPanel>
                                        <!-- Screenshot history -->
                                        <materialDesign:Card Style="{StaticResource PremiumCard}" Padding="12,10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <StackPanel Style="{StaticResource SectionHeaderRow}">
                                                    <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource BrushTealGradient}" Margin="0,0,10,0">
                                                        <materialDesign:PackIcon Kind="ImageMultiple" Width="14" Height="14" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="截图历史" Style="{StaticResource TextSubtitle}" />
                                                        <TextBlock Text="{Binding ScreenshotHistorySummary}" Style="{StaticResource TextHint}" Margin="0,1,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                
                                                <TextBlock Text="还没有截图历史。点击“立即截图”后会自动保存最近 20 张。"
                                                           Style="{StaticResource TextHint}"
                                                           Margin="0,12,0,12"
                                                           HorizontalAlignment="Center"
                                                           Visibility="{Binding HasScreenshotHistoryItems, Converter={StaticResource InverseBoolToVis}}" />
                
                                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                              VerticalScrollBarVisibility="Disabled"
                                                              Visibility="{Binding HasScreenshotHistoryItems, Converter={StaticResource BoolToVis}}">
                                                    <ItemsControl ItemsSource="{Binding ScreenshotHistoryItems}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Width="188" Margin="0,0,8,0" Padding="8"
                                                                        BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7"
                                                                        Background="#FAFBFC">
                                                                    <StackPanel>
                                                                        <Border Height="92" CornerRadius="5" Background="#E5E7EB" ClipToBounds="True">
                                                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                                                        </Border>
                                                                        <TextBlock Text="{Binding Title}" Style="{StaticResource TextBodyStandard}"
                                                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,6,0,1" />
                                                                        <TextBlock Style="{StaticResource TextHint}" TextTrimming="CharacterEllipsis">
                                                                            <Run Text="{Binding TimeText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SizeText, Mode=OneWay}" />
                                                                        </TextBlock>
                                                                        <TextBlock Text="{Binding DimensionsText}" Style="{StaticResource TextHint}" TextTrimming="CharacterEllipsis" Margin="0,1,0,6" />
                                                                        <WrapPanel>
                                                                            <Button Style="{StaticResource GhostActionButton}"
                                                                                    Height="26" MinWidth="46" Padding="6,0" Margin="0,0,5,5"
                                                                                    Command="{Binding DataContext.CopyScreenshotHistoryItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                    CommandParameter="{Binding}">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <materialDesign:PackIcon Kind="ContentCopy" Width="13" Height="13" Margin="0,0,4,0" />
                                                                                    <TextBlock Text="复制" />
                                                                                </StackPanel>
                                                                            </Button>
                                                                            <Button Style="{StaticResource GhostActionButton}"
                                                                                    Height="26" MinWidth="46" Padding="6,0" Margin="0,0,5,5"
                                                                                    Command="{Binding DataContext.EditScreenshotHistoryItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                    CommandParameter="{Binding}">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <materialDesign:PackIcon Kind="ImageEdit" Width="13" Height="13" Margin="0,0,4,0" />
                                                                                    <TextBlock Text="编辑" />
                                                                                </StackPanel>
                                                                            </Button>
                                                                            <Button Style="{StaticResource GhostActionButton}"
                                                                                    Height="26" MinWidth="46" Padding="6,0" Margin="0,0,5,5"
                                                                                    Command="{Binding DataContext.OpenScreenshotHistoryItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                    CommandParameter="{Binding}">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <materialDesign:PackIcon Kind="OpenInNew" Width="13" Height="13" Margin="0,0,4,0" />
                                                                                    <TextBlock Text="打开" />
                                                                                </StackPanel>
                                                                            </Button>
                                                                            <Button Style="{StaticResource GhostActionButton}"
                                                                                    Height="26" MinWidth="46" Padding="6,0" Margin="0,0,5,5"
                                                                                    Command="{Binding DataContext.DeleteScreenshotHistoryItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                    CommandParameter="{Binding}">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="13" Height="13" Margin="0,0,4,0" />
                                                                                    <TextBlock Text="删除" />
                                                                                </StackPanel>
                                                                            </Button>
                                                                        </WrapPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </materialDesign:Card>
                
                                        </StackPanel>
                                    </TabItem>
                                    <TabItem Header="录制目录">
                                        <StackPanel>
                                        <!-- Recording output folders -->
                                        <materialDesign:Card Style="{StaticResource PremiumCard}" Padding="12,10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="录制输出目录" Style="{StaticResource TextSubtitle}" FontWeight="Bold" Margin="0,0,0,8" />
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="录像" Style="{StaticResource TextFieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding RecordingOutputFolderText}" Style="{StaticResource TextCaption}"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <Button Grid.Column="2" Style="{StaticResource GhostActionButton}"
                                                            Command="{Binding SelectRecordingOutputFolderCommand}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="FolderCogOutline" Width="14" Height="14" Margin="0,0,6,0" />
                                                            <TextBlock Text="更改" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="录音" Style="{StaticResource TextFieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding AudioOutputFolderText}" Style="{StaticResource TextCaption}"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <Button Grid.Column="2" Style="{StaticResource GhostActionButton}"
                                                            Command="{Binding SelectAudioOutputFolderCommand}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="FolderCogOutline" Width="14" Height="14" Margin="0,0,6,0" />
                                                            <TextBlock Text="更改" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </materialDesign:Card>
                
                                        <!-- Save button -->
                                        <Button Style="{StaticResource PrimaryActionButton}"
                                                Command="{Binding SaveScreenshotSettingsCommand}"
                                                HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ContentSaveOutline" Width="15" Height="15" Margin="0,0,6,0"/>
                                                <TextBlock Text="保存设置"/>
                                            </StackPanel>
                                        </Button>
                
                                        </StackPanel>
                                    </TabItem>
                                    <TabItem Header="哈希校验">
                                        <StackPanel>
                                        <!-- File Hash Calculator -->
                                        <materialDesign:Card Padding="12,10" Margin="0,8,0,0">
                                            <StackPanel>
                                                <StackPanel Style="{StaticResource SectionHeaderRow}">
                                                    <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource BrushBlueGradient}" Margin="0,0,10,0">
                                                        <materialDesign:PackIcon Kind="ShieldKey" Width="14" Height="14" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="文件哈希校验" Style="{StaticResource TextSubtitle}" />
                                                        <TextBlock Text="{Binding FileHashStatusMessage}" Style="{StaticResource TextHint}" Margin="0,1,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                
                                                <Button Style="{StaticResource GhostActionButton}"
                                                        Command="{Binding ComputeFileHashCommand}"
                                                        HorizontalAlignment="Left">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="FileSearch" Width="14" Height="14" Margin="0,0,6,0"/>
                                                        <TextBlock Text="选择文件并计算"/>
                                                    </StackPanel>
                                                </Button>
                
                                                <TextBox Text="{Binding ExpectedFileHash, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource StandardTextBox}"
                                                         materialDesign:HintAssist.Hint="官方校验值（可选：MD5 / SHA-1 / SHA-256 / CRC32）"
                                                         Margin="0,8,0,0" />
                
                                                <Border Background="{DynamicResource BrushInfoSoft}"
                                                        CornerRadius="6" Padding="10,7" Margin="0,8,0,0"
                                                        Visibility="{Binding HasFileHashCompareResult, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="14" Height="14"
                                                                                 Foreground="{DynamicResource BrushInfo}"
                                                                                 Margin="0,0,7,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding FileHashCompareResult}" Style="{StaticResource TextCaption}"
                                                                   FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                
                                                <Border Background="{DynamicResource MaterialDesignToolBarBackground}"
                                                        CornerRadius="6" Padding="10,8" Margin="0,8,0,0"
                                                        Visibility="{Binding FileHashResult, Converter={StaticResource StringNotEmptyToVisibility}}"
                                                        Cursor="Hand"
                                                        MouseLeftButtonUp="FileHashResult_OnClick">
                                                    <TextBlock Text="{Binding FileHashResult}" Style="{StaticResource TextMonoCode}"
                                                               ToolTip="点击复制到剪贴板" />
                                                </Border>
                                            </StackPanel>
                                        </materialDesign:Card>
                
                                        </StackPanel>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                
            </DataTemplate>
        </ContentControl.Resources>
        <ContentControl.Style>
            <Style TargetType="ContentControl">
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="ContentTemplate" Value="{x:Null}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentModule}" Value="Screenshot">
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="ContentTemplate" Value="{StaticResource ScreenshotDeferredTemplate}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ContentControl.Style>
    </ContentControl>
    <ContentControl Content="{Binding}">
        <ContentControl.Style>
            <Style TargetType="ContentControl">
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="ContentTemplate" Value="{x:Null}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentModule}" Value="Frp">
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="ContentTemplate" Value="{StaticResource FrpViewTemplate}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ContentControl.Style>
    </ContentControl>

    <ContentControl Content="{Binding}">
        <ContentControl.Style>
            <Style TargetType="ContentControl">
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="ContentTemplate" Value="{x:Null}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentModule}" Value="Multimedia">
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="ContentTemplate" Value="{StaticResource MultimediaViewTemplate}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ContentControl.Style>
    </ContentControl>
    <!-- Image viewer panel -->
    <ContentControl x:Name="ImageViewerHost" Content="{Binding}">
        <ContentControl.Resources>
            <DataTemplate x:Key="ImageViewerDeferredTemplate">
                            <Grid Margin="16">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentModule}" Value="ImageViewer">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                
                                <Border Grid.Row="0"
                                        Margin="0,0,0,12"
                                        CornerRadius="{StaticResource CornerRadiusCard}"
                                        Padding="12,8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource PrimaryActionButton}"
                                                    Command="{Binding OpenImageViewerFileCommand}"
                                                    Height="34"
                                                    Padding="12,0"
                                                    Margin="0,0,8,0"
                                                    ToolTip="打开图片">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="FolderOpenOutline" Width="15" Height="15" Margin="0,0,6,0" />
                                                    <TextBlock Text="打开" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource GhostActionButton}"
                                                    Command="{Binding CopyImageViewerImageCommand}"
                                                    Height="34"
                                                    Padding="12,0"
                                                    Margin="0,0,8,0"
                                                    ToolTip="复制当前图片到剪贴板">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="ContentCopy" Width="15" Height="15" Margin="0,0,6,0" />
                                                    <TextBlock Text="复制" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource GhostActionButton}"
                                                    Command="{Binding SaveImageViewerImageAsCommand}"
                                                    Height="34"
                                                    Padding="12,0"
                                                    Margin="0,0,8,0"
                                                    ToolTip="另存当前图片">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="ContentSaveOutline" Width="15" Height="15" Margin="0,0,6,0" />
                                                    <TextBlock Text="另存" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource GhostActionButton}"
                                                    Command="{Binding EditImageViewerImageCommand}"
                                                    Height="34"
                                                    Padding="12,0"
                                                    ToolTip="进入标注编辑器">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="ImageEdit" Width="15" Height="15" Margin="0,0,6,0" />
                                                    <TextBlock Text="标注" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource BrushTealGradient}" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Image" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="图片查看" Style="{StaticResource TextHeadline}" />
                                                <TextBlock Text="{Binding ImageViewerStatusMessage}" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="175" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="260" />
                                    </Grid.ColumnDefinitions>
                
                                    <!-- 左侧文件夹树 -->
                                    <materialDesign:Card Grid.Column="0" Padding="8" Margin="0,0,12,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="文件夹" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                       Margin="2,0,0,6" />
                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Auto">
                                                <TreeView ItemsSource="{Binding ImageFolderRoots}"
                                                          Background="Transparent"
                                                          BorderThickness="0"
                                                          SelectedItemChanged="ImageFolderTree_SelectedItemChanged">
                                                    <TreeView.ItemContainerStyle>
                                                        <Style TargetType="TreeViewItem">
                                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                                            <Setter Property="FontSize" Value="11" />
                                                            <Setter Property="Padding" Value="2,2" />
                                                        </Style>
                                                    </TreeView.ItemContainerStyle>
                                                    <TreeView.ItemTemplate>
                                                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="FolderOutline" Width="13" Height="13"
                                                                                         VerticalAlignment="Center" Margin="0,0,4,0"
                                                                                         Foreground="{DynamicResource BrushAccentBlue}" />
                                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </HierarchicalDataTemplate>
                                                    </TreeView.ItemTemplate>
                                                </TreeView>
                                            </ScrollViewer>
                                        </Grid>
                                    </materialDesign:Card>
                
                                    <materialDesign:Card Grid.Column="1" Padding="12" Margin="0,0,12,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                
                                            <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                                                <Button Style="{StaticResource GhostActionButton}"
                                                        Command="{Binding OpenPreviousImageViewerFileCommand}"
                                                        Width="34"
                                                        Height="32"
                                                        Padding="0"
                                                        Margin="0,0,6,6"
                                                        ToolTip="上一张">
                                                    <materialDesign:PackIcon Kind="ChevronLeft" Width="16" Height="16" />
                                                </Button>
                                                <Button Style="{StaticResource GhostActionButton}"
                                                        Command="{Binding OpenNextImageViewerFileCommand}"
                                                        Width="34"
                                                        Height="32"
                                                        Padding="0"
                                                        Margin="0,0,10,6"
                                                        ToolTip="下一张">
                                                    <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16" />
                                                </Button>
                                                <Button Style="{StaticResource GhostActionButton}"
                                                        Command="{Binding ImageViewerZoomOutCommand}"
                                                        Width="34"
                                                        Height="32"
                                                        Padding="0"
                                                        Margin="0,0,6,6"
                                                        ToolTip="缩小">
                                                    <materialDesign:PackIcon Kind="MagnifyMinusOutline" Width="16" Height="16" />
                                                </Button>
                                                <Button Style="{StaticResource GhostActionButton}"
                                                        Command="{Binding ImageViewerZoomActualCommand}"
                                                        Height="32"
                                                        Padding="10,0"
                                                        Margin="0,0,6,6"
                                                        ToolTip="实际大小">
                                                    <TextBlock Text="{Binding ImageViewerZoomText}" />
                                                </Button>
                                                <Button Style="{StaticResource GhostActionButton}"
                                                        Command="{Binding ImageViewerZoomInCommand}"
                                                        Width="34"
                                                        Height="32"
                                                        Padding="0"
                                                        Margin="0,0,6,6"
                                                        ToolTip="放大">
                                                    <materialDesign:PackIcon Kind="MagnifyPlusOutline" Width="16" Height="16" />
                                                </Button>
                                                <Button Style="{StaticResource GhostActionButton}"
                                                        Command="{Binding ImageViewerFitToFrameCommand}"
                                                        Height="32"
                                                        Padding="10,0"
                                                        Margin="0,0,10,6"
                                                        ToolTip="满框显示（自动缩放以铺满预览区域）">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="ImageSearchOutline" Width="15" Height="15" Margin="0,0,5,0" />
                                                        <TextBlock Text="满框">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ImageViewerFitToFrame}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource BrushAccentBlue}" />
                                                                            <Setter Property="FontWeight" Value="Bold" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource GhostActionButton}"
                                                        Command="{Binding RotateImageViewerRightCommand}"
                                                        Width="34"
                                                        Height="32"
                                                        Padding="0"
                                                        Margin="0,0,10,6"
                                                        ToolTip="顺时针旋转 90°">
                                                    <materialDesign:PackIcon Kind="RotateRight" Width="16" Height="16" />
                                                </Button>
                                                <Button Style="{StaticResource GhostActionButton}"
                                                        Command="{Binding FlipImageViewerHorizontalCommand}"
                                                        Height="32"
                                                        Padding="10,0"
                                                        Margin="0,0,6,6"
                                                        ToolTip="水平翻转">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="SwapHorizontal" Width="15" Height="15" Margin="0,0,5,0" />
                                                        <TextBlock Text="水平" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource GhostActionButton}"
                                                        Command="{Binding FlipImageViewerVerticalCommand}"
                                                        Height="32"
                                                        Padding="10,0"
                                                        Margin="0,0,10,6"
                                                        ToolTip="垂直翻转">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="SwapVertical" Width="15" Height="15" Margin="0,0,5,0" />
                                                        <TextBlock Text="垂直" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource GhostActionButton}"
                                                        Command="{Binding ToggleImageViewerGrayscaleCommand}"
                                                        Height="32"
                                                        Padding="10,0"
                                                        Margin="0,0,6,6"
                                                        ToolTip="切换灰度效果">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="InvertColorsOff" Width="15" Height="15" Margin="0,0,5,0" />
                                                        <TextBlock Text="灰度" />
                                                    </StackPanel>
                                                </Button>
                                            </WrapPanel>
                
                                            <Border Grid.Row="1"
                                                    Background="#121820"
                                                    CornerRadius="6"
                                                    ClipToBounds="True">
                                                <Grid x:Name="ImageViewerPreviewHost">
                                                    <ScrollViewer x:Name="ImageViewerScrollViewer"
                                                                  HorizontalScrollBarVisibility="Auto"
                                                                  VerticalScrollBarVisibility="Auto">
                                                        <Grid MinHeight="360" MinWidth="500">
                                                            <Image Source="{Binding ImageViewerPreviewImage}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Setter Property="Stretch" Value="None" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ImageViewerFitToFrame}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                                <Image.LayoutTransform>
                                                                    <ScaleTransform ScaleX="{Binding ImageViewerZoom}" ScaleY="{Binding ImageViewerZoom}" />
                                                                </Image.LayoutTransform>
                                                            </Image>
                                                            <Image Source="{Binding ImageViewerPreviewImage}"
                                                                   Width="{Binding ActualWidth, ElementName=ImageViewerScrollViewer}"
                                                                   Height="{Binding ActualHeight, ElementName=ImageViewerScrollViewer}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ImageViewerFitToFrame}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>
                                                        </Grid>
                                                    </ScrollViewer>
                                                    <Border Background="#CC121820"
                                                            CornerRadius="6"
                                                            Padding="18"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding HasImageViewerImage, Converter={StaticResource InverseBoolToVis}}">
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <materialDesign:PackIcon Kind="ImageSearch" Width="42" Height="42" Foreground="#E5E7EB" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                                            <TextBlock Text="打开图片开始查看"
                                                                       Foreground="#F9FAFB"
                                                                       FontSize="16"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center" />
                                                            <TextBlock Text="支持 PNG / JPG / BMP / GIF / TIFF"
                                                                       Foreground="#CBD5E1"
                                                                       Margin="0,4,0,0"
                                                                       HorizontalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </materialDesign:Card>
                
                                    <materialDesign:Card Grid.Column="2" Padding="14">
                                        <TabControl Style="{StaticResource MaterialDesignTabControl}"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Stretch"
                                                    materialDesign:ColorZoneAssist.Mode="PrimaryMid">
                                            <TabItem Header="信息">
                                                <StackPanel>
                                                    <TextBlock Text="图片信息" Style="{StaticResource TextSubtitle}" FontWeight="Bold" Margin="0,0,0,8" />
                                                    <TextBlock Text="文件名" Style="{StaticResource TextFieldLabel}" />
                                                    <TextBlock Text="{Binding ImageViewerFileName}" TextWrapping="Wrap" Margin="0,1,0,7" FontSize="12" />
                                                    <TextBlock Text="尺寸" Style="{StaticResource TextFieldLabel}" />
                                                    <TextBlock Text="{Binding ImageViewerImageInfo}" Margin="0,1,0,7" FontSize="12" />
                                                    <TextBlock Text="目录" Style="{StaticResource TextFieldLabel}" />
                                                    <TextBlock Text="{Binding ImageViewerDirectoryPositionText}" Margin="0,1,0,7" FontSize="12" />
                                                    <TextBlock Text="缩放" Style="{StaticResource TextFieldLabel}" />
                                                    <TextBlock Text="{Binding ImageViewerZoomText}" Margin="0,1,0,7" FontSize="12" />
                                                    <TextBlock Text="处理" Style="{StaticResource TextFieldLabel}" />
                                                    <TextBlock Text="{Binding ImageViewerTransformText}" TextWrapping="Wrap" Margin="0,1,0,7" FontSize="12" />
                
                                                    <Border Style="{StaticResource DividerLine}" Margin="0,4,0,8" />
                                                    <TextBlock Text="路径" Style="{StaticResource TextFieldLabel}" />
                                                    <TextBlock Text="{Binding ImageViewerFilePath}"
                                                               TextWrapping="Wrap"
                                                               Opacity="0.72"
                                                               FontSize="11"
                                                               Margin="0,1,0,8" />
                
                                                    <Border Background="{DynamicResource MaterialDesignToolBarBackground}"
                                                            CornerRadius="6"
                                                            Padding="10"
                                                            Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding ImageViewerStatusMessage}"
                                                                   Style="{StaticResource TextCaption}"
                                                                   TextWrapping="Wrap" />
                                                    </Border>
                                                </StackPanel>
                                            </TabItem>
                                            <TabItem Header="轻编辑">
                                                <StackPanel>
                                                    <TextBlock Text="轻编辑" Style="{StaticResource TextSubtitle}" FontWeight="Bold" Margin="0,0,0,8" />
                                                    <TextBlock Text="中心裁剪" Style="{StaticResource TextFieldLabel}" />
                                                    <ComboBox ItemsSource="{Binding ImageViewerCropModes}"
                                                              SelectedItem="{Binding ImageViewerCropMode, Mode=TwoWay}"
                                                              Style="{StaticResource StandardComboBox}"
                                                              Margin="0,0,0,8" />
                
                                                    <Grid Margin="0,0,0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="亮度" Style="{StaticResource TextFieldLabel}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding ImageViewerBrightnessText}" Style="{StaticResource TextHint}" />
                                                    </Grid>
                                                    <Slider Minimum="-100" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="False"
                                                            Height="28"
                                                            Value="{Binding ImageViewerBrightness, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                            PreviewMouseLeftButtonUp="ImageAdjustmentSlider_OnCommit"
                                                            KeyUp="ImageAdjustmentSlider_OnCommit"
                                                            LostFocus="ImageAdjustmentSlider_OnCommit"
                                                            Margin="0,0,0,8" />
                
                                                    <Grid Margin="0,0,0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="对比度" Style="{StaticResource TextFieldLabel}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding ImageViewerContrastText}" Style="{StaticResource TextHint}" />
                                                    </Grid>
                                                    <Slider Minimum="-100" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="False"
                                                            Height="28"
                                                            Value="{Binding ImageViewerContrast, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                            PreviewMouseLeftButtonUp="ImageAdjustmentSlider_OnCommit"
                                                            KeyUp="ImageAdjustmentSlider_OnCommit"
                                                            LostFocus="ImageAdjustmentSlider_OnCommit"
                                                            Margin="0,0,0,8" />
                
                                                    <Grid Margin="0,0,0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="锐化" Style="{StaticResource TextFieldLabel}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding ImageViewerSharpenText}" Style="{StaticResource TextHint}" />
                                                    </Grid>
                                                    <Slider Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="False"
                                                            Height="28"
                                                            Value="{Binding ImageViewerSharpenAmount, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                            PreviewMouseLeftButtonUp="ImageAdjustmentSlider_OnCommit"
                                                            KeyUp="ImageAdjustmentSlider_OnCommit"
                                                            LostFocus="ImageAdjustmentSlider_OnCommit"
                                                            Margin="0,0,0,8" />
                
                                                    <Button Style="{StaticResource GhostActionButton}"
                                                            Command="{Binding ResetImageViewerAdjustmentsCommand}"
                                                            HorizontalAlignment="Stretch"
                                                            Margin="0,0,0,8">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <materialDesign:PackIcon Kind="Restore" Width="14" Height="14" Margin="0,0,6,0" />
                                                            <TextBlock Text="重置轻编辑" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </TabItem>
                                        </TabControl>
                                    </materialDesign:Card>
                                </Grid>
                            </Grid>
                
            </DataTemplate>
        </ContentControl.Resources>
        <ContentControl.Style>
            <Style TargetType="ContentControl">
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="ContentTemplate" Value="{x:Null}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentModule}" Value="ImageViewer">
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="ContentTemplate" Value="{StaticResource ImageViewerDeferredTemplate}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ContentControl.Style>
    </ContentControl>
    <!-- Video viewer panel -->
    <ContentControl x:Name="VideoViewerHost" Content="{Binding}">
        <ContentControl.Style>
            <Style TargetType="ContentControl">
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="ContentTemplate" Value="{x:Null}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentModule}" Value="VideoViewer">
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="ContentTemplate" Value="{StaticResource VideoViewerViewTemplate}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ContentControl.Style>
    </ContentControl>

    <ContentControl x:Name="ScheduleHost" Content="{Binding}">
        <ContentControl.Style>
            <Style TargetType="ContentControl">
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="ContentTemplate" Value="{x:Null}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentModule}" Value="Schedule">
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="ContentTemplate" Value="{StaticResource ScheduleViewTemplate}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ContentControl.Style>
    </ContentControl>

    <!-- Codex config profiles panel -->
    <ContentControl x:Name="CodexProfilesHost" Content="{Binding}">
        <ContentControl.Resources>
            <Style x:Key="CodexCompactPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
                <Setter Property="Height" Value="28" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6" />
            </Style>
            <Style x:Key="CodexCompactSuccessButton" TargetType="Button" BasedOn="{StaticResource SuccessActionButton}">
                <Setter Property="Height" Value="28" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6" />
            </Style>
            <Style x:Key="CodexCompactGhostButton" TargetType="Button" BasedOn="{StaticResource GhostActionButton}">
                <Setter Property="Height" Value="28" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="7,0" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6" />
            </Style>
            <Style x:Key="CodexCompactOutlinedButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                <Setter Property="Height" Value="26" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="Margin" Value="6,0,0,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="5" />
            </Style>
            <Style x:Key="CodexCompactIconButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <DataTemplate x:Key="CodexProfilesDeferredTemplate">
                <Grid Margin="16">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentModule}" Value="CodexProfiles">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Margin="0,0,0,8"
                            CornerRadius="{StaticResource CornerRadiusCard}"
                            Padding="12,8">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                                <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Row="0"
                                        Grid.Column="0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource BrushTealGradient}" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="FolderCogOutline" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Codex 账号切换器" Style="{StaticResource TextHeadline}" />
                                    <TextBlock Text="本地加密保存多个账号档案，切换后可温和重启并继续原会话" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <WrapPanel Grid.Row="0"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right">
                                <Button Style="{StaticResource CodexCompactSuccessButton}"
                                        Height="28"
                                        Padding="8,0"
                                        Margin="0,0,4,0"
                                        Content="测试中转"
                                        Command="{Binding TestCodexRelaysCommand}" />
                                <Button Style="{StaticResource CodexCompactPrimaryButton}"
                                        Height="28"
                                        Padding="8,0"
                                        Margin="0,0,4,0"
                                        Content="导入当前账号"
                                        Command="{Binding ImportCodexProfileCommand}" />
                                <Button Style="{StaticResource CodexCompactGhostButton}"
                                        Height="28"
                                        Padding="8,0"
                                        Margin="0,0,4,0"
                                        Content="导入 CPA Token"
                                        Command="{Binding ImportCodexCpaTokenCommand}" />
                                <Button Style="{StaticResource CodexCompactGhostButton}"
                                        Height="28"
                                        Padding="8,0"
                                        Margin="0,0,4,0"
                                        Content="导出加密包"
                                        Command="{Binding ExportCodexProfilesEncBoxCommand}" />
                                <Button Style="{StaticResource CodexCompactGhostButton}"
                                        Height="28"
                                        Padding="8,0"
                                        Margin="0,0,4,0"
                                        Content="导入加密包"
                                        Command="{Binding ImportCodexProfilesEncBoxCommand}" />
                                <Button Style="{StaticResource CodexCompactGhostButton}"
                                        Height="28"
                                        Padding="8,0"
                                        Content="回滚上次切换"
                                        Command="{Binding RestoreLastCodexBackupCommand}" />
                            </WrapPanel>
                            <Border Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Background="{DynamicResource BrushCard}"
                                    CornerRadius="4"
                                    Padding="12,8"
                                    Margin="0,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                ToolTip="{Binding CodexLocalRelayStatusMessage}">
                                        <Border Width="10"
                                                Height="10"
                                                CornerRadius="5"
                                                VerticalAlignment="Center"
                                                Margin="0,0,6,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource BrushCodexStatusUnknown}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCodexLocalRelayStatusOk}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource BrushCodexStatusOk}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsCodexLocalRelayStatusFailed}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource BrushCodexStatusExpired}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsCodexLocalRelayStatusTesting}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource BrushCodexStatusWarn}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <TextBlock Text="{Binding CodexLocalRelayDisplayText}"
                                                   MaxWidth="180"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="立即轮换"
                                            Command="{Binding RotateToNextCodexProfileCommand}"
                                            IsEnabled="{Binding IsCodexRotationAvailable}"
                                            Style="{StaticResource CodexCompactOutlinedButton}"
                                            Padding="8,2"
                                            Margin="8,0,0,0" />
                                    <Button Grid.Column="2"
                                            Content="重启 Codex"
                                            Command="{Binding RestartCodexDesktopCommand}"
                                            Style="{StaticResource CodexCompactOutlinedButton}"
                                            Padding="8,2"
                                            Margin="6,0,0,0" />
                                    <Button Grid.Column="3"
                                            Content="启动本地中转"
                                            Command="{Binding EnableCodexLocalRelayCommand}"
                                            ToolTip="启动本地 relay，并通过 relay 测试当前 NewAPI。"
                                            Style="{StaticResource CodexCompactOutlinedButton}"
                                            Padding="8,2"
                                            Margin="6,0,0,0" />
                                    <Button Grid.Column="4"
                                            Content="重启 Codex 使用中转"
                                            Command="{Binding RestartCodexWithLocalRelayCommand}"
                                            IsEnabled="{Binding CanRestartCodexWithLocalRelay}"
                                            ToolTip="仅在本地中转测试为绿色时可用。"
                                            Style="{StaticResource CodexCompactOutlinedButton}"
                                            Padding="8,2"
                                            Margin="6,0,0,0" />
                                    <Button Grid.Column="5"
                                            Content="全选轮换"
                                            Command="{Binding SelectAllCodexRotationCommand}"
                                            Style="{StaticResource CodexCompactOutlinedButton}"
                                            Padding="8,2"
                                            Margin="6,0,0,0" />
                                    <Button Grid.Column="6"
                                            Content="反选轮换"
                                            Command="{Binding InvertCodexRotationCommand}"
                                            Style="{StaticResource CodexCompactOutlinedButton}"
                                            Padding="8,2"
                                            Margin="6,0,0,0" />
                                    <StackPanel Grid.Column="7"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CodexNextSwitchPreview}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                        <WrapPanel Margin="0,3,0,0">
                                            <Border CornerRadius="999"
                                                    Padding="7,2"
                                                    Margin="0,0,6,0"
                                                    Visibility="{Binding HasCodexExpiryReminder, Converter={StaticResource BoolToVis}}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource BrushCodexStatusWarn}" />
                                                        <Setter Property="TextElement.Foreground" Value="White" />
                                                        <Setter Property="TextElement.FontSize" Value="11" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCodexExpiryCritical}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource BrushCodexStatusExpired}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding CodexExpirySummaryText}" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <TextBlock Text="{Binding CodexRateLimitStatusText}"
                                                       MaxWidth="300"
                                                       TextTrimming="CharacterEllipsis"
                                                       Style="{StaticResource TextCaption}" />
                                        </WrapPanel>
                                    </StackPanel>
                                    <CheckBox Grid.Column="8"
                                              Content="轮换后通知"
                                              IsChecked="{Binding CodexRotationSettings.NotifyOnSwitch}"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource MaterialDesignCheckBox}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,8"
                            Margin="0,0,0,8"
                            Background="{DynamicResource MaterialDesignPaper}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="档案库"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <Border Grid.Column="1" Style="{StaticResource BadgeInfo}" Padding="8,2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="InformationOutline" Width="12" Height="12" Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding CodexProfilesStatusMessage}"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding CodexMachineText}"
                                       Style="{StaticResource TextCaption}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="{DynamicResource MaterialDesignFlatBackground}">
                        <ItemsControl x:Name="CodexProfilesItems" ItemsSource="{Binding CodexProfiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <materialDesign:Card Padding="0" Margin="0,0,0,8">
                                        <materialDesign:Card.Style>
                                            <Style TargetType="materialDesign:Card" BasedOn="{StaticResource SectionCard}">
                                                <Setter Property="Background" Value="White" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background" Value="#FFFBEB" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:Card.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Border Grid.RowSpan="2" Grid.Column="0" Width="4" CornerRadius="8,0,0,8">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource BrushCodexStatusUnknown}" />
                                                        <Setter Property="Width" Value="4" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="正常">
                                                                <Setter Property="Background" Value="{DynamicResource BrushCodexStatusOk}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="即将过期">
                                                                <Setter Property="Background" Value="{DynamicResource BrushCodexStatusWarn}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="已过期">
                                                                <Setter Property="Background" Value="{DynamicResource BrushCodexStatusExpired}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Width" Value="6" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <Grid Grid.Row="0" Grid.Column="1" Margin="12,10,12,10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ActivePrefix}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <Border Style="{StaticResource StatusPill}" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding Status}" />
                                                    </Border>
                                                    <Border Margin="8,0,0,0"
                                                            CornerRadius="999"
                                                            Padding="7,2"
                                                            Visibility="{Binding HasExpiryReminder, Converter={StaticResource BoolToVis}}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource BrushCodexStatusWarn}" />
                                                                <Setter Property="TextElement.Foreground" Value="White" />
                                                                <Setter Property="TextElement.FontSize" Value="11" />
                                                                <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsStatusExpired}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource BrushCodexStatusExpired}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding ExpiryReminderText}" />
                                                    </Border>
                                                    <Border Margin="8,0,0,0"
                                                            CornerRadius="999"
                                                            Padding="7,2"
                                                            ToolTip="{Binding RelayTestMessage}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource BrushCodexStatusUnknown}" />
                                                                <Setter Property="TextElement.Foreground" Value="White" />
                                                                <Setter Property="TextElement.FontSize" Value="11" />
                                                                <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRelayStatusOk}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource BrushSuccess}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsRelayStatusFailed}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource BrushError}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsRelayStatusTesting}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource BrushWarning}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="7" Height="7" Fill="White" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding RelayTestDisplayText}" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                                <WrapPanel Grid.Row="1" Margin="0,5,0,0">
                                                    <TextBlock Text="{Binding AccountEmailDisplay}" Style="{StaticResource TextCaption}" Margin="0,0,14,0" />
                                                    <TextBlock Text="{Binding LastImportedText}" Style="{StaticResource TextCaption}" Margin="0,0,14,0" />
                                                    <TextBlock Text="{Binding RemainingValidityText}" Style="{StaticResource TextCaption}" Margin="0,0,14,0" />
                                                    <TextBlock Text="{Binding ContentStorageSummary}" Style="{StaticResource TextCaption}" />
                                                </WrapPanel>
                                                <TextBlock Grid.Row="2"
                                                           Text="{Binding NoteDisplay}"
                                                           Style="{StaticResource TextCaption}"
                                                           Margin="0,5,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Note}" />
                                            </Grid>

                                            <WrapPanel Grid.Row="0" Grid.Column="2" Margin="0,8,8,8" VerticalAlignment="Center">
                                                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                             IsIndeterminate="True"
                                                             Width="18"
                                                             Height="18"
                                                             Margin="0,0,8,0"
                                                             Visibility="{Binding IsApplying, Converter={StaticResource BoolToVis}}" />
                                                <Button Style="{StaticResource CodexCompactPrimaryButton}"
                                                        Height="28"
                                                        Padding="8,0"
                                                        Margin="0,0,4,0"
                                                        Content="{Binding DataContext.CodexProfileSwitchButtonText, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        ToolTip="{Binding DataContext.CodexProfileSwitchButtonToolTip, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        Command="{Binding DataContext.SwitchCodexProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource CodexCompactGhostButton}"
                                                        Height="28"
                                                        Padding="7,0"
                                                        Margin="0,0,4,0"
                                                        Content="刷新"
                                                        Command="{Binding DataContext.RefreshCodexProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource CodexCompactGhostButton}"
                                                        Height="28"
                                                        Padding="7,0"
                                                        Margin="0,0,4,0"
                                                        Content="复制"
                                                        Command="{Binding DataContext.CopyCodexProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource CodexCompactGhostButton}"
                                                        Height="28"
                                                        Padding="7,0"
                                                        Margin="0,0,4,0"
                                                        Content="改名"
                                                        Command="{Binding DataContext.RenameCodexProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource CodexCompactGhostButton}"
                                                        Height="28"
                                                        Padding="7,0"
                                                        Margin="0,0,4,0"
                                                        Content="备注"
                                                        Command="{Binding DataContext.EditCodexProfileNoteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource CodexCompactGhostButton}"
                                                        Height="28"
                                                        Padding="7,0"
                                                        Margin="0,0,4,0"
                                                        Content="差异"
                                                        Command="{Binding DataContext.PreviewCodexProfileDiffCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource CodexCompactGhostButton}"
                                                        Height="28"
                                                        Padding="7,0"
                                                        Margin="0,0,4,0"
                                                        Content="应用到所有"
                                                        ToolTip="以此档案的 config.toml 为模板，同步到其他档案并保留各自 base_url"
                                                        Command="{Binding DataContext.ApplyCodexConfigTemplateToAllCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource CodexCompactGhostButton}"
                                                        Height="28"
                                                        Padding="7,0"
                                                        Margin="0,0,4,0"
                                                        Content="config"
                                                        Command="{Binding DataContext.EditCodexConfigTomlCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource CodexCompactGhostButton}"
                                                        Height="28"
                                                        Padding="7,0"
                                                        Margin="0,0,4,0"
                                                        Content="auth"
                                                        Command="{Binding DataContext.EditCodexAuthJsonCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource CodexCompactGhostButton}"
                                                        Height="28"
                                                        Padding="7,0"
                                                        Margin="0,0,4,0"
                                                        Content="导出"
                                                        Command="{Binding DataContext.ExportCodexProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Height="28"
                                                        Width="28"
                                                        Padding="0"
                                                        Command="{Binding DataContext.DeleteCodexProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource CodexCompactIconButton}"
                                                        ToolTip="删除档案">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16" />
                                                </Button>
                                            </WrapPanel>
                                            <StackPanel Grid.Row="1"
                                                        Grid.Column="1"
                                                        Grid.ColumnSpan="2"
                                                        Orientation="Horizontal"
                                                        Margin="12,0,10,10">
                                                <CheckBox Content="加入轮换"
                                                          IsChecked="{Binding EnableRotation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          VerticalAlignment="Center"
                                                          Style="{StaticResource MaterialDesignCheckBox}"/>
                                                <TextBlock Text="优先级:" Margin="12,0,4,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"/>
                                                <TextBox Text="{Binding RotationPriority, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Width="44" VerticalAlignment="Center"
                                                         Style="{StaticResource MaterialDesignTextBox}"
                                                         ToolTip="数字越小优先级越高"/>
                                            </StackPanel>
                                        </Grid>
                                    </materialDesign:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border Grid.Row="2"
                            Margin="0,8,0,0"
                            Padding="24"
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Background="{DynamicResource MaterialDesignPaper}"
                            Visibility="{Binding ElementName=CodexProfilesItems, Path=HasItems, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="FolderCogOutline"
                                                     Width="34"
                                                     Height="34"
                                                     Opacity="0.55"
                                                     HorizontalAlignment="Center"
                                                     Foreground="{DynamicResource MaterialDesignBodyLight}" />
                            <TextBlock Text="暂无 Codex 档案"
                                       Margin="0,10,0,0"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource MaterialDesignBody}" />
                            <TextBlock Text="{Binding CodexProfilesStatusMessage}"
                                       Margin="0,4,0,0"
                                       MaxWidth="520"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Style="{StaticResource TextCaption}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </DataTemplate>
        </ContentControl.Resources>
        <ContentControl.Style>
            <Style TargetType="ContentControl">
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="ContentTemplate" Value="{x:Null}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentModule}" Value="CodexProfiles">
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="ContentTemplate" Value="{StaticResource CodexProfilesDeferredTemplate}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ContentControl.Style>
    </ContentControl>            <!-- System Info module -->
    <ContentControl x:Name="FileVerifyHost" Content="{Binding}">
        <ContentControl.Resources>
            <DataTemplate x:Key="FileVerifyDeferredTemplate">
                            <Grid Margin="16"
                                  Background="Transparent"
                                  AllowDrop="True"
                                  DragEnter="FileVerify_OnDragOver"
                                  DragOver="FileVerify_OnDragOver"
                                  Drop="FileVerify_OnDrop">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentModule}" Value="FileVerify">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                
                                <!-- Header -->
                                <Border Grid.Row="0" Margin="0,0,0,12"
                                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                                        BorderThickness="0,0,0,1"
                                        CornerRadius="{StaticResource CornerRadiusCard}"
                                        Padding="12,8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource PrimaryActionButton}"
                                                    Command="{Binding VerifyFileCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="FileSearch" Width="14" Height="14" Margin="0,0,6,0" />
                                                    <TextBlock Text="选择文件（可多选）" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource BrushTealGradient}" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="文件验证" Style="{StaticResource TextHeadline}" />
                                                <TextBlock Text="{Binding FileHashStatusMessage}" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                
                                <TabControl Grid.Row="1"
                                            Style="{StaticResource MaterialDesignTabControl}"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            materialDesign:ColorZoneAssist.Mode="PrimaryMid">
                                    <TabItem Header="单文件校验">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Margin="0,0,0,0" Padding="20,18" CornerRadius="8"
                                                BorderThickness="2" BorderBrush="#5e72e4" Background="#F4F6FF">
                                            <StackPanel HorizontalAlignment="Center">
                                                <materialDesign:PackIcon Kind="FileUploadOutline" Width="32" Height="32"
                                                                         Foreground="#5e72e4" HorizontalAlignment="Center" />
                                                <TextBlock Text="拖入一个或多个文件即可校验"
                                                           FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="单文件可粘贴官方校验值；多文件可导出校验清单" FontSize="11" Opacity="0.6"
                                                           Margin="0,4,0,0" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                
                                        <materialDesign:Card Grid.Column="0" Padding="14,12" Margin="0">
                                            <StackPanel>
                                                <TextBlock Text="支持算法：MD5 / SHA-1 / SHA-256 / CRC32" Style="{StaticResource TextSubtitle}" />
                                                <TextBlock Style="{StaticResource TextCaption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                           Text="选择任意文件后单遍计算 4 种校验值。粘贴官方校验值后会自动识别算法并判断匹配状态。" />
                                                <TextBox Text="{Binding ExpectedFileHash, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource StandardTextBox}"
                                                         materialDesign:HintAssist.Hint="官方校验值（可选，支持整行粘贴）"
                                                         Margin="0,10,0,0" />
                                                <Border Background="{DynamicResource BrushInfoSoft}"
                                                        CornerRadius="6" Padding="10,7" Margin="0,8,0,0"
                                                        Visibility="{Binding HasFileHashCompareResult, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="14" Height="14"
                                                                                 Foreground="{DynamicResource BrushInfo}"
                                                                                 Margin="0,0,7,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding FileHashCompareResult}" Style="{StaticResource TextCaption}"
                                                                   FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <ProgressBar IsIndeterminate="True" Margin="0,10,0,0"
                                                             Style="{StaticResource MaterialDesignLinearProgressBar}"
                                                             Visibility="{Binding IsFileHashBusy, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </materialDesign:Card>
                
                                        <materialDesign:Card Grid.Column="2" Padding="14,12"
                                                             Visibility="{Binding FileHashResult, Converter={StaticResource StringNotEmptyToVisibility}}">
                                            <StackPanel>
                                                <StackPanel Style="{StaticResource SectionHeaderRow}">
                                                    <materialDesign:PackIcon Kind="ClipboardCheckOutline" Width="16" Height="16" Margin="0,0,8,0"
                                                                              Foreground="{DynamicResource BrushSuccess}" VerticalAlignment="Center" />
                                                    <TextBlock Text="校验结果" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <Border Background="{DynamicResource MaterialDesignToolBarBackground}"
                                                        CornerRadius="6" Padding="12,10"
                                                        Cursor="Hand"
                                                        MouseLeftButtonUp="FileHashResult_OnClick"
                                                        ToolTip="点击复制到剪贴板">
                                                    <TextBlock Text="{Binding FileHashResult}" Style="{StaticResource TextMonoCode}" />
                                                </Border>
                                            </StackPanel>
                                        </materialDesign:Card>
                
                                        </Grid>
                                        </Grid>
                                    </TabItem>
                                    <TabItem Header="批量结果">
                                        <StackPanel>
                                        <materialDesign:Card Padding="14,12" Margin="0,0,0,0"
                                                             Visibility="{Binding HasBatchFileHashResults, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <Button Style="{StaticResource GhostActionButton}"
                                                                Margin="0,0,6,0"
                                                                Command="{Binding CopyBatchFileHashColumnCommand}"
                                                                CommandParameter="MD5"
                                                                ToolTip="复制文件名和 MD5">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" Margin="0,0,5,0" />
                                                                <TextBlock Text="MD5" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource GhostActionButton}"
                                                                Margin="0,0,6,0"
                                                                Command="{Binding CopyBatchFileHashColumnCommand}"
                                                                CommandParameter="SHA-1"
                                                                ToolTip="复制文件名和 SHA-1">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" Margin="0,0,5,0" />
                                                                <TextBlock Text="SHA-1" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource GhostActionButton}"
                                                                Margin="0,0,6,0"
                                                                Command="{Binding CopyBatchFileHashColumnCommand}"
                                                                CommandParameter="SHA-256"
                                                                ToolTip="复制文件名和 SHA-256">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" Margin="0,0,5,0" />
                                                                <TextBlock Text="SHA-256" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource GhostActionButton}"
                                                                Margin="0,0,6,0"
                                                                Command="{Binding CopyBatchFileHashColumnCommand}"
                                                                CommandParameter="CRC32"
                                                                ToolTip="复制文件名和 CRC32">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" Margin="0,0,5,0" />
                                                                <TextBlock Text="CRC32" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource GhostActionButton}"
                                                                Command="{Binding ImportFileHashListCommand}"
                                                                Margin="0,0,6,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="FileImportOutline" Width="14" Height="14" Margin="0,0,6,0" />
                                                                <TextBlock Text="导入清单" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource GhostActionButton}"
                                                                Command="{Binding ExportFileHashListCommand}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="FileExportOutline" Width="14" Height="14" Margin="0,0,6,0" />
                                                                <TextBlock Text="导出清单" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                    <StackPanel Style="{StaticResource SectionHeaderRow}">
                                                        <materialDesign:PackIcon Kind="TableCheck" Width="16" Height="16" Margin="0,0,8,0"
                                                                                 Foreground="{DynamicResource BrushSuccess}" VerticalAlignment="Center" />
                                                        <TextBlock Text="批量校验结果" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <DataGrid ItemsSource="{Binding BatchFileHashResults}"
                                                          AutoGenerateColumns="False"
                                                          IsReadOnly="True"
                                                          CanUserAddRows="False"
                                                          HeadersVisibility="Column"
                                                          MinHeight="160"
                                                          MaxHeight="280">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="文件" Binding="{Binding FileName}" Width="1.2*" />
                                                        <DataGridTextColumn Header="比对" Binding="{Binding CompareStatus}" Width="86" />
                                                        <DataGridTextColumn Header="清单算法" Binding="{Binding ExpectedHashKind}" Width="86" />
                                                        <DataGridTextColumn Header="大小" Binding="{Binding FileSize}" Width="90" />
                                                        <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" Width="2*" />
                                                        <DataGridTextColumn Header="MD5" Binding="{Binding Md5}" Width="1.4*" />
                                                        <DataGridTextColumn Header="CRC32" Binding="{Binding Crc32}" Width="90" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>
                                        </materialDesign:Card>
                                        </StackPanel>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                
            </DataTemplate>
        </ContentControl.Resources>
        <ContentControl.Style>
            <Style TargetType="ContentControl">
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="ContentTemplate" Value="{x:Null}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentModule}" Value="FileVerify">
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="ContentTemplate" Value="{StaticResource FileVerifyDeferredTemplate}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ContentControl.Style>
    </ContentControl>
    <!-- Convert module -->
    <ContentControl x:Name="ConvertHost" Content="{Binding}">
        <ContentControl.Resources>
            <DataTemplate x:Key="ConvertDeferredTemplate">
                            <Grid Margin="16">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentModule}" Value="Convert">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                
                                <!-- Header -->
                                <Border Grid.Row="0" Margin="0,0,0,12"
                                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                                        BorderThickness="0,0,0,1"
                                        CornerRadius="{StaticResource CornerRadiusCard}"
                                        Padding="12,8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                                            <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <DockPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#F59E0B" Offset="0" />
                                                        <GradientStop Color="#EF4444" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <materialDesign:PackIcon Kind="SwapHorizontal" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="格式转换" Style="{StaticResource TextHeadline}" />
                                                <TextBlock Text="{Binding ConvertStatusMessage}" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                
                                <TabControl Grid.Row="1"
                                            Style="{StaticResource MaterialDesignTabControl}"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            materialDesign:ColorZoneAssist.Mode="PrimaryMid">
                                    <TabItem Header="转换设置">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                
                                        <materialDesign:Card Grid.Row="0" Grid.ColumnSpan="3" Padding="12,8" Margin="0,0,0,8">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource GhostActionButton}"
                                                            Command="{Binding SelectConvertOutputFolderCommand}"
                                                            Visibility="{Binding HasConvertCustomOutputFolder, Converter={StaticResource BoolToVis}}"
                                                            Margin="0,0,8,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="FolderCogOutline" Width="14" Height="14" Margin="0,0,6,0" />
                                                            <TextBlock Text="选择目录" />
                                                        </StackPanel>
                                                    </Button>
                                                    <TextBlock Text="{Binding ConvertOutputTargetText}" Style="{StaticResource TextCaption}"
                                                               VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="输出" Style="{StaticResource TextFieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <ComboBox Width="116" Height="30" SelectedValue="{Binding ConvertOutputMode, Mode=TwoWay}"
                                                              SelectedValuePath="Content">
                                                        <ComboBoxItem Content="同目录" IsSelected="True" />
                                                        <ComboBoxItem Content="桌面" />
                                                        <ComboBoxItem Content="指定目录" />
                                                    </ComboBox>
                                                </StackPanel>
                                            </DockPanel>
                                        </materialDesign:Card>
                
                                        <!-- Image conversion card -->
                                        <materialDesign:Card Grid.Row="1" Grid.Column="0" Padding="12,10" Margin="0">
                                            <StackPanel>
                                                <StackPanel Style="{StaticResource SectionHeaderRow}">
                                                    <Border Width="24" Height="24" CornerRadius="6" Background="{StaticResource BrushTealGradient}" Margin="0,0,7,0">
                                                        <materialDesign:PackIcon Kind="Image" Width="13" Height="13" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="图片转换" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                                                    <TextBlock Text="内置" Style="{StaticResource TextHint}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="{StaticResource ThicknessFieldGap}">
                                                        <TextBlock Text="格式" Style="{StaticResource TextFieldLabel}" />
                                                        <TextBox Text="{Binding ImageOutputFormat, UpdateSourceTrigger=PropertyChanged}"
                                                                 materialDesign:HintAssist.Hint="jpg"
                                                                 Style="{StaticResource StandardTextBox}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="0" Grid.Column="1">
                                                        <TextBlock Text="JPEG 质量" Style="{StaticResource TextFieldLabel}" />
                                                        <TextBox Text="{Binding ImageQuality, UpdateSourceTrigger=PropertyChanged}"
                                                                 materialDesign:HintAssist.Hint="85"
                                                                 Style="{StaticResource StandardTextBox}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,8,0">
                                                        <TextBlock Text="最大宽度" Style="{StaticResource TextFieldLabel}" />
                                                        <TextBox Text="{Binding ImageMaxWidth, UpdateSourceTrigger=PropertyChanged}"
                                                                 materialDesign:HintAssist.Hint="0=不限"
                                                                 Style="{StaticResource StandardTextBox}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
                                                        <TextBlock Text="最大高度" Style="{StaticResource TextFieldLabel}" />
                                                        <TextBox Text="{Binding ImageMaxHeight, UpdateSourceTrigger=PropertyChanged}"
                                                                 materialDesign:HintAssist.Hint="0=不限"
                                                                 Style="{StaticResource StandardTextBox}" />
                                                    </StackPanel>
                                                </Grid>
                
                                                <WrapPanel Margin="0,8,0,0">
                                                    <Button Style="{StaticResource GhostActionButton}"
                                                            Command="{Binding ApplyImageCompressPresetCommand}"
                                                            Margin="0,0,6,6">
                                                        <TextBlock Text="图片压缩" />
                                                    </Button>
                                                    <Button Style="{StaticResource GhostActionButton}"
                                                            Command="{Binding ApplyImageAvatarPresetCommand}"
                                                            Margin="0,0,6,6">
                                                        <TextBlock Text="头像 512" />
                                                    </Button>
                                                </WrapPanel>
                
                                                <Button Style="{StaticResource PrimaryActionButton}" Margin="0,10,0,0"
                                                        HorizontalAlignment="Left"
                                                        Command="{Binding ConvertImageCommand}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="ImageMove" Width="14" Height="14" Margin="0,0,6,0" />
                                                        <TextBlock Text="选择图片（可多选）" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </materialDesign:Card>
                
                                        <!-- Audio/Video conversion card -->
                                        <materialDesign:Card Grid.Row="1" Grid.Column="2" Padding="12,10" Margin="0">
                                            <StackPanel>
                                                <StackPanel Style="{StaticResource SectionHeaderRow}">
                                                    <Border Width="24" Height="24" CornerRadius="6" Background="{StaticResource BrushAccentGradient}" Margin="0,0,7,0">
                                                        <materialDesign:PackIcon Kind="MovieOpenOutline" Width="13" Height="13" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="音视频转换" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                                                    <Border Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource BadgeSuccess}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFfmpegAvailable}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="FFmpeg" Foreground="White" FontWeight="Bold" FontSize="11" />
                                                    </Border>
                                                    <Border Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource BadgeWarning}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFfmpegAvailable}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="未检测到 FFmpeg" Foreground="White" FontWeight="Bold" FontSize="11" />
                                                    </Border>
                                                </StackPanel>
                
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="2*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="{StaticResource ThicknessFieldGap}">
                                                        <TextBlock Text="格式" Style="{StaticResource TextFieldLabel}" />
                                                        <TextBox Text="{Binding MediaOutputFormat, UpdateSourceTrigger=PropertyChanged}"
                                                                 materialDesign:HintAssist.Hint="mp3"
                                                                 Style="{StaticResource StandardTextBox}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="{StaticResource ThicknessFieldGap}">
                                                        <TextBlock Text="FFmpeg 参数（可选）" Style="{StaticResource TextFieldLabel}" />
                                                        <TextBox Text="{Binding MediaExtraArgs, UpdateSourceTrigger=PropertyChanged}"
                                                                 materialDesign:HintAssist.Hint="-b:a 192k"
                                                                 Style="{StaticResource StandardTextBox}" />
                                                    </StackPanel>
                                                </Grid>
                
                                                <WrapPanel Margin="0,8,0,0">
                                                    <Button Style="{StaticResource GhostActionButton}"
                                                            Command="{Binding ApplyMediaMp4PresetCommand}"
                                                            Margin="0,0,6,6">
                                                        <TextBlock Text="视频转 MP4" />
                                                    </Button>
                                                    <Button Style="{StaticResource GhostActionButton}"
                                                            Command="{Binding ApplyMediaMp3PresetCommand}"
                                                            Margin="0,0,6,6">
                                                        <TextBlock Text="音频转 MP3" />
                                                    </Button>
                                                </WrapPanel>
                
                                                <Button Style="{StaticResource PrimaryActionButton}" Margin="0,10,0,0"
                                                        HorizontalAlignment="Left"
                                                        Command="{Binding ConvertMediaCommand}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="FileMusic" Width="14" Height="14" Margin="0,0,6,0" />
                                                        <TextBlock Text="选择音视频（可多选）" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </materialDesign:Card>
                                    </Grid>
                                    </TabItem>
                                    <TabItem Header="队列与结果">
                                    <StackPanel>
                                        <!-- Convert queue -->
                                        <materialDesign:Card Padding="12,10" Margin="0,8,0,0"
                                                             Visibility="{Binding HasConvertQueueItems, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <Button Style="{StaticResource GhostActionButton}"
                                                                Command="{Binding ToggleConvertPauseCommand}"
                                                                Margin="0,0,6,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="PauseCircleOutline" Width="14" Height="14" Margin="0,0,6,0" />
                                                                <TextBlock Text="{Binding ConvertPauseButtonText}" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource GhostActionButton}"
                                                                Command="{Binding ClearConvertQueueCommand}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="Broom" Width="14" Height="14" Margin="0,0,6,0" />
                                                                <TextBlock Text="清空" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="可拖拽排序" Style="{StaticResource TextCaption}"
                                                               Margin="0,0,10,0" VerticalAlignment="Center" />
                                                    <StackPanel Style="{StaticResource SectionHeaderRow}">
                                                        <materialDesign:PackIcon Kind="FormatListChecks" Width="16" Height="16" Margin="0,0,8,0"
                                                                                 Foreground="{DynamicResource BrushAccentBlue}" VerticalAlignment="Center" />
                                                        <TextBlock Text="转换队列" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <DataGrid x:Name="ConvertQueueGrid"
                                                          ItemsSource="{Binding ConvertQueueItems}"
                                                          AutoGenerateColumns="False"
                                                          IsReadOnly="True"
                                                          CanUserAddRows="False"
                                                          HeadersVisibility="Column"
                                                          GridLinesVisibility="Horizontal"
                                                          MinHeight="110"
                                                          MaxHeight="220"
                                                          PreviewMouseLeftButtonDown="ConvertQueueGrid_OnPreviewMouseLeftButtonDown"
                                                          MouseMove="ConvertQueueGrid_OnMouseMove"
                                                          Drop="ConvertQueueGrid_OnDrop"
                                                          AllowDrop="True"
                                                          Style="{StaticResource MaterialDesignDataGrid}"
                                                          materialDesign:DataGridAssist.CellPadding="8 4 8 4"
                                                          materialDesign:DataGridAssist.ColumnHeaderPadding="8 4 8 4">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="44" />
                                                        <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="72" />
                                                        <DataGridTextColumn Header="文件" Binding="{Binding FileName}" Width="1.2*" />
                                                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="86" />
                                                        <DataGridTextColumn Header="输出路径" Binding="{Binding OutputPath}" Width="1.7*" />
                                                        <DataGridTextColumn Header="消息" Binding="{Binding Message}" Width="1.4*" />
                                                        <DataGridTemplateColumn Header="操作" Width="222">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                                                Width="30"
                                                                                Height="30"
                                                                                Command="{Binding DataContext.MoveConvertQueueItemUpCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                                CommandParameter="{Binding}"
                                                                                ToolTip="上移">
                                                                            <materialDesign:PackIcon Kind="ArrowUp" Width="17" Height="17" />
                                                                        </Button>
                                                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                                                Width="30"
                                                                                Height="30"
                                                                                Command="{Binding DataContext.MoveConvertQueueItemDownCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                                CommandParameter="{Binding}"
                                                                                ToolTip="下移">
                                                                            <materialDesign:PackIcon Kind="ArrowDown" Width="17" Height="17" />
                                                                        </Button>
                                                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                                                Width="30"
                                                                                Height="30"
                                                                                Command="{Binding DataContext.OpenConvertQueueOutputCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                                CommandParameter="{Binding}"
                                                                                ToolTip="打开输出位置">
                                                                            <materialDesign:PackIcon Kind="FolderOpenOutline" Width="17" Height="17" />
                                                                        </Button>
                                                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                                                Width="30"
                                                                                Height="30"
                                                                                Command="{Binding DataContext.CopyConvertQueueMessageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                                CommandParameter="{Binding}"
                                                                                ToolTip="复制消息">
                                                                            <materialDesign:PackIcon Kind="ContentCopy" Width="17" Height="17" />
                                                                        </Button>
                                                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                                                Width="30"
                                                                                Height="30"
                                                                                Command="{Binding DataContext.RetryConvertQueueItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                                CommandParameter="{Binding}"
                                                                                ToolTip="重试">
                                                                            <materialDesign:PackIcon Kind="Refresh" Width="17" Height="17" />
                                                                        </Button>
                                                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                                                Width="30"
                                                                                Height="30"
                                                                                Command="{Binding DataContext.RemoveConvertQueueItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                                CommandParameter="{Binding}"
                                                                                ToolTip="移除">
                                                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="17" Height="17" />
                                                                        </Button>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                                <TextBlock Text="暂停会在当前文件完成后暂停后续队列，避免中途截断输出。"
                                                           Style="{StaticResource TextCaption}" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </materialDesign:Card>
                
                                        <!-- Convert result -->
                                        <materialDesign:Card Padding="12,10" Margin="0,8,0,0"
                                                                 Visibility="{Binding ConvertResult, Converter={StaticResource StringNotEmptyToVisibility}}">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right"
                                                        Style="{StaticResource PrimaryActionButton}"
                                                        Command="{Binding OpenConvertOutputFolderCommand}"
                                                        Visibility="{Binding HasConvertOutputTarget, Converter={StaticResource BoolToVis}}"
                                                        Margin="10,0,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="FolderOpenOutline" Width="14" Height="14" Margin="0,0,6,0" />
                                                        <TextBlock Text="打开位置" />
                                                    </StackPanel>
                                                </Button>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <materialDesign:PackIcon Kind="CheckCircleOutline" Width="15" Height="15" Margin="0,0,7,0"
                                                                                  Foreground="{DynamicResource BrushSuccess}" VerticalAlignment="Center" />
                                                        <TextBlock Text="转换结果" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding ConvertResult}" Style="{StaticResource TextMonoCode}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                        </materialDesign:Card>
                
                                        <DockPanel Margin="0,8,0,0"
                                                   Visibility="{Binding IsConvertBusy, Converter={StaticResource BoolToVis}}">
                                            <Button DockPanel.Dock="Right"
                                                    Style="{StaticResource GhostActionButton}"
                                                    Command="{Binding CancelConvertCommand}"
                                                    Margin="10,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="StopCircleOutline" Width="14" Height="14" Margin="0,0,6,0" />
                                                    <TextBlock Text="取消" />
                                                </StackPanel>
                                            </Button>
                                            <ProgressBar IsIndeterminate="True"
                                                         Style="{StaticResource MaterialDesignLinearProgressBar}"
                                                         VerticalAlignment="Center" />
                                        </DockPanel>
                                    </StackPanel>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                
            </DataTemplate>
        </ContentControl.Resources>
        <ContentControl.Style>
            <Style TargetType="ContentControl">
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="ContentTemplate" Value="{x:Null}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentModule}" Value="Convert">
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="ContentTemplate" Value="{StaticResource ConvertDeferredTemplate}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ContentControl.Style>
    </ContentControl>
    </Grid>
</UserControl>
