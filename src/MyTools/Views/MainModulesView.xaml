                                                        Command="{Binding SaveScreenshotSettingsCommand}"
                                                        HorizontalAlignment="Left">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="ContentSaveOutline" Width="15" Height="15" Margin="0,0,6,0"/>
                                                        <TextBlock Text="保存设置"/>
                                                    </StackPanel>
                                                </Button>
                        
                                                </StackPanel>
                                            </TabItem>
                                            <TabItem Header="哈希校验">
                                                <StackPanel>
