                                                                            Margin="0,0,8,0"
                                                                            Content="执行查询"
                                                                            Command="{Binding ExecuteSqlQueryCommand}"
                                                                            Style="{StaticResource PrimaryActionButton}">
                                                                        <Button.ContentTemplate>
                                                                            <DataTemplate>
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <materialDesign:PackIcon Kind="Play" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                                                                </StackPanel>
                                                                            </DataTemplate>
                                                                        </Button.ContentTemplate>
                                                                    </Button>
                                                                    <Button Width="116" Height="32"
                                                                            Margin="0,0,8,0"
                                                                            Content="导出 Excel"
                                                                            Command="{Binding ExportQueryResultCommand}"
                                                                            Style="{StaticResource GhostActionButton}">
                                                                        <Button.ContentTemplate>
                                                                            <DataTemplate>
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <materialDesign:PackIcon Kind="FileExcel" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                                                                </StackPanel>
                                                                            </DataTemplate>
                                                                        </Button.ContentTemplate>
                                                                    </Button>
                                                                    <Button Width="108" Height="32"
                                                                            Margin="0,0,8,0"
                                                                            Content="导出 CSV"
                                                                            Command="{Binding ExportQueryResultCsvCommand}"
                                                                            Style="{StaticResource GhostActionButton}">
                                                                        <Button.ContentTemplate>
                                                                            <DataTemplate>
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <materialDesign:PackIcon Kind="FileDelimitedOutline" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                                                                </StackPanel>
                                                                            </DataTemplate>
                                                                        </Button.ContentTemplate>
                                                                    </Button>
                                                                    <Button Width="108" Height="32"
                                                                            Margin="0,0,12,0"
                                                                            Content="复制结果"
                                                                            Click="CopySqlQueryResultButton_OnClick"
                                                                            Style="{StaticResource GhostActionButton}">
                                                                        <Button.ContentTemplate>
                                                                            <DataTemplate>
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <materialDesign:PackIcon Kind="ContentCopy" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                                                                </StackPanel>
                                                                            </DataTemplate>
                                                                        </Button.ContentTemplate>
                                                                    </Button>
                                                                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                                                 IsIndeterminate="True"
                                                                                 Width="18" Height="18"
                                                                                 VerticalAlignment="Center"
                                                                                 Margin="0,0,10,0"
                                                                                 Visibility="{Binding IsQueryBusy, Converter={StaticResource BoolToVis}}" />
                                                                    <TextBlock Text="{Binding QueryStatusMessage}"
                                                                               Style="{StaticResource TextCaption}"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Opacity="0.7" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </materialDesign:Card>
                        
                                                        <DataGrid Grid.Row="1"
                                                                  x:Name="SqlQueryResultGrid"
                                                                  ItemsSource="{Binding SqlQueryResult}"
                                                                  AutoGenerateColumns="True"
                                                                  IsReadOnly="True"
                                                                  ClipboardCopyMode="IncludeHeader"
                                                                  CanUserAddRows="False"
                                                                  CanUserDeleteRows="False"
                                                                  CanUserSortColumns="True"
                                                                  MinHeight="180"
                                                                  VerticalScrollBarVisibility="Visible"
                                                                  HorizontalScrollBarVisibility="Auto"
                                                                  SelectionMode="Extended"
                                                                  Style="{StaticResource MaterialDesignDataGrid}"
                                                                  materialDesign:DataGridAssist.CellPadding="8 4 8 4"
                                                                  materialDesign:DataGridAssist.ColumnHeaderPadding="8 4 8 4" />
                                                    </Grid>
                                                </TabItem>
                        
                                            </TabControl>
                                        </Grid>
                                    </Grid>
                        
                    </DataTemplate>
                </ContentControl.Resources>
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="ContentTemplate" Value="{x:Null}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentModule}" Value="SqlExport">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="ContentTemplate" Value="{StaticResource SqlExportDeferredTemplate}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            <!-- Screenshot Settings panel -->
            <ContentControl x:Name="ScreenshotHost" Content="{Binding}">
                <ContentControl.Resources>
                    <DataTemplate x:Key="ScreenshotDeferredTemplate">
                                    <Grid Margin="20">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentModule}" Value="Screenshot">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                        
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                        
                                        <Border Grid.Row="0"
                                                Margin="0,0,0,20"
                                                CornerRadius="{StaticResource CornerRadiusCard}"
                                                Padding="20,16">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                                                    <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,12,0"
                                                                Visibility="{Binding HasAudioRecordingIndicator, Converter={StaticResource BoolToVis}}">
                                                        <Ellipse Width="8" Height="8" Fill="#E53935" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding AudioRecordingIndicator}" Foreground="#C62828" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <Button Style="{StaticResource PrimaryActionButton}"
                                                            Command="{Binding TakeScreenshotNowCommand}"
                                                            Margin="0,0,8,0"
                                                            ToolTip="立即截图">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="Camera" Width="16" Height="16" Margin="0,0,6,0"/>
                                                            <TextBlock Text="立即截图"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource GhostActionButton}"
                                                            Command="{Binding StartVideoRecordingCommand}"
                                                            Margin="0,0,8,0"
                                                            ToolTip="开启区域录像">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="RecordRec" Width="16" Height="16" Margin="0,0,6,0" Foreground="#E53935" />
                                                            <TextBlock Text="开启录像"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource GhostActionButton}"
                                                            Command="{Binding ToggleAudioRecordingCommand}"
                                                            Margin="0,0,8,0"
                                                            ToolTip="开启或停止录音">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0">
                                                                <materialDesign:PackIcon.Style>
                                                                    <Style TargetType="materialDesign:PackIcon">
                                                                        <Setter Property="Kind" Value="Microphone" />
                                                                        <Setter Property="Foreground" Value="#E53935" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsAudioRecording}" Value="True">
                                                                                <Setter Property="Kind" Value="StopCircle" />
                                                                                <Setter Property="Foreground" Value="#757575" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </materialDesign:PackIcon.Style>
                                                            </materialDesign:PackIcon>
                                                            <TextBlock VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="开启录音" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsAudioRecording}" Value="True">
                                                                                <Setter Property="Text" Value="停止录音" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource GhostActionButton}"
                                                            Command="{Binding EditClipboardImageCommand}"
                                                            ToolTip="打开编辑器编辑剪贴板中的图片">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="ImageEdit" Width="16" Height="16" Margin="0,0,6,0"/>
                                                            <TextBlock Text="编辑剪贴板截图"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="30" Height="30" CornerRadius="7" Background="{StaticResource BrushAccentGradient}" Margin="0,0,9,0" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="CameraIris" Width="16" Height="16" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="截图工具" Style="{StaticResource TextHeadline}" />
                                                        <TextBlock Text="全屏截图 · 区域录像 · 独立录音" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                        
                                        <TabControl Grid.Row="1"
                                                    Style="{StaticResource MaterialDesignTabControl}"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Stretch"
                                                    materialDesign:ColorZoneAssist.Mode="PrimaryMid">
                                            <TabItem Header="截图设置">
                                                <StackPanel>
                        
                                                <!-- Hotkey card -->
                                                <materialDesign:Card Style="{StaticResource PremiumCard}" Padding="12,10" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <TextBlock Text="快捷键设置" Style="{StaticResource TextSubtitle}" FontWeight="Bold" Margin="0,0,0,8"/>
                        
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                        
                                                            <Border Grid.Column="0" BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                                    BorderThickness="1" CornerRadius="4" Padding="10,6"
                                                                    Margin="0,0,8,0">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{DynamicResource MaterialDesignTextFieldBoxBackground}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCapturingHotkey}" Value="True">
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                                                <Setter Property="BorderThickness" Value="2"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <materialDesign:PackIcon Kind="Keyboard" Width="18" Height="18"
                                                                                             VerticalAlignment="Center" Margin="0,0,10,0"
                                                                                             Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                                    <TextBlock VerticalAlignment="Center" FontSize="14">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Text" Value="{Binding ScreenshotHotkeyText}"/>
                                                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
                                                                                <Setter Property="FontWeight" Value="Medium"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsCapturingHotkey}" Value="True">
                                                                                        <Setter Property="Text" Value="请按下新快捷键组合..."/>
                                                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Border>
                        
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                <Button Margin="0,0,6,0"
                                                                        Command="{Binding StartCaptureHotkeyCommand}">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button" BasedOn="{StaticResource GhostActionButton}">
                                                                            <Setter Property="Content" Value="修改快捷键"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsCapturingHotkey}" Value="True">
                                                                                    <Setter Property="Content" Value="监听中..."/>
                                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                                <Button Content="取消"
                                                                        Command="{Binding CancelCaptureHotkeyCommand}">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button" BasedOn="{StaticResource GhostActionButton}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsCapturingHotkey}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                        
                                                        <TextBlock Text="注意：快捷键需包含 Ctrl 或 Alt 之一，避免与系统快捷键冲突。快捷键在全局生效，包括窗口隐藏期间。"
                                                                   Style="{StaticResource TextCaption}"
                                                                   Opacity="0.55" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                </materialDesign:Card>
                        
                                                <!-- Behavior card -->
                                                <materialDesign:Card Style="{StaticResource PremiumCard}" Padding="12,10" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <TextBlock Text="截图行为" Style="{StaticResource TextSubtitle}" FontWeight="Bold" Margin="0,0,0,8"/>
                        
                                                        <TextBlock Text="截图范围" FontWeight="Medium" Margin="0,0,0,6" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <RadioButton GroupName="ScreenshotMode" Content="全屏" Margin="0,0,18,0"
                                                                         IsChecked="{Binding IsScreenshotModeFullScreen}" />
                                                            <RadioButton GroupName="ScreenshotMode" Content="划区域" Margin="0,0,18,0"
                                                                         IsChecked="{Binding IsScreenshotModeRegion}" />
                                                            <RadioButton GroupName="ScreenshotMode" Content="当前窗口"
                                                                         IsChecked="{Binding IsScreenshotModeWindow}" />
                                                        </StackPanel>
                                                        <TextBlock Style="{StaticResource TextCaption}" Opacity="0.6" Margin="0,0,0,8" TextWrapping="Wrap"
                                                                   Text="全屏：直接截整个虚拟屏幕；划区域：弹出半透明蒙层让你拖动选区，Esc 取消；当前窗口：截按下快捷键时位于最前的那个窗口。" />
                        
                                                        <Grid Margin="0,0,0,10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ToggleButton Grid.Column="0"
                                                                          IsChecked="{Binding IsGifRecordingMode}"
                                                                          Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                                          VerticalAlignment="Top"
                                                                          Margin="0,2,12,0" />
                                                            <StackPanel Grid.Column="1">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="区域录像输出" Style="{StaticResource TextSubtitle}" FontWeight="Medium" Margin="0,0,8,0" />
                                                                    <Border Style="{StaticResource StatusPill}">
                                                                        <TextBlock Text="{Binding RecordingModeText}" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding RecordingModeHint}"
                                                                           Style="{StaticResource TextCaption}"
                                                                           Opacity="0.6"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,4,20,0" />
                                                            </StackPanel>
                                                        </Grid>
                        
                                                        <UniformGrid Rows="1" Columns="2" Margin="0,0,0,10">
                                                            <StackPanel Margin="0,0,8,0">
                                                                <TextBlock Text="录像帧率" Style="{StaticResource TextCaption}" Margin="0,0,0,4" />
                                                                <ComboBox ItemsSource="{Binding RecordingFrameRateOptions}"
                                                                          SelectedItem="{Binding RecordingFrameRateOption, Mode=TwoWay}"
                                                                          Height="32" />
                                                            </StackPanel>
                                                            <StackPanel>
                                                                <TextBlock Text="MP4 画质" Style="{StaticResource TextCaption}" Margin="0,0,0,4" />
                                                                <ComboBox ItemsSource="{Binding RecordingQualityOptions}"
                                                                          SelectedItem="{Binding RecordingQualityOption, Mode=TwoWay}"
                                                                          Height="32" />
                                                            </StackPanel>
                                                        </UniformGrid>
                        
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0"
                                                                      IsChecked="{Binding ShowEditorAfterCapture}"
                                                                      VerticalAlignment="Top"
                                                                      Margin="0,2,12,0" />
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="截图后打开编辑器"
                                                                           Style="{StaticResource TextSubtitle}"
                                                                           FontWeight="Medium"/>
                                                                <TextBlock Margin="0,4,20,0" Opacity="0.6" TextWrapping="Wrap">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                                                                            <Setter Property="Text" Value="截图后弹出编辑器进行标注；关闭编辑器时自动把编辑后的图写入剪贴板。"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ShowEditorAfterCapture}" Value="False">
                                                                                    <Setter Property="Text" Value="截图后直接写入剪贴板，不弹编辑器。"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                </materialDesign:Card>
                        
                                                </StackPanel>
                                            </TabItem>
                                            <TabItem Header="截图历史">
                                                <StackPanel>
                                                <!-- Screenshot history -->
                                                <materialDesign:Card Style="{StaticResource PremiumCard}" Padding="12,10" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <StackPanel Style="{StaticResource SectionHeaderRow}">
                                                            <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource BrushTealGradient}" Margin="0,0,10,0">
                                                                <materialDesign:PackIcon Kind="ImageMultiple" Width="14" Height="14" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                            </Border>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="截图历史" Style="{StaticResource TextSubtitle}" />
                                                                <TextBlock Text="{Binding ScreenshotHistorySummary}" Style="{StaticResource TextHint}" Margin="0,1,0,0" />
                                                            </StackPanel>
                                                        </StackPanel>
                        
                                                        <TextBlock Text="还没有截图历史。点击“立即截图”后会自动保存最近 20 张。"
                                                                   Style="{StaticResource TextHint}"
                                                                   Margin="0,12,0,12"
                                                                   HorizontalAlignment="Center"
                                                                   Visibility="{Binding HasScreenshotHistoryItems, Converter={StaticResource InverseBoolToVis}}" />
                        
                                                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                                      VerticalScrollBarVisibility="Disabled"
                                                                      Visibility="{Binding HasScreenshotHistoryItems, Converter={StaticResource BoolToVis}}">
                                                            <ItemsControl ItemsSource="{Binding ScreenshotHistoryItems}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Width="188" Margin="0,0,8,0" Padding="8"
                                                                                BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7"
                                                                                Background="#FAFBFC">
                                                                            <StackPanel>
                                                                                <Border Height="92" CornerRadius="5" Background="#E5E7EB" ClipToBounds="True">
                                                                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                                                                </Border>
                                                                                <TextBlock Text="{Binding Title}" Style="{StaticResource TextBodyStandard}"
                                                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,6,0,1" />
                                                                                <TextBlock Style="{StaticResource TextHint}" TextTrimming="CharacterEllipsis">
                                                                                    <Run Text="{Binding TimeText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SizeText, Mode=OneWay}" />
                                                                                </TextBlock>
                                                                                <TextBlock Text="{Binding DimensionsText}" Style="{StaticResource TextHint}" TextTrimming="CharacterEllipsis" Margin="0,1,0,6" />
                                                                                <WrapPanel>
                                                                                    <Button Style="{StaticResource GhostActionButton}"
                                                                                            Height="26" MinWidth="46" Padding="6,0" Margin="0,0,5,5"
                                                                                            Command="{Binding DataContext.CopyScreenshotHistoryItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                            CommandParameter="{Binding}">
                                                                                        <StackPanel Orientation="Horizontal">
                                                                                            <materialDesign:PackIcon Kind="ContentCopy" Width="13" Height="13" Margin="0,0,4,0" />
                                                                                            <TextBlock Text="复制" />
                                                                                        </StackPanel>
                                                                                    </Button>
                                                                                    <Button Style="{StaticResource GhostActionButton}"
                                                                                            Height="26" MinWidth="46" Padding="6,0" Margin="0,0,5,5"
                                                                                            Command="{Binding DataContext.EditScreenshotHistoryItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                            CommandParameter="{Binding}">
                                                                                        <StackPanel Orientation="Horizontal">
                                                                                            <materialDesign:PackIcon Kind="ImageEdit" Width="13" Height="13" Margin="0,0,4,0" />
                                                                                            <TextBlock Text="编辑" />
                                                                                        </StackPanel>
                                                                                    </Button>
                                                                                    <Button Style="{StaticResource GhostActionButton}"
                                                                                            Height="26" MinWidth="46" Padding="6,0" Margin="0,0,5,5"
                                                                                            Command="{Binding DataContext.OpenScreenshotHistoryItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                            CommandParameter="{Binding}">
                                                                                        <StackPanel Orientation="Horizontal">
                                                                                            <materialDesign:PackIcon Kind="OpenInNew" Width="13" Height="13" Margin="0,0,4,0" />
                                                                                            <TextBlock Text="打开" />
                                                                                        </StackPanel>
                                                                                    </Button>
                                                                                    <Button Style="{StaticResource GhostActionButton}"
                                                                                            Height="26" MinWidth="46" Padding="6,0" Margin="0,0,5,5"
                                                                                            Command="{Binding DataContext.DeleteScreenshotHistoryItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                            CommandParameter="{Binding}">
                                                                                        <StackPanel Orientation="Horizontal">
                                                                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="13" Height="13" Margin="0,0,4,0" />
                                                                                            <TextBlock Text="删除" />
                                                                                        </StackPanel>
                                                                                    </Button>
                                                                                </WrapPanel>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </StackPanel>
                                                </materialDesign:Card>
                        
                                                </StackPanel>
                                            </TabItem>
                                            <TabItem Header="录制目录">
                                                <StackPanel>
                                                <!-- Recording output folders -->
                                                <materialDesign:Card Style="{StaticResource PremiumCard}" Padding="12,10" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <TextBlock Text="录制输出目录" Style="{StaticResource TextSubtitle}" FontWeight="Bold" Margin="0,0,0,8" />
                                                        <Grid Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="录像" Style="{StaticResource TextFieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                            <TextBlock Grid.Column="1" Text="{Binding RecordingOutputFolderText}" Style="{StaticResource TextCaption}"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            <Button Grid.Column="2" Style="{StaticResource GhostActionButton}"
                                                                    Command="{Binding SelectRecordingOutputFolderCommand}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <materialDesign:PackIcon Kind="FolderCogOutline" Width="14" Height="14" Margin="0,0,6,0" />
