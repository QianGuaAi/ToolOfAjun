<UserControl x:Class="MyTools.Views.SchedulePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:MyTools.ViewModels"
             d:DesignHeight="700" d:DesignWidth="1200"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="188" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="226" />
        </Grid.ColumnDefinitions>

        <!-- ===== Left: version list ===== -->
        <Border Grid.Column="0" Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="False" Margin="10,8,8,6">
                    <TextBlock DockPanel.Dock="Left" Text="排班版本" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Content="刷新" Style="{StaticResource ToolbarButton}" MinWidth="48"
                            Command="{Binding RefreshVersionsCommand}" Margin="0" />
                </DockPanel>

                <ListBox Grid.Row="1" x:Name="VersionList"
                         ItemsSource="{Binding Versions}"
                         BorderThickness="0"
                         MouseDoubleClick="VersionList_MouseDoubleClick"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="5,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayLabel}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DisplaySub}" FontSize="11" Opacity="0.7" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="×" ToolTip="删除"
                                        Width="22" Height="22" Padding="0"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Command="{Binding DataContext.DeleteVersionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="2" Margin="10,6,10,10" FontSize="11" Opacity="0.7"
                           TextWrapping="Wrap"
                           Text="双击加载；工作表加载后可直接编辑。" />
            </Grid>
        </Border>

        <!-- ===== Right: schedule editor ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header / toolbar -->
            <Border Grid.Row="0" Padding="10,7" Background="{DynamicResource MaterialDesignCardBackground}">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="新建" Style="{StaticResource ToolbarButton}" Command="{Binding NewCommand}" />
                        <Button Content="设置休息日" Style="{StaticResource ToolbarButton}" Command="{Binding AutoOptimizeCommand}" ToolTip="开始设置休息日" />
                        <CheckBox Content="无警告再显示"
                                  IsChecked="{Binding RequireWarningFreeSchedule, Mode=TwoWay}"
                                  Height="28"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  FontSize="12"
                                  ToolTip="勾选后会反复生成，直到生成结果没有冲突警告才显示到表格" />
                        <Button Content="清空" Style="{StaticResource ToolbarButton}"
                                Command="{Binding ClearAllCellsCommand}" ToolTip="清空所有班次单元格，恢复为空白初始状态" />
                        <Button Content="清空随机单元" Style="{StaticResource ToolbarButton}" MinWidth="92"
                                Command="{Binding ClearRandomCellsCommand}" ToolTip="清空自动生成的随机单元格，保留用户手动设置的单元格" />
                        <Button Content="-" Style="{StaticResource ToolbarButton}" MinWidth="34" Width="34" Padding="0" Click="ZoomOut_Click" ToolTip="缩小排班表" />
                        <TextBlock x:Name="ZoomText" Text="100%" Width="42" Height="28" TextAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                        <Button Content="+" Style="{StaticResource ToolbarButton}" MinWidth="34" Width="34" Padding="0" Click="ZoomIn_Click" ToolTip="放大排班表" />
                        <Button Content="100%" Style="{StaticResource ToolbarButton}" MinWidth="52" Click="ZoomReset_Click" ToolTip="恢复原始大小" />
                        <Button Content="添加人员" Style="{StaticResource ToolbarButton}" Click="AddEmployee_Click" />
                        <TextBox x:Name="AddCountBox" Text="1" Width="48" Height="28"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 MaxLength="4" ToolTip="一次添加的人数（0-2000）"
                                 PreviewTextInput="AddCountBox_PreviewTextInput"
                                 Margin="0,0,6,0" />
                        <Button Content="导入人员" Style="{StaticResource ToolbarButton}" Command="{Binding ImportEmployeeTemplateCommand}" ToolTip="导入 CSV/TXT 人员名单" />
                        <Button Content="人员模板" Style="{StaticResource ToolbarButton}" Command="{Binding ExportEmployeeTemplateCommand}" ToolTip="导出当前人员名单 CSV" />
                        <Button Content="复制上月" Style="{StaticResource ToolbarButton}" Command="{Binding CopyPreviousMonthEmployeesCommand}" ToolTip="复制上月最新版本人员名单" />
                        <Button Content="导出" Style="{StaticResource ToolbarButton}" Command="{Binding ExportExcelCommand}" ToolTip="导出 Excel" />
                        <Button Content="另存" Style="{StaticResource ToolbarButton}" Command="{Binding SaveAsCommand}" ToolTip="在当前月份下另存为新版本名" />
                        <Button Content="保存" Style="{StaticResource ToolbarButton}" Command="{Binding SaveCommand}"
                                Background="#5e72e4" Foreground="White" BorderBrush="#5e72e4" />
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CalendarMonth" Width="17" Height="17" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding HeaderTitle}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Status -->
            <Border Grid.Row="1" Padding="10,4" Background="{DynamicResource MaterialDesignChipBackground}">
                <TextBlock Text="{Binding StatusMessage}" FontSize="11" TextTrimming="CharacterEllipsis" />
            </Border>

            <!-- Schedule grid -->
            <ScrollViewer x:Name="ScheduleScroll" Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="ScheduleScroll_PreviewMouseWheel"
                          ScrollChanged="ScheduleScroll_ScrollChanged">
                <Grid x:Name="ScheduleHost" Margin="10,8">
                    <Grid.LayoutTransform>
                        <ScaleTransform x:Name="ScheduleScale" ScaleX="1" ScaleY="1" />
                    </Grid.LayoutTransform>
                </Grid>
            </ScrollViewer>

            <!-- Legend -->
            <Border Grid.Row="3" Padding="10,6" Background="{DynamicResource MaterialDesignCardBackground}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,1,0,0">
                <WrapPanel>
                    <TextBlock Text="图例" FontSize="11" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <Border Background="#E3F2FD" CornerRadius="3" Padding="5,1" Margin="0,0,4,0"><TextBlock Text="白" FontSize="11" /></Border>
                    <Border Background="#E8EAF6" CornerRadius="3" Padding="5,1" Margin="0,0,4,0"><TextBlock Text="卡" FontSize="11" /></Border>
                    <Border Background="#E0F7FA" CornerRadius="3" Padding="5,1" Margin="0,0,4,0"><TextBlock Text="副" FontSize="11" /></Border>
                    <Border Background="#FFEBEE" CornerRadius="3" Padding="5,1" Margin="0,0,4,0"><TextBlock Text="感" FontSize="11" /></Border>
                    <Border Background="#37474F" CornerRadius="3" Padding="5,1" Margin="0,0,4,0"><TextBlock Text="夜" FontSize="11" Foreground="White" /></Border>
                    <Border Background="#78909C" CornerRadius="3" Padding="5,1" Margin="0,0,4,0"><TextBlock Text="小" FontSize="11" Foreground="White" /></Border>
                    <Border Background="#C8E6C9" CornerRadius="3" Padding="5,1" Margin="0,0,4,0"><TextBlock Text="休" FontSize="11" /></Border>
                    <Border Background="#A5D6A7" CornerRadius="3" Padding="5,1" Margin="0,0,4,0"><TextBlock Text="公" FontSize="11" /></Border>
                    <Border Background="#FFF9C4" CornerRadius="3" Padding="5,1" Margin="0,0,8,0"><TextBlock Text="午" FontSize="11" /></Border>
                    <TextBlock FontSize="11" Opacity="0.78" TextWrapping="Wrap" Text="小1=小→夜→休→休。单击格子选班次。" />
                </WrapPanel>
            </Border>
        </Grid>

        <Border Grid.Column="2"
                Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="1,0,0,0"
                Padding="10,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <materialDesign:PackIcon Kind="AlertCircleOutline" Width="15" Height="15"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource BrushAccentAmber}" />
                        <TextBlock Text="冲突检查" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border CornerRadius="4" Background="{DynamicResource MaterialDesignChipBackground}" Padding="7,4">
                        <TextBlock Text="{Binding ScheduleConflictSummary}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,10,0,10">
                    <TextBlock Text="整月复制" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                    <ComboBox Height="30"
                              Margin="0,0,0,6"
                              ItemsSource="{Binding Current.Employees}"
                              SelectedItem="{Binding CopySourceEmployee}"
                              DisplayMemberPath="Name"
                              Style="{StaticResource MaterialDesignFilledComboBox}"
                              materialDesign:HintAssist.Hint="来源人员" />
                    <ComboBox Height="30"
                              Margin="0,0,0,6"
                              ItemsSource="{Binding Current.Employees}"
                              SelectedItem="{Binding CopyTargetEmployee}"
                              DisplayMemberPath="Name"
                              Style="{StaticResource MaterialDesignFilledComboBox}"
                              materialDesign:HintAssist.Hint="目标人员" />
                    <Button Content="复制整月班次"
                            Height="30"
                            Command="{Binding CopyEmployeeMonthCommand}"
                            Style="{StaticResource ToolbarButton}"
                            HorizontalAlignment="Stretch" />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                    <TextBlock Text="周休均衡" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding WeeklyRestStats}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,5" Padding="7,5" CornerRadius="4"
                                        BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding WeekText}" FontSize="11" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding DateRangeText}" FontSize="10.5" Opacity="0.7" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding TotalRestText}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding BalanceText}" FontSize="10.5" Opacity="0.72" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <ListBox Grid.Row="3"
                         ItemsSource="{Binding ScheduleConflicts}"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasScheduleConflicts}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6"
                                    Padding="7,6"
                                    CornerRadius="4"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,2">
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding Level}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushAccentRed}" />
                                        <TextBlock Text="{Binding Category}"
                                                   FontSize="10"
                                                   Opacity="0.68"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                     <TextBlock Text="{Binding Detail}"
                                               FontSize="10.5"
                                               Opacity="0.75"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                    <Button Content="定位"
                                            Height="24"
                                            Margin="0,5,0,0"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource ToolbarButton}"
                                            Command="{Binding DataContext.LocateScheduleConflictCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
        <Border Grid.ColumnSpan="3"
                Background="#66000000"
                Visibility="{Binding IsAutoOptimizeWaiting, Converter={StaticResource BoolToVis}}"
                Panel.ZIndex="99">
            <Border Width="360"
                    Padding="22"
                    CornerRadius="12"
                    Background="{DynamicResource MaterialDesignPaper}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="正在生成正确的结果，请等待！"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding AutoOptimizeWaitMessage}"
                               FontSize="12"
                               Opacity="0.72"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,14" />
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding AutoOptimizeProgress, Mode=OneWay}"
                                 Height="8" />
                    <TextBlock Text="系统正在自动尝试不同方案，成功前不会刷新表格结果。"
                               FontSize="11"
                               Opacity="0.62"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
