<UserControl x:Class="MyTools.Views.SchedulePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:MyTools.ViewModels"
             d:DesignHeight="700" d:DesignWidth="1200"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <UserControl.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Height" Value="32" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Left: version list ===== -->
        <Border Grid.Column="0" Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="False" Margin="12,10,8,8">
                    <TextBlock DockPanel.Dock="Left" Text="排班版本" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Content="刷新" Style="{StaticResource ToolbarButton}"
                            Command="{Binding RefreshVersionsCommand}" Margin="0" />
                </DockPanel>

                <ListBox Grid.Row="1" x:Name="VersionList"
                         ItemsSource="{Binding Versions}"
                         BorderThickness="0"
                         MouseDoubleClick="VersionList_MouseDoubleClick"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayLabel}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DisplaySub}" FontSize="11" Opacity="0.7" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="×" ToolTip="删除"
                                        Width="22" Height="22" Padding="0"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Command="{Binding DataContext.DeleteVersionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="2" Margin="12,8,12,12" FontSize="11" Opacity="0.7"
                           TextWrapping="Wrap"
                           Text="提示：双击版本加载。加载后为只读，请点上方【编辑】修改。" />
            </Grid>
        </Border>

        <!-- ===== Right: schedule editor ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header / toolbar -->
            <Border Grid.Row="0" Padding="14,10" Background="{DynamicResource MaterialDesignCardBackground}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="新建" Style="{StaticResource ToolbarButton}" Command="{Binding NewCommand}" />
                        <Button Content="{Binding EditButtonLabel}" Style="{StaticResource ToolbarButton}" Command="{Binding EditCommand}" />
                        <Button Content="开始设置休息日" Style="{StaticResource ToolbarButton}" Command="{Binding AutoOptimizeCommand}" />
                        <Button Content="添加人员" Style="{StaticResource ToolbarButton}" Click="AddEmployee_Click" />
                        <TextBox x:Name="AddCountBox" Text="1" Width="56" Height="32"
                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                 MaxLength="4" ToolTip="一次添加的人数（0-2000）"
                                 PreviewTextInput="AddCountBox_PreviewTextInput"
                                 Margin="0,0,8,0" />
                        <Button Content="保存" Style="{StaticResource ToolbarButton}" Command="{Binding SaveCommand}"
                                Background="#5e72e4" Foreground="White" BorderBrush="#5e72e4" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CalendarMonth" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding HeaderTitle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Status -->
            <Border Grid.Row="1" Padding="14,6" Background="{DynamicResource MaterialDesignChipBackground}">
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" />
            </Border>

            <!-- Schedule grid -->
            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="ScheduleHost" Margin="14,12" />
            </ScrollViewer>

            <!-- Legend -->
            <Border Grid.Row="3" Padding="14,8" Background="{DynamicResource MaterialDesignCardBackground}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,1,0,0">
                <TextBlock FontSize="11" Opacity="0.85" TextWrapping="Wrap"
                           Text="班次：白(白班)  卡(卡班)  副(副小)  感(感染科)  大(大夜=1天上班)  小(小夜=1天上班)  休(休息)  公(公休)  午(下午休0.5)  ｜ 大1=小→大→休→休  大2=小→大→休  ｜ 单击单元格弹出选项；右键编辑姓名/删除人员。" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
