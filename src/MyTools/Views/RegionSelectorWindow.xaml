<Window x:Class="MyTools.Views.RegionSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择区域"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Cursor="Cross"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">
    <Grid x:Name="RootGrid">
        <!-- 截图作为背景 -->
        <Image x:Name="BackgroundImage" Stretch="Fill" />
        <!-- 半透明黑色蒙层 -->
        <Rectangle x:Name="DimRect" Fill="#80000000" />
        <!-- 选区高亮：用 Image + Clip 显示原图 -->
        <Canvas x:Name="OverlayCanvas">
            <Image x:Name="SelectionImage" Stretch="None" Visibility="Collapsed" />
            <Rectangle x:Name="SelectionBorder"
                       Stroke="#FF5e72e4" StrokeThickness="2"
                       Visibility="Collapsed" />
            <Border x:Name="SizeHint"
                    Background="#CC1F1F1F"
                    Padding="8,4"
                    CornerRadius="4"
                    Visibility="Collapsed">
                <TextBlock x:Name="SizeHintText" Foreground="White" FontSize="12" />
            </Border>
        </Canvas>
        <!-- 提示文字 -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="0,24,0,0" Padding="14,8" CornerRadius="6"
                Background="#CC1F1F1F">
            <TextBlock Foreground="White" FontSize="13"
                       Text="拖动鼠标选择区域 · Enter 确认 · Esc 取消" />
        </Border>
    </Grid>
</Window>
