<UserControl x:Class="MyTools.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewModels="clr-namespace:MyTools.ViewModels">
    <Grid Margin="16,12,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,12"
                CornerRadius="{StaticResource CornerRadiusCard}"
                Padding="14,10"
                BorderBrush="#E2E8F0"
                BorderThickness="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{DynamicResource BrushHeaderGradientStartColor}" Offset="0" />
                    <GradientStop Color="{DynamicResource BrushHeaderGradientEndColor}" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBox Width="220"
                             Margin="0,0,10,0"
                             Text="{Binding StartupSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource StandardTextBox}"
                             materialDesign:HintAssist.Hint="搜索名称/发布者/命令/位置/来源" />
                    <Button Style="{StaticResource MaterialDesignIconButton}"
                            Command="{Binding RefreshCommand}"
                            ToolTip="刷新启动项">
                        <materialDesign:PackIcon Kind="Refresh" Width="22" Height="22" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#F59E0B" Offset="0" />
                                <GradientStop Color="#EF4444" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <materialDesign:PackIcon Kind="RocketLaunchOutline" Width="18" Height="18" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="启动项管理" Style="{StaticResource TextHeadline}" />
                        <TextBlock Text="管理 Windows 开机启动项" Style="{StaticResource TextCaption}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FilteredStartupView}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card Style="{StaticResource PremiumCard}" Padding="0" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" CornerRadius="4,0,0,4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#2E7D32" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                        <Setter Property="Background" Value="#9E9E9E" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,12,8,12">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource TextSubtitle}" FontWeight="Bold" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <materialDesign:PackIcon Kind="CertificateOutline" Width="12" Height="12" VerticalAlignment="Center" Opacity="0.5" />
                                            <TextBlock Text="{Binding PublisherDisplay}"
                                                       Style="{StaticResource TextCaption}"
                                                       Margin="4,0,14,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding PublisherDisplay}" />
                                            <materialDesign:PackIcon Kind="FileOutline" Width="12" Height="12" VerticalAlignment="Center" Opacity="0.5" />
                                            <TextBlock Text="{Binding ExecutablePathDisplay}"
                                                       Style="{StaticResource TextCaption}"
                                                       Margin="4,0,0,0"
                                                       Opacity="0.65"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ExecutablePathDisplay}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Command}" Style="{StaticResource TextCaption}" Opacity="0.6" Margin="0,4,0,4"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}" />
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AccountCircle" Width="12" Height="12" VerticalAlignment="Center" Opacity="0.5" />
                                            <TextBlock Text="{Binding SourceLocationDisplay}" Style="{StaticResource TextCaption}" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="4,0,0,0" />
                                            <materialDesign:PackIcon Kind="AlertCircleOutline" Width="12" Height="12" VerticalAlignment="Center" Opacity="0.5" Margin="14,0,0,0" />
                                            <TextBlock Text="{Binding ExecutableStatusDisplay}" Margin="4,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                                                        <Setter Property="Foreground" Value="#2E7D32" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ExecutableExists}" Value="False">
                                                                <Setter Property="Foreground" Value="#E65100" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasExecutablePath}" Value="False">
                                                                <Setter Property="Foreground" Value="#757575" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="12" Height="12" VerticalAlignment="Center" Opacity="0.5" Margin="14,0,0,0" />
                                            <TextBlock Text="{Binding SignatureStatusDisplay}" Margin="4,0,0,0"
                                                       ToolTip="{Binding SignatureDetailDisplay}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                                                        <Setter Property="Foreground" Value="#E65100" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDigitallySigned}" Value="True">
                                                                <Setter Property="Foreground" Value="#2E7D32" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ExecutableExists}" Value="False">
                                                                <Setter Property="Foreground" Value="#757575" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <materialDesign:PackIcon Kind="ShieldLockOutline" Width="12" Height="12" VerticalAlignment="Center" Opacity="0.5" Margin="14,0,0,0" />
                                            <TextBlock Text="{Binding SignatureTrustStatus}" Margin="4,0,0,0"
                                                       ToolTip="{Binding SignatureDetailDisplay}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                                                        <Setter Property="Foreground" Value="#757575" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSignatureChainTrusted}" Value="True">
                                                                <Setter Property="Foreground" Value="#2E7D32" />
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsDigitallySigned}" Value="True" />
                                                                    <Condition Binding="{Binding IsSignatureChainTrusted}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Foreground" Value="#C62828" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Margin="0,0,8,0">
                                        <Button Command="{Binding DataContext.ToggleStartupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Width="80"
                                                Margin="0,0,8,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource GhostActionButton}">
                                                    <Setter Property="Content" Value="禁用" />
                                                    <Setter Property="Foreground" Value="#C62828" />
                                                    <Setter Property="BorderBrush" Value="#C62828" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                            <Setter Property="Content" Value="启用" />
                                                            <Setter Property="Foreground" Value="#2E7D32" />
                                                            <Setter Property="BorderBrush" Value="#2E7D32" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding DataContext.DeleteStartupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="永久删除（需确认）">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Foreground="#9E9E9E" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding HasNoStartupItems, Converter={StaticResource BoolToVis}}">
                <Image Source="{StaticResource StartupEmpty}" Width="160" Height="120" HorizontalAlignment="Center" />
                <TextBlock Text="未发现匹配的启动项" Style="{StaticResource TextSubtitle}"
                           HorizontalAlignment="Center" Opacity="0.4" Margin="0,12,0,0" />
                <TextBlock Text="可清空搜索或点击刷新重新扫描" Style="{StaticResource TextCaption}"
                           HorizontalAlignment="Center" Opacity="0.3" Margin="0,4,0,0" />
                <Button Content="刷新"
                        Style="{StaticResource GhostActionButton}"
                        Command="{Binding RefreshCommand}"
                        Margin="0,12,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
