<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MyToolsSetup</AssemblyName>
    <RootNamespace>MyTools.Installer</RootNamespace>
    <ApplicationIcon>..\MyTools\Resources\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version Condition="'$(Version)' == ''">2026.5.30.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <Product>阿君的工具安装程序</Product>
    <Company>Ajun</Company>
    <PayloadZip Condition="'$(PayloadZip)' == ''">..\..\artifacts\installer\MyToolsPayload.zip</PayloadZip>
    <UninstallerExe Condition="'$(UninstallerExe)' == ''">..\MyTools.Uninstaller\bin\Release\net48\MyTools.Uninstaller.exe</UninstallerExe>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\MediaFileAssociationCore.cs" Link="Shared\MediaFileAssociationCore.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="MyToolsPayload.zip" Condition="Exists('$(PayloadZip)')" />
    <EmbeddedResource Include="$(UninstallerExe)" LogicalName="MyTools.Uninstaller.exe" Condition="Exists('$(UninstallerExe)')" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>
