<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MyTools.Uninstaller</AssemblyName>
    <RootNamespace>MyTools.Uninstaller</RootNamespace>
    <ApplicationIcon>..\MyTools\Resources\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version Condition="'$(Version)' == ''">2026.5.12.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <Product>阿君的工具卸载程序</Product>
    <Company>Ajun</Company>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\MediaFileAssociationCore.cs" Link="Shared\MediaFileAssociationCore.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>
